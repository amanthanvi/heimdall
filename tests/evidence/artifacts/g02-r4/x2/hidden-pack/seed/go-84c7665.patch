diff -ruN a/internal/profile/k14_test.go b/internal/profile/k14_test.go
--- a/internal/profile/k14_test.go
+++ b/internal/profile/k14_test.go
@@ -53,16 +53,20 @@
 			t.Errorf("%s: Load still blocked after 2 s", name)
 		}
 	}
-	// A symlink to a regular file is still accepted.
+	// A symlink is refused even when it points to a regular file: the
+	// regular-file check does not follow links (see Load).
 	reg := filepath.Join(dir, "ok.toml")
 	if err := os.WriteFile(reg, []byte("schema_version = 1\nname = \"x\"\nrevision = 1\n"), 0o600); err != nil {
 		t.Fatal(err)
 	}
+	if _, e := Load(reg); e != nil {
+		t.Fatalf("regular file: %+v", e)
+	}
 	rl := filepath.Join(dir, "ok-link.toml")
 	if err := os.Symlink(reg, rl); err != nil {
 		t.Fatal(err)
 	}
-	if _, e := Load(rl); e != nil {
-		t.Fatalf("symlink to regular file: %+v", e)
+	if _, e := Load(rl); e == nil || e.Code != result.UsageError {
+		t.Fatalf("symlink to regular file: got %+v, want USAGE_ERROR", e)
 	}
 }
diff -ruN a/internal/profile/profile.go b/internal/profile/profile.go
--- a/internal/profile/profile.go
