+// Truncation at narrow widths never leaves underline open and never
+// overflows.
+func TestUnderlineTruncated(t *testing.T) {
+	m := New(homelab(), true)
+	press(m, txt("/"), txt("s"), txt("e"), txt("r"), txt("v"), txt("e"), txt("r"))
+	for _, w := range []int{1, 3, 5, 7, 8, 20, 49, 50, 55} {
+		m.Update(tea.WindowSizeMsg{Width: w, Height: 5})
+		for _, l := range strings.Split(m.Render(), "\n") {
+			if ansi.StringWidth(l) > w {
+				t.Fatalf("w=%d overflow %q", w, l)
+			}
+			if strings.Count(l, sgrUnderline) != strings.Count(l, sgrNoUnderline) {
+				t.Fatalf("w=%d unbalanced underline %q", w, l)
+			}
+		}
+	}
+}
