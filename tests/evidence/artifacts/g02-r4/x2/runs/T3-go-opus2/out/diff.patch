+func TestNoUnderlineWhenFilterEmpty(t *testing.T) {
+	m := New(homelab(), true)
+	press(m, txt("/"), txt("a"))
+	if !strings.Contains(m.Render(), sgrUnderline) {
+		t.Fatal("expected underline with filter")
+	}
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape})
+	if strings.Contains(m.Render(), "\x1b[") {
+		t.Fatalf("after Esc: %q", m.Render())
+	}
+	press(m, txt("/"), txt("a"), tea.KeyPressMsg{Code: tea.KeyBackspace})
+	if strings.Contains(m.Render(), "\x1b[") {
+		t.Fatal("after Backspace to empty")
+	}
+}
