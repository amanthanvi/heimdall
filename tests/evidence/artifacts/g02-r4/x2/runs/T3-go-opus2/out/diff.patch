@@ -0,0 +1,51 @@
+package main
+
+import (
+	"bytes"
+	"os"
+
+	"github.com/charmbracelet/x/ansi"
+)
+
+// pinnedSGROutput is the TUI's terminal output. Bubble Tea writes the xterm
+// modifyOtherKeys controls CSI > 4 ; 2 m and CSI > 4 m. Terminals and
+// emulators that do not know the '>' private marker read them as plain SGR,
+// i.e. "underline on" (SGR 4), and then show stale underline on cells the
+// renderer believes are unstyled (seen with pyte). Right after each of these
+// controls the renderer's pen is the default style, so appending SGR 0 there
+// changes nothing on a conforming terminal and pins the pen everywhere else.
+//
+// Embedding *os.File keeps Fd(), so Bubble Tea still detects a terminal and
+// queries its size. Bubble Tea writes each control whole within one Write
+// (Program.flush writes its whole output buffer at once), so a control is
+// never split across calls.
+type pinnedSGROutput struct {
+	*os.File
+}
+
+var modifyOtherKeysControls = [][]byte{[]byte(ansi.SetModifyOtherKeys2), []byte(ansi.ResetModifyOtherKeys)}
+
+// pinSGR returns b with SGR 0 appended after every modifyOtherKeys control.
+func pinSGR(b []byte) []byte {
+	if !bytes.Contains(b, []byte("\x1b[>4")) {
+		return b
+	}
+	out := b
+	for _, c := range modifyOtherKeysControls {
+		out = bytes.ReplaceAll(out, c, append(append([]byte(nil), c...), ansi.ResetStyle...))
+	}
+	return out
+}
+
+func (o pinnedSGROutput) Write(b []byte) (int, error) {
+	if _, err := o.File.Write(pinSGR(b)); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+
+// WriteString shadows (*os.File).WriteString so io.WriteString cannot bypass
+// Write.
+func (o pinnedSGROutput) WriteString(s string) (int, error) {
+	return o.Write([]byte(s))
+}
