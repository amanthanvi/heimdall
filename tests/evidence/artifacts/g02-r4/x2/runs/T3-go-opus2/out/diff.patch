+func norm(s string) string { return strings.Join(strings.Fields(s), " ") }
+
+func TestHelpOverlay(t *testing.T) {
+	m := New(homelab(), true)
+	m.Update(tea.WindowSizeMsg{Width: 80, Height: 24})
+	press(m, txt("/"), txt("a"), tea.KeyPressMsg{Code: tea.KeyDown}, tea.KeyPressMsg{Code: tea.KeyEnter})
+	before, beforeSel, beforeShown := m.Render(), m.sel, len(m.shown)
+
+	press(m, txt("?"))
+	lines := strings.Split(m.Render(), "\n")
+	for i, w := range helpWant {
+		if norm(lines[i]) != w {
+			t.Fatalf("help line %d = %q want %q", i, lines[i], w)
+		}
+	}
+	// Every other key is ignored while the overlay is open.
+	_, cmd := m.Update(txt("q"))
+	press(m, txt("j"), txt("k"), txt("/"), txt("x"), tea.KeyPressMsg{Code: tea.KeyDown},
+		tea.KeyPressMsg{Code: tea.KeyUp}, tea.KeyPressMsg{Code: tea.KeyBackspace})
+	_, cmd2 := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
+	if cmd != nil || cmd2 != nil || !m.help || m.filtering || m.filter != "a" {
+		t.Fatalf("key leaked through overlay: help=%v filtering=%v filter=%q", m.help, m.filtering, m.filter)
+	}
+	// Esc only closes the overlay; the filter stays.
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape})
+	if m.help || m.filter != "a" || m.sel != beforeSel || len(m.shown) != beforeShown || m.Render() != before {
+		t.Fatalf("esc close changed state:\n%s\n---\n%s", m.Render(), before)
+	}
+	for _, w := range helpWant[1:] {
+		if strings.Contains(norm(m.Render()), w) {
+			t.Fatalf("help line %q remains", w)
+		}
+	}
+	// '?' closes too.
+	press(m, txt("?"), txt("?"))
+	if m.help || m.Render() != before {
+		t.Fatal("? close")
+	}
+	// Ctrl-C cancels while the overlay is open.
+	press(m, txt("?"))
+	if _, cmd := m.Update(tea.KeyPressMsg{Code: 'c', Mod: tea.ModCtrl}); cmd == nil || m.Outcome != Cancelled {
+		t.Fatal("ctrl-c in help")
+	}
+}
