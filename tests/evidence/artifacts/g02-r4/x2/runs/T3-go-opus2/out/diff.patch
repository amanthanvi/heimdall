+// underlined decodes a rendered frame into, per line, the plain text and the
+// set of underlined rune indices. It understands the SGR forms Render emits
+// (and 0/empty reset); any colour parameter is reported via colour.
+func underlined(t *testing.T, frame string) (plain []string, ul []map[int]bool, colour bool) {
+	t.Helper()
+	for _, line := range strings.Split(frame, "\n") {
+		var p []rune
+		u := map[int]bool{}
+		on := false
+		rs := []rune(line)
+		for i := 0; i < len(rs); i++ {
+			if rs[i] == 0x1b {
+				j := i + 2
+				for j < len(rs) && rs[j] != 'm' {
+					j++
+				}
+				for _, f := range strings.FieldsFunc(string(rs[i+2:j]), func(r rune) bool { return r == ';' || r == ':' }) {
+					switch f {
+					case "4":
+						on = true
+					case "24", "0":
+						on = false
+					case "1", "22":
+					default:
+						colour = true
+					}
+				}
+				if j == i+2 { // ESC[m
+					on = false
+				}
+				i = j
+				continue
+			}
+			if on {
+				u[len(p)] = true
+			}
+			p = append(p, rs[i])
+		}
+		plain = append(plain, string(p))
+		ul = append(ul, u)
+	}
+	return
+}
+
+// marks renders the underlined runes of line i as the underlined substrings,
+// joined by "|", e.g. "nas|nas" for a match in alias and host.
+func marks(plain string, u map[int]bool) string {
+	var parts []string
+	var cur []rune
+	for i, r := range []rune(plain) {
+		if u[i] {
+			cur = append(cur, r)
+		} else if cur != nil {
+			parts = append(parts, string(cur))
+			cur = nil
+		}
+	}
+	if cur != nil {
+		parts = append(parts, string(cur))
+	}
+	return strings.Join(parts, "|")
+}
