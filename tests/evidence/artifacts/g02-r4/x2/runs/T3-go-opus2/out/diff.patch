+func TestMatchUnderline(t *testing.T) {
+	type tc struct {
+		name, filter string
+		width        int
+		enter        bool
+		want         map[string]string // alias -> marks ("" = row shown, nothing underlined)
+	}
+	cases := []tc{
+		{"single char wide", "a", 80, false, map[string]string{
+			"lab-server": "a|a", "nas": "a|a", "vps-東京": "a", "Router": "a"}},
+		{"multi char only first occurrence", "nas", 80, false, map[string]string{"nas": "nas|nas"}},
+		{"mixed case", "LaB", 80, true, map[string]string{"lab-server": "lab|lab"}},
+		{"mixed case alias upper", "rOU", 80, false, map[string]string{"Router": "Rou"}},
+		{"cjk", "東京", 80, false, map[string]string{"vps-東京": "東京"}},
+		{"host only", "example", 80, false, map[string]string{"lab-server": "example", "vps-東京": "example"}},
+		{"host only narrow", "example", 40, false, map[string]string{"lab-server": "", "vps-東京": ""}},
+		{"narrow alias", "s", 40, true, map[string]string{"lab-server": "s", "nas": "s", "vps-東京": "s"}},
+		{"host only, account not underlined", "home", 80, false, map[string]string{"nas": "home"}},
+		{"later occurrences not underlined", "e", 80, false, map[string]string{
+			"lab-server": "e|e", "nas": "e", "vps-東京": "e", "Router": "e"}},
+	}
+	for _, c := range cases {
+		for _, noColor := range []bool{true, false} {
+			t.Run(fmt.Sprintf("%s/nocolor=%v", c.name, noColor), func(t *testing.T) {
+				m := New(homelab(), noColor)
+				m.Update(tea.WindowSizeMsg{Width: c.width, Height: 24})
+				press(m, txt("/"))
+				for _, r := range c.filter {
+					press(m, txt(string(r)))
+				}
+				if c.enter {
+					press(m, tea.KeyPressMsg{Code: tea.KeyEnter})
+				}
+				plain, ul, colour := underlined(t, m.Render())
+				if colour != !noColor {
+					t.Fatalf("colour SGR present=%v with noColor=%v", colour, noColor)
+				}
+				got := map[string]string{}
+				for i, p := range plain[:len(plain)-1] {
+					if p == "" {
+						continue
+					}
+					if !strings.HasPrefix(p, "> ") && !strings.HasPrefix(p, "  ") {
+						t.Fatalf("row %q", p)
+					}
+					alias := strings.Fields(p[2:])[0]
+					got[alias] = marks(p, ul[i])
+					if ul[i][0] || ul[i][1] {
+						t.Fatalf("prefix underlined in %q", p)
+					}
+				}
+				if len(ul[len(ul)-1]) != 0 {
+					t.Fatal("status line underlined")
+				}
+				if fmt.Sprint(got) != fmt.Sprint(c.want) {
+					t.Fatalf("got %v want %v\n%s", got, c.want, strings.Join(plain, "\n"))
+				}
+			})
+		}
+	}
+}
