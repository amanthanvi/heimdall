+// A destination far down a long list stays selected and visible (the list
+// scrolls to it) across filter edits, and the window stays full.
+func TestSelectionKeptFarDownScrolls(t *testing.T) {
+	m := New(dests(100), true)
+	m.Update(tea.WindowSizeMsg{Width: 80, Height: 24})
+	for i := 0; i < 87; i++ {
+		press(m, txt("j"))
+	}
+	press(m, txt("/"), txt("H"), txt("o"))
+	check := func(what string) {
+		t.Helper()
+		if got := m.dests[m.shown[m.sel]].Alias; got != "host-087" {
+			t.Fatalf("%s: selected %s", what, got)
+		}
+		lines := strings.Split(ansi.Strip(m.Render()), "\n")
+		if !strings.HasPrefix(lines[22], "> host-087") {
+			t.Fatalf("%s: marker not on visible host-087: %q", what, lines[22])
+		}
+		if !strings.HasPrefix(lines[0], "  host-065") {
+			t.Fatalf("%s: window not full: %q", what, lines[0])
+		}
+	}
+	check("append")
+	press(m, tea.KeyPressMsg{Code: tea.KeyBackspace})
+	check("backspace")
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape})
+	check("esc")
+}
