+func TestHelpQuestionMarkInFilterMode(t *testing.T) {
+	m := New(homelab(), true)
+	press(m, txt("/"), txt("?"))
+	if m.help || m.filter != "?" || !m.filtering {
+		t.Fatalf("help=%v filter=%q", m.help, m.filter)
+	}
+	// Closing filter mode with Esc, then '?' opens help.
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape}, txt("?"))
+	if !m.help {
+		t.Fatal("? outside filter mode")
+	}
+}
