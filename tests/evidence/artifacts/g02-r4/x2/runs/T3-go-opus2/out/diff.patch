+func TestHelpOverlayTinySizes(t *testing.T) {
+	m := New(homelab(), false)
+	press(m, txt("?"))
+	for _, sz := range [][2]int{{20, 5}, {80, 24}, {1, 1}, {0, 0}, {3, 2}, {49, 10}, {20, 5}} {
+		m.Update(tea.WindowSizeMsg{Width: sz[0], Height: sz[1]})
+		lines := strings.Split(m.Render(), "\n")
+		if len(lines) != max(sz[1], 1) {
+			t.Fatalf("%v lines=%d", sz, len(lines))
+		}
+		for _, l := range lines {
+			if ansi.StringWidth(l) > max(sz[0], 1) {
+				t.Fatalf("%v overflow %q", sz, l)
+			}
+		}
+	}
+	press(m, txt("?"))
+	m.Update(tea.WindowSizeMsg{Width: 20, Height: 5})
+	if m.help || !strings.HasPrefix(ansi.Strip(m.Render()), "> lab-server") {
+		t.Fatal(m.Render())
+	}
+}
