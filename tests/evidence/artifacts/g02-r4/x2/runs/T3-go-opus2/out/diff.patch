@@ -0,0 +1,43 @@
+package main
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPinSGR(t *testing.T) {
+	for in, want := range map[string]string{
+		"":                                      "",
+		"plain \x1b[4mx\x1b[m":                  "plain \x1b[4mx\x1b[m",
+		"\x1b[>4m\x1b[?1049h\x1b[>4;2m\x1b[>1u": "\x1b[>4m\x1b[m\x1b[?1049h\x1b[>4;2m\x1b[m\x1b[>1u",
+		"a\x1b[>4;2mb\x1b[>4;2m":                "a\x1b[>4;2m\x1b[mb\x1b[>4;2m\x1b[m",
+		"\x1b[>4;1m":                            "\x1b[>4;1m", // not emitted by Bubble Tea; left alone
+	} {
+		if got := string(pinSGR([]byte(in))); got != want {
+			t.Errorf("pinSGR(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestPinnedSGROutputWrite(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "out")
+	f, err := os.Create(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	o := pinnedSGROutput{f}
+	in := "x\x1b[>4;2my"
+	if n, err := o.Write([]byte(in)); err != nil || n != len(in) {
+		t.Fatalf("Write = %d, %v", n, err)
+	}
+	if n, err := io.WriteString(o, in); err != nil || n != len(in) {
+		t.Fatalf("WriteString = %d, %v", n, err)
+	}
+	f.Close()
+	got, _ := os.ReadFile(p)
+	if want := "x\x1b[>4;2m\x1b[myx\x1b[>4;2m\x1b[my"; string(got) != want {
+		t.Fatalf("got %q want %q", got, want)
+	}
+}
diff --git a/prototypes/go/cmd/heimdall-proto/tui_t3_test.go b/prototypes/go/cmd/heimdall-proto/tui_t3_test.go
new file mode 100644
index 0000000..d0a3b5f
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/tui_t3_test.go
@@ -0,0 +1,78 @@
+//go:build darwin || linux
+
+package main
+
+import (
+	"bytes"
+	"regexp"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+
+	"github.com/heimdall-g02/proto-go/internal/profile"
+	"github.com/heimdall-g02/proto-go/internal/tui"
+)
+
+var colourSGR = regexp.MustCompile(`\x1b\[[0-9;:]*(3[0-8]|4[0-8]|9[0-7]|10[0-7]|58)[;:m]`)
+
+// End to end through Bubble Tea in a pty with NO_COLOR: the filter match is
+// underlined (SGR 4), the modifyOtherKeys controls are followed by SGR 0, no
+// colour SGR is written, the help overlay opens and closes, and Enter after
+// a kept filter selects the kept destination.
+func TestTUIUnderlineHelpEndToEnd(t *testing.T) {
+	// runTUI picks the colour profile from the process environment. Without
+	// TERM it is NoTTY, which writes no SGR at all.
+	t.Setenv("TERM", "xterm-256color")
+	t.Setenv("NO_COLOR", "1")
+	r := startPTY(t)
+	defer r.master.Close()
+	defer r.slave.Close()
+	m := tui.New([]profile.Destination{
+		{ID: "a", Alias: "lab", Host: "lab.example", Account: "u", Port: 22},
+		{ID: "b", Alias: "nas", Host: "nas.example", Account: "u", Port: 22},
+	}, true)
+	// waitFor polls the pty output; it never fails the test itself (it runs
+	// off the test goroutine), it only reports whether cond was seen.
+	waitFor := func(cond func([]byte) bool) bool {
+		for end := time.Now().Add(3 * time.Second); time.Now().Before(end); time.Sleep(20 * time.Millisecond) {
+			if cond(r.output()) {
+				return true
+			}
+		}
+		return false
+	}
+	var sawUnderline, sawHelp bool
+	go func() {
+		send := func(s string) { _, _ = r.master.Write([]byte(s)); time.Sleep(150 * time.Millisecond) }
+		time.Sleep(400 * time.Millisecond)
+		send("/")
+		send("NA")
+		sawUnderline = waitFor(func(b []byte) bool { return bytes.Contains(b, []byte("\x1b[4m")) })
+		send("\r")
+		send("?")
+		sawHelp = waitFor(func(b []byte) bool { return bytes.Contains(b, []byte("close help")) })
+		send("j")
+		send("\x1b")
+		send("\r")
+	}()
+	// Safety net: never hang the test binary if a step is lost.
+	stop := time.AfterFunc(10*time.Second, func() { _, _ = r.master.Write([]byte{3}) })
+	defer stop.Stop()
+	var stdout, stderr bytes.Buffer
+	opts := append(teaOpts(r), tea.WithOutput(pinnedSGROutput{r.slave}))
+	code := runTUI(m, m, r.slave, &stdout, &stderr, opts...)
+	out := r.output()
+	if !sawUnderline || !sawHelp {
+		t.Fatalf("underline seen=%v help seen=%v out=%q", sawUnderline, sawHelp, out)
+	}
+	if code != 0 || stdout.String() != "SELECTED nas\n" {
+		t.Fatalf("exit=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+	}
+	if !bytes.Contains(out, []byte("\x1b[>4;2m\x1b[m")) {
+		t.Fatalf("modifyOtherKeys not followed by SGR 0: %q", out)
+	}
+	if hits := colourSGR.FindAll(out, -1); len(hits) > 0 {
+		t.Fatalf("colour SGR with NO_COLOR: %q", hits)
+	}
+}
