+// A key that changes the screen while a double-width character is visible
+// asks for a full repaint (works around the renderer's wide-cell cursor
+// optimisation); ASCII-only screens and ignored keys do not.
+func TestWideCharacterFullRepaint(t *testing.T) {
+	isClear := func(cmd tea.Cmd) bool { return cmd != nil && cmd() == tea.ClearScreen() }
+	m := New(homelab(), true) // vps-東京 is on screen
+	m.Update(tea.WindowSizeMsg{Width: 20, Height: 5})
+	if _, cmd := m.Update(txt("/")); !isClear(cmd) {
+		t.Fatal("state change with CJK on screen: want full repaint")
+	}
+	if _, cmd := m.Update(tea.KeyPressMsg{Code: tea.KeyUp}); cmd != nil {
+		t.Fatal("no-op key (Up at top) must not repaint")
+	}
+	if _, cmd := m.Update(txt("東")); !isClear(cmd) {
+		t.Fatal("filter edit with CJK")
+	}
+	if _, cmd := m.Update(tea.KeyPressMsg{Code: 'c', Mod: tea.ModCtrl}); cmd == nil || isClear(cmd) {
+		t.Fatal("Ctrl-C must quit, not repaint")
+	}
+	a := New(dests(100)[:100], true) // ASCII only
+	for _, k := range []tea.KeyPressMsg{txt("j"), txt("/"), txt("7"), tea.KeyPressMsg{Code: tea.KeyBackspace}, txt("?")} {
+		if _, cmd := a.Update(k); cmd != nil {
+			t.Fatalf("ASCII screen: unexpected cmd for %v", k)
+		}
+	}
+	// The CJK destination scrolled off screen: no repaint needed.
+	b := New(dests(100), true) // vps-東京 is row 101
+	b.Update(tea.WindowSizeMsg{Width: 80, Height: 24})
+	if _, cmd := b.Update(txt("j")); cmd != nil {
+		t.Fatal("wide character not on screen")
+	}
+	if !hasWide("vps-東京") || hasWide("host-001 é") {
+		t.Fatal("hasWide")
+	}
+}
