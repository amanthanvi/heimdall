+/// K14 for lint: FIFO without a writer, directory, character device and socket are
+/// USAGE_ERROR within 2 s; lint never blocks.
+#[test]
+fn lint_k14_non_regular_never_blocks() {
+    let d = TempDir::new("lintk14");
+    let fifo = d.path().join("profile fifo ü");
+    mkfifo(&fifo);
+    let sock = d.path().join("p.sock");
+    let _l = UnixListener::bind(&sock).unwrap();
+    for p in [
+        fifo.as_path(),
+        d.path(),
+        Path::new("/dev/null"),
+        sock.as_path(),
+    ] {
+        for json in [true, false] {
+            let mut c = cmd();
+            c.args(["profile", "lint", "--file"]).arg(p);
+            if json {
+                c.arg("--json");
+            }
+            let mut c = c
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::piped())
+                .spawn()
+                .unwrap();
+            let t = Instant::now();
+            while c.try_wait().unwrap().is_none() && t.elapsed() < Duration::from_secs(2) {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            if c.try_wait().unwrap().is_none() {
+                let _ = c.kill();
+                let _ = c.wait();
+                panic!("{}: still running after 2 s", p.display());
+            }
+            let o = c.wait_with_output().unwrap();
+            assert_eq!(o.status.code(), Some(2), "{}", p.display());
+            if json {
+                let v = one_json(&o);
+                assert_eq!(v["code"], "USAGE_ERROR", "{}", p.display());
+                assert_eq!(v["data"]["error"]["key_path"], Value::Null);
+            } else {
+                assert!(o.stdout.is_empty());
+            }
+        }
+    }
+}
