+            ],
+        ];
+        for dests in cases {
+            let p = parse_bytes(src(dests).as_bytes()).unwrap();
+            let f = lint(&p);
+            assert_eq!(
+                String::from_utf8(json_line(&p.destinations, &f)).unwrap(),
+                reference_line(&p, &f)
+            );
+        }
