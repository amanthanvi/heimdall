+
+    /// A test destination: `(id, host, port, account, labels)`; `port` None omits the key.
+    type D<'a> = (&'a str, &'a str, Option<u16>, &'a str, &'a [&'a str]);
+
+    /// Build a profile source from test destinations (aliases are `alias-<index>`).
+    fn src(dests: &[D]) -> String {
+        let mut s = String::from("schema_version = 1\nname = \"n\"\nrevision = 1\n");
+        for (k, (id, host, port, account, labels)) in dests.iter().enumerate() {
+            s.push_str(&format!(
+                "[[destinations]]\nid = {id:?}\nalias = \"alias-{k}\"\nhost = {host:?}\naccount = {account:?}\n"
+            ));
+            if let Some(p) = port {
+                s.push_str(&format!("port = {p}\n"));
+            }
+            let ls: Vec<String> = labels.iter().map(|l| format!("{l:?}")).collect();
+            s.push_str(&format!("labels = [{}]\n", ls.join(", ")));
+        }
+        s
+    }
+
+    /// The `--json` line of `dests`, checked to be one JSON document plus `\n`.
+    fn lint_line(dests: &[D]) -> String {
+        let p = parse_bytes(src(dests).as_bytes()).expect("schema-valid");
+        let line = String::from_utf8(json_line(&p.destinations, &lint(&p))).unwrap();
+        assert!(line.ends_with('\n') && line.matches('\n').count() == 1);
+        line
+    }
+
+    fn lint_json(dests: &[D]) -> Json {
+        serde_json::from_str(&lint_line(dests)).unwrap()
+    }
+
+    /// Independent construction of the same result through `Envelope` and a
+    /// `serde_json::Value` tree, to pin [`json_line`] to the envelope shape (§1).
+    fn reference_line(p: &Profile, f: &[Finding]) -> String {
+        let list: Vec<Json> = f
+            .iter()
+            .map(|x| {
+                let ids: Vec<&str> = x
+                    .destination_indexes()
+                    .into_iter()
+                    .map(|i| p.destinations[i].id.as_str())
+                    .collect();
+                let paths: Vec<String> = x.places.iter().map(Place::key_path).collect();
+                json!({"rule": x.rule.id(), "key_paths": paths,
+                       "destination_ids": ids, "message": x.rule.message()})
+            })
+            .collect();
+        Envelope::success(code(f), json!({ "findings": list })).to_line()
+    }
