index 0000000..9f1d9eb
--- /dev/null
+++ b/prototypes/rust/src/lint.rs
@@ -0,0 +1,748 @@
+//! `profile lint` (X2 task T2): findings about a schema-valid profile.
+//!
+//! Lint runs on a [`Profile`] that [`crate::profile::load_file`] already accepted, so
+//! input handling (size bound, non-regular files, K2, K14, K15, K18) is exactly that of
+//! `profile show`. Only destinations are linted; `name`, `revision` and `[meta]` never
+//! are.
+//!
+//! Value non-echo: a finding names places by key path only. The one profile value it
+//! carries is the destination `id`, in `destination_ids`. Messages are fixed strings.
+//!
+//! Resources: every rule is one pass with a hash map, so a 1 MiB profile with a
+//! quarter of a million labels is linted in linear time. Findings hold compact
+//! `(destination, field)` places, and the JSON result is written straight into one
+//! buffer ([`json_line`]) instead of a `serde_json::Value` tree, which keeps peak RSS
+//! close to that of `profile show` on the same file (K15 margin).
+
+use std::borrow::Cow;
+use std::collections::HashMap;
+use std::collections::hash_map::Entry;
+use std::io::Write;
+
+use crate::envelope::{Code, State};
+use crate::profile::{Destination, Profile};
+
+/// Lint rules, in reporting order (rule number 1 to 5).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Rule {
+    DuplicateEndpoint,
+    PrivilegedPort,
+    RootAccount,
+    DuplicateLabel,
+    LabelCaseVariant,
+}
+
+impl Rule {
+    pub fn id(self) -> &'static str {
+        match self {
+            Rule::DuplicateEndpoint => "duplicate-endpoint",
+            Rule::PrivilegedPort => "privileged-port",
+            Rule::RootAccount => "root-account",
+            Rule::DuplicateLabel => "duplicate-label",
+            Rule::LabelCaseVariant => "label-case-variant",
+        }
+    }
+
+    /// The exact message for this rule. Fixed text: never contains a profile value.
+    pub fn message(self) -> &'static str {
+        match self {
+            Rule::DuplicateEndpoint => "destinations share the same host and port",
+            Rule::PrivilegedPort => "port below 1024 other than 22",
+            Rule::RootAccount => "account is root",
+            Rule::DuplicateLabel => "label repeated within a destination",
+            Rule::LabelCaseVariant => "labels differ only in letter case",
+        }
+    }
+}
+
+/// Which field of a destination a key path points at.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Field {
+    Host,
+    Port,
+    Account,
+    Label(usize),
+}
+
+/// One place in the profile: destination index plus field.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Place {
+    pub dest: usize,
+    pub field: Field,
+}
+
+impl Place {
+    fn new(dest: usize, field: Field) -> Self {
+        Place { dest, field }
+    }
+
+    /// Key path in the exact form `destinations[2].labels[0]`.
+    pub fn key_path(&self) -> String {
+        let mut b = Vec::new();
+        self.write_key_path(&mut b);
+        String::from_utf8(b).expect("key paths are ASCII")
+    }
+
+    /// Append the key path. It is built from fixed ASCII and decimal indexes only, so
+    /// it needs no JSON escaping and never carries a profile value.
+    fn write_key_path(&self, b: &mut Vec<u8>) {
+        let i = self.dest;
+        // Writing into a Vec<u8> cannot fail.
+        let _ = match self.field {
+            Field::Host => write!(b, "destinations[{i}].host"),
+            Field::Port => write!(b, "destinations[{i}].port"),
+            Field::Account => write!(b, "destinations[{i}].account"),
+            Field::Label(j) => write!(b, "destinations[{i}].labels[{j}]"),
+        };
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Finding {
+    pub rule: Rule,
+    /// Places in the order the rule's `key_paths` require. Never empty.
+    pub places: Vec<Place>,
+}
+
+impl Finding {
+    pub fn key_paths(&self) -> Vec<String> {
+        self.places.iter().map(Place::key_path).collect()
+    }
+
+    /// Indexes of the destinations named in `places`, first-appearance order, no
+    /// repeats. Every rule emits places in non-decreasing destination order (rule 1 in
+    /// file order, rule 4 within one destination, rule 5 in `(i, j)` order), so
+    /// skipping a repeat of the previous index removes every repeat.
+    pub fn destination_indexes(&self) -> Vec<usize> {
+        debug_assert!(self.places.windows(2).all(|w| w[0].dest <= w[1].dest));
+        let mut out: Vec<usize> = Vec::new();
+        for p in &self.places {
+            if out.last() != Some(&p.dest) {
+                out.push(p.dest);
+            }
+        }
+        out
+    }
+}
+
+/// The effective port: `port`, or 22 when omitted (the loader already applied the default).
+fn effective_port(d: &Destination) -> u16 {
+    d.port
+}
+
+/// All findings of `p`, ordered by rule number, then by each rule's own order.
+pub fn lint(p: &Profile) -> Vec<Finding> {
+    let d = &p.destinations;
+    let mut out = Vec::new();
+    duplicate_endpoints(d, &mut out);
+    for (i, dest) in d.iter().enumerate() {
+        let port = effective_port(dest);
+        if port < 1024 && port != 22 {
+            out.push(Finding {
+                rule: Rule::PrivilegedPort,
+                places: vec![Place::new(i, Field::Port)],
+            });
+        }
+    }
+    for (i, dest) in d.iter().enumerate() {
+        if dest.account == "root" {
+            out.push(Finding {
+                rule: Rule::RootAccount,
+                places: vec![Place::new(i, Field::Account)],
+            });
+        }
+    }
+    duplicate_labels(d, &mut out);
+    label_case_variants(d, &mut out);
+    out
+}
+
+/// Rule 1. Groups keyed by (ASCII-lowercased host, effective port), kept in the order
+/// of each group's first member; members within a group are in file order.
+fn duplicate_endpoints(d: &[Destination], out: &mut Vec<Finding>) {
+    let mut index: HashMap<(String, u16), usize> = HashMap::with_capacity(d.len());
+    let mut groups: Vec<Vec<usize>> = Vec::new();
+    for (i, dest) in d.iter().enumerate() {
+        let key = (dest.host.to_ascii_lowercase(), effective_port(dest));
+        match index.entry(key) {
+            Entry::Occupied(e) => groups[*e.get()].push(i),
+            Entry::Vacant(e) => {
+                e.insert(groups.len());
+                groups.push(vec![i]);
+            }
+        }
+    }
+    out.extend(groups.into_iter().filter(|g| g.len() > 1).map(|g| Finding {
+        rule: Rule::DuplicateEndpoint,
+        places: g.into_iter().map(|i| Place::new(i, Field::Host)).collect(),
+    }));
+}
+
+/// Rule 4. Per destination, exact label strings in order of first occurrence; one
+/// finding per string that occurs more than once, with every occurrence ascending.
+fn duplicate_labels(d: &[Destination], out: &mut Vec<Finding>) {
+    for (i, dest) in d.iter().enumerate() {
+        let mut index: HashMap<&str, usize> = HashMap::new();
+        let mut groups: Vec<Vec<usize>> = Vec::new();
+        for (j, label) in dest.labels.iter().enumerate() {
+            match index.entry(label.as_str()) {
+                Entry::Occupied(e) => groups[*e.get()].push(j),
+                Entry::Vacant(e) => {
+                    e.insert(groups.len());
+                    groups.push(vec![j]);
+                }
+            }
+        }
+        out.extend(groups.into_iter().filter(|g| g.len() > 1).map(|g| {
+            Finding {
+                rule: Rule::DuplicateLabel,
+                places: g
+                    .into_iter()
+                    .map(|j| Place::new(i, Field::Label(j)))
+                    .collect(),
+            }
+        }));
+    }
+}
+
+/// Rule 5. Labels of the whole profile grouped by their ASCII-lowercased form. A group
+/// is a finding when it holds two or more *different* spellings. Iterating in `(i, j)`
+/// order makes both the groups (by first occurrence) and their members `(i, j)`-ordered.
+fn label_case_variants(d: &[Destination], out: &mut Vec<Finding>) {
+    struct Group<'a> {
+        first_spelling: &'a str,
+        mixed: bool,
+        places: Vec<Place>,
+    }
+    let mut index: HashMap<Cow<'_, str>, usize> = HashMap::new();
+    let mut groups: Vec<Group> = Vec::new();
+    for (i, dest) in d.iter().enumerate() {
+        for (j, label) in dest.labels.iter().enumerate() {
+            let place = Place::new(i, Field::Label(j));
+            // Allocate a folded copy only when the label has an ASCII capital.
+            let folded = if label.bytes().any(|b| b.is_ascii_uppercase()) {
+                Cow::Owned(label.to_ascii_lowercase())
+            } else {
+                Cow::Borrowed(label.as_str())
+            };
+            match index.entry(folded) {
+                Entry::Occupied(e) => {
+                    let g = &mut groups[*e.get()];
+                    g.mixed |= g.first_spelling != label.as_str();
+                    g.places.push(place);
+                }
+                Entry::Vacant(e) => {
+                    e.insert(groups.len());
+                    groups.push(Group {
+                        first_spelling: label.as_str(),
+                        mixed: false,
+                        places: vec![place],
+                    });
+                }
+            }
+        }
+    }
+    out.extend(groups.into_iter().filter(|g| g.mixed).map(|g| Finding {
+        rule: Rule::LabelCaseVariant,
+        places: g.places,
+    }));
+}
+
+/// Result code: `LINT_CLEAN` (exit 0) or `LINT_FINDINGS` (exit 3).
+pub fn code(findings: &[Finding]) -> Code {
+    if findings.is_empty() {
+        Code::LintClean
+    } else {
+        Code::LintFindings
+    }
+}
+
+/// The `--json` result: exactly one JSON document followed by `\n`, in the envelope
+/// shape of [`crate::envelope::Envelope::to_line`] (same member order), with `data`
+/// holding only `findings`. Strings that are not fixed ASCII (the destination ids) are
+/// escaped by serde_json.
+pub fn json_line(dests: &[Destination], findings: &[Finding]) -> Vec<u8> {
+    fn string(b: &mut Vec<u8>, s: &str) {
+        serde_json::to_writer(&mut *b, s).expect("serializing a str into a Vec cannot fail");
+    }
+    let mut b = Vec::with_capacity(160 + findings.len() * 128);
+    b.extend_from_slice(b"{\"schema_version\":\"1\",\"state\":");
+    string(&mut b, State::Succeeded.as_str());
+    b.extend_from_slice(b",\"code\":");
+    string(&mut b, code(findings).as_str());
+    b.extend_from_slice(b",\"data\":{\"findings\":[");
+    for (n, f) in findings.iter().enumerate() {
+        if n > 0 {
+            b.push(b',');
+        }
+        b.extend_from_slice(b"{\"rule\":");
+        string(&mut b, f.rule.id());
+        b.extend_from_slice(b",\"key_paths\":[");
+        for (k, p) in f.places.iter().enumerate() {
+            if k > 0 {
+                b.push(b',');
+            }
+            b.push(b'"');
+            p.write_key_path(&mut b);
+            b.push(b'"');
+        }
+        b.extend_from_slice(b"],\"destination_ids\":[");
+        for (k, i) in f.destination_indexes().into_iter().enumerate() {
+            if k > 0 {
+                b.push(b',');
+            }
+            string(&mut b, &dests[i].id);
+        }
+        b.extend_from_slice(b"],\"message\":");
+        string(&mut b, f.rule.message());
+        b.push(b'}');
+    }
+    b.extend_from_slice(b"]},\"warnings\":[],\"next\":null}\n");
+    b
+}
+
+/// Human-readable lines for output without `--json` (K12: unspecified, not judged).
+/// Key paths, rule ids and fixed messages only: no profile value, not even ids.
+pub fn plain_lines(findings: &[Finding]) -> Vec<String> {
+    if findings.is_empty() {
+        return vec!["no findings".to_string()];
+    }
+    let mut lines: Vec<String> = findings
+        .iter()
+        .map(|f| {
+            format!(
+                "{}: {} ({})",
+                f.rule.id(),
+                f.rule.message(),
+                f.key_paths().join(", ")
+            )
+        })
+        .collect();
+    lines.push(format!("{} finding(s)", findings.len()));
+    lines
+}
