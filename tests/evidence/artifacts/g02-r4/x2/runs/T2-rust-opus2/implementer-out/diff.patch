+#[test]
+fn lint_usage_errors() {
+    let cases: &[(&[&str], bool)] = &[
+        (&["profile", "lint"], false),
+        (&["profile", "lint", "--json"], true),
+        (&["profile", "lint", "--file"], false),
+        (&["profile", "lint", "--file", "--json"], true),
+        (&["profile", "lint", "--json", "--file"], true),
+        (&["profile", "lint", "--file", "x.toml", "--bogus"], false),
+        (
+            &["profile", "lint", "--bogus", "--file", "x.toml", "--json"],
+            true,
+        ),
+        (
+            &["profile", "lint", "--json", "--json", "--file", "x.toml"],
+            true,
+        ),
+    ];
+    for (args, json) in cases {
+        let o = run(args);
+        assert_eq!(o.status.code(), Some(2), "{args:?}");
+        assert!(!o.stderr.is_empty(), "{args:?}");
+        if *json {
+            let v = one_json(&o);
+            assert_eq!(v["code"], "USAGE_ERROR", "{args:?}");
+            assert_eq!(v["state"], "failed", "{args:?}");
+        } else {
+            assert!(o.stdout.is_empty(), "{args:?}");
+        }
+    }
+}
