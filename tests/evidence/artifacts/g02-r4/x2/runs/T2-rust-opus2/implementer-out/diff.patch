+/// `profile lint` fails exactly like `profile show`: same exit status, stdout and
+/// stderr (so the same state, code, key_path, message and warnings).
+#[test]
+fn lint_input_errors_identical_to_profile_show() {
+    let d = TempDir::new("linteq");
+    let big = d.path().join("oversize ü.toml");
+    let mut body = b"schema_version = 1\nname = \"x\"\nrevision = 1\n".to_vec();
+    body.resize(1_048_577, b'#');
+    std::fs::write(&big, body).unwrap();
+    let ctl = d.path().join("control.toml");
+    std::fs::write(
+        &ctl,
+        "schema_version=1\nname=\"n\"\nrevision=1\n[[destinations]]\nid=\"i\"\nalias=\"a\"\nhost=\"h\\u001bLVCTL\"\naccount=\"u\"\n",
+    )
+    .unwrap();
+    let dir = d.path().join("a dir");
+    std::fs::create_dir(&dir).unwrap();
+    let mut paths: Vec<PathBuf> = [
+        "invalid-forbidden-key.toml",
+        "invalid-unknown-dest-key.toml",
+        "invalid-malformed.toml",
+        "invalid-schema-version.toml",
+        "invalid-duplicate-alias.toml",
+        "invalid-port.toml",
+        "does-not-exist.toml",
+    ]
+    .iter()
+    .map(|n| fixtures().join(n))
+    .collect();
+    paths.extend([big, ctl, dir, PathBuf::from("/dev/null")]);
+    for p in &paths {
+        for mode in [Some(true), Some(false), None] {
+            let mut show = cmd();
+            show.args(["profile", "show"]);
+            match mode {
+                Some(true) => show.arg("--json").arg("--file").arg(p),
+                Some(false) => show.arg("--file").arg(p).arg("--json"),
+                None => show.arg("--file").arg(p),
+            };
+            let s = show.stdin(Stdio::null()).output().unwrap();
+            let l = lint_cmd(p, mode);
+            assert_eq!(l.status.code(), Some(2), "{} {mode:?}", p.display());
+            assert_eq!(l.status.code(), s.status.code(), "{}", p.display());
+            assert_eq!(l.stdout, s.stdout, "{} {mode:?}", p.display());
+            assert_eq!(l.stderr, s.stderr, "{} {mode:?}", p.display());
+            no_canary(&l);
+            for stream in [&l.stdout, &l.stderr] {
+                assert!(!String::from_utf8_lossy(stream).contains("LVCTL"));
+            }
+            if mode.is_some() {
+                let v = one_json(&l);
+                assert_eq!(v["state"], "failed");
+            } else {
+                assert!(l.stdout.is_empty());
+            }
+        }
+    }
+}
