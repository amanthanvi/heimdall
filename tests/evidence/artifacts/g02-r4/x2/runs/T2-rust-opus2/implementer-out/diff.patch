+fn lint_cmd(path: &Path, json_first: Option<bool>) -> Output {
+    let mut c = cmd();
+    c.args(["profile", "lint"]);
+    match json_first {
+        Some(true) => {
+            c.arg("--json").arg("--file").arg(path);
+        }
+        Some(false) => {
+            c.arg("--file").arg(path).arg("--json");
+        }
+        None => {
+            c.arg("--file").arg(path);
+        }
+    }
+    c.stdin(Stdio::null()).output().unwrap()
+}
+
+/// Every regular file under `dir` with its contents (to prove lint writes nothing).
+fn snapshot(dir: &Path) -> Vec<(PathBuf, Vec<u8>)> {
+    let mut out = Vec::new();
+    let mut stack = vec![dir.to_path_buf()];
+    while let Some(d) = stack.pop() {
+        for e in std::fs::read_dir(&d).unwrap() {
+            let p = e.unwrap().path();
+            let ft = std::fs::symlink_metadata(&p).unwrap().file_type();
+            if ft.is_dir() {
+                stack.push(p);
+            } else if ft.is_file() {
+                let b = std::fs::read(&p).unwrap();
+                out.push((p, b));
+            } else {
+                out.push((p, Vec::new()));
+            }
+        }
+    }
+    out.sort();
+    out
+}
