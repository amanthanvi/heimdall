+package main
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/heimdall-g02/proto-go/internal/testfix"
+)
+
+const lintSecretProfile = `schema_version = 1
+name = "SECRETNAME"
+revision = 2
+[meta]
+note = "SECRETMETA"
+[[destinations]]
+id = "d_one"
+alias = "SECRETALIAS1"
+host = "SECRETHOST.example"
+port = 80
+account = "root"
+labels = ["SecretLabel", "secretlabel", "SecretLabel"]
+[[destinations]]
+id = "d_two"
+alias = "SECRETALIAS2"
+host = "secrethost.EXAMPLE"
+port = 80
+account = "SECRETACCOUNT"
+`
+
+func writeTemp(t *testing.T, name, body string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(p, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestProfileLintFindingsAndNonEcho(t *testing.T) {
+	f := writeTemp(t, "prøfile sp ace.toml", lintSecretProfile)
+	for _, args := range [][]string{
+		{"profile", "lint", "--file", f, "--json"},
+		{"profile", "lint", "--json", "--file", f},
+		{"profile", "lint", "--file=" + f, "--json"},
+	} {
+		code, out, errS := call(args...)
+		if code != 3 {
+			t.Fatal(args, code, out, errS)
+		}
+		m := envelope(t, out)
+		if m["state"] != "succeeded" || m["code"] != "LINT_FINDINGS" || m["next"] != nil {
+			t.Fatal(out)
+		}
+		d := m["data"].(map[string]any)
+		if len(d) != 1 || len(d["findings"].([]any)) != 6 {
+			t.Fatal(out)
+		}
+		for _, bad := range []string{"SECRET", "secret"} {
+			if strings.Contains(out+errS, bad) {
+				t.Fatalf("value %q echoed: %s %s", bad, out, errS)
+			}
+		}
+	}
+	// Without --json: same exit status, no value echo, nothing on stderr.
+	code, out, errS := call("profile", "lint", "--file", f)
+	if code != 3 || errS != "" {
+		t.Fatal(code, out, errS)
+	}
+	for _, bad := range []string{"SECRET", "secret", "d_one"} {
+		if strings.Contains(out+errS, bad) {
+			t.Fatalf("value %q echoed without --json: %s", bad, out)
+		}
+	}
+}
+
+func TestProfileLintClean(t *testing.T) {
+	code, out, errS := call("profile", "lint", "--file", filepath.Join(testfix.Dir(t), "homelab.toml"), "--json")
+	m := envelope(t, out)
+	if code != 0 || errS != "" || m["code"] != "LINT_CLEAN" || m["state"] != "succeeded" {
+		t.Fatal(code, out, errS)
+	}
+	if !strings.Contains(out, `"data":{"findings":[]}`) {
+		t.Fatal(out)
+	}
+	if code, out, _ = call("profile", "lint", "--file", filepath.Join(testfix.Dir(t), "homelab.toml")); code != 0 || out != "" {
+		t.Fatal(code, out)
+	}
+}
+
+// Input handling must match `profile show` exactly (status, state, code,
+// key_path) for invalid and non-regular inputs and for usage errors.
+func TestProfileLintMatchesShowOnBadInput(t *testing.T) {
+	dir := t.TempDir()
+	big := filepath.Join(dir, "big.toml")
+	_ = os.WriteFile(big, make([]byte, 1<<20+1), 0o600)
+	var argsets [][]string
+	argsets = append(argsets, []string{"--file", big, "--json"}, []string{"--file", dir, "--json"},
+		[]string{"--file", filepath.Join(dir, "missing"), "--json"},
+		[]string{"--json"}, []string{"--file"}, []string{"--file", "--json"}, []string{"--bogus", "--json"},
+		[]string{"--file", "x", "extra", "--json"}, []string{"--file", ""}, []string{"--json", "--file"})
+	for _, n := range []string{"invalid-forbidden-key.toml", "invalid-unknown-dest-key.toml", "invalid-malformed.toml",
+		"invalid-schema-version.toml", "invalid-duplicate-alias.toml", "invalid-port.toml"} {
+		argsets = append(argsets, []string{"--file", filepath.Join(testfix.Dir(t), n), "--json"},
+			[]string{"--json", "--file", filepath.Join(testfix.Dir(t), n)})
+	}
+	for _, a := range argsets {
+		sc, so, _ := call(append([]string{"profile", "show"}, a...)...)
+		lc, lo, le := call(append([]string{"profile", "lint"}, a...)...)
+		if sc != lc || so != lo {
+			t.Errorf("%q: show=%d %q lint=%d %q", a, sc, so, lc, lo)
+		}
+		if strings.Contains(lo+le, "HEIMDALL_CANARY_") {
+			t.Errorf("canary echoed for %q", a)
+		}
+	}
+	// Usage error without --json: stderr only.
+	if code, out, errS := call("profile", "lint"); code != 2 || out != "" || errS == "" {
+		t.Fatal(code, out, errS)
+	}
+	if code, out, _ := call("profile", "lint", "--json"); code != 2 || envelope(t, out)["code"] != "USAGE_ERROR" {
+		t.Fatal(code, out)
+	}
+	if code, out, _ := call("profile", "bogus", "--json"); code != 2 || envelope(t, out)["code"] != "USAGE_ERROR" {
+		t.Fatal(code, out)
+	}
+}
+
+func TestProfileLintWritesNothing(t *testing.T) {
+	dir := t.TempDir()
+	f := filepath.Join(dir, "p.toml")
+	_ = os.WriteFile(f, []byte(lintSecretProfile), 0o600)
+	call("profile", "lint", "--file", f, "--json")
+	ents, _ := os.ReadDir(dir)
+	if len(ents) != 1 {
+		t.Fatalf("lint wrote files: %v", ents)
+	}
+}
