+)
+
+func mustParse(t *testing.T, toml string) *Profile {
+	t.Helper()
+	p, err := Parse([]byte("schema_version = 1\nname = \"n\"\nrevision = 1\n" + toml))
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	return p
+}
+
+func dest(id, host string, extra string) string {
+	return "[[destinations]]\nid = \"" + id + "\"\nalias = \"a-" + id + "\"\nhost = \"" + host + "\"\naccount = \"u\"\n" + extra + "\n"
+}
+
+func TestLintTable(t *testing.T) {
+	type f struct {
+		rule string
+		kp   []string
+		ids  []string
+		msg  string
+	}
+	cases := []struct {
+		name string
+		toml string
+		want []f
+	}{
+		{"empty profile", "", nil},
+		{"clean", dest("d0", "a.example", "port = 2222") + dest("d1", "b.example", "labels = [\"x\"]"), nil},
+		{"dup endpoint, case-insensitive, default port",
+			dest("d0", "Host.Example", "") + dest("d1", "other", "") + dest("d2", "host.EXAMPLE", "port = 22"),
+			[]f{{RuleDuplicateEndpoint, []string{"destinations[0].host", "destinations[2].host"}, []string{"d0", "d2"}, "destinations share the same host and port"}}},
+		{"dup endpoint near miss: different port",
+			dest("d0", "h", "") + dest("d1", "h", "port = 2222"), nil},
+		{"dup endpoint: non-ASCII case is not folded",
+			dest("d0", "É.example", "") + dest("d1", "é.example", ""), nil},
+		{"dup endpoint groups ordered by first member",
+			dest("d0", "a", "") + dest("d1", "b", "") + dest("d2", "b", "") + dest("d3", "a", ""),
+			[]f{
+				{RuleDuplicateEndpoint, []string{"destinations[0].host", "destinations[3].host"}, []string{"d0", "d3"}, "destinations share the same host and port"},
+				{RuleDuplicateEndpoint, []string{"destinations[1].host", "destinations[2].host"}, []string{"d1", "d2"}, "destinations share the same host and port"},
+			}},
+		{"privileged port",
+			dest("d0", "a", "port = 443") + dest("d1", "b", "port = 22") + dest("d2", "c", "port = 1023") + dest("d3", "d", "port = 1024") + dest("d4", "e", "port = 1"),
+			[]f{
+				{RulePrivilegedPort, []string{"destinations[0].port"}, []string{"d0"}, "port below 1024 other than 22"},
+				{RulePrivilegedPort, []string{"destinations[2].port"}, []string{"d2"}, "port below 1024 other than 22"},
+				{RulePrivilegedPort, []string{"destinations[4].port"}, []string{"d4"}, "port below 1024 other than 22"},
+			}},
+		{"root account is case sensitive",
+			"[[destinations]]\nid=\"d0\"\nalias=\"a0\"\nhost=\"h0\"\naccount=\"root\"\n[[destinations]]\nid=\"d1\"\nalias=\"a1\"\nhost=\"h1\"\naccount=\"Root\"\n[[destinations]]\nid=\"d2\"\nalias=\"a2\"\nhost=\"h2\"\naccount=\"root \"\n",
+			[]f{{RuleRootAccount, []string{"destinations[0].account"}, []string{"d0"}, "account is root"}}},
+		{"duplicate label",
+			dest("d0", "a", `labels = ["x", "y", "x", "y", "x", "z"]`),
+			[]f{
+				{RuleDuplicateLabel, []string{"destinations[0].labels[0]", "destinations[0].labels[2]", "destinations[0].labels[4]"}, []string{"d0"}, "label repeated within a destination"},
+				{RuleDuplicateLabel, []string{"destinations[0].labels[1]", "destinations[0].labels[3]"}, []string{"d0"}, "label repeated within a destination"},
+			}},
+		{"same label in two destinations is clean",
+			dest("d0", "a", `labels = ["x"]`) + dest("d1", "b", `labels = ["x"]`), nil},
+		{"case variants in one destination are rule 5 only",
+			dest("d0", "a", `labels = ["Ab", "aB"]`),
+			[]f{{RuleLabelCaseVariant, []string{"destinations[0].labels[0]", "destinations[0].labels[1]"}, []string{"d0"}, "labels differ only in letter case"}}},
+		{"case variants across destinations, all occurrences",
+			dest("d0", "a", `labels = ["Web"]`) + dest("d1", "b", `labels = ["web", "x"]`) + dest("d2", "c", `labels = ["WEB", "web"]`),
+			[]f{{RuleLabelCaseVariant,
+				[]string{"destinations[0].labels[0]", "destinations[1].labels[0]", "destinations[2].labels[0]", "destinations[2].labels[1]"},
+				[]string{"d0", "d1", "d2"}, "labels differ only in letter case"}}},
+		{"non-ASCII case is not a variant",
+			dest("d0", "a", `labels = ["É", "é"]`), nil},
+		{"duplicate and variant together: rule 4 then rule 5",
+			dest("d0", "a", `labels = ["A", "A", "a"]`),
+			[]f{
+				{RuleDuplicateLabel, []string{"destinations[0].labels[0]", "destinations[0].labels[1]"}, []string{"d0"}, "label repeated within a destination"},
+				{RuleLabelCaseVariant, []string{"destinations[0].labels[0]", "destinations[0].labels[1]", "destinations[0].labels[2]"}, []string{"d0"}, "labels differ only in letter case"},
+			}},
+		{"variant sets ordered by first occurrence",
+			dest("d0", "a", `labels = ["q", "B"]`) + dest("d1", "b", `labels = ["b", "Q"]`),
+			[]f{
+				{RuleLabelCaseVariant, []string{"destinations[0].labels[0]", "destinations[1].labels[1]"}, []string{"d0", "d1"}, "labels differ only in letter case"},
+				{RuleLabelCaseVariant, []string{"destinations[0].labels[1]", "destinations[1].labels[0]"}, []string{"d0", "d1"}, "labels differ only in letter case"},
+			}},
+		{"rule order across rules",
+			"[[destinations]]\nid=\"d0\"\nalias=\"a0\"\nhost=\"H\"\naccount=\"root\"\nport=80\nlabels=[\"l\",\"l\"]\n[[destinations]]\nid=\"d1\"\nalias=\"a1\"\nhost=\"h\"\naccount=\"u\"\nport=80\n",
+			[]f{
+				{RuleDuplicateEndpoint, []string{"destinations[0].host", "destinations[1].host"}, []string{"d0", "d1"}, "destinations share the same host and port"},
+				{RulePrivilegedPort, []string{"destinations[0].port"}, []string{"d0"}, "port below 1024 other than 22"},
+				{RulePrivilegedPort, []string{"destinations[1].port"}, []string{"d1"}, "port below 1024 other than 22"},
+				{RuleRootAccount, []string{"destinations[0].account"}, []string{"d0"}, "account is root"},
+				{RuleDuplicateLabel, []string{"destinations[0].labels[0]", "destinations[0].labels[1]"}, []string{"d0"}, "label repeated within a destination"},
+			}},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := Lint(mustParse(t, c.toml))
+			if got == nil {
+				t.Fatal("Lint returned nil")
+			}
+			var want []Finding
+			for _, w := range c.want {
+				want = append(want, Finding{Rule: w.rule, KeyPaths: w.kp, DestinationIDs: w.ids, Message: w.msg})
+			}
+			if len(got) != len(want) || (len(want) > 0 && !reflect.DeepEqual(got, want)) {
+				gj, _ := json.Marshal(got)
+				wj, _ := json.Marshal(want)
+				t.Fatalf("got  %s\nwant %s", gj, wj)
+			}
+		})
+	}
+}
+
+func TestLintJSONShape(t *testing.T) {
+	b, _ := json.Marshal(Lint(mustParse(t, "")))
+	if string(b) != "[]" {
+		t.Fatalf("empty findings must marshal as [], got %s", b)
+	}
+	fs := Lint(mustParse(t, dest("d0", "a", "port = 80")))
+	b, _ = json.Marshal(fs[0])
+	if !strings.HasPrefix(string(b), `{"rule":`) {
+		t.Fatal(string(b))
+	}
+	var m map[string]any
+	_ = json.Unmarshal(b, &m)
+	if len(m) != 4 {
+		t.Fatalf("finding must have exactly four members: %s", b)
+	}
+}
+
+func TestAsciiLower(t *testing.T) {
+	for in, want := range map[string]string{"": "", "abc": "abc", "ABC-xyZ": "abc-xyz", "ÉÀ": "ÉÀ", "Éa|B": "Éa|b"} {
+		if got := asciiLower(in); got != want {
+			t.Errorf("asciiLower(%q)=%q want %q", in, got, want)
+		}
+	}
+}
