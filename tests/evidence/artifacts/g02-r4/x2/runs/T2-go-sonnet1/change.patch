diff --color -ruN -x target -x dist base/prototypes/go/internal/profile/lint.go frozen/go/internal/profile/lint.go
--- base/prototypes/go/internal/profile/lint.go	1969-12-31 19:00:00
+++ frozen/go/internal/profile/lint.go	2026-10-09 01:44:42
@@ -0,0 +1,178 @@
+package profile
+
+import (
+	"fmt"
+	"sort"
+)
+
+// Lint rule ids, in rule-number order (rule 1 to 5).
+const (
+	RuleDuplicateEndpoint = "duplicate-endpoint"
+	RulePrivilegedPort    = "privileged-port"
+	RuleRootAccount       = "root-account"
+	RuleDuplicateLabel    = "duplicate-label"
+	RuleLabelCaseVariant  = "label-case-variant"
+)
+
+// Lint messages (exact text).
+const (
+	msgDuplicateEndpoint = "destinations share the same host and port"
+	msgPrivilegedPort    = "port below 1024 other than 22"
+	msgRootAccount       = "account is root"
+	msgDuplicateLabel    = "label repeated within a destination"
+	msgLabelCaseVariant  = "labels differ only in letter case"
+)
+
+// Finding is one lint finding. KeyPaths name places, never values.
+// DestinationIDs are the ids of the destinations named in KeyPaths, in order
+// of first appearance without repeats. Both slices are never nil.
+type Finding struct {
+	Rule           string   `json:"rule"`
+	KeyPaths       []string `json:"key_paths"`
+	DestinationIDs []string `json:"destination_ids"`
+	Message        string   `json:"message"`
+}
+
+// asciiLower maps A-Z to a-z and leaves every other byte unchanged.
+func asciiLower(s string) string {
+	for i := 0; i < len(s); i++ {
+		if c := s[i]; c >= 'A' && c <= 'Z' {
+			b := []byte(s)
+			for j := i; j < len(b); j++ {
+				if b[j] >= 'A' && b[j] <= 'Z' {
+					b[j] += 'a' - 'A'
+				}
+			}
+			return string(b)
+		}
+	}
+	return s
+}
+
+// ref locates one label (or one destination when J is -1).
+type ref struct{ I, J int }
+
+func (r ref) less(o ref) bool { return r.I < o.I || (r.I == o.I && r.J < o.J) }
+
+// Lint reports findings for a schema-valid profile. It only looks at
+// destinations; name, revision and meta are never linted. Findings are
+// ordered by rule number, then by the per-rule order of the task contract.
+// The result is never nil. Pure function: no I/O.
+func Lint(p *Profile) []Finding {
+	out := []Finding{}
+	ds := p.Destinations
+	newFinding := func(rule, msg string, paths []string, idx []int) Finding {
+		ids := []string{}
+		seen := map[int]bool{}
+		for _, i := range idx {
+			if !seen[i] {
+				seen[i] = true
+				ids = append(ids, ds[i].ID)
+			}
+		}
+		return Finding{Rule: rule, KeyPaths: paths, DestinationIDs: ids, Message: msg}
+	}
+
+	// Rule 1: duplicate-endpoint. Groups are kept in order of first member.
+	type endpoint struct {
+		host string
+		port int64
+	}
+	groups := map[endpoint][]int{}
+	var order []endpoint
+	for i, d := range ds {
+		k := endpoint{asciiLower(d.Host), d.Port}
+		if _, ok := groups[k]; !ok {
+			order = append(order, k)
+		}
+		groups[k] = append(groups[k], i)
+	}
+	for _, k := range order {
+		m := groups[k]
+		if len(m) < 2 {
+			continue
+		}
+		paths := make([]string, len(m))
+		for n, i := range m {
+			paths[n] = fmt.Sprintf("destinations[%d].host", i)
+		}
+		out = append(out, newFinding(RuleDuplicateEndpoint, msgDuplicateEndpoint, paths, m))
+	}
+
+	// Rule 2: privileged-port.
+	for i, d := range ds {
+		if d.Port < 1024 && d.Port != 22 {
+			out = append(out, newFinding(RulePrivilegedPort, msgPrivilegedPort,
+				[]string{fmt.Sprintf("destinations[%d].port", i)}, []int{i}))
+		}
+	}
+
+	// Rule 3: root-account (case-sensitive).
+	for i, d := range ds {
+		if d.Account == "root" {
+			out = append(out, newFinding(RuleRootAccount, msgRootAccount,
+				[]string{fmt.Sprintf("destinations[%d].account", i)}, []int{i}))
+		}
+	}
+
+	// Rule 4: duplicate-label (exact string, within one destination).
+	for i, d := range ds {
+		pos := map[string][]int{}
+		var first []string
+		for j, l := range d.Labels {
+			if _, ok := pos[l]; !ok {
+				first = append(first, l)
+			}
+			pos[l] = append(pos[l], j)
+		}
+		for _, l := range first {
+			js := pos[l]
+			if len(js) < 2 {
+				continue
+			}
+			paths := make([]string, len(js))
+			idx := make([]int, len(js))
+			for n, j := range js {
+				paths[n] = fmt.Sprintf("destinations[%d].labels[%d]", i, j)
+				idx[n] = i
+			}
+			out = append(out, newFinding(RuleDuplicateLabel, msgDuplicateLabel, paths, idx))
+		}
+	}
+
+	// Rule 5: label-case-variant (across the whole profile).
+	type labelSet struct {
+		occ      []ref
+		spelling map[string]bool
+	}
+	sets := map[string]*labelSet{}
+	for i, d := range ds {
+		for j, l := range d.Labels {
+			k := asciiLower(l)
+			s := sets[k]
+			if s == nil {
+				s = &labelSet{spelling: map[string]bool{}}
+				sets[k] = s
+			}
+			s.occ = append(s.occ, ref{i, j}) // visited in (i, j) order
+			s.spelling[l] = true
+		}
+	}
+	var variants []*labelSet
+	for _, s := range sets {
+		if len(s.spelling) >= 2 {
+			variants = append(variants, s)
+		}
+	}
+	sort.Slice(variants, func(a, b int) bool { return variants[a].occ[0].less(variants[b].occ[0]) })
+	for _, s := range variants {
+		paths := make([]string, len(s.occ))
+		idx := make([]int, len(s.occ))
+		for n, r := range s.occ {
+			paths[n] = fmt.Sprintf("destinations[%d].labels[%d]", r.I, r.J)
+			idx[n] = r.I
+		}
+		out = append(out, newFinding(RuleLabelCaseVariant, msgLabelCaseVariant, paths, idx))
+	}
+	return out
+}
