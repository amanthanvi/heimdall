+    with open(FIX / "homelab.toml", "rb") as src, open(real, "wb") as dst:
+        dst.write(src.read())
+    abs_link = os.path.join(root, "config", "abs.toml")
+    os.symlink(real, abs_link)
+    rel_link = os.path.join(root, "config", "profile.toml")
