+}
+
+/// Bug report "profile show and tui reject my profile when the path is a symlink"
+/// (dotfiles / GNU stow layout). A --file that is a symbolic link resolving to a
+/// regular profile file behaves exactly like the file itself: same exit status, same
+/// stdout and stderr bytes, with and without --json. Covers an absolute link, a
+/// relative link (`../dotfiles/x.toml`), a chain of links, and a link inside a
+/// symlinked directory. Links that do not resolve (dangling, loop) are USAGE_ERROR.
+/// The `tui` side is covered by the pty case `tui-symlinked-profile`.
+#[test]
+fn symlinked_profile_reads_like_its_target() {
+    use std::os::unix::fs::symlink;
+    let d = TempDir::new("symlink");
+    let dotfiles = d.path().join("dotfiles");
+    let config = d.path().join("config");
+    std::fs::create_dir(&dotfiles).unwrap();
+    std::fs::create_dir(&config).unwrap();
+    for name in ["homelab.toml", "invalid-forbidden-key.toml"] {
+        let real = dotfiles.join(name);
+        std::fs::copy(fixtures().join(name), &real).unwrap();
+        let abs = config.join(format!("abs-{name}"));
+        symlink(&real, &abs).unwrap();
+        let rel = config.join(format!("rel-{name}"));
+        symlink(Path::new("../dotfiles").join(name), &rel).unwrap();
+        let chain = config.join(format!("chain-{name}"));
+        symlink(&rel, &chain).unwrap();
+        let linked_dir = d.path().join(format!("linked-dir-{name}"));
+        symlink(&dotfiles, &linked_dir).unwrap();
+        let via_dir = linked_dir.join(name);
+        for json in [true, false] {
+            let show = |p: &Path| {
+                let mut c = cmd();
+                c.args(["profile", "show", "--file"]).arg(p);
+                if json {
+                    c.arg("--json");
+                }
+                c.stdin(Stdio::null()).output().unwrap()
+            };
+            let want = show(&real);
+            for link in [&abs, &rel, &chain, &via_dir] {
+                let got = show(link);
+                let what = format!("{name} json={json} via {}", link.display());
+                assert_eq!(got.status.code(), want.status.code(), "{what}");
+                assert_eq!(got.stdout, want.stdout, "{what}: stdout");
+                assert_eq!(got.stderr, want.stderr, "{what}: stderr");
+                no_canary(&got);
+            }
+            if json {
+                let v = one_json(&want);
+                if name == "homelab.toml" {
+                    assert_eq!(want.status.code(), Some(0));
+                    assert_eq!(v["code"], "PROFILE_OK");
+                } else {
+                    assert_eq!(want.status.code(), Some(2));
+                    assert_eq!(v["code"], "SCHEMA_INVALID");
+                }
+            }
+        }
+    }
+    // Links that resolve to nothing are a usage error, never a crash or a hang.
+    let dangling = config.join("dangling.toml");
+    symlink(dotfiles.join("missing.toml"), &dangling).unwrap();
+    let a = config.join("loop-a.toml");
+    let b = config.join("loop-b.toml");
+    symlink(&b, &a).unwrap();
+    symlink(&a, &b).unwrap();
+    for p in [&dangling, &a] {
         let o = cmd()
             .args(["profile", "show", "--json", "--file"])
             .arg(p)
+            .stdin(Stdio::null())
             .output()
             .unwrap();
-        assert_eq!(o.status.code(), Some(want), "{}", p.display());
+        assert_eq!(o.status.code(), Some(2), "{}", p.display());
+        assert_eq!(one_json(&o)["code"], "USAGE_ERROR", "{}", p.display());
     }
 }
 
