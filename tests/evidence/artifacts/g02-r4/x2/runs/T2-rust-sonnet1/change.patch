+fn lint_clean_and_near_misses() {
+    let d = TempDir::new("lintc");
+    let p = write_profile(
+        d.path(),
+        "clean.toml",
+        &profile_toml(&[
+            "id = \"d0\"\nalias = \"a0\"\nhost = \"h.example\"\naccount = \"aman\"\nlabels = [\"x\", \"y\"]",
+            "id = \"d1\"\nalias = \"a1\"\nhost = \"h.example\"\nport = 2222\naccount = \"Root\"\nlabels = [\"x\", \"é\", \"É\"]",
+            "id = \"d2\"\nalias = \"a2\"\nhost = \"ÄB\"\nport = 1024\naccount = \"rooted\"",
+            "id = \"d3\"\nalias = \"a3\"\nhost = \"äb\"\nport = 1024\naccount = \"aman\"",
+        ]),
+    );
+    let (o, v) = lint_json(&p);
+    assert_eq!(o.status.code(), Some(0));
+    assert_eq!(v["state"], "succeeded");
+    assert_eq!(v["code"], "LINT_CLEAN");
+    assert_eq!(v["data"], serde_json::json!({"findings": []}));
+    assert_eq!(v["warnings"], serde_json::json!([]));
+    assert!(v["next"].is_null());
+    // No destinations at all is clean as well.
+    let p = write_profile(d.path(), "empty.toml", &profile_toml(&[]));
+    let (o, v) = lint_json(&p);
+    assert_eq!(o.status.code(), Some(0));
+    assert_eq!(v["code"], "LINT_CLEAN");
+}
