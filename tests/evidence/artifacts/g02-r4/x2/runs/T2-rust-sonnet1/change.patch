+            {"rule": "label-case-variant",
+             "key_paths": ["destinations[0].labels[2]", "destinations[2].labels[1]",
+                           "destinations[3].labels[0]"],
+             "destination_ids": ["d0", "d2", "d3"],
+             "message": "labels differ only in letter case"},
