+             "destination_ids": ["d3"],
+             "message": "port below 1024 other than 22"},
+            {"rule": "root-account",
+             "key_paths": ["destinations[0].account"],
+             "destination_ids": ["d0"],
+             "message": "account is root"},
+            {"rule": "duplicate-label",
