+// ---------- profile lint ----------
+
+/// Profile text with the given destination tables (each a `[[destinations]]` body).
+fn profile_toml(dests: &[&str]) -> String {
+    let mut s = String::from(
+        "schema_version = 1\nname = \"LINTNAME-SECRET\"\nrevision = 4\n\n[meta]\nnote = \"LINTMETA-SECRET\"\n",
+    );
+    for d in dests {
+        s.push_str("\n[[destinations]]\n");
+        s.push_str(d);
+        s.push('\n');
+    }
+    s
+}
+
+fn write_profile(dir: &Path, name: &str, text: &str) -> PathBuf {
+    let p = dir.join(name);
+    std::fs::write(&p, text).unwrap();
+    p
+}
+
+fn lint_json(path: &Path) -> (Output, Value) {
+    let o = cmd()
+        .args(["profile", "lint", "--file"])
+        .arg(path)
+        .arg("--json")
+        .stdin(Stdio::null())
+        .output()
+        .unwrap();
+    let v = one_json(&o);
+    (o, v)
+}
+
+/// A profile that triggers every rule once or more, plus near misses that must not fire.
+fn all_rules_profile() -> String {
+    profile_toml(&[
+        // 0: root, privileged port 80, endpoint twin of 3 (ASCII case-insensitive host)
+        "id = \"d0\"\nalias = \"a0\"\nhost = \"Lab.Example\"\nport = 80\naccount = \"root\"\nlabels = [\"prod\", \"prod\", \"Web\"]",
+        // 1: near misses: port 22 explicit, account Root, port 1024, labels that are the
+        //    same string as in another destination
+        "id = \"d1\"\nalias = \"a1\"\nhost = \"one.example\"\nport = 22\naccount = \"Root\"\nlabels = [\"shared\"]",
+        "id = \"d2\"\nalias = \"a2\"\nhost = \"two.example\"\nport = 1024\naccount = \"aman\"\nlabels = [\"shared\", \"web\"]",
+        // 3: same endpoint as 0, privileged port 80, label case variant of d0's and d2's
+        "id = \"d3\"\nalias = \"a3\"\nhost = \"lab.example\"\nport = 80\naccount = \"aman\"\nlabels = [\"WEB\", \"ÄB\", \"äb\"]",
+        // 4 and 5: omitted port equals explicit 22; non-ASCII host case is not folded
+        "id = \"d4\"\nalias = \"a4\"\nhost = \"same.example\"\naccount = \"aman\"",
+        "id = \"d5\"\nalias = \"a5\"\nhost = \"SAME.example\"\nport = 22\naccount = \"aman\"",
+        "id = \"d6\"\nalias = \"a6\"\nhost = \"ÄB.example\"\naccount = \"aman\"",
+        "id = \"d7\"\nalias = \"a7\"\nhost = \"äb.example\"\naccount = \"aman\"",
+    ])
+}
