+/// `lint` writes nothing: not next to the input, not in the working directory.
+#[test]
+fn lint_writes_nothing() {
+    fn listing(dir: &Path) -> Vec<(String, u64, std::time::SystemTime)> {
+        let mut v: Vec<_> = std::fs::read_dir(dir)
+            .unwrap()
+            .map(|e| {
+                let e = e.unwrap();
+                let m = e.metadata().unwrap();
+                (
+                    e.file_name().to_string_lossy().into_owned(),
+                    m.len(),
+                    m.modified().unwrap(),
+                )
+            })
+            .collect();
+        v.sort();
+        v
+    }
+    let d = TempDir::new("lintw");
+    let cwd = d.path().join("cwd");
+    std::fs::create_dir(&cwd).unwrap();
+    let p = write_profile(d.path(), "w.toml", &all_rules_profile());
+    let (before_d, before_c) = (listing(d.path()), listing(&cwd));
+    for json in [true, false] {
+        let mut c = cmd();
+        c.current_dir(&cwd)
+            .args(["profile", "lint", "--file"])
+            .arg(&p);
+        if json {
+            c.arg("--json");
+        }
+        assert_eq!(c.output().unwrap().status.code(), Some(3));
+    }
+    assert_eq!(listing(d.path()), before_d);
+    assert_eq!(listing(&cwd), before_c);
+}
