+/// Profile values never reach stdout or stderr; only destination ids may (in --json).
+#[test]
+fn lint_value_non_echo() {
+    let d = TempDir::new("lintne");
+    let p = write_profile(
+        d.path(),
+        "ne.toml",
+        &profile_toml(&[
+            "id = \"idone\"\nalias = \"ALIAS-SECRET-1\"\nhost = \"HOST-SECRET.example\"\nport = 80\naccount = \"root\"\nlabels = [\"LABEL-SECRET\", \"LABEL-SECRET\", \"label-secret\"]",
+            "id = \"idtwo\"\nalias = \"ALIAS-SECRET-2\"\nhost = \"host-secret.example\"\nport = 80\naccount = \"root\"",
+        ]),
+    );
+    for json in [true, false] {
+        let mut c = cmd();
+        c.args(["profile", "lint", "--file"]).arg(&p);
+        if json {
+            c.arg("--json");
+        }
+        let o = c.output().unwrap();
+        assert_eq!(o.status.code(), Some(3));
+        for stream in [&o.stdout, &o.stderr] {
+            let t = String::from_utf8_lossy(stream).to_ascii_lowercase();
+            for needle in [
+                "secret",
+                "lab.example",
+                "alias-",
+                "aman",
+                "\"root\"",
+                "label-secret",
+            ] {
+                assert!(!t.contains(needle), "json={json}: {needle} leaked: {t}");
+            }
+            if !json {
+                assert!(
+                    !t.contains("idone") && !t.contains("idtwo"),
+                    "plain mode prints no ids"
+                );
+            }
+        }
+    }
+    // Canary fixtures: errors never echo values either (K18).
+    let o = cmd()
+        .args(["profile", "lint", "--json", "--file"])
+        .arg(fixtures().join("invalid-forbidden-key.toml"))
+        .output()
+        .unwrap();
+    no_canary(&o);
+}
