diff --color -ruN -x target -x dist base/prototypes/rust/src/lint.rs frozen/rust/src/lint.rs
--- base/prototypes/rust/src/lint.rs	1969-12-31 19:00:00
+++ frozen/rust/src/lint.rs	2026-10-09 02:09:00
@@ -0,0 +1,477 @@
+//! `profile lint`: findings about the destinations of a schema-valid profile.
+//!
+//! Five rules, evaluated in this order (a finding list is ordered by rule number):
+//!
+//! 1. `duplicate-endpoint`: same ASCII-lowercased host and same effective port.
+//! 2. `privileged-port`: effective port below 1024 other than 22.
+//! 3. `root-account`: account is exactly `root`.
+//! 4. `duplicate-label`: the same label string more than once in one destination.
+//! 5. `label-case-variant`: different label strings equal after ASCII-lowercasing.
+//!
+//! Only destinations are linted; `name`, `revision` and `[meta]` never are. A finding
+//! names places by key path (`destinations[2].labels[0]`) and the owning destinations
+//! by `id`. It never carries a host, account, label or any other profile value.
+//!
+//! All grouping is hash based, so a profile at the 1 MiB input bound is linted in
+//! linear time.
+
+use std::collections::{HashMap, HashSet};
+
+use serde_json::{Value, json};
+
+use crate::envelope::{Code, Envelope};
+use crate::profile::Profile;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Rule {
+    DuplicateEndpoint,
+    PrivilegedPort,
+    RootAccount,
+    DuplicateLabel,
+    LabelCaseVariant,
+}
+
+impl Rule {
+    pub fn id(self) -> &'static str {
+        match self {
+            Rule::DuplicateEndpoint => "duplicate-endpoint",
+            Rule::PrivilegedPort => "privileged-port",
+            Rule::RootAccount => "root-account",
+            Rule::DuplicateLabel => "duplicate-label",
+            Rule::LabelCaseVariant => "label-case-variant",
+        }
+    }
+
+    pub fn message(self) -> &'static str {
+        match self {
+            Rule::DuplicateEndpoint => "destinations share the same host and port",
+            Rule::PrivilegedPort => "port below 1024 other than 22",
+            Rule::RootAccount => "account is root",
+            Rule::DuplicateLabel => "label repeated within a destination",
+            Rule::LabelCaseVariant => "labels differ only in letter case",
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Finding {
+    pub rule: Rule,
+    pub key_paths: Vec<String>,
+    /// `id` of each destination named in `key_paths`, first-appearance order, no repeats.
+    pub destination_ids: Vec<String>,
+}
+
+impl Finding {
+    /// `places` are `(destination index, key path)` pairs in the order they are reported.
+    fn new(rule: Rule, profile: &Profile, places: Vec<(usize, String)>) -> Self {
+        let mut seen = HashSet::new();
+        let mut destination_ids = Vec::new();
+        for (i, _) in &places {
+            if seen.insert(*i) {
+                destination_ids.push(profile.destinations[*i].id.clone());
+            }
+        }
+        Finding {
+            rule,
+            key_paths: places.into_iter().map(|(_, p)| p).collect(),
+            destination_ids,
+        }
+    }
+
+    pub fn to_json(&self) -> Value {
+        json!({
+            "rule": self.rule.id(),
+            "key_paths": self.key_paths,
+            "destination_ids": self.destination_ids,
+            "message": self.rule.message(),
+        })
+    }
+}
+
+/// All findings for `profile`, ordered by rule number and then as the contract says.
+pub fn lint(profile: &Profile) -> Vec<Finding> {
+    let mut out = Vec::new();
+    duplicate_endpoints(profile, &mut out);
+    privileged_ports(profile, &mut out);
+    root_accounts(profile, &mut out);
+    duplicate_labels(profile, &mut out);
+    label_case_variants(profile, &mut out);
+    out
+}
+
+/// The result envelope: `LINT_CLEAN` without findings, `LINT_FINDINGS` with any.
+pub fn envelope(findings: &[Finding]) -> Envelope {
+    let code = if findings.is_empty() {
+        Code::LintClean
+    } else {
+        Code::LintFindings
+    };
+    let list: Vec<Value> = findings.iter().map(Finding::to_json).collect();
+    Envelope::success(code, json!({ "findings": list }))
+}
+
+/// Rule 1. Groups are created in order of their first member, members stay in file order.
+fn duplicate_endpoints(p: &Profile, out: &mut Vec<Finding>) {
+    let mut index: HashMap<(String, u16), usize> = HashMap::new();
+    let mut groups: Vec<Vec<usize>> = Vec::new();
+    for (i, d) in p.destinations.iter().enumerate() {
+        let key = (d.host.to_ascii_lowercase(), d.port);
+        match index.get(&key) {
+            Some(&g) => groups[g].push(i),
+            None => {
+                index.insert(key, groups.len());
+                groups.push(vec![i]);
+            }
+        }
+    }
+    for members in groups.into_iter().filter(|m| m.len() >= 2) {
+        let places = members
+            .into_iter()
+            .map(|i| (i, format!("destinations[{i}].host")))
+            .collect();
+        out.push(Finding::new(Rule::DuplicateEndpoint, p, places));
+    }
+}
+
+/// Rule 2. `port` is already the effective port (22 when omitted).
+fn privileged_ports(p: &Profile, out: &mut Vec<Finding>) {
+    for (i, d) in p.destinations.iter().enumerate() {
+        if d.port < 1024 && d.port != 22 {
+            let places = vec![(i, format!("destinations[{i}].port"))];
+            out.push(Finding::new(Rule::PrivilegedPort, p, places));
+        }
+    }
+}
+
+/// Rule 3. Case-sensitive: `Root` and `ROOT` do not fire.
+fn root_accounts(p: &Profile, out: &mut Vec<Finding>) {
+    for (i, d) in p.destinations.iter().enumerate() {
+        if d.account == "root" {
+            let places = vec![(i, format!("destinations[{i}].account"))];
+            out.push(Finding::new(Rule::RootAccount, p, places));
+        }
+    }
+}
+
+/// Rule 4. Exact string comparison inside one destination; the finding order is the
+/// destination index, then the first occurrence of the repeated string.
+fn duplicate_labels(p: &Profile, out: &mut Vec<Finding>) {
+    for (i, d) in p.destinations.iter().enumerate() {
+        let mut index: HashMap<&str, usize> = HashMap::new();
+        let mut groups: Vec<Vec<usize>> = Vec::new();
+        for (j, label) in d.labels.iter().enumerate() {
+            match index.get(label.as_str()) {
+                Some(&g) => groups[g].push(j),
+                None => {
+                    index.insert(label.as_str(), groups.len());
+                    groups.push(vec![j]);
+                }
+            }
+        }
+        for occurrences in groups.into_iter().filter(|g| g.len() >= 2) {
+            let places = occurrences
+                .into_iter()
+                .map(|j| (i, format!("destinations[{i}].labels[{j}]")))
+                .collect();
+            out.push(Finding::new(Rule::DuplicateLabel, p, places));
+        }
+    }
+}
+
+/// Rule 5. Across the whole profile; a set needs two or more different spellings.
+/// Occurrences are visited in `(i, j)` order, so each set lists them in that order and
+/// sets are created in order of their first occurrence.
+fn label_case_variants(p: &Profile, out: &mut Vec<Finding>) {
+    struct Set<'a> {
+        first_spelling: &'a str,
+        has_variant: bool,
+        places: Vec<(usize, String)>,
+    }
+    let mut index: HashMap<String, usize> = HashMap::new();
+    let mut sets: Vec<Set> = Vec::new();
+    for (i, d) in p.destinations.iter().enumerate() {
+        for (j, label) in d.labels.iter().enumerate() {
+            let place = (i, format!("destinations[{i}].labels[{j}]"));
+            let folded = label.to_ascii_lowercase();
+            match index.get(&folded) {
+                Some(&s) => {
+                    let set = &mut sets[s];
+                    set.has_variant |= set.first_spelling != label.as_str();
+                    set.places.push(place);
+                }
+                None => {
+                    index.insert(folded, sets.len());
+                    sets.push(Set {
+                        first_spelling: label.as_str(),
+                        has_variant: false,
+                        places: vec![place],
+                    });
+                }
+            }
+        }
+    }
+    for set in sets.into_iter().filter(|s| s.has_variant) {
+        out.push(Finding::new(Rule::LabelCaseVariant, p, set.places));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::profile::Destination;
+
+    fn dest(id: &str, host: &str, port: u16, account: &str, labels: &[&str]) -> Destination {
+        Destination {
+            id: id.into(),
+            alias: format!("a-{id}"),
+            host: host.into(),
+            port,
+            account: account.into(),
+            labels: labels.iter().map(|s| s.to_string()).collect(),
+        }
+    }
+
+    fn profile(destinations: Vec<Destination>) -> Profile {
+        Profile {
+            name: "p".into(),
+            revision: 1,
+            destinations,
+        }
+    }
+
+    /// (rule id, key paths, destination ids) of each finding.
+    fn summary(p: &Profile) -> Vec<(&'static str, Vec<String>, Vec<String>)> {
+        lint(p)
+            .into_iter()
+            .map(|f| (f.rule.id(), f.key_paths, f.destination_ids))
+            .collect()
+    }
+
+    fn s(v: &[&str]) -> Vec<String> {
+        v.iter().map(|x| x.to_string()).collect()
+    }
+
+    #[test]
+    fn clean_profile_and_empty_profile() {
+        assert!(lint(&profile(vec![])).is_empty());
+        let p = profile(vec![
+            dest("d0", "a.example", 22, "aman", &["x", "y"]),
+            dest("d1", "b.example", 2222, "aman", &["x"]),
+            dest("d2", "a.example", 2200, "ops", &[]),
+        ]);
+        assert!(lint(&p).is_empty());
+        let e = envelope(&[]);
+        assert_eq!(e.code, Code::LintClean);
+        assert_eq!(e.exit_code(), 0);
+        assert_eq!(e.data, json!({"findings": []}));
+    }
+
+    #[test]
+    fn rule1_duplicate_endpoint_ascii_case_and_port() {
+        let p = profile(vec![
+            dest("d0", "Lab.Example", 2222, "u", &[]),
+            dest("d1", "other", 2222, "u", &[]),
+            dest("d2", "lab.example", 2222, "u", &[]),
+            dest("d3", "LAB.EXAMPLE", 2223, "u", &[]),
+            dest("d4", "other", 2222, "u", &[]),
+            dest("d5", "LAB.example", 2222, "u", &[]),
+        ]);
+        assert_eq!(
+            summary(&p),
+            vec![
+                (
+                    "duplicate-endpoint",
+                    s(&[
+                        "destinations[0].host",
+                        "destinations[2].host",
+                        "destinations[5].host"
+                    ]),
+                    s(&["d0", "d2", "d5"])
+                ),
+                (
+                    "duplicate-endpoint",
+                    s(&["destinations[1].host", "destinations[4].host"]),
+                    s(&["d1", "d4"])
+                ),
+            ]
+        );
+    }
+
+    #[test]
+    fn rule1_omitted_port_equals_22_and_non_ascii_case_is_distinct() {
+        // `port` is already 22 when omitted, so this is the same endpoint.
+        let p = profile(vec![
+            dest("d0", "h", 22, "u", &[]),
+            dest("d1", "H", 22, "u", &[]),
+            dest("d2", "ÄB", 22, "u", &[]),
+            dest("d3", "äb", 22, "u", &[]),
+        ]);
+        let got = summary(&p);
+        assert_eq!(got.len(), 1);
+        assert_eq!(
+            got[0].1,
+            s(&["destinations[0].host", "destinations[1].host"])
+        );
+    }
+
+    #[test]
+    fn rules2_and_3_per_destination() {
+        let p = profile(vec![
+            dest("d0", "a", 22, "root", &[]),
+            dest("d1", "b", 1023, "Root", &[]),
+            dest("d2", "c", 1024, "ROOT", &[]),
+            dest("d3", "d", 1, "root", &[]),
+            dest("d4", "e", 443, "x", &[]),
+        ]);
+        assert_eq!(
+            summary(&p),
+            vec![
+                ("privileged-port", s(&["destinations[1].port"]), s(&["d1"])),
+                ("privileged-port", s(&["destinations[3].port"]), s(&["d3"])),
+                ("privileged-port", s(&["destinations[4].port"]), s(&["d4"])),
+                ("root-account", s(&["destinations[0].account"]), s(&["d0"])),
+                ("root-account", s(&["destinations[3].account"]), s(&["d3"])),
+            ]
+        );
+    }
+
+    #[test]
+    fn rule4_exact_duplicates_within_a_destination() {
+        let p = profile(vec![
+            dest("d0", "a", 22, "u", &["b", "a", "b", "a", "b", "c"]),
+            dest("d1", "b", 22, "u", &["a", "a"]),
+            dest("d2", "c", 22, "u", &["a"]),
+        ]);
+        assert_eq!(
+            summary(&p),
+            vec![
+                (
+                    "duplicate-label",
+                    s(&[
+                        "destinations[0].labels[0]",
+                        "destinations[0].labels[2]",
+                        "destinations[0].labels[4]"
+                    ]),
+                    s(&["d0"])
+                ),
+                (
+                    "duplicate-label",
+                    s(&["destinations[0].labels[1]", "destinations[0].labels[3]"]),
+                    s(&["d0"])
+                ),
+                (
+                    "duplicate-label",
+                    s(&["destinations[1].labels[0]", "destinations[1].labels[1]"]),
+                    s(&["d1"])
+                ),
+            ]
+        );
+    }
+
+    #[test]
+    fn rule5_case_variants_across_the_profile_only_when_spellings_differ() {
+        // "x" in d0 and d2 is identical (no finding); "Web"/"web"/"WEB" is one set.
+        let p = profile(vec![
+            dest("d0", "a", 22, "u", &["x", "Web"]),
+            dest("d1", "b", 22, "u", &["web", "q"]),
+            dest("d2", "c", 22, "u", &["x", "WEB", "web"]),
+        ]);
+        assert_eq!(
+            summary(&p),
+            vec![(
+                "label-case-variant",
+                s(&[
+                    "destinations[0].labels[1]",
+                    "destinations[1].labels[0]",
+                    "destinations[2].labels[1]",
+                    "destinations[2].labels[2]"
+                ]),
+                s(&["d0", "d1", "d2"])
+            )]
+        );
+    }
+
+    #[test]
+    fn rule5_same_destination_is_not_rule4_and_sets_are_ordered_by_first_occurrence() {
+        let p = profile(vec![
+            dest("d0", "a", 22, "u", &["b", "A", "B", "a"]),
+            dest("d1", "b", 22, "u", &["é", "É"]),
+        ]);
+        // "é"/"É" differ in a non-ASCII letter: not equal after ASCII-lowercasing.
+        assert_eq!(
+            summary(&p),
+            vec![
+                (
+                    "label-case-variant",
+                    s(&["destinations[0].labels[0]", "destinations[0].labels[2]"]),
+                    s(&["d0"])
+                ),
+                (
+                    "label-case-variant",
+                    s(&["destinations[0].labels[1]", "destinations[0].labels[3]"]),
+                    s(&["d0"])
+                ),
+            ]
+        );
+    }
+
+    #[test]
+    fn rules_4_and_5_can_both_fire_on_the_same_labels() {
+        let p = profile(vec![dest("d0", "a", 22, "u", &["Foo", "Foo", "foo"])]);
+        assert_eq!(
+            summary(&p),
+            vec![
+                (
+                    "duplicate-label",
+                    s(&["destinations[0].labels[0]", "destinations[0].labels[1]"]),
+                    s(&["d0"])
+                ),
+                (
+                    "label-case-variant",
+                    s(&[
+                        "destinations[0].labels[0]",
+                        "destinations[0].labels[1]",
+                        "destinations[0].labels[2]"
+                    ]),
+                    s(&["d0"])
+                ),
+            ]
+        );
+    }
+
+    #[test]
+    fn findings_are_ordered_by_rule_number() {
+        let p = profile(vec![
+            dest("d0", "h", 80, "root", &["a", "a", "A"]),
+            dest("d1", "H", 80, "root", &[]),
+        ]);
+        let rules: Vec<_> = lint(&p).iter().map(|f| f.rule.id()).collect();
+        assert_eq!(
+            rules,
+            [
+                "duplicate-endpoint",
+                "privileged-port",
+                "privileged-port",
+                "root-account",
+                "root-account",
+                "duplicate-label",
+                "label-case-variant"
+            ]
+        );
+        let e = envelope(&lint(&p));
+        assert_eq!(e.code, Code::LintFindings);
+        assert_eq!(e.exit_code(), 3);
+    }
+
+    #[test]
+    fn finding_json_has_exactly_four_members_and_no_values() {
+        let p = profile(vec![dest("d0", "SECRET-HOST", 80, "root", &[])]);
+        let f = &lint(&p)[0];
+        let v = f.to_json();
+        let mut keys: Vec<_> = v.as_object().unwrap().keys().cloned().collect();
+        keys.sort();
+        assert_eq!(keys, ["destination_ids", "key_paths", "message", "rule"]);
+        let text = envelope(&lint(&p)).to_line();
+        assert!(!text.contains("SECRET-HOST"));
+    }
+}
