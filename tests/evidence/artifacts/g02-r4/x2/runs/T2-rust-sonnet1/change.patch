+/// Same exit status, state, code and key_path as `profile show --json` for every
+/// input that `show` rejects, including non-regular files (K14).
+#[test]
+fn lint_input_handling_equals_show() {
+    let d = TempDir::new("lintin");
+    let fifo = d.path().join("fifo p");
+    mkfifo(&fifo);
+    let dir = d.path().join("dir ü");
+    std::fs::create_dir(&dir).unwrap();
+    let sock = d.path().join("p.sock");
+    let _l = UnixListener::bind(&sock).unwrap();
+    let big = d.path().join("big.toml");
+    let mut body = b"schema_version = 1\nname = \"x\"\nrevision = 1\n".to_vec();
+    body.resize(1_048_577, b'#');
+    std::fs::write(&big, body).unwrap();
+    let exact = d.path().join("exact.toml");
+    let mut body = b"schema_version = 1\nname = \"x\"\nrevision = 1\n".to_vec();
+    body.resize(1_048_576, b'#');
+    std::fs::write(&exact, body).unwrap();
+    let ctrl = write_profile(
+        d.path(),
+        "ctrl.toml",
+        "schema_version = 1\nname = \"a\\u001bb\"\nrevision = 1\n",
+    );
+    let dup = write_profile(
+        d.path(),
+        "dup.toml",
+        &profile_toml(&[
+            "id = \"d\"\nalias = \"a\"\nhost = \"h\"\naccount = \"u\"",
+            "id = \"d\"\nalias = \"b\"\nhost = \"h\"\naccount = \"u\"",
+        ]),
+    );
+    let mut inputs: Vec<PathBuf> = vec![
+        fifo,
+        dir,
+        sock,
+        big,
+        exact,
+        ctrl,
+        dup,
+        PathBuf::from("/dev/null"),
+        d.path().join("missing ü.toml"),
+    ];
+    for n in [
+        "invalid-forbidden-key.toml",
+        "invalid-unknown-dest-key.toml",
+        "invalid-malformed.toml",
+        "invalid-schema-version.toml",
+        "invalid-duplicate-alias.toml",
+        "invalid-port.toml",
+    ] {
+        inputs.push(fixtures().join(n));
+    }
+    for p in &inputs {
+        let mut results = Vec::new();
+        for sub in ["show", "lint"] {
+            let mut c = cmd()
+                .args(["profile", sub, "--json", "--file"])
+                .arg(p)
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::piped())
+                .spawn()
+                .unwrap();
+            let t = Instant::now();
+            while c.try_wait().unwrap().is_none() && t.elapsed() < Duration::from_secs(2) {
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            if c.try_wait().unwrap().is_none() {
+                let _ = c.kill();
+                let _ = c.wait();
+                panic!("{sub} {}: still running after 2 s", p.display());
+            }
+            let o = c.wait_with_output().unwrap();
+            let v = one_json(&o);
+            no_canary(&o);
+            results.push((o.status.code(), v));
+        }
+        let (show, lint) = (&results[0], &results[1]);
+        if show.1["code"] == "PROFILE_OK" {
+            // The one accepted input here (exactly 1 MiB): a valid profile, lints clean.
+            assert_eq!(
+                (lint.0, &lint.1["code"]),
+                (Some(0), &Value::from("LINT_CLEAN"))
+            );
+        } else {
+            assert_eq!(show.0, lint.0, "{}", p.display());
+            for k in ["state", "code", "warnings", "next", "data"] {
+                assert_eq!(show.1[k], lint.1[k], "{} {k}", p.display());
+            }
+        }
+        // Without --json: same exit status, nothing on stdout.
+        let plain = cmd()
+            .args(["profile", "lint", "--file"])
+            .arg(p)
+            .stdin(Stdio::null())
+            .output()
+            .unwrap();
+        assert_eq!(plain.status.code(), lint.0, "{}", p.display());
+        if lint.0 == Some(2) {
+            assert!(plain.stdout.is_empty(), "{}", p.display());
+        }
+    }
+}
