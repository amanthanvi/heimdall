+#[test]
+fn lint_usage_errors() {
+    for (args, json) in [
+        (vec!["profile", "lint"], false),
+        (vec!["profile", "lint", "--json"], true),
+        (vec!["profile", "lint", "--file"], false),
+        (vec!["profile", "lint", "--file", "--json"], true),
+        (vec!["profile", "lint", "--json", "--file"], true),
+        (vec!["profile", "lint", "--file", "x", "--bogus"], false),
+        (
+            vec!["profile", "lint", "--file", "x", "--bogus", "--json"],
+            true,
+        ),
+        (
+            vec!["profile", "lint", "--bogus", "--json", "--file", "x"],
+            true,
+        ),
+    ] {
+        let o = run(&args);
+        assert_eq!(o.status.code(), Some(2), "{args:?}");
+        if json {
+            let v = one_json(&o);
+            assert_eq!(v["code"], "USAGE_ERROR", "{args:?}");
+            assert_eq!(v["state"], "failed");
+        } else {
+            assert!(o.stdout.is_empty(), "{args:?}");
+        }
+        assert!(!o.stderr.is_empty(), "{args:?}");
+    }
+}
