+/// A profile at the input bound with very many labels and destinations lints in linear
+/// time (K15 spirit): no quadratic grouping.
+#[test]
+fn lint_large_input_is_fast() {
+    let d = TempDir::new("lintbig");
+    let mut s = String::from("schema_version = 1\nname = \"n\"\nrevision = 1\n");
+    s.push_str(
+        "[[destinations]]\nid = \"d0\"\nalias = \"a0\"\nhost = \"h0\"\naccount = \"u\"\nlabels = [",
+    );
+    let mut i = 0;
+    while s.len() < 600_000 {
+        s.push_str(&format!("\"L{}\",", i % 5000));
+        i += 1;
+    }
+    s.push_str("\"Z\"]\n");
+    let p = write_profile(d.path(), "big.toml", &s);
+    let t = Instant::now();
+    let (o, v) = lint_json(&p);
+    assert!(t.elapsed() < Duration::from_secs(2), "{:?}", t.elapsed());
+    assert_eq!(o.status.code(), Some(3));
+    assert_eq!(v["code"], "LINT_FINDINGS");
+    assert_eq!(v["data"]["findings"].as_array().unwrap().len(), 5000);
+}
