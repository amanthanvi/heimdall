+/// K12 closed stdout: lint has the same wait status with and without --json.
+#[test]
+fn lint_closed_stdout_exit_parity() {
+    let d = TempDir::new("lintk12");
+    let findings = write_profile(d.path(), "f.toml", &all_rules_profile());
+    let clean = write_profile(d.path(), "c.toml", &profile_toml(&[]));
+    for p in [findings, clean, d.path().join("missing.toml")] {
+        let mk = |json: bool| {
+            let mut v: Vec<OsString> = vec!["profile".into(), "lint".into(), "--file".into()];
+            v.push(p.as_os_str().to_owned());
+            if json {
+                v.push("--json".into());
+            }
+            v
+        };
+        let (plain, json) = (
+            closed_stdout_status(&mk(false)),
+            closed_stdout_status(&mk(true)),
+        );
+        assert_eq!(plain, json, "{}", p.display());
+    }
+}
