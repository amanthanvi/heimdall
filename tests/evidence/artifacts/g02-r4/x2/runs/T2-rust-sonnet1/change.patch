+#[test]
+fn lint_option_orders_and_plain_mode() {
+    let d = TempDir::new("lintopt");
+    let p = write_profile(d.path(), "sp ace ü.toml", &all_rules_profile());
+    let a = cmd()
+        .args(["profile", "lint", "--file"])
+        .arg(&p)
+        .arg("--json")
+        .output()
+        .unwrap();
+    let b = cmd()
+        .args(["profile", "lint", "--json", "--file"])
+        .arg(&p)
+        .output()
+        .unwrap();
+    assert_eq!(a.status.code(), Some(3));
+    assert_eq!(a.stdout, b.stdout);
+    // K12: the exit status is the same without --json; the output is not judged.
+    let plain = cmd()
+        .args(["profile", "lint", "--file"])
+        .arg(&p)
+        .output()
+        .unwrap();
+    assert_eq!(plain.status.code(), Some(3));
+    assert!(plain.stderr.is_empty());
+    // Clean profile without --json: exit 0.
+    let clean = write_profile(d.path(), "c.toml", &profile_toml(&[]));
+    let plain = cmd()
+        .args(["profile", "lint", "--file"])
+        .arg(&clean)
+        .output()
+        .unwrap();
+    assert_eq!(plain.status.code(), Some(0));
+}
