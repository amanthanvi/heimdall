--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/tui_output_test.go
@@ -0,0 +1,48 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestResetAfterXTMODKEYS(t *testing.T) {
+	for _, c := range []struct{ in, want string }{
+		{"", ""},
+		{"plain \x1b[4mtext\x1b[m", "plain \x1b[4mtext\x1b[m"},
+		{"\x1b[>4m\x1b[?1049h\x1b[>4;2m\x1b[>1u", "\x1b[>4m\x1b[m\x1b[?1049h\x1b[>4;2m\x1b[m\x1b[>1u"},
+		{"\x1b[>1u\x1b[?u", "\x1b[>1u\x1b[?u"}, // kitty keyboard, not SGR-like
+		{"\x1b[>c", "\x1b[>c"},                 // DA2 request
+		{"x\x1b[>4;2mx\x1b[>4m", "x\x1b[>4;2m\x1b[mx\x1b[>4m\x1b[m"},
+	} {
+		if got := string(resetAfterXTMODKEYS([]byte(c.in))); got != c.want {
+			t.Errorf("resetAfterXTMODKEYS(%q) = %q, want %q", c.in, got, c.want)
+		}
+	}
+}
+
+// Write reports the caller's byte count, not the expanded one, and passes
+// other bytes through unchanged.
+func TestSGRSafeOutputWrite(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "out")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	o := sgrSafeOutput{f}
+	in := []byte("a\x1b[>4;2mb\x00\xff")
+	if n, err := o.Write(in); n != len(in) || err != nil {
+		t.Fatalf("Write = %d, %v", n, err)
+	}
+	if o.Fd() != f.Fd() {
+		t.Fatal("Fd")
+	}
+	if err := o.Close(); err != nil {
+		t.Fatal(err)
+	}
+	got, _ := os.ReadFile(path)
+	if want := []byte("a\x1b[>4;2m\x1b[mb\x00\xff"); !bytes.Equal(got, want) {
+		t.Fatalf("%q", got)
+	}
+}
diff --git a/prototypes/go/cmd/heimdall-proto/tui_underline_pty_test.go b/prototypes/go/cmd/heimdall-proto/tui_underline_pty_test.go
new file mode 100644
index 0000000..da22e07
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/tui_underline_pty_test.go
@@ -0,0 +1,64 @@
+//go:build darwin || linux
+
+package main
+
+import (
+	"bytes"
+	"regexp"
+	"testing"
+	"time"
+)
+
+// TASK part A through the real program in a pty: the match is drawn with SGR
+// 4 (no colour SGR with NO_COLOR), and every XTMODKEYS sequence Bubble Tea
+// writes is followed by an SGR reset (sgrSafeOutput), so a terminal that
+// misreads it as SGR 4 does not underline the whole first frame.
+func TestTUIUnderlineInPTY(t *testing.T) {
+	// runTUI takes the colour profile from the process environment. NO_COLOR
+	// gives the ASCII profile, which keeps text attributes such as underline.
+	t.Setenv("TERM", "xterm-256color")
+	t.Setenv("NO_COLOR", "1")
+	t.Setenv("COLORTERM", "")
+	r := startPTY(t)
+	defer r.master.Close()
+	defer r.slave.Close()
+	m := newModel() // one destination "lab", NO_COLOR
+	go func() {
+		for _, k := range []string{"/", "a", "\r", "q"} {
+			time.Sleep(250 * time.Millisecond)
+			_, _ = r.master.Write([]byte(k))
+		}
+	}()
+	var stdout, stderr bytes.Buffer
+	res := make(chan int, 1)
+	go func() { res <- runTUI(m, m, r.slave, r.slave, &stdout, &stderr, teaOpts(r)...) }()
+	select {
+	case code := <-res:
+		if code != 0 || stdout.Len() != 0 {
+			t.Fatalf("exit=%d stdout=%q stderr=%q", code, stdout.String(), stderr.String())
+		}
+	case <-time.After(8 * time.Second):
+		t.Fatal("tui did not exit")
+	}
+	time.Sleep(100 * time.Millisecond)
+	out := r.output()
+	mods := regexp.MustCompile("\x1b\\[>[0-9;]*m").FindAllIndex(out, -1)
+	if len(mods) == 0 {
+		t.Fatalf("no XTMODKEYS sequence seen; output %q", out)
+	}
+	for _, loc := range mods {
+		if !bytes.HasPrefix(out[loc[1]:], []byte("\x1b[m")) {
+			t.Fatalf("XTMODKEYS %q at %d not followed by an SGR reset", out[loc[0]:loc[1]], loc[0])
+		}
+	}
+	if !bytes.Contains(out, []byte("\x1b[4ma\x1b[m")) {
+		t.Fatalf("match 'a' in 'lab' not underlined: %q", out)
+	}
+	for _, sgr := range regexp.MustCompile("\x1b\\[([0-9;:]*)m").FindAllSubmatch(out, -1) {
+		switch string(sgr[1]) {
+		case "", "0", "4", "24":
+		default:
+			t.Fatalf("NO_COLOR: unexpected SGR %q", sgr[0])
+		}
+	}
+}
