+func TestHelpOverlay(t *testing.T) {
+	m := New(dests(30), true)
+	m.Update(tea.WindowSizeMsg{Width: 80, Height: 24})
+	press(m, tea.KeyPressMsg{Code: tea.KeyDown}, txt("/"), txt("1"), tea.KeyPressMsg{Code: tea.KeyDown}, tea.KeyPressMsg{Code: tea.KeyEnter})
+	before := m.Render()
+	selBefore := m.dests[m.shown[m.sel]].Alias
+
+	press(m, txt("?"))
+	if !m.help {
+		t.Fatal("? did not open help")
+	}
+	lines := strings.Split(ansi.Strip(m.Render()), "\n")
+	var got []string
+	for _, l := range lines {
+		if f := strings.Join(strings.Fields(l), " "); f != "" {
+			got = append(got, f)
+		}
+	}
+	want := []string{"Keys", "Up / k move up", "Down / j move down", "/ filter", "Enter select",
+		"Esc clear filter", "q quit", "? close help", "Ctrl-C cancel"}
+	if len(got) < len(want) || strings.Join(got[:len(want)], "|") != strings.Join(want, "|") {
+		t.Fatalf("help lines:\n%s", strings.Join(got, "\n"))
+	}
+	if strings.Contains(m.Render(), "\x1b[4m") {
+		t.Fatal("help overlay must not underline")
+	}
+
+	// Every other key is ignored.
+	for _, k := range []tea.KeyPressMsg{
+		txt("q"), txt("j"), txt("k"), txt("/"), txt("x"), txt("1"),
+		{Code: tea.KeyEnter}, {Code: tea.KeyUp}, {Code: tea.KeyDown}, {Code: tea.KeyBackspace},
+		{Code: tea.KeyEscape, Mod: tea.ModAlt},
+	} {
+		if _, cmd := m.Update(k); cmd != nil || !m.help {
+			t.Fatalf("key %q not ignored", k.Keystroke())
+		}
+	}
+	if m.Outcome != Quit || m.filtering || m.filter != "1" {
+		t.Fatal("state changed while help was open")
+	}
+
+	// Esc closes the overlay without clearing the filter.
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape})
+	if m.help || helpShown(m) || m.filter != "1" || m.dests[m.shown[m.sel]].Alias != selBefore || m.Render() != before {
+		t.Fatalf("after Esc:\n%s", m.Render())
+	}
+
+	// ? closes it too; filter mode survives an open/close cycle.
+	press(m, txt("?"), txt("?"))
+	if m.help || m.Render() != before {
+		t.Fatal("? did not close help")
+	}
+
+	// In filter mode ? is filter text.
+	press(m, txt("/"), txt("?"))
+	if m.help || m.filter != "1?" || !m.filtering {
+		t.Fatalf("? in filter mode: help=%v filter=%q", m.help, m.filter)
+	}
+
+	// Ctrl-C cancels while the overlay is open.
+	m = New(dests(3), true)
+	press(m, txt("?"))
+	if _, cmd := m.Update(tea.KeyPressMsg{Code: 'c', Mod: tea.ModCtrl}); cmd == nil || m.Outcome != Cancelled {
+		t.Fatal("ctrl-c in help")
+	}
+}
