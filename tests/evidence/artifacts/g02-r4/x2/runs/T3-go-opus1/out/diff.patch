+// underlines renders m and returns, per screen line, the plain text with every
+// underlined cell wrapped in [ ]. It parses the frame with ultraviolet, the
+// cell model Bubble Tea's renderer draws from.
+func underlines(m *Model) []string {
+	w, h := max(m.width, 1), max(m.height, 1)
+	scr := uv.NewScreenBuffer(w, h)
+	scr.Method = ansi.GraphemeWidth
+	uv.NewStyledString(m.Render()).Draw(scr, uv.Rect(0, 0, w, h))
+	var out []string
+	for y := 0; y < h; y++ {
+		line := scr.Line(y)
+		var b strings.Builder
+		on := false
+		for _, c := range line {
+			if c.Width == 0 { // right half of a wide character
+				continue
+			}
+			u := c.Style.Underline != uv.UnderlineNone
+			if u != on {
+				if u {
+					b.WriteString("[")
+				} else {
+					b.WriteString("]")
+				}
+				on = u
+			}
+			b.WriteString(c.Content)
+		}
+		if on {
+			b.WriteString("]")
+		}
+		out = append(out, strings.TrimRight(b.String(), " "))
+	}
+	return out
+}
