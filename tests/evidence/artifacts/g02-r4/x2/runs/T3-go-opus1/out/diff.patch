diff --git a/prototypes/go/cmd/heimdall-proto/tui_output.go b/prototypes/go/cmd/heimdall-proto/tui_output.go
new file mode 100644
index 0000000..5ed9ac9
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/tui_output.go
@@ -0,0 +1,59 @@
+package main
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"regexp"
+)
+
+// sgrSafeOutput is the TUI's terminal output. It follows every XTMODKEYS
+// sequence (CSI > Pp [; Pv] m) with an SGR reset (CSI m).
+//
+// Bubble Tea writes CSI > 4 ; 2 m (modifyOtherKeys) when it starts and
+// CSI > 4 m when it stops, and cannot be told not to while it reads keyboard
+// input. A terminal that does not know XTMODKEYS and ignores the '>' marker
+// (the pyte emulator is one) reads them as SGR 4, underline, and the renderer,
+// which believes the pen is still plain, never turns it off: every cell it
+// draws until its first styled run comes out underlined. Underline marks the
+// filter match (TASK part A), so a stray underline would be misleading. The
+// renderer's pen is plain at both points, so the reset is a no-op on
+// terminals that understand XTMODKEYS.
+//
+// The type deliberately does not embed *os.File: a promoted WriteString or
+// ReadFrom would let io.WriteString or io.Copy bypass Write. It keeps Fd, so
+// Bubble Tea still recognizes the terminal (term.File) for raw mode and size.
+// Bubble Tea writes each frame with a single Write call, so a sequence is never
+// split across calls; a split one would merely miss its reset.
+type sgrSafeOutput struct{ f *os.File }
+
+func (o sgrSafeOutput) Read(p []byte) (int, error) { return o.f.Read(p) }
+func (o sgrSafeOutput) Close() error               { return o.f.Close() }
+func (o sgrSafeOutput) Fd() uintptr                { return o.f.Fd() }
+
+func (o sgrSafeOutput) Write(p []byte) (int, error) {
+	q := resetAfterXTMODKEYS(p)
+	n, err := o.f.Write(q)
+	if n == len(q) {
+		return len(p), err
+	}
+	// Short write: report at most len(p) bytes, and always an error.
+	if n > len(p) {
+		n = len(p)
+	}
+	if err == nil {
+		err = io.ErrShortWrite
+	}
+	return n, err
+}
+
+var xtmodkeysRE = regexp.MustCompile("\x1b\\[>[0-9;]*m")
+
+// resetAfterXTMODKEYS returns p with CSI m inserted after every XTMODKEYS
+// sequence; p itself when it contains none.
+func resetAfterXTMODKEYS(p []byte) []byte {
+	if !bytes.Contains(p, []byte("\x1b[>")) {
+		return p
+	}
+	return xtmodkeysRE.ReplaceAll(p, []byte("${0}\x1b[m"))
+}
