+func TestMatchSpan(t *testing.T) {
+	for _, c := range []struct {
+		s, q       string
+		start, end int
+		ok         bool
+	}{
+		{"Lab-Server", "SERV", 4, 8, true},
+		{"vps-東京", "京", 5, 6, true},
+		{"abab", "ab", 0, 2, true},
+		{"abc", "", 0, 0, false},
+		{"abc", "abcd", 0, 0, false},
+		{"abc", "x", 0, 0, false},
+	} {
+		start, end, ok := matchSpan(c.s, c.q)
+		if start != c.start || end != c.end || ok != c.ok {
+			t.Errorf("matchSpan(%q,%q) = %d,%d,%v", c.s, c.q, start, end, ok)
+		}
+		// Same rule as the filter.
+		if want := len(profile.Filter([]profile.Destination{{Alias: c.s}}, c.q)) == 1; c.q != "" && ok != want {
+			t.Errorf("matchSpan(%q,%q) disagrees with profile.Filter", c.s, c.q)
+		}
+	}
+}
