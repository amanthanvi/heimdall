+}
+
+// matchSpan returns the rune range [start, end) of the first case-insensitive
+// occurrence of query in s, or ok=false. It applies the rule of
+// profile.Filter (strings.ToLower, which maps rune by rune), so a row is
+// highlighted exactly where the filter matched it. Indexes are runes, which
+// Sanitize preserves one for one.
+func matchSpan(s, query string) (start, end int, ok bool) {
+	if query == "" {
+		return 0, 0, false
+	}
+	hay := []rune(strings.ToLower(s))
+	needle := []rune(strings.ToLower(query))
+	for i := 0; i+len(needle) <= len(hay); i++ {
+		j := 0
+		for j < len(needle) && hay[i+j] == needle[j] {
+			j++
+		}
+		if j == len(needle) {
+			return i, i + len(needle), true
+		}
+	}
+	return 0, 0, false
+}
+
+// highlight returns Sanitize(s) with the first case-insensitive occurrence of
+// query wrapped in underline on/off SGR sequences (TASK part A).
+func highlight(s, query string) string {
+	clean := Sanitize(s)
+	start, end, ok := matchSpan(s, query)
+	if !ok {
+		return clean
+	}
+	r := []rune(clean)
+	if end > len(r) { // defensive: Sanitize maps rune for rune, so this never happens
+		return clean
+	}
+	return string(r[:start]) + sgrUnderline + string(r[start:end]) + sgrUnderlineOff + string(r[end:])
+}
+
 // Render is the pure layout function (exported for tests).
