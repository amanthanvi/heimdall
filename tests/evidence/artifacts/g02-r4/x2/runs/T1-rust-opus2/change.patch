+# ---------- X2 T1: exec-equivalent job control (S2-S5; S1 is tests/cli.rs) ----------
+# Every scenario runs a plain-exec control first and then the same command under
+# `heimdall-proto run`, in the same interactive shell session, and compares what the
+# user sees: stop notices, `$?`, `jobs`, typed input reaching the child, process states.
+
+X2_PROBE = r"""
+import os, signal, sys, time
+d, tag, mode, rc = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
+def put(name, text):
+    p = os.path.join(d, tag + "." + name)
+    with open(p + ".part", "w") as f:
+        f.write(text)
+    os.replace(p + ".part", p)
+put("pid", "%d %d" % (os.getpid(), os.getppid()))
+if mode == "work":                      # about 2 s of running time, silent, then exit rc
+    for i in range(100):
+        time.sleep(0.02)
+        put("beat", str(i))
+    put("done", "1")
+    sys.exit(rc)
+if mode.startswith("selfstop-"):        # stop ITSELF (OpenSSH ~^Z), then read one line
+    put("stopping", "1")
+    os.kill(os.getpid(), getattr(signal, mode.split("-", 1)[1]))
+    put("resumed", "1")
+else:                                   # "read": block reading one line from the terminal
+    put("reading", "1")
+line = sys.stdin.readline()
+put("got", line)
+print("X2GOT", line.strip(), flush=True)
+sys.exit(rc)
+"""
+
+
+def x2_shells():
+    """(name, argv, stop notice word, `jobs`-count expression) of the shells present."""
+    out = [("bash", ["/bin/bash", "--norc", "--noprofile", "-i"], b"Stopped", "$(jobs -p | wc -l)")]
+    zsh = next((p for p in ("/bin/zsh", "/usr/bin/zsh") if os.access(p, os.X_OK)), None)
+    if zsh:
+        out.append(("zsh", [zsh, "-f", "-i"], b"suspended", "${#jobstates}"))
+    return out, ([] if zsh else ["zsh (not installed)"])
+
+
+class X2Session:
+    """One interactive shell session in a fresh pty, with marker-based helpers."""
+
+    def __init__(self, shell):
+        self.name, argv, self.stopw, self.jobs_expr = shell
+        self.sh = Shell(argv)
+        self.d = tempfile.mkdtemp(prefix=f"x2-{self.name}-", dir=TMP)
+        self.probe = os.path.join(self.d, "probe.py")
+        open(self.probe, "w").write(X2_PROBE)
+        self.pids = []
+        assert self.sh.wait_count(b"HPS1$ ", 1, timeout=10), f"{self.name}: no prompt: {self.sh.out[-200:]!r}"
+        assert b"no job control" not in self.sh.out, f"{self.name}: no job control"
+
+    def mark(self):
+        return len(self.sh.out)
+
+    def since(self, m):
+        return self.sh.out[m:]
+
+    def wait(self, pred, timeout):
+        end = time.monotonic() + timeout
+        while time.monotonic() < end:
+            if pred():
+                return True
+            self.sh.read_for(0.02)
+        return pred()
+
+    def wait_re(self, rx, m, timeout=4.0):
+        self.wait(lambda: re.search(rx, self.since(m)) is not None, timeout)
+        return re.search(rx, self.since(m))
+
+    def file(self, tag, name):
+        return os.path.join(self.d, f"{tag}.{name}")
+
+    def wait_file(self, tag, name, timeout=5.0):
+        return self.wait(lambda: os.path.exists(self.file(tag, name)), timeout)
+
+    def ids(self, tag):
+        """(child pid, the child's parent: heimdall-proto, or the shell for plain exec)."""
+        assert self.wait_file(tag, "pid", 10), f"{tag}: the child never started: {self.sh.out[-300:]!r}"
+        child, parent = (int(x) for x in open(self.file(tag, "pid")).read().split())
+        self.pids += [child] + ([parent] if parent != self.sh.p.pid else [])
+        return child, parent
+
+    def notice(self, m, timeout=4.0):
+        """The shell's stop notice and the prompt after it, since mark m."""
+        return self.wait(lambda: self.stopw in self.since(m)
+                         and b"HPS1$ " in self.since(m)[self.since(m).find(self.stopw):], timeout)
+
+    def status(self):
+        m = self.mark()
+        self.sh.send(b'echo "X2ST""=$?"\n')
+        mm = self.wait_re(rb"X2ST=(\d+)", m)
+        assert mm, f"{self.name}: no status echo: {self.since(m)[-200:]!r}"
+        return int(mm.group(1))
+
+    def jobs(self):
+        """(`jobs` text, number of jobs left). `jobs` runs first so done jobs are reported and dropped."""
+        m = self.mark()
+        self.sh.send(('jobs; echo "X2JL""=%s"\n' % self.jobs_expr).encode())
+        mm = self.wait_re(rb"X2JL=\s*(\d+)", m)
+        assert mm, f"{self.name}: no jobs echo: {self.since(m)[-200:]!r}"
+        text = self.since(m)[:mm.start()]
+        return text, int(mm.group(1))
+
+    def run(self, b, tag, via, mode, rc, meta=None, argv=None, redir=""):
+        cmd = argv or f'"{sys.executable}" "{self.probe}" "{self.d}" {tag} {mode} {rc}'
+        if via:
+            cmd = f'"{b}" run ' + (f'--meta-file "{meta}" ' if meta else "") + "-- " + cmd
+        cmd += redir
+        m = self.mark()
+        self.sh.send(cmd.encode() + b"\n")
+        return m
+
+    def gone(self, pids, timeout=3.0):
+        def alive():
+            return [p for p in pids if proc_state(p) not in ("", "Z")]
+        self.wait(lambda: not alive(), timeout)
+        return alive()
+
+    def close(self):
+        for pid in self.pids:
+            try:
+                os.kill(pid, signal.SIGCONT)
+                os.kill(pid, signal.SIGKILL)
+            except (ProcessLookupError, PermissionError):
+                pass
+        self.sh.close()
+
+
+def x2_each_shell(fn):
+    shells, blocked = x2_shells()
+    notes = []
+    for shell in shells:
+        s = X2Session(shell)
+        try:
+            notes.append(f"{shell[0]}: " + fn(s))
+        finally:
+            s.close()
+    if blocked:
+        notes.append("blocked: " + ", ".join(blocked))
+    return "; ".join(notes)
+
+
+@case("x2-s2-third-party-stop-cont-interactive")
+def t_x2_s2(b):
+    """S2: a third party stops the foreground child (SIGSTOP, SIGTSTP), waits 0.5 s and
+    continues the child PID only. The shell prints a stop notice, `$?` equals plain exec's
+    (128+sig), the child runs to completion, and the job either finishes on its own or
+    (permitted deviation b) stays listed stopped until `fg`, which ends it with the
+    child's status. Nothing is left behind."""
+    def one(s):
+        out = []
+        for sig in (signal.SIGSTOP, signal.SIGTSTP):
+            seen = {}
+            for via in (False, True):
+                tag = f"s2-{sig.name}-{'hp' if via else 'ctl'}"
+                lbl = f"[{s.name} {sig.name} {'heimdall-proto' if via else 'plain exec'}]"
+                m = s.run(b, tag, via, "work", 7)
+                child, parent = s.ids(tag)
+                s.sh.read_for(0.3)
+                os.kill(child, sig)          # third party: exactly one PID
+                time.sleep(0.5)
+                os.kill(child, signal.SIGCONT)
+                assert s.notice(m), f"{lbl} no stop notice: {s.since(m)[-300:]!r}"
+                st = s.status()
+                assert st == 128 + sig, f"{lbl} $? {st}, expected {128 + sig}"
+                assert s.wait_file(tag, "done", 6), f"{lbl} the child did not run to completion"
+                # "done" is written just before the exit: wait for the exit itself (gone, or a
+                # zombie while a stopped heimdall-proto cannot reap it).
+                assert s.wait(lambda: proc_state(child) in ("", "Z"), 3), \
+                    f"{lbl} the child did not exit: {proc_state(child)}"
+                s.sh.read_for(0.2)
+                text, n = s.jobs()
+                how = "finished"
+                if n:
+                    assert via, f"{lbl} plain exec left a job: {text!r}"
+                    assert s.stopw in text, f"{lbl} job listed but not stopped: {text!r}"
+                    m2 = s.mark()
+                    s.sh.send(b"fg\n")
+                    assert s.wait(lambda: s.since(m2).count(b"HPS1$ ") >= 1, 6), f"{lbl} fg did not end the job"
+                    st2 = s.status()
+                    assert st2 == 7, f"{lbl} fg ended the job with $? {st2}, expected 7"
+                    text, n = s.jobs()
+                    assert n == 0, f"{lbl} a job is left after fg: {text!r}"
+                    how = "stopped until fg (deviation b), fg -> 7"
+                left = s.gone([child] + ([parent] if via else []))
+                assert not left, f"{lbl} processes left behind: {left}"
+                seen[via] = st
+                out.append(f"{sig.name} {'hp' if via else 'ctl'} $?={st} {how}")
+            assert seen[True] == seen[False], f"[{s.name} {sig.name}] $? differs from plain exec: {seen}"
+        return ", ".join(out)
+    return x2_each_shell(one)
+
