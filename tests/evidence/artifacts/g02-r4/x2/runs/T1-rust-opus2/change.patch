+/// X2 T1 S1 (exec-equivalent job control, non-interactive parent): a program that is not
+/// a shell runs `run -- <cmd>` with no terminal on stdin, stdout or stderr, in a process
+/// group of its own that is not orphaned (the test process is its parent, in another
+/// group of the same session). A third party stops the child (SIGSTOP, then SIGTSTP),
+/// waits 0.5 s and continues the child PID only. As with plain exec (the control run,
+/// same environment): the command runs to completion, the launcher exits with the
+/// child's status within 6 s of the SIGCONT, and the child is reaped. Before X2 the
+/// launcher mirrored the stop onto itself and, never continued, stayed stopped forever.
+#[test]
+fn x2_s1_third_party_stop_cont_without_terminal() {
+    use std::os::unix::process::CommandExt;
+    let script = "echo $$; i=0; while [ $i -lt 30 ]; do sleep 0.05; i=$((i+1)); done; exit 7";
+    let mut seen = Vec::new();
+    for sig in ["STOP", "TSTP"] {
+        for via in [false, true] {
+            let lbl = format!(
+                "SIG{sig} {}",
+                if via { "heimdall-proto" } else { "plain exec" }
+            );
+            let mut c = if via {
+                let mut c = cmd();
+                c.args(["run", "--"]);
+                c.arg("sh");
+                c
+            } else {
+                Command::new("sh")
+            };
+            let mut job = c
+                .args(["-c", script])
+                .process_group(0)
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .spawn()
+                .unwrap();
+            let mut r = BufReader::new(job.stdout.take().unwrap());
+            let mut line = String::new();
+            r.read_line(&mut line).unwrap();
+            let child: i32 = line.trim().parse().unwrap();
+            std::thread::sleep(Duration::from_millis(200));
+            // Third party: exactly one PID each time.
+            assert!(
+                shell_kill(&format!("-{sig}"), &child.to_string()),
+                "{lbl}: stop"
+            );
+            std::thread::sleep(Duration::from_millis(500));
+            assert!(shell_kill("-CONT", &child.to_string()), "{lbl}: continue");
+            let t = Instant::now();
+            let mut exited = false;
+            while t.elapsed() < Duration::from_secs(6) {
+                if job.try_wait().unwrap().is_some() {
+                    exited = true;
+                    break;
+                }
+                std::thread::sleep(Duration::from_millis(20));
+            }
+            let after_cont = t.elapsed();
+            if !exited {
+                // Release whatever is stuck (only this test's own job group), then fail.
+                let g = format!("-{}", job.id());
+                shell_kill("-CONT", &g);
+                shell_kill("-KILL", &g);
+            }
+            let st = job.wait().unwrap();
+            assert!(exited, "{lbl}: no exit within 6 s of SIGCONT");
+            assert_eq!(st.code(), Some(7), "{lbl}: the child's status");
+            let t = Instant::now();
+            while pid_running(child) && t.elapsed() < Duration::from_secs(2) {
+                std::thread::sleep(Duration::from_millis(20));
+            }
+            assert!(!pid_running(child), "{lbl}: child left behind");
+            seen.push(format!("{lbl}: exit 7, {after_cont:?} after SIGCONT"));
+        }
+    }
+    eprintln!("X2 S1: {}", seen.join("; "));
