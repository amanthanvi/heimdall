+/// Run `f` on heimdall-proto's controlling terminal: the first of stdin, stdout,
+/// stderr that is that terminal (`tcgetpgrp` fails with ENOTTY on any other terminal),
+/// else `/dev/tty`, opened read-only and closed again at once (the crossterm backend
+/// of `tui` opens it the same way). `None`: no controlling terminal.
+#[cfg(unix)]
+fn with_tty<R>(f: impl FnOnce(std::os::fd::BorrowedFd<'_>, bool) -> R) -> Option<R> {
+    use std::os::fd::AsFd;
+    use std::os::unix::fs::OpenOptionsExt;
+    let (i, o, e) = (std::io::stdin(), std::io::stdout(), std::io::stderr());
+    if let Some(fd) = [i.as_fd(), o.as_fd(), e.as_fd()]
+        .into_iter()
+        .find(|fd| rustix::termios::isatty(fd) && rustix::termios::tcgetpgrp(fd).is_ok())
+    {
+        return Some(f(fd, true));
+    }
+    let dev = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOCTTY | libc::O_NONBLOCK)
+        .open("/dev/tty")
+        .ok()?;
+    Some(f(dev.as_fd(), false))
+}
