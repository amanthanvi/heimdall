+@case("x2-s3-self-stop-then-cont-launcher-only")
+def t_x2_s3(b):
+    """S3: the child stops itself (SIGTSTP); after the stop notice a third party sends
+    SIGCONT to the launcher PID only (plain exec: to the child). The child resumes, reads
+    the terminal in the background and is stopped by SIGTTIN, so `jobs` lists the job
+    stopped (never running while the child is stopped); `fg` gives the terminal back,
+    the child reads the typed line and its status (3) is `$?`."""
+    def one(s):
+        out = []
+        for via in (False, True):
+            tag = f"s3-{'hp' if via else 'ctl'}"
+            lbl = f"[{s.name} {'heimdall-proto' if via else 'plain exec'}]"
+            m = s.run(b, tag, via, "selfstop-SIGTSTP", 3)
+            child, parent = s.ids(tag)
+            assert s.wait_file(tag, "stopping"), f"{lbl} no self-stop"
+            assert s.notice(m), f"{lbl} no stop notice: {s.since(m)[-300:]!r}"
+            st = s.status()
+            assert st == 128 + signal.SIGTSTP, f"{lbl} $? {st}"
+            os.kill(parent if via else child, signal.SIGCONT)  # third party, one PID
+            assert s.wait_file(tag, "resumed", 3), \
+                f"{lbl} the child did not resume (child {proc_state(child)}, parent {proc_state(parent)})"
+            assert s.wait(lambda: proc_state(child).startswith("T"), 3), \
+                f"{lbl} the resumed child was not stopped by its background read: {proc_state(child)}"
