+/// `profile show --file <p>` (with or without `--json`), stdin closed. Panics if the
+/// process is still running after 2 s (K14: it must never block on the input).
+fn profile_show_within_2s(p: &Path, json: bool) -> Output {
+    let mut c = cmd();
+    c.args(["profile", "show", "--file"]).arg(p);
+    if json {
+        c.arg("--json");
+    }
+    let mut c = c
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let t = Instant::now();
+    while c.try_wait().unwrap().is_none() && t.elapsed() < Duration::from_secs(2) {
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    if c.try_wait().unwrap().is_none() {
+        let _ = c.kill();
+        let _ = c.wait();
+        panic!("{}: still running after 2 s", p.display());
+    }
+    c.wait_with_output().unwrap()
+}
+
+/// Asserts the K14 outcome: exit 2 `USAGE_ERROR` (one JSON document with `--json`,
+/// a stderr diagnostic and no stdout without it).
+fn assert_k14_usage_error(p: &Path) {
+    let o = profile_show_within_2s(p, true);
+    assert_eq!(o.status.code(), Some(2), "{} --json", p.display());
+    let v = one_json(&o);
+    assert_eq!(v["code"], "USAGE_ERROR", "{} --json", p.display());
+    assert_eq!(v["state"], "failed", "{} --json", p.display());
+    let o = profile_show_within_2s(p, false);
+    assert_eq!(o.status.code(), Some(2), "{}", p.display());
+    assert!(o.stdout.is_empty(), "{}: no stdout on failure", p.display());
+    let err = String::from_utf8_lossy(&o.stderr);
+    assert!(err.contains("USAGE_ERROR"), "{}: {err}", p.display());
+}
