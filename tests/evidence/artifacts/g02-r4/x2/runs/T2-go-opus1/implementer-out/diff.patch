new file mode 100644
index 0000000..f47a2a0
--- /dev/null
+++ b/prototypes/go/internal/lint/lint.go
@@ -0,0 +1,217 @@
+// Package lint reports findings about a schema-valid profile
+// (`heimdall-proto profile lint`, TASK.md T2). It is a pure function of an
+// already validated *profile.Profile: no I/O, no file writes.
+//
+// Findings name places by key path only. The only profile values a finding
+// carries are destination ids (DestinationIDs); host, account, labels, alias,
+// name and [meta] are never copied into a finding.
+package lint
+
+import (
+	"fmt"
+
+	"github.com/heimdall-g02/proto-go/internal/profile"
+)
+
+// Rule ids, in reporting order (rule numbers 1 to 5).
+const (
+	RuleDuplicateEndpoint = "duplicate-endpoint"
+	RulePrivilegedPort    = "privileged-port"
+	RuleRootAccount       = "root-account"
+	RuleDuplicateLabel    = "duplicate-label"
+	RuleLabelCaseVariant  = "label-case-variant"
+)
+
+// Exact finding messages.
+const (
+	MsgDuplicateEndpoint = "destinations share the same host and port"
+	MsgPrivilegedPort    = "port below 1024 other than 22"
+	MsgRootAccount       = "account is root"
+	MsgDuplicateLabel    = "label repeated within a destination"
+	MsgLabelCaseVariant  = "labels differ only in letter case"
+)
+
+// Finding is one lint result. All four members are always present; the
+// slices are never nil, so they encode as JSON arrays.
+type Finding struct {
+	Rule           string   `json:"rule"`
+	KeyPaths       []string `json:"key_paths"`
+	DestinationIDs []string `json:"destination_ids"`
+	Message        string   `json:"message"`
+}
+
+// loc is one key-path target: destination index i, and label index j for
+// label rules (-1 otherwise).
+type loc struct{ i, j int }
+
+// Lint returns the findings for p, ordered by rule number and, within a
+// rule, as TASK.md specifies. The result is never nil.
+func Lint(p *profile.Profile) []Finding {
+	ds := p.Destinations
+	out := []Finding{}
+	out = append(out, duplicateEndpoints(ds)...)
+	out = append(out, privilegedPorts(ds)...)
+	out = append(out, rootAccounts(ds)...)
+	out = append(out, duplicateLabels(ds)...)
+	out = append(out, labelCaseVariants(ds)...)
+	return out
+}
+
+// asciiLower maps A-Z to a-z and leaves every other byte unchanged. Every
+// byte of a multi-byte UTF-8 sequence is >= 0x80, so non-ASCII characters
+// (and invalid bytes) are never altered. strings.ToLower is not used: it
+// applies Unicode case mapping (for example to "Ä" or the Kelvin sign).
+func asciiLower(s string) string {
+	b := []byte(s)
+	for k, c := range b {
+		if 'A' <= c && c <= 'Z' {
+			b[k] = c + ('a' - 'A')
+		}
+	}
+	return string(b)
+}
+
+// effectivePort is port, or 22 when omitted. profile.Parse already stores 22
+// for an omitted port; the zero check keeps Lint correct for a Profile built
+// by other code.
+func effectivePort(d profile.Destination) int64 {
+	if d.Port == 0 {
+		return 22
+	}
+	return d.Port
+}
+
+func hostPath(i int) string     { return fmt.Sprintf("destinations[%d].host", i) }
+func portPath(i int) string     { return fmt.Sprintf("destinations[%d].port", i) }
+func accountPath(i int) string  { return fmt.Sprintf("destinations[%d].account", i) }
+func labelPath(i, j int) string { return fmt.Sprintf("destinations[%d].labels[%d]", i, j) }
+func single(i int) []loc        { return []loc{{i, -1}} }
+
+// finding builds a Finding from locations already in the required order.
+// destination_ids lists each named destination once, in first-appearance
+// order.
+func finding(ds []profile.Destination, rule, msg string, locs []loc, path func(loc) string) Finding {
+	f := Finding{Rule: rule, Message: msg, KeyPaths: make([]string, 0, len(locs)), DestinationIDs: []string{}}
+	seen := map[int]bool{}
+	for _, l := range locs {
+		f.KeyPaths = append(f.KeyPaths, path(l))
+		if !seen[l.i] {
+			seen[l.i] = true
+			f.DestinationIDs = append(f.DestinationIDs, ds[l.i].ID)
+		}
+	}
+	return f
+}
+
+// groupInOrder groups keys in order of first appearance. order lists the
+// distinct keys by first appearance; members maps each key to its items in
+// insertion order.
+type groupInOrder[K comparable, V any] struct {
+	order   []K
+	members map[K][]V
+}
+
+func newGroups[K comparable, V any]() *groupInOrder[K, V] {
+	return &groupInOrder[K, V]{members: map[K][]V{}}
+}
+
+func (g *groupInOrder[K, V]) add(k K, v V) {
+	if _, ok := g.members[k]; !ok {
+		g.order = append(g.order, k)
+	}
+	g.members[k] = append(g.members[k], v)
+}
+
+// Rule 1: same ASCII-lowercased host and same effective port. One finding per
+// group of two or more, ordered by the group's first member.
+func duplicateEndpoints(ds []profile.Destination) []Finding {
+	type endpoint struct {
+		host string
+		port int64
+	}
+	g := newGroups[endpoint, loc]()
+	for i, d := range ds {
+		g.add(endpoint{asciiLower(d.Host), effectivePort(d)}, loc{i, -1})
+	}
+	out := []Finding{}
+	for _, k := range g.order {
+		if m := g.members[k]; len(m) >= 2 {
+			out = append(out, finding(ds, RuleDuplicateEndpoint, MsgDuplicateEndpoint, m, func(l loc) string { return hostPath(l.i) }))
+		}
+	}
+	return out
+}
+
+// Rule 2: effective port below 1024 and not 22. An omitted port is 22, so a
+// finding always names an explicit port key.
+func privilegedPorts(ds []profile.Destination) []Finding {
+	out := []Finding{}
+	for i, d := range ds {
+		if p := effectivePort(d); p < 1024 && p != 22 {
+			out = append(out, finding(ds, RulePrivilegedPort, MsgPrivilegedPort, single(i), func(l loc) string { return portPath(l.i) }))
+		}
+	}
+	return out
+}
+
+// Rule 3: account exactly "root" (case-sensitive).
+func rootAccounts(ds []profile.Destination) []Finding {
+	out := []Finding{}
+	for i, d := range ds {
+		if d.Account == "root" {
+			out = append(out, finding(ds, RuleRootAccount, MsgRootAccount, single(i), func(l loc) string { return accountPath(l.i) }))
+		}
+	}
+	return out
+}
+
+func labelLoc(l loc) string { return labelPath(l.i, l.j) }
+
+// Rule 4: within one destination, the same label string (exact comparison)
+// more than once. One finding per (destination, label string), ordered by
+// destination index, then by the string's first occurrence; key paths list
+// every occurrence ascending.
+func duplicateLabels(ds []profile.Destination) []Finding {
+	out := []Finding{}
+	for i, d := range ds {
+		g := newGroups[string, loc]()
+		for j, l := range d.Labels {
+			g.add(l, loc{i, j})
+		}
+		for _, k := range g.order {
+			if m := g.members[k]; len(m) >= 2 {
+				out = append(out, finding(ds, RuleDuplicateLabel, MsgDuplicateLabel, m, labelLoc))
+			}
+		}
+	}
+	return out
+}
+
+// Rule 5: across the profile, two or more different label strings equal
+// after ASCII-lowercasing. One finding per such set, naming every occurrence
+// of every spelling in (i, j) order; sets are ordered by their first
+// occurrence. Identical strings alone (in one or several destinations) are
+// not a finding.
+func labelCaseVariants(ds []profile.Destination) []Finding {
+	g := newGroups[string, loc]()
+	spell := map[string]map[string]bool{}
+	for i, d := range ds {
+		for j, l := range d.Labels {
+			k := asciiLower(l)
+			g.add(k, loc{i, j})
+			if spell[k] == nil {
+				spell[k] = map[string]bool{}
+			}
+			spell[k][l] = true
+		}
+	}
+	out := []Finding{}
+	// Occurrences were added in (i, j) order, so each group's members are
+	// already sorted and g.order is ordered by each set's first occurrence.
+	for _, k := range g.order {
+		if len(spell[k]) >= 2 {
+			out = append(out, finding(ds, RuleLabelCaseVariant, MsgLabelCaseVariant, g.members[k], labelLoc))
+		}
+	}
+	return out
+}
