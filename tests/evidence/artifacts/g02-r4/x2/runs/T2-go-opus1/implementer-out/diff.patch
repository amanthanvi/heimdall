diff --git a/prototypes/go/cmd/heimdall-proto/lint_fifo_test.go b/prototypes/go/cmd/heimdall-proto/lint_fifo_test.go
new file mode 100644
index 0000000..5d2e898
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/lint_fifo_test.go
@@ -0,0 +1,44 @@
+//go:build !windows
+
+package main
+
+import (
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// K14: a FIFO without a writer given to lint is USAGE_ERROR, exactly as for
+// show, and never blocks (bound: 2 s).
+func TestProfileLintFIFO(t *testing.T) {
+	fifo := filepath.Join(t.TempDir(), "fifo ü")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// Bound each call without calling t.Fatal off the test goroutine.
+	bounded := func(args ...string) (int, string) {
+		type r struct {
+			code int
+			out  string
+		}
+		ch := make(chan r, 1)
+		go func() { c, o, _ := call(args...); ch <- r{c, o} }()
+		select {
+		case x := <-ch:
+			return x.code, x.out
+		case <-time.After(2 * time.Second):
+			t.Fatalf("%v blocked on a FIFO", args)
+			return 0, ""
+		}
+	}
+	lc, lo := bounded("profile", "lint", "--file", fifo, "--json")
+	sc, so := bounded("profile", "show", "--file", fifo, "--json")
+	lv, sv := viewOf(t, lc, lo), viewOf(t, sc, so)
+	if lv != sv || lv.code != "USAGE_ERROR" || lv.exit != 2 {
+		t.Fatalf("fifo: lint %+v, show %+v", lv, sv)
+	}
+	if pc, _ := bounded("profile", "lint", "--file", fifo); pc != 2 {
+		t.Fatalf("fifo plain exit %d", pc)
+	}
+}
diff --git a/prototypes/go/cmd/heimdall-proto/lint_test.go b/prototypes/go/cmd/heimdall-proto/lint_test.go
