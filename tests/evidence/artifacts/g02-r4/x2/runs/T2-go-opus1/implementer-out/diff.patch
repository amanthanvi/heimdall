+// K15) and the same error result, so a profile that show rejects is rejected
+// here with the same exit status, code and key_path. One stricter usage rule:
+// a --file immediately followed by one of this command's own flags is a
+// missing value, not a path named "--json". On a schema-valid profile the
+// findings are reported by key path and destination id only; no other
+// profile value is written to stdout or stderr, with or without --json.
+// Nothing is written to disk.
+func cmdProfileLint(args []string, stdout, stderr io.Writer) int {
+	fs := newFlags("profile lint")
+	file := fs.String("file", "", "")
+	jsonOut := fs.Bool("json", false, "")
+	if fileValueIsFlag(args) {
+		return usage(stdout, stderr, hasJSON(args), "flag --file needs a value")
+	}
+	if err := parseFlags(fs, args); err != nil {
+		return usage(stdout, stderr, hasJSON(args), err.Error())
+	}
+	if *file == "" {
+		return usage(stdout, stderr, *jsonOut, "--file is required")
+	}
+	p, perr := profile.Load(*file)
+	if perr != nil {
+		fmt.Fprintf(stderr, "heimdall-proto: %s\n", perr.Error())
+		if *jsonOut {
+			_ = result.Write(stdout, result.Fail(perr.Code, perr.KeyPath, perr.Message, perr.Warnings...))
+		}
+		return result.ExitCode(perr.Code)
+	}
+	findings := lint.Lint(p)
+	code := result.LintClean
+	if len(findings) > 0 {
+		code = result.LintFindings
+	}
+	if *jsonOut {
+		_ = result.Write(stdout, result.OK(code, map[string]any{"findings": findings}))
+		return result.ExitCode(code)
+	}
+	// Plain output (K12: unspecified, not judged): rule, message and key
+	// paths only. Destination ids are left out too, so plain mode echoes no
+	// profile value at all.
+	for _, f := range findings {
+		fmt.Fprintf(stdout, "%s: %s: %s\n", f.Rule, f.Message, strings.Join(f.KeyPaths, ", "))
+	}
+	fmt.Fprintf(stdout, "%d finding(s)\n", len(findings))
+	return result.ExitCode(code)
+}
+
+// fileValueIsFlag reports a --file (or -file) whose next argument is one of
+// profile lint's own flags, for example `--file --json`: the value is
+// missing. The Go flag package would otherwise take "--json" as the path.
+// The explicit form --file=--json still names a file called "--json".
+func fileValueIsFlag(args []string) bool {
+	for k, a := range args {
+		if a == "--" {
+			return false
+		}
+		if (a == "--file" || a == "-file") && k+1 < len(args) {
+			next := args[k+1]
+			name := strings.TrimLeft(next, "-")
+			dashes := len(next) - len(name)
+			if eq := strings.IndexByte(name, '='); eq >= 0 {
+				name = name[:eq]
+			}
+			if (dashes == 1 || dashes == 2) && (name == "json" || name == "file") {
+				return true
+			}
+		}
+	}
+	return false
+}
+
