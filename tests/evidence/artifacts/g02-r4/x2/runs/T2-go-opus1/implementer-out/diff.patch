+package lint
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/heimdall-g02/proto-go/internal/profile"
+)
+
+// dest is a compact destination spec for test profiles. port 0 means the
+// port key is omitted; labels nil means the labels key is omitted.
+type dest struct {
+	host    string
+	port    int
+	account string
+	labels  []string
+}
+
+// build renders a TOML profile and parses it with profile.Parse, so every
+// test input is a schema-valid profile exactly as the CLI would see it.
+func build(t *testing.T, ds ...dest) *profile.Profile {
+	t.Helper()
+	var b strings.Builder
+	b.WriteString("schema_version = 1\nname = \"n\"\nrevision = 1\n[meta]\nnote = \"m\"\n")
+	for i, d := range ds {
+		fmt.Fprintf(&b, "[[destinations]]\nid = \"id%d\"\nalias = \"a%d\"\nhost = %q\naccount = %q\n", i, i, d.host, d.account)
+		if d.port != 0 {
+			fmt.Fprintf(&b, "port = %d\n", d.port)
+		}
+		if d.labels != nil {
+			q := make([]string, len(d.labels))
+			for k, l := range d.labels {
+				q[k] = fmt.Sprintf("%q", l)
+			}
+			fmt.Fprintf(&b, "labels = [%s]\n", strings.Join(q, ", "))
+		}
+	}
+	p, err := profile.Parse([]byte(b.String()))
+	if err != nil {
+		t.Fatalf("test profile invalid: %v\n%s", err, b.String())
+	}
+	return p
+}
+
+func f(rule, msg string, ids []string, paths ...string) Finding {
+	return Finding{Rule: rule, KeyPaths: paths, DestinationIDs: ids, Message: msg}
+}
+
+func ids(s ...string) []string { return s }
+
+func check(t *testing.T, got []Finding, want ...Finding) {
+	t.Helper()
+	if want == nil {
+		want = []Finding{}
+	}
+	g, _ := json.Marshal(got)
+	w, _ := json.Marshal(want)
+	if string(g) != string(w) {
+		t.Fatalf("findings mismatch\n got: %s\nwant: %s", g, w)
+	}
+}
+
+func TestCleanAndEmpty(t *testing.T) {
+	check(t, Lint(build(t)))
+	check(t, Lint(build(t,
+		dest{host: "a.example", account: "u", labels: []string{"x", "y"}},
+		dest{host: "b.example", port: 2222, account: "Root", labels: []string{"x"}},
+	)))
+	// Never nil, so the JSON is [] rather than null.
+	if b, _ := json.Marshal(Lint(build(t))); string(b) != "[]" {
+		t.Fatalf("empty findings encode as %s", b)
+	}
+}
+
+func TestDuplicateEndpoint(t *testing.T) {
+	p := build(t,
+		dest{host: "Lab.Example", account: "u"},           // 0: port 22 (omitted)
+		dest{host: "other", account: "u"},                 // 1
+		dest{host: "lab.example", port: 22, account: "u"}, // 2: same as 0
+		dest{host: "other", port: 2222, account: "u"},     // 3: other host, different port: near miss
+		dest{host: "LAB.EXAMPLE", port: 23, account: "u"}, // 4: different port: near miss
+		dest{host: "OTHER", account: "u"},                 // 5: same as 1
+		dest{host: "lab.example", account: "u"},           // 6: same as 0
+	)
+	check(t, Lint(p),
+		f(RuleDuplicateEndpoint, MsgDuplicateEndpoint, ids("id0", "id2", "id6"),
+			"destinations[0].host", "destinations[2].host", "destinations[6].host"),
+		f(RuleDuplicateEndpoint, MsgDuplicateEndpoint, ids("id1", "id5"),
+			"destinations[1].host", "destinations[5].host"),
+		f(RulePrivilegedPort, MsgPrivilegedPort, ids("id4"), "destinations[4].port"),
+	)
+}
+
+func TestDuplicateEndpointASCIIOnlyLowercase(t *testing.T) {
+	// "Ä" and "ä" differ after ASCII-lowercasing; so do the Kelvin sign and
+	// "k", which Unicode case folding would equate.
+	p := build(t,
+		dest{host: "Äb.example", account: "u"},
+		dest{host: "äb.example", account: "u"},
+		dest{host: "K.example", account: "u"},
+		dest{host: "k.example", account: "u"},
+		dest{host: "ÄB.EXAMPLE", account: "u"},
+	)
+	check(t, Lint(p),
+		f(RuleDuplicateEndpoint, MsgDuplicateEndpoint, ids("id0", "id4"),
+			"destinations[0].host", "destinations[4].host"))
+}
+
+func TestPrivilegedPortAndRoot(t *testing.T) {
+	p := build(t,
+		dest{host: "h0", port: 1, account: "root"},     // both rules
+		dest{host: "h1", port: 22, account: "ROOT"},    // near misses
+		dest{host: "h2", port: 1023, account: " root"}, // port only
+		dest{host: "h3", port: 1024, account: "root"},  // root only
+		dest{host: "h4", account: "root "},             // nothing
+		dest{host: "h5", port: 80, account: "u"},       // port only
+	)
+	check(t, Lint(p),
+		f(RulePrivilegedPort, MsgPrivilegedPort, ids("id0"), "destinations[0].port"),
+		f(RulePrivilegedPort, MsgPrivilegedPort, ids("id2"), "destinations[2].port"),
+		f(RulePrivilegedPort, MsgPrivilegedPort, ids("id5"), "destinations[5].port"),
+		f(RuleRootAccount, MsgRootAccount, ids("id0"), "destinations[0].account"),
+		f(RuleRootAccount, MsgRootAccount, ids("id3"), "destinations[3].account"),
+	)
+}
+
+func TestDuplicateLabel(t *testing.T) {
+	p := build(t,
+		dest{host: "h0", account: "u", labels: []string{"b", "a", "b", "a", "c", "b"}},
+		dest{host: "h1", account: "u", labels: []string{"x"}},
+		dest{host: "h2", account: "u", labels: []string{"x", "x"}},
+		dest{host: "h3", account: "u", labels: []string{"", ""}},
+	)
+	check(t, Lint(p),
+		f(RuleDuplicateLabel, MsgDuplicateLabel, ids("id0"),
+			"destinations[0].labels[0]", "destinations[0].labels[2]", "destinations[0].labels[5]"),
+		f(RuleDuplicateLabel, MsgDuplicateLabel, ids("id0"),
+			"destinations[0].labels[1]", "destinations[0].labels[3]"),
+		f(RuleDuplicateLabel, MsgDuplicateLabel, ids("id2"),
+			"destinations[2].labels[0]", "destinations[2].labels[1]"),
+		f(RuleDuplicateLabel, MsgDuplicateLabel, ids("id3"),
+			"destinations[3].labels[0]", "destinations[3].labels[1]"),
+	)
+}
+
+func TestLabelCaseVariant(t *testing.T) {
+	p := build(t,
+		dest{host: "h0", account: "u", labels: []string{"keep", "Prod"}},
+		dest{host: "h1", account: "u", labels: []string{"prod", "keep", "Ünï"}},
+		dest{host: "h2", account: "u", labels: []string{"PROD", "Prod", "ünï"}},
+		dest{host: "h3", account: "u", labels: []string{"Dev", "dev"}},
+	)
+	check(t, Lint(p),
+		f(RuleLabelCaseVariant, MsgLabelCaseVariant, ids("id0", "id1", "id2"),
+			"destinations[0].labels[1]", "destinations[1].labels[0]",
+			"destinations[2].labels[0]", "destinations[2].labels[1]"),
+		f(RuleLabelCaseVariant, MsgLabelCaseVariant, ids("id3"),
+			"destinations[3].labels[0]", "destinations[3].labels[1]"),
+	)
+}
+
+func TestLabelCaseVariantOrderByFirstOccurrence(t *testing.T) {
+	p := build(t,
+		dest{host: "h0", account: "u", labels: []string{"x", "Y"}},
+		dest{host: "h1", account: "u", labels: []string{"y", "X"}},
+	)
+	check(t, Lint(p),
+		f(RuleLabelCaseVariant, MsgLabelCaseVariant, ids("id0", "id1"),
+			"destinations[0].labels[0]", "destinations[1].labels[1]"),
+		f(RuleLabelCaseVariant, MsgLabelCaseVariant, ids("id0", "id1"),
+			"destinations[0].labels[1]", "destinations[1].labels[0]"),
+	)
+}
+
+// Exact repeats plus a case variant in one destination: rule 4 for the
+// exact repeat, rule 5 for the variant set naming every occurrence. A label
+// identical across destinations alone is not a finding.
+func TestDuplicateAndCaseVariantTogether(t *testing.T) {
+	p := build(t,
+		dest{host: "h0", account: "u", labels: []string{"a", "a", "A"}},
+		dest{host: "h1", account: "u", labels: []string{"same", "a"}},
+		dest{host: "h2", account: "u", labels: []string{"same"}},
+	)
+	check(t, Lint(p),
+		f(RuleDuplicateLabel, MsgDuplicateLabel, ids("id0"),
+			"destinations[0].labels[0]", "destinations[0].labels[1]"),
+		f(RuleLabelCaseVariant, MsgLabelCaseVariant, ids("id0", "id1"),
+			"destinations[0].labels[0]", "destinations[0].labels[1]",
+			"destinations[0].labels[2]", "destinations[1].labels[1]"),
+	)
+}
+
+func TestAllRulesOrder(t *testing.T) {
+	p := build(t,
+		dest{host: "h", port: 443, account: "root", labels: []string{"L", "l", "l"}},
+		dest{host: "H", port: 443, account: "root"},
+	)
+	check(t, Lint(p),
+		f(RuleDuplicateEndpoint, MsgDuplicateEndpoint, ids("id0", "id1"), "destinations[0].host", "destinations[1].host"),
+		f(RulePrivilegedPort, MsgPrivilegedPort, ids("id0"), "destinations[0].port"),
+		f(RulePrivilegedPort, MsgPrivilegedPort, ids("id1"), "destinations[1].port"),
+		f(RuleRootAccount, MsgRootAccount, ids("id0"), "destinations[0].account"),
+		f(RuleRootAccount, MsgRootAccount, ids("id1"), "destinations[1].account"),
+		f(RuleDuplicateLabel, MsgDuplicateLabel, ids("id0"), "destinations[0].labels[1]", "destinations[0].labels[2]"),
+		f(RuleLabelCaseVariant, MsgLabelCaseVariant, ids("id0"),
+			"destinations[0].labels[0]", "destinations[0].labels[1]", "destinations[0].labels[2]"),
+	)
+}
+
+func TestASCIILower(t *testing.T) {
+	for in, want := range map[string]string{"": "", "AbZ@[`{": "abz@[`{", "ÄÖÜ": "ÄÖÜ", "\u212a": "\u212a", "xY\xff": "xy\xff"} {
+		if got := asciiLower(in); got != want {
+			t.Errorf("asciiLower(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+// A Destination built without Parse (Port 0) still gets effective port 22.
+func TestEffectivePortZero(t *testing.T) {
+	if effectivePort(profile.Destination{}) != 22 || effectivePort(profile.Destination{Port: 80}) != 80 {
+		t.Fatal("effective port")
+	}
+}
