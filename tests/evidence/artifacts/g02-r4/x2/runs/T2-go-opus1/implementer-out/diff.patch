@@ -0,0 +1,317 @@
+package main
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/heimdall-g02/proto-go/internal/testfix"
+)
+
+// lintProfile triggers every lint rule. Every profile value except the ids
+// is a distinct marker, so the non-echo test can look for each one.
+const lintProfile = `schema_version = 1
+name = "NAMEVALUEzq"
+revision = 7
+
+[meta]
+note = "METAVALUEzq"
+nested = { inner = "METANESTEDzq" }
+
+[[destinations]]
+id = "idA"
+alias = "ALIASAzq"
+host = "HOSTVALUEzq.example"
+port = 80
+account = "root"
+labels = ["LabelAzq", "labelazq", "DUPLBLzq", "DUPLBLzq"]
+
+[[destinations]]
+id = "idB"
+alias = "ALIASBzq"
+host = "hostvaluezq.EXAMPLE"
+port = 80
+account = "ACCOUNTBzq"
+labels = ["SHAREDzq"]
+
+[[destinations]]
+id = "idC"
+alias = "ALIASCzq"
+host = "OTHERHOSTzq"
+account = "ACCOUNTCzq"
+labels = ["SHAREDzq", "LABELAZQ"]
+`
+
+const lintWantJSON = `{"schema_version":"1","state":"succeeded","code":"LINT_FINDINGS","data":{"findings":[` +
+	`{"rule":"duplicate-endpoint","key_paths":["destinations[0].host","destinations[1].host"],"destination_ids":["idA","idB"],"message":"destinations share the same host and port"},` +
+	`{"rule":"privileged-port","key_paths":["destinations[0].port"],"destination_ids":["idA"],"message":"port below 1024 other than 22"},` +
+	`{"rule":"privileged-port","key_paths":["destinations[1].port"],"destination_ids":["idB"],"message":"port below 1024 other than 22"},` +
+	`{"rule":"root-account","key_paths":["destinations[0].account"],"destination_ids":["idA"],"message":"account is root"},` +
+	`{"rule":"duplicate-label","key_paths":["destinations[0].labels[2]","destinations[0].labels[3]"],"destination_ids":["idA"],"message":"label repeated within a destination"},` +
+	`{"rule":"label-case-variant","key_paths":["destinations[0].labels[0]","destinations[0].labels[1]","destinations[2].labels[1]"],"destination_ids":["idA","idC"],"message":"labels differ only in letter case"}` +
+	`]},"warnings":[],"next":null}` + "\n"
+
+// lintValues are the profile values that must never be printed.
+var lintValues = []string{"NAMEVALUEzq", "METAVALUEzq", "METANESTEDzq", "ALIASAzq", "ALIASBzq", "ALIASCzq",
+	"HOSTVALUEzq", "hostvaluezq", "OTHERHOSTzq", "ACCOUNTBzq", "ACCOUNTCzq",
+	"LabelAzq", "labelazq", "LABELAZQ", "DUPLBLzq", "SHAREDzq"}
+
+func writeProfile(t *testing.T, dir, name, body string) string {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	if err := os.WriteFile(p, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// sameJSON compares two JSON documents ignoring member order.
+func sameJSON(t *testing.T, got, want string) {
+	t.Helper()
+	var g, w any
+	if err := json.Unmarshal([]byte(got), &g); err != nil {
+		t.Fatalf("stdout is not JSON: %q", got)
+	}
+	_ = json.Unmarshal([]byte(want), &w)
+	if !reflect.DeepEqual(g, w) {
+		t.Fatalf("JSON mismatch\n got: %s\nwant: %s", got, want)
+	}
+}
+
+func TestProfileLintFindingsExact(t *testing.T) {
+	dir := t.TempDir()
+	f := writeProfile(t, dir, "lint profile ü 東京.toml", lintProfile)
+	for _, args := range [][]string{
+		{"profile", "lint", "--file", f, "--json"},
+		{"profile", "lint", "--json", "--file", f},
+		{"profile", "lint", "--file=" + f, "--json"},
+	} {
+		code, out, errS := call(args...)
+		if code != 3 {
+			t.Fatalf("%v: exit %d, want 3", args, code)
+		}
+		envelope(t, out)
+		sameJSON(t, out, lintWantJSON)
+		if errS != "" {
+			t.Fatalf("%v: unexpected stderr %q", args, errS)
+		}
+	}
+	// Without --json: same exit status, output unspecified (K12).
+	if code, _, _ := call("profile", "lint", "--file", f); code != 3 {
+		t.Fatalf("plain exit %d, want 3", code)
+	}
+}
+
+func TestProfileLintClean(t *testing.T) {
+	f := filepath.Join(testfix.Dir(t), "homelab.toml")
+	want := `{"schema_version":"1","state":"succeeded","code":"LINT_CLEAN","data":{"findings":[]},"warnings":[],"next":null}` + "\n"
+	for _, args := range [][]string{
+		{"profile", "lint", "--file", f, "--json"},
+		{"profile", "lint", "--json", "--file", f},
+	} {
+		code, out, _ := call(args...)
+		if code != 0 || out != want {
+			t.Fatalf("%v: exit %d, out %q", args, code, out)
+		}
+	}
+	if code, _, _ := call("profile", "lint", "--file", f); code != 0 {
+		t.Fatalf("plain exit %d", code)
+	}
+	// Path with spaces and non-ASCII characters (shared fixture).
+	sp := filepath.Join(testfix.Dir(t), "spaced dir ü", "prøfile homelab.toml")
+	if code, out, _ := call("profile", "lint", "--json", "--file", sp); code != 0 || out != want {
+		t.Fatalf("spaced path: exit %d, out %q", code, out)
+	}
+	// A profile without destinations is clean.
+	dir := t.TempDir()
+	e := writeProfile(t, dir, "empty.toml", "schema_version = 1\nname = \"n\"\nrevision = 1\n")
+	if code, out, _ := call("profile", "lint", "--file", e, "--json"); code != 0 || out != want {
+		t.Fatalf("empty: exit %d, out %q", code, out)
+	}
+}
+
+// Profile values never reach stdout or stderr, with or without --json. The
+// destination ids appear only inside destination_ids in JSON mode.
+func TestProfileLintNoValueEcho(t *testing.T) {
+	dir := t.TempDir()
+	f := writeProfile(t, dir, "p.toml", lintProfile)
+	for _, args := range [][]string{
+		{"profile", "lint", "--file", f, "--json"},
+		{"profile", "lint", "--file", f},
+	} {
+		_, out, errS := call(args...)
+		for _, v := range lintValues {
+			if strings.Contains(strings.ToLower(out+errS), strings.ToLower(v)) {
+				t.Fatalf("%v: value %q echoed", args, v)
+			}
+		}
+		if len(args) == 4 {
+			for _, id := range []string{"idA", "idB", "idC"} {
+				if strings.Contains(out+errS, id) {
+					t.Fatalf("plain mode echoed id %q", id)
+				}
+			}
+		}
+	}
+	// A schema-invalid value (K2 control character, K18) is not echoed either.
+	bad := writeProfile(t, dir, "bad.toml", "schema_version = 1\nname = \"n\"\nrevision = 1\n"+
+		"[[destinations]]\nid = \"i\"\nalias = \"a\"\nhost = \"BADVALUEzq\\u001b\"\naccount = \"u\"\n")
+	for _, j := range []bool{true, false} {
+		args := []string{"profile", "lint", "--file", bad}
+		if j {
+			args = append(args, "--json")
+		}
+		code, out, errS := call(args...)
+		if code != 2 || strings.Contains(out+errS, "BADVALUEzq") {
+			t.Fatalf("invalid value: exit %d out %q err %q", code, out, errS)
+		}
+	}
+}
+
+// errorView is what lint must share with show on an input show rejects.
+type errorView struct {
+	exit    int
+	state   any
+	code    any
+	keyPath any
+}
+
+func viewOf(t *testing.T, code int, out string) errorView {
+	t.Helper()
+	m := envelope(t, out)
+	d, _ := m["data"].(map[string]any)
+	e, _ := d["error"].(map[string]any)
+	if e == nil {
+		t.Fatalf("no data.error in %q", out)
+	}
+	return errorView{code, m["state"], m["code"], e["key_path"]}
+}
+
+// assertSameAsShow checks that lint fails exactly like show for path, with
+// and without --json.
+func assertSameAsShow(t *testing.T, path string) errorView {
+	t.Helper()
+	sc, so, _ := call("profile", "show", "--file", path, "--json")
+	lc, lo, _ := call("profile", "lint", "--file", path, "--json")
+	sv, lv := viewOf(t, sc, so), viewOf(t, lc, lo)
+	if sv != lv {
+		t.Fatalf("%s: show %+v, lint %+v", filepath.Base(path), sv, lv)
+	}
+	if sc == 0 {
+		t.Fatalf("%s: show succeeded", filepath.Base(path))
+	}
+	if pc, pout, _ := call("profile", "lint", "--file", path); pc != lc || pout != "" {
+		t.Fatalf("%s: plain exit %d stdout %q, json exit %d", filepath.Base(path), pc, pout, lc)
+	}
+	return lv
+}
+
+func TestProfileLintInputHandlingMatchesShow(t *testing.T) {
+	fx := testfix.Dir(t)
+	ents, err := os.ReadDir(fx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n := 0
+	for _, e := range ents {
+		if strings.HasPrefix(e.Name(), "invalid-") {
+			v := assertSameAsShow(t, filepath.Join(fx, e.Name()))
+			if v.code != "SCHEMA_INVALID" {
+				t.Fatalf("%s: %+v", e.Name(), v)
+			}
+			n++
+		}
+	}
+	if n < 5 {
+		t.Fatalf("only %d invalid fixtures found", n)
+	}
+	dir := t.TempDir()
+	big := writeProfile(t, dir, "big ü.toml", strings.Repeat("#", 1<<20+1))
+	if v := assertSameAsShow(t, big); v.code != "INPUT_TOO_LARGE" {
+		t.Fatalf("oversize: %+v", v)
+	}
+	if v := assertSameAsShow(t, filepath.Join(dir, "missing ü.toml")); v.code != "USAGE_ERROR" {
+		t.Fatalf("missing: %+v", v)
+	}
+	if v := assertSameAsShow(t, dir); v.code != "USAGE_ERROR" {
+		t.Fatalf("directory: %+v", v)
+	}
+	// Schema-valid for show, but with duplicate ids: rejected identically.
+	dup := writeProfile(t, dir, "dup.toml", "schema_version = 1\nname = \"n\"\nrevision = 1\n"+
+		"[[destinations]]\nid = \"i\"\nalias = \"a\"\nhost = \"h\"\naccount = \"u\"\n"+
+		"[[destinations]]\nid = \"i\"\nalias = \"b\"\nhost = \"h\"\naccount = \"u\"\n")
+	if v := assertSameAsShow(t, dup); v.keyPath != "destinations[1].id" {
+		t.Fatalf("duplicate id: %+v", v)
+	}
+}
+
+func TestProfileLintCanaryNeverEmitted(t *testing.T) {
+	for _, f := range []string{"invalid-forbidden-key.toml", "invalid-unknown-dest-key.toml"} {
+		for _, extra := range [][]string{{"--json"}, nil} {
+			args := append([]string{"profile", "lint", "--file", filepath.Join(testfix.Dir(t), f)}, extra...)
+			code, out, errS := call(args...)
+			if code != 2 || strings.Contains(out+errS, "HEIMDALL_CANARY_") {
+				t.Fatal(f, code, out, errS)
+			}
+		}
+	}
+}
+
+func TestProfileLintUsageErrors(t *testing.T) {
+	f := filepath.Join(testfix.Dir(t), "homelab.toml")
+	for _, args := range [][]string{
+		{},                        // missing --file
+		{"--file"},                // flag without value
+		{"--file", "--json"},      // value missing: the next token is a flag
+		{"--json", "--file"},      // flag without value
+		{"--file", f, "--bogus"},  // unknown flag
+		{"--file", f, "extra"},    // stray positional argument
+		{"--file", "-json", "x"},  // value missing (single-dash flag form)
+		{"--file", "--json=true"}, // value missing (flag with explicit value)
+	} {
+		withJSON := append(append([]string{"profile", "lint"}, args...), "--json")
+		code, out, errS := call(withJSON...)
+		if code != 2 || envelope(t, out)["code"] != "USAGE_ERROR" || errS == "" {
+			t.Fatalf("%v: exit %d out %q", withJSON, code, out)
+		}
+		plain := append([]string{"profile", "lint"}, args...)
+		hasJ := false
+		for _, a := range plain {
+			hasJ = hasJ || strings.HasPrefix(a, "--json") || a == "-json"
+		}
+		code, out, errS = call(plain...)
+		if code != 2 || errS == "" {
+			t.Fatalf("%v: exit %d", plain, code)
+		}
+		if !hasJ && out != "" {
+			t.Fatalf("%v: plain usage error wrote stdout %q", plain, out)
+		}
+	}
+	// --file=<value> names the file explicitly, even one called "--json".
+	code, out, _ := call("profile", "lint", "--file=--json", "--json")
+	if code != 2 || viewOf(t, code, out).code != "USAGE_ERROR" {
+		t.Fatalf("--file=--json: exit %d out %q", code, out)
+	}
+	// Unknown profile subcommand.
+	if code, out, _ := call("profile", "lnt", "--json"); code != 2 || envelope(t, out)["code"] != "USAGE_ERROR" {
+		t.Fatal(code, out)
+	}
+}
+
+// lint writes nothing to disk: the profile's directory is unchanged.
+func TestProfileLintWritesNothing(t *testing.T) {
+	dir := t.TempDir()
+	f := writeProfile(t, dir, "p.toml", lintProfile)
+	before, _ := os.ReadDir(dir)
+	st0, _ := os.Stat(f)
+	call("profile", "lint", "--file", f, "--json")
+	call("profile", "lint", "--file", f)
+	after, _ := os.ReadDir(dir)
+	st1, _ := os.Stat(f)
+	if len(before) != len(after) || len(after) != 1 || !st0.ModTime().Equal(st1.ModTime()) || st0.Size() != st1.Size() {
+		t.Fatal("lint changed the profile directory")
+	}
+}
