+/// Byte range in `hay` of the first occurrence of `needle_lower` (already lowercased,
+/// non-empty) when `hay` is compared case-insensitively character by character. The
+/// range is in `hay`'s own byte offsets even if lowercasing changes a character's
+/// length; a match that ends inside a character's lowercase expansion covers the whole
+/// character.
+pub fn find_ci(hay: &str, needle_lower: &str) -> Option<(usize, usize)> {
+    let needle: Vec<char> = needle_lower.chars().collect();
+    if needle.is_empty() {
+        return None;
+    }
+    // Each lowercased char with the byte range of the original char it came from.
+    let mut lowered: Vec<(char, usize, usize)> = Vec::with_capacity(hay.len());
+    for (start, c) in hay.char_indices() {
+        let end = start + c.len_utf8();
+        lowered.extend(c.to_lowercase().map(|l| (l, start, end)));
+    }
+    if lowered.len() < needle.len() {
+        return None;
+    }
+    (0..=lowered.len() - needle.len())
+        .find(|&i| {
+            lowered[i..i + needle.len()]
+                .iter()
+                .map(|t| t.0)
+                .eq(needle.iter().copied())
+        })
+        .map(|i| (lowered[i].1, lowered[i + needle.len() - 1].2))
 }
 
