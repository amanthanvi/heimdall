+@case("x2b-help-overlay")
+def t_x2b(b):
+    s = tui(b)
+    assert s.wait_text("3/3") is not None
+    s.write(b"j/e\r")  # select nas, keep filter "e"
+    assert s.wait_text("filter: e") is not None
+    before = s.screen.text()
+    s.write(b"?")
+    assert s.wait_screen(help_on_screen) is not None, f"help not shown: {s.screen.text()!r}"
+    s.write(b"jk/q\r\x7f\x1b[B!")
+    s.read_for(0.2)
+    assert s.alive() and help_on_screen(s.screen.text()), "other keys are ignored"
+    s.write(b"?")
+    assert s.wait_screen(lambda t: not any(h in t for h in ("close help", "Ctrl-C"))) is not None
+    s.read_for(0.1)
+    assert s.screen.text() == before, f"state kept:\n{before}\nvs\n{s.screen.text()}"
+    s.write(b"?")
+    assert s.wait_screen(help_on_screen) is not None
+    s.write(b"\x1b")
+    assert s.wait_screen(lambda t: "close help" not in t) is not None
+    s.read_for(0.1)
+    assert s.screen.text() == before, "Esc closes without clearing the filter"
+    s.write(b"/?")  # '?' in filter mode is text
+    assert s.wait_text("0/3") is not None and not help_on_screen(s.screen.text())
+    s.write(b"\x1b")
+    s.read_for(0.1)
+    s.write(b"?")
+    assert s.wait_screen(help_on_screen) is not None
+    s.write(b"\x03")  # Ctrl-C in help
+    code, termios_ok = s.finish()
+    assert code == 130 and termios_ok, f"exit {code}"
+    assert b"SELECTED" not in s.out
+    return "nine lines in order; other keys ignored; ? and Esc close; state kept; Ctrl-C exits 130"
