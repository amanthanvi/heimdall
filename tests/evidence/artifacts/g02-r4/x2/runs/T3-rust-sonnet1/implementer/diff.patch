+@case("x2a-highlight-underline")
+def t_x2a(b):
+    s = tui(b)
+    assert s.wait_text("3/3") is not None
+    assert not s.screen.any_underline(), "no underline without a filter"
+    s.write(b"/e")
+    assert s.wait_screen(lambda t: "3/3  /e" in t) is not None
+    s.read_for(0.1)
+    # alias: lab-s[e]rver; host: lab.[e]xample / nas.[e]xample / vps1.[e]xample; accounts are not marked
+    assert underlined_rows(s)[:3] == ["e|e", "e", "e"], underlined_rows(s)
+    s.write(b"\r")  # Enter keeps the filter and the highlight
+    assert s.wait_text("filter: e") is not None
+    s.read_for(0.1)
+    assert underlined_rows(s)[:3] == ["e|e", "e", "e"], underlined_rows(s)
+    s.write(b"/")  # filter mode again; extend to a mixed-case alias+host match
+    s.write(b"\x1b")
+    assert s.wait_text("3/3") is not None
+    s.read_for(0.1)
+    assert not s.screen.any_underline(), "Esc clears the highlight"
+    s.write(b"/LAB")
+    assert s.wait_text("1/3") is not None
+    s.read_for(0.1)
+    assert underlined_rows(s)[0] == "lab|lab", underlined_rows(s)
+    s.write(b"\x1b")
+    s.read_for(0.1)  # a lone Esc is decided after a pause; ESC + byte would be Alt+byte
+    s.write(b"/internal")  # host-only match on two rows
+    assert s.wait_text("2/3") is not None
+    s.read_for(0.1)
+    assert underlined_rows(s)[:2] == ["internal", "internal"], underlined_rows(s)
+    s.write(b"\x1b")
+    s.read_for(0.1)
+    s.write("/東京".encode())
+    assert s.wait_text("1/3") is not None
+    s.read_for(0.1)
+    assert underlined_rows(s)[0] == "東京", underlined_rows(s)
+    s.write(b"\x1b")
+    s.read_for(0.1)
+    s.resize(40, 10)
+    s.write(b"/lab")
+    assert s.wait_text("1/3") is not None
+    s.read_for(0.1)
+    assert underlined_rows(s)[0] == "lab", f"alias only below 50 columns: {underlined_rows(s)}"
+    s.write(b"q")  # q is filter text here
+    s.read_for(0.05)
+    s.write(b"\x1b")
+    s.read_for(0.05)
+    s.write(b"q")
+    code, termios_ok = s.finish()
+    assert code == 0 and termios_ok
+    return "first occurrence in alias and host only, host only >= 50 columns, cleared by Esc"
