+HELP_LINES = ["Keys", "Up / k move up", "Down / j move down", "/ filter", "Enter select",
+              "Esc clear filter", "q quit", "? close help", "Ctrl-C cancel"]
+
+
+def help_on_screen(t):
+    rows = [" ".join(l.split()) for l in t.splitlines()]
+    for i in range(len(rows)):
+        if rows[i:i + len(HELP_LINES)] == HELP_LINES:
+            return True
+    return False
