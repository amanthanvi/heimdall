+/// Append `text` to `spans`, underlining the byte range `mark` (a char-boundary range of
+/// `text`) when there is one.
+fn push_marked(spans: &mut Vec<Span<'static>>, text: &str, mark: Option<(usize, usize)>) {
+    match mark {
+        Some((a, b)) if a < b && b <= text.len() => {
+            spans.push(Span::raw(text[..a].to_string()));
+            spans.push(Span::styled(
+                text[a..b].to_string(),
+                Style::new().add_modifier(Modifier::UNDERLINED),
+            ));
+            spans.push(Span::raw(text[b..].to_string()));
+        }
+        _ => spans.push(Span::raw(text.to_string())),
+    }
+}
+
+/// One list row (same text as `ListModel::row_text`). Only the first match of the
+/// filter text in the alias and in the host (when shown) is underlined; underline is
+/// not a colour, so it is drawn with `NO_COLOR` as well.
+fn row_line(m: &ListModel, d: &Destination, width: u16) -> Line<'static> {
+    let r = m.match_ranges(d, width);
+    let mut spans = Vec::with_capacity(8);
+    push_marked(&mut spans, &d.alias, r.alias);
+    if width >= 50 {
+        spans.push(Span::raw(format!("  {}@", d.account)));
+        push_marked(&mut spans, &d.host, r.host);
+        spans.push(Span::raw(format!(":{}", d.port)));
+    }
+    Line::from(spans)
+}
