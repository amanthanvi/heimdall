+/// A symbolic link to a regular profile file works exactly like the file itself
+/// (absolute, relative, chained, and with a link in a directory component), in both
+/// the JSON and the plain output. A link whose final target is not a regular file is
+/// still K14: exit 2 `USAGE_ERROR` within 2 s, never blocking.
+#[test]
+fn profile_symlinks_follow_to_regular_files_only() {
+    use std::os::unix::fs::symlink;
+    let d = TempDir::new("symlink");
+    let real_dir = d.path().join("dotfiles");
+    let cfg = d.path().join("config");
+    std::fs::create_dir(&real_dir).unwrap();
+    std::fs::create_dir(&cfg).unwrap();
+    let real = real_dir.join("homelab.toml");
+    std::fs::copy(fixtures().join("homelab.toml"), &real).unwrap();
+
+    let want_json = one_json(&run(&[
+        "profile",
+        "show",
+        "--json",
+        "--file",
+        real.to_str().unwrap(),
+    ]));
+    assert_eq!(want_json["code"], "PROFILE_OK");
+    let plain_of = |p: &Path| {
         let o = cmd()
-            .args(["profile", "show", "--json", "--file"])
+            .args(["profile", "show", "--file"])
             .arg(p)
             .output()
             .unwrap();
-        assert_eq!(o.status.code(), Some(want), "{}", p.display());
+        (o.status.code(), o.stdout, o.stderr)
+    };
+    let want_plain = plain_of(&real);
+    assert_eq!(want_plain.0, Some(0));
+
+    let abs = cfg.join("profile.toml");
+    symlink(&real, &abs).unwrap();
+    let rel = cfg.join("relative.toml");
+    symlink("../dotfiles/homelab.toml", &rel).unwrap();
+    let chain = cfg.join("chain.toml");
+    symlink("profile.toml", &chain).unwrap();
+    let dirlink = d.path().join("dirlink");
+    symlink("dotfiles", &dirlink).unwrap();
+    let via_dir = dirlink.join("homelab.toml");
+
+    for p in [&abs, &rel, &chain, &via_dir] {
+        let o = show_within_2s(p);
+        assert_eq!(o.status.code(), Some(0), "{}", p.display());
+        assert_eq!(one_json(&o), want_json, "{}", p.display());
+        assert_eq!(plain_of(p), want_plain, "{}", p.display());
     }
+
+    // A link to a regular file that is not a valid profile reports the file's own error.
+    let bad = real_dir.join("bad.toml");
+    std::fs::write(&bad, "schema_version = 1\nname = ").unwrap();
+    let bad_link = cfg.join("bad-link.toml");
+    symlink(&bad, &bad_link).unwrap();
+    let o = show_within_2s(&bad_link);
+    assert_eq!(o.status.code(), show_within_2s(&bad).status.code());
+    assert_eq!(
+        one_json(&o)["code"],
+        one_json(&show_within_2s(&bad))["code"]
+    );
+
+    // Links that do not end at a regular file are K14 (or an open failure).
+    let fifo = d.path().join("fifo");
+    mkfifo(&fifo);
+    let sock = d.path().join("p.sock");
+    let _l = UnixListener::bind(&sock).unwrap();
+    let mut bad_links: Vec<PathBuf> = Vec::new();
+    for (name, target) in [
+        ("to-fifo", fifo.clone()),
+        ("to-socket", sock.clone()),
+        ("to-dir", real_dir.clone()),
+        ("to-null", PathBuf::from("/dev/null")),
+        ("dangling", d.path().join("missing")),
+        ("to-fifo-via-link", cfg.join("to-fifo")),
+    ] {
+        let l = cfg.join(name);
+        symlink(&target, &l).unwrap();
+        bad_links.push(l);
+    }
+    symlink("loop-b", cfg.join("loop-a")).unwrap();
+    symlink("loop-a", cfg.join("loop-b")).unwrap();
+    bad_links.push(cfg.join("loop-a"));
+    for l in &bad_links {
+        let o = show_within_2s(l);
+        assert_eq!(o.status.code(), Some(2), "{}", l.display());
+        assert_eq!(one_json(&o)["code"], "USAGE_ERROR", "{}", l.display());
+        no_canary(&o);
+    }
+    // The link target is untouched and still loads.
+    assert_eq!(show_within_2s(&real).status.code(), Some(0));
 }
 
