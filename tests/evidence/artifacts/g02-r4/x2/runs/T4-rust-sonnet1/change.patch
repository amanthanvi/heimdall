+/// Run `profile show --json --file <p>` and require it to finish within 2 s.
+fn show_within_2s(p: &Path) -> Output {
+    let mut c = cmd()
+        .args(["profile", "show", "--json", "--file"])
+        .arg(p)
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let t = Instant::now();
+    while c.try_wait().unwrap().is_none() && t.elapsed() < Duration::from_secs(2) {
+        std::thread::sleep(Duration::from_millis(10));
+    }
+    if c.try_wait().unwrap().is_none() {
+        let _ = c.kill();
+        let _ = c.wait();
+        panic!("{}: still running after 2 s", p.display());
+    }
+    c.wait_with_output().unwrap()
+}
