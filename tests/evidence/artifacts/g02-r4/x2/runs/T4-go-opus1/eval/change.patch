+// symlinkLayout reproduces the bug report's stow-style layout under a fresh
+// directory: dotfiles/homelab.toml (a copy of the fixture), and in config/
+// an absolute link profile.toml and a relative link relative.toml to it.
+func symlinkLayout(t *testing.T) (root, regular, abs, rel string) {
+	t.Helper()
+	src, err := os.ReadFile(filepath.Join(testfix.Dir(t), "homelab.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	root = t.TempDir()
+	for _, d := range []string{"dotfiles", "config"} {
+		if err := os.Mkdir(filepath.Join(root, d), 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	regular = filepath.Join(root, "dotfiles", "homelab.toml")
+	if err := os.WriteFile(regular, src, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	abs = filepath.Join(root, "config", "profile.toml")
+	rel = filepath.Join(root, "config", "relative.toml")
+	if err := os.Symlink(regular, abs); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join("..", "dotfiles", "homelab.toml"), rel); err != nil {
+		t.Fatal(err)
+	}
+	return root, regular, abs, rel
+}
+
+// Bug report: `profile show --file <symlink>` exited 2 USAGE_ERROR "profile
+// path is not a regular file". A link to a regular profile now gives exactly
+// the output of the file itself, with and without --json, whether the link
+// is absolute or relative and whether --file is absolute or relative.
+func TestProfileShowSymlink(t *testing.T) {
+	root, regular, abs, rel := symlinkLayout(t)
+	for _, jsonFlag := range [][]string{{"--json"}, nil} {
+		args := func(f string) []string { return append([]string{"profile", "show", "--file", f}, jsonFlag...) }
+		wantCode, wantOut, wantErr := call(args(regular)...)
+		if wantCode != 0 || wantErr != "" {
+			t.Fatalf("regular file %v: exit %d, stderr %q", jsonFlag, wantCode, wantErr)
+		}
+		if jsonFlag != nil && envelope(t, wantOut)["code"] != "PROFILE_OK" {
+			t.Fatalf("regular file: %s", wantOut)
+		}
+		check := func(name, f string) {
+			t.Helper()
+			code, out, errS := call(args(f)...)
+			if code != 0 || out != wantOut || errS != "" {
+				t.Errorf("%s %v: exit %d stdout %q stderr %q; want exit 0 and the regular file's output", name, jsonFlag, code, out, errS)
+			}
+		}
+		check("absolute link", abs)
+		check("relative link", rel)
+		t.Chdir(filepath.Join(root, "config"))
+		check("relative --file naming a relative link", "relative.toml")
+		check("relative --file naming an absolute link", "profile.toml")
+	}
+}
+
+// K14 through a link, at the CLI: a link to a FIFO (no writer) is still exit
+// 2 USAGE_ERROR well within 2 s.
+func TestProfileShowSymlinkToFIFO(t *testing.T) {
+	dir, err := os.MkdirTemp("/tmp", "hpsf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(dir, "profile.toml")
+	if err := os.Symlink(fifo, link); err != nil {
+		t.Fatal(err)
+	}
+	type res struct {
+		code int
+		out  string
+	}
+	done := make(chan res, 1)
+	go func() { c, o, _ := call("profile", "show", "--file", link, "--json"); done <- res{c, o} }()
+	select {
+	case r := <-done:
+		if r.code != 2 || envelope(t, r.out)["code"] != "USAGE_ERROR" {
+			t.Fatalf("exit %d, %s; want 2 USAGE_ERROR", r.code, r.out)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("profile show blocked on a link to a FIFO")
+	}
+}
+
+// Bug report: `tui --file <symlink>` exited 2 at once. A link to a regular
+// profile now opens the picker (destinations drawn, exit 0 on q); a link to
+// a FIFO is still exit 2 within 2 s without drawing.
+func TestTUISymlink(t *testing.T) {
+	_, _, abs, rel := symlinkLayout(t)
+	env := []string{"PATH=/usr/bin:/bin", "HOME=" + t.TempDir(), "USER=hp-test", "TERM=xterm-256color", "NO_COLOR=1"}
+	for name, f := range map[string]string{"absolute link": abs, "relative link": rel} {
+		res := runTUIFile(t, f, env)
+		if res.killed != "" || !res.drew || res.code != 0 || !bytes.Contains(res.output, []byte("lab-server")) {
+			t.Errorf("%s: exit=%d drew=%v killed=%q output=%q", name, res.code, res.drew, res.killed, res.output)
+		}
+	}
+
+	dir, err := os.MkdirTemp("/tmp", "hptf")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(dir, "profile.toml")
+	if err := os.Symlink(fifo, link); err != nil {
+		t.Fatal(err)
+	}
+	res := runTUIFile(t, link, env)
+	if res.killed != "" || res.drew || res.code != 2 || res.elapsed > 2*time.Second ||
+		!strings.Contains(string(res.output), "not a regular file") {
+		t.Errorf("link to FIFO: exit=%d drew=%v killed=%q elapsed=%v output=%q", res.code, res.drew, res.killed, res.elapsed, res.output)
+	}
+}
