+// target. Anything that is not a regular file there (FIFO, socket, device,
+// directory; dangling links and link loops fail to resolve) is a usage error
+// and is never read or waited on (K14): the path is checked before opening,
+// opened without blocking, and the open descriptor is checked again. That
+// second check is what makes following links safe: if the path or a link on
+// it is retargeted between the two checks (to a FIFO, a device or another
+// file), the descriptor is not a regular file or not the file first checked,
+// and Load refuses it without reading.
 func Load(path string) (*Profile, *Error) {
