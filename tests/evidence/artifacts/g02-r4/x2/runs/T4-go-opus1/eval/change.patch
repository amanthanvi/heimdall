diff -ruN -x target -x dist base/prototypes/go/internal/profile/symlink_test.go frozen/go/internal/profile/symlink_test.go
--- base/prototypes/go/internal/profile/symlink_test.go	1969-12-31 19:00:00
+++ frozen/go/internal/profile/symlink_test.go	2026-10-08 22:49:03
@@ -0,0 +1,218 @@
+//go:build !windows
+
+package profile
+
+import (
+	"bytes"
+	"net"
+	"os"
+	"path/filepath"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/heimdall-g02/proto-go/internal/result"
+	"github.com/heimdall-g02/proto-go/internal/testfix"
+)
+
+// loadWithin runs Load and fails the test if it does not return within 2 s
+// (K14: never block on a non-regular file).
+func loadWithin(t *testing.T, name, path string) (*Profile, *Error) {
+	t.Helper()
+	type res struct {
+		p *Profile
+		e *Error
+	}
+	done := make(chan res, 1)
+	start := time.Now()
+	go func() { p, e := Load(path); done <- res{p, e} }()
+	select {
+	case r := <-done:
+		if el := time.Since(start); el > 2*time.Second {
+			t.Errorf("%s: Load took %v", name, el)
+		}
+		return r.p, r.e
+	case <-time.After(2 * time.Second):
+		t.Fatalf("%s: Load still blocked after 2 s", name)
+		return nil, nil
+	}
+}
+
+func symlink(t *testing.T, target, link string) string {
+	t.Helper()
+	if err := os.Symlink(target, link); err != nil {
+		t.Fatal(err)
+	}
+	return link
+}
+
+// Bug report "profile show and tui reject my profile when the path is a
+// symlink": a --file that is a symbolic link (absolute, relative, chained,
+// or reached through a linked directory) to a regular profile file must load
+// exactly like the file itself.
+func TestLoadSymlinkToRegularFile(t *testing.T) {
+	src, err := os.ReadFile(filepath.Join(testfix.Dir(t), "homelab.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	root := t.TempDir()
+	dotfiles := filepath.Join(root, "dotfiles")
+	config := filepath.Join(root, "config")
+	for _, d := range []string{dotfiles, config} {
+		if err := os.Mkdir(d, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	regular := filepath.Join(dotfiles, "homelab.toml")
+	if err := os.WriteFile(regular, src, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	want, e := Load(regular)
+	if e != nil {
+		t.Fatalf("regular file: %+v", e)
+	}
+	if len(want.Destinations) == 0 {
+		t.Fatal("fixture has no destinations")
+	}
+
+	abs := symlink(t, regular, filepath.Join(config, "profile.toml"))
+	rel := symlink(t, filepath.Join("..", "dotfiles", "homelab.toml"), filepath.Join(config, "relative.toml"))
+	chain := symlink(t, "relative.toml", filepath.Join(config, "chain.toml"))
+	linkedDir := symlink(t, dotfiles, filepath.Join(root, "linked-dir"))
+	spaced := filepath.Join(root, "spaced dir ü")
+	if err := os.Mkdir(spaced, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	linkU := symlink(t, regular, filepath.Join(spaced, "profil ü.toml"))
+
+	for name, path := range map[string]string{
+		"absolute link":              abs,
+		"relative link":              rel,
+		"chain of links":             chain,
+		"linked directory component": filepath.Join(linkedDir, "homelab.toml"),
+		"link through linked dir":    filepath.Join(linkedDir, "..", "config", "profile.toml"),
+		"link with space and ü":      linkU,
+	} {
+		got, e := loadWithin(t, name, path)
+		if e != nil {
+			t.Errorf("%s: got %+v, want success", name, e)
+			continue
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: profile differs from the target's", name)
+		}
+	}
+
+	// The result for a link is the result for its target, failures included.
+	big := filepath.Join(dotfiles, "big.toml")
+	if err := os.WriteFile(big, bytes.Repeat([]byte("a"), MaxBytes+1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, e := loadWithin(t, "link to oversize", symlink(t, big, filepath.Join(config, "big.toml"))); e == nil || e.Code != result.InputTooLarge {
+		t.Errorf("link to oversize file: got %+v, want INPUT_TOO_LARGE", e)
+	}
+	bad := filepath.Join(testfix.Dir(t), "invalid-port.toml")
+	_, direct := Load(bad)
+	if direct == nil || direct.Code != result.SchemaInvalid {
+		t.Fatalf("invalid-port.toml directly: got %+v, want SCHEMA_INVALID", direct)
+	}
+	_, viaLink := loadWithin(t, "link to invalid", symlink(t, bad, filepath.Join(config, "bad.toml")))
+	if !reflect.DeepEqual(viaLink, direct) {
+		t.Errorf("link to invalid profile: got %+v, want %+v", viaLink, direct)
+	}
+}
+
+// K14 still holds through links: a link whose final target is not a regular
+// file, a dangling link and a link loop are all USAGE_ERROR within 2 s, and
+// nothing blocks.
+func TestLoadSymlinkToNonRegular(t *testing.T) {
+	dir, err := os.MkdirTemp("/tmp", "hpln") // short: sockets have a path limit
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sock := filepath.Join(dir, "sock")
+	l, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	sub := filepath.Join(dir, "sub")
+	if err := os.Mkdir(sub, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	toFIFO := symlink(t, fifo, filepath.Join(dir, "l-fifo"))
+	cases := map[string]string{
+		"link to fifo":             toFIFO,
+		"relative link to fifo":    symlink(t, "fifo", filepath.Join(dir, "l-rel-fifo")),
+		"chain to fifo":            symlink(t, toFIFO, filepath.Join(dir, "l-chain-fifo")),
+		"link to unix socket":      symlink(t, sock, filepath.Join(dir, "l-sock")),
+		"link to directory":        symlink(t, sub, filepath.Join(dir, "l-dir")),
+		"link to char device":      symlink(t, "/dev/null", filepath.Join(dir, "l-null")),
+		"dangling link":            symlink(t, filepath.Join(dir, "missing"), filepath.Join(dir, "l-dangling")),
+		"link loop":                symlink(t, "l-loop-b", filepath.Join(dir, "l-loop-a")),
+		"link to dir, slash added": symlink(t, sub, filepath.Join(dir, "l-dir2")) + "/",
+	}
+	symlink(t, "l-loop-a", filepath.Join(dir, "l-loop-b"))
+	for name, path := range cases {
+		if _, e := loadWithin(t, name, path); e == nil || e.Code != result.UsageError {
+			t.Errorf("%s: got %+v, want USAGE_ERROR", name, e)
+		}
+	}
+}
+
+// The link is checked before the open and the opened descriptor is checked
+// again: retargeting the link to a FIFO between the two (the race the old
+// Lstat-only check was written against) neither blocks nor loads anything.
+func TestLoadSymlinkRetargetedBeforeOpen(t *testing.T) {
+	dir, err := os.MkdirTemp("/tmp", "hplr")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	reg := filepath.Join(dir, "ok.toml")
+	if err := os.WriteFile(reg, []byte("schema_version = 1\nname = \"x\"\nrevision = 1\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := symlink(t, reg, filepath.Join(dir, "profile.toml"))
+	for name, swap := range map[string]func(){
+		"link retargeted to fifo": func() {
+			tmp := filepath.Join(dir, "next")
+			symlink(t, fifo, tmp)
+			if err := os.Rename(tmp, link); err != nil {
+				t.Error(err)
+			}
+		},
+		"link target replaced by another regular file": func() {
+			tmp := filepath.Join(dir, "next.toml")
+			if err := os.WriteFile(tmp, []byte("schema_version = 1\nname = \"y\"\nrevision = 2\n"), 0o600); err != nil {
+				t.Error(err)
+			}
+			if err := os.Rename(tmp, reg); err != nil {
+				t.Error(err)
+			}
+		},
+	} {
+		beforeOpen = swap
+		_, e := loadWithin(t, name, link)
+		beforeOpen = func() {}
+		if e == nil || e.Code != result.UsageError {
+			t.Errorf("%s: got %+v, want USAGE_ERROR", name, e)
+		}
+		// Restore the link to the regular file for the next case.
+		_ = os.Remove(link)
+		symlink(t, reg, link)
+	}
+	if _, e := Load(link); e != nil {
+		t.Fatalf("restored link: %+v", e)
+	}
+}
