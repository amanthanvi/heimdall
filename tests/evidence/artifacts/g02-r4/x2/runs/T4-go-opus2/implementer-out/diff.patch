@@ -222,7 +222,7 @@ Task M00-T05-go-round2-fix fixes the defects from the round-1 adversarial review
 | K6a inherited-ignored **SIGQUIT** (also SIGTERM, SIGWINCH) | **stack limitation** | The Go runtime installs its own handler for these signals whatever the inherited disposition (`runtime/signal_unix.go` `sigInstallGoHandler` respects SIG_IGN only for SIGHUP and SIGINT). `clearSignalHandlers` then resets them to SIG_DFL in the exec'd child, and `os/signal.Ignored` reports false for them, so the original disposition cannot be read. Observed on darwin and Linux: the selftest OBSERVE line shows child `SIGQUIT=dfl`; in the informational shared-harness `run.k6a_inherited_ignore` [async-job], the child had SIGQUIT SIG_DFL and heimdall exited 131. Not routed around: guessing SIGQUIT from SIGINT is a heuristic, and `//go:linkname` to `runtime.fwdSig` is a private-API hack. A production option is a cgo constructor that reads the dispositions with `sigaction` before the runtime starts and restores SIG_IGN with `signal.Ignore`, at the cost of cgo and a dynamic libc. |
 | K6a: controlling terminal not on stdio (round-1 known gap) | **fixed** | `controllingTTY` falls back to `/dev/tty` (O_RDONLY, O_NOCTTY, O_NONBLOCK). Because macOS answers TIOCGPGRP on pipes too, a descriptor counts as a terminal only if it is a tty and TIOCGPGRP succeeds. Proof: selftest `run.k6a_ctty_not_on_stdio_child_reads_tty`. Round 1: the child was stopped by SIGTTIN forever. After: it reads the line, exit 0. |
 | K6 regression found during round 2 | **fixed** | The first round-2 build also treated a piped *stderr* as a pipeline, so an explicit SIGINT under the harness's pty shim (stderr piped) was not forwarded. Only stdin and stdout count now. New selftest `run.k6_foreground_explicit_sigint_once_stderr_piped` (red: red-round2-build1-stderr-piped-darwin-arm64.txt). |
-| K14 non-regular `--file` | **fixed** | `internal/profile/profile.go` `Load` stats the path before opening, opens with O_NONBLOCK (`open_unix.go`), then checks fstat and SameFile. Proof: `TestK14NonRegularFiles` (FIFO, symlink to a FIFO, socket, directory, /dev/null). Red: the FIFO blocked for more than 2 s and /dev/null gave SCHEMA_INVALID. The TUI uses the same `Load`. |
+| K14 non-regular `--file` | **fixed** | `internal/profile/profile.go` `Load` stats the path before opening, opens with O_NONBLOCK (`open_unix.go`), then checks fstat and SameFile. Proof: `TestK14NonRegularFiles` (FIFO, symlink to a FIFO, socket, directory, /dev/null). Red: the FIFO blocked for more than 2 s and /dev/null gave SCHEMA_INVALID. The TUI uses the same `Load`. [Post-round bug fix] `Load` now checks the path with `Stat`, not `Lstat`, so a symlink (absolute, relative or chained) to a regular profile works like the file in `profile show` and `tui`; a link to a FIFO, socket, device or directory is still exit 2 within 2 s, and the O_NONBLOCK open plus fstat/SameFile re-check refuse a link retargeted between the checks. Proof: `internal/profile/symlink_test.go`, `cmd/heimdall-proto/symlink_test.go`, extended `TestK14NonRegularFiles`. |
 | minor GODEBUG=execerrdot=0 re-enables `.` PATH matches | **fixed** | `internal/run/run.go` refuses a bare name that resolves to a relative path, whatever GODEBUG says. Proof: `TestDotPathRefusalNotEnvironmentControlled`, with PATH `.`, `:/usr/bin` and `/usr/bin::/bin` under three GODEBUG values; red: it ran. |
 | minor FIFO `--meta-file` blocks forever | **fixed** | `cmd/heimdall-proto/meta_unix.go` opens with O_NONBLOCK: with no reader, the child's status is kept and stderr reports the lost side channel; with a reader, the JSON is delivered. Proof: `TestRunMetaFIFO`; red: blocked for more than 3 s. |
 | minor DYLD_INSERT_LIBRARIES injects into the darwin artifact | **fixed** (local signing only) | `build.sh` runs `codesign --force --options runtime --sign -`, an ad-hoc signature with hardened runtime. Before: `INJECTED_DYLIB_LOADED`; after: not loaded (dyld-insert-darwin-arm64-*.txt). Not notarized; there is no Developer ID. The Linux artifacts are static, so LD_PRELOAD does not apply. |
diff --git a/prototypes/go/cmd/heimdall-proto/symlink_test.go b/prototypes/go/cmd/heimdall-proto/symlink_test.go
new file mode 100644
index 0000000..e10940d
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/symlink_test.go
@@ -0,0 +1,136 @@
+//go:build darwin || linux
+
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/heimdall-g02/proto-go/internal/testfix"
+)
+
+// symlinkLayout reproduces the bug report: a profile in a dotfiles directory
+// linked into a config directory (GNU stow style), by an absolute link, a
+// relative link and a link to a link. It returns the regular file and the
+// links to it.
+func symlinkLayout(t *testing.T) (string, map[string]string) {
+	t.Helper()
+	root := t.TempDir()
+	dotfiles := filepath.Join(root, "dotfiles")
+	config := filepath.Join(root, "config ü")
+	for _, d := range []string{dotfiles, config} {
+		if err := os.MkdirAll(d, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	src, err := os.ReadFile(filepath.Join(testfix.Dir(t), "homelab.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := filepath.Join(dotfiles, "homelab.toml")
+	if err := os.WriteFile(target, src, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	links := map[string]string{
+		"absolute symlink":     filepath.Join(config, "profile.toml"),
+		"relative symlink":     filepath.Join(config, "relative.toml"),
+		"symlink to a symlink": filepath.Join(config, "chain.toml"),
+	}
+	for name, old := range map[string]string{
+		"absolute symlink":     target,
+		"relative symlink":     "../dotfiles/homelab.toml",
+		"symlink to a symlink": "relative.toml",
+	} {
+		if err := os.Symlink(old, links[name]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return target, links
+}
+
+// Bug report: `profile show --file <symlink>` exited 2 USAGE_ERROR "profile
+// path is not a regular file". A link to a regular profile must give exactly
+// the output of the file itself, with and without --json.
+func TestProfileShowSymlink(t *testing.T) {
+	target, links := symlinkLayout(t)
+	for _, jsonFlag := range [][]string{{"--json"}, nil} {
+		args := append([]string{"profile", "show", "--file", target}, jsonFlag...)
+		wantCode, wantOut, wantErr := call(args...)
+		if wantCode != 0 || wantOut == "" {
+			t.Fatalf("regular file %v: exit %d %q", jsonFlag, wantCode, wantOut)
+		}
+		if jsonFlag != nil && envelope(t, wantOut)["code"] != "PROFILE_OK" {
+			t.Fatalf("regular file: %q", wantOut)
+		}
+		for name, link := range links {
+			args := append([]string{"profile", "show", "--file", link}, jsonFlag...)
+			code, out, errS := call(args...)
+			if code != wantCode || out != wantOut || errS != wantErr {
+				t.Errorf("%s %v: exit %d stdout %q stderr %q; want exit %d stdout %q", name, jsonFlag, code, out, errS, wantCode, wantOut)
+			}
+		}
+	}
+}
+
+// K14 still holds through a link: a link to a FIFO, a directory or a device
+// is exit 2 USAGE_ERROR within 2 s; a dangling link is exit 2 USAGE_ERROR.
+func TestProfileShowSymlinkToNonRegular(t *testing.T) {
+	dir := t.TempDir()
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for name, old := range map[string]string{
+		"fifo": fifo, "directory": dir, "char device": "/dev/null", "dangling": filepath.Join(dir, "missing.toml"),
+	} {
+		link := filepath.Join(dir, "link to "+name)
+		if err := os.Symlink(old, link); err != nil {
+			t.Fatal(err)
+		}
+		type res struct {
+			code int
+			out  string
+		}
+		done := make(chan res, 1)
+		go func() { c, o, _ := call("profile", "show", "--file", link, "--json"); done <- res{c, o} }()
+		select {
+		case r := <-done:
+			if r.code != 2 || envelope(t, r.out)["code"] != "USAGE_ERROR" {
+				t.Errorf("link to %s: exit %d %q, want 2 USAGE_ERROR", name, r.code, r.out)
+			}
+		case <-time.After(2 * time.Second):
+			t.Fatalf("link to %s: profile show still blocked after 2 s", name)
+		}
+	}
+}
+
+// Bug report: `tui --file <symlink>` exited 2 straight away. Through a link
+// the TUI must draw and quit on q with exit 0 like it does for the file, and
+// a link to a FIFO must still be refused (exit 2) without blocking.
+func TestTUISymlink(t *testing.T) {
+	dir := t.TempDir()
+	env := []string{"PATH=/usr/bin:/bin", "HOME=" + dir, "USER=hp-test", "TERM=xterm-256color"}
+	_, links := symlinkLayout(t)
+	for name, link := range links {
+		res := runTUIFile(t, link, env)
+		if res.killed != "" || !res.drew || res.code != 0 || !res.stderrOK {
+			t.Errorf("%s: exit=%d drew=%v killed=%q no_panic_trace=%v; want a frame and exit 0", name, res.code, res.drew, res.killed, res.stderrOK)
+		}
+	}
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(dir, "fifo-link.toml")
+	if err := os.Symlink(fifo, link); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	res := runTUIFile(t, link, env)
+	if el := time.Since(start); res.code != 2 || res.drew || el > 2*time.Second {
+		t.Errorf("symlink to FIFO: exit=%d drew=%v after %v; want exit 2 within 2 s without a frame", res.code, res.drew, el)
+	}
+}
