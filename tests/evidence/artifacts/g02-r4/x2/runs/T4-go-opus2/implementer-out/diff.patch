diff --git a/prototypes/go/internal/profile/symlink_test.go b/prototypes/go/internal/profile/symlink_test.go
new file mode 100644
index 0000000..80537fe
--- /dev/null
+++ b/prototypes/go/internal/profile/symlink_test.go
@@ -0,0 +1,179 @@
+//go:build !windows
+
+package profile
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/heimdall-g02/proto-go/internal/result"
+	"github.com/heimdall-g02/proto-go/internal/testfix"
+)
+
+// Bug report "profile show and tui reject my profile when the path is a
+// symlink": a symlink to a regular profile (dotfiles linked into place, GNU
+// stow style) must load exactly like the file it points to. Red before the
+// fix: every link case below was USAGE_ERROR "profile path is not a regular
+// file", because Load checked the path with Lstat.
+func TestLoadFollowsSymlinkToRegularFile(t *testing.T) {
+	root := t.TempDir()
+	dotfiles := filepath.Join(root, "dot files ü")
+	config := filepath.Join(root, "config")
+	nested := filepath.Join(config, "nested")
+	for _, d := range []string{dotfiles, nested} {
+		if err := os.MkdirAll(d, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	src, err := os.ReadFile(filepath.Join(testfix.Dir(t), "homelab.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := filepath.Join(dotfiles, "homelab.toml")
+	if err := os.WriteFile(target, src, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	want, e := Load(target)
+	if e != nil {
+		t.Fatalf("regular file: %+v", e)
+	}
+
+	symlink := func(oldname, newname string) string {
+		t.Helper()
+		if err := os.Symlink(oldname, newname); err != nil {
+			t.Fatal(err)
+		}
+		return newname
+	}
+	abs := symlink(target, filepath.Join(config, "profile.toml"))
+	rel := symlink("../dot files ü/homelab.toml", filepath.Join(config, "relative.toml"))
+	chain := symlink("../relative.toml", filepath.Join(nested, "chain.toml"))
+	dirLink := symlink(dotfiles, filepath.Join(config, "linked-dir"))
+	cases := map[string]string{
+		"absolute symlink":           abs,
+		"relative symlink":           rel,
+		"symlink to a symlink":       chain,
+		"path through a dir symlink": filepath.Join(dirLink, "homelab.toml"),
+	}
+	for name, path := range cases {
+		got, e := Load(path)
+		if e != nil {
+			t.Errorf("%s: got %+v, want the profile", name, e)
+			continue
+		}
+		if !reflect.DeepEqual(got, want) {
+			t.Errorf("%s: loaded %+v, want %+v", name, got, want)
+		}
+	}
+
+	// A link to a file that violates the schema reports the schema error
+	// of that file, exactly like the file itself.
+	bad := filepath.Join(dotfiles, "bad.toml")
+	if err := os.WriteFile(bad, []byte("schema_version = 2\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	_, wantErr := Load(bad)
+	_, gotErr := Load(symlink(bad, filepath.Join(config, "bad.toml")))
+	if wantErr == nil || gotErr == nil || !reflect.DeepEqual(gotErr, wantErr) {
+		t.Errorf("symlink to schema-invalid file: got %+v, want %+v", gotErr, wantErr)
+	}
+
+	// A link to an oversize regular file is INPUT_TOO_LARGE, like the file.
+	big := filepath.Join(dotfiles, "big.toml")
+	if err := os.WriteFile(big, make([]byte, MaxBytes+1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, e := Load(symlink(big, filepath.Join(config, "big.toml"))); e == nil || e.Code != result.InputTooLarge {
+		t.Errorf("symlink to oversize file: got %+v, want INPUT_TOO_LARGE", e)
+	}
+}
+
+// Links that cannot be resolved to a file are usage errors, promptly.
+func TestLoadUnresolvableSymlinks(t *testing.T) {
+	dir := t.TempDir()
+	dangling := filepath.Join(dir, "dangling.toml")
+	if err := os.Symlink(filepath.Join(dir, "missing.toml"), dangling); err != nil {
+		t.Fatal(err)
+	}
+	loopA, loopB := filepath.Join(dir, "a.toml"), filepath.Join(dir, "b.toml")
+	if err := os.Symlink(loopB, loopA); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(loopA, loopB); err != nil {
+		t.Fatal(err)
+	}
+	for name, path := range map[string]string{"dangling symlink": dangling, "symlink loop": loopA} {
+		start := time.Now()
+		if _, e := Load(path); e == nil || e.Code != result.UsageError {
+			t.Errorf("%s: got %+v, want USAGE_ERROR", name, e)
+		}
+		if el := time.Since(start); el > 2*time.Second {
+			t.Errorf("%s: took %v", name, el)
+		}
+	}
+}
+
+// The open-time check still holds after following links: if the link is
+// retargeted to a FIFO after the Stat check, the non-blocking open does not
+// wait and the fstat/SameFile check refuses it. The race window cannot be
+// hit deterministically from outside, so this exercises the same sequence
+// Load performs (Stat a regular target, then open the retargeted link).
+func TestLoadRetargetedSymlinkDoesNotBlock(t *testing.T) {
+	dir := t.TempDir()
+	reg := filepath.Join(dir, "ok.toml")
+	if err := os.WriteFile(reg, []byte("schema_version = 1\nname = \"x\"\nrevision = 1\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	fifo := filepath.Join(dir, "fifo")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(dir, "link.toml")
+	if err := os.Symlink(reg, link); err != nil {
+		t.Fatal(err)
+	}
+	st, err := os.Stat(link)
+	if err != nil || !st.Mode().IsRegular() {
+		t.Fatalf("stat: %v %v", st, err)
+	}
+	tmp := filepath.Join(dir, "link.tmp")
+	if err := os.Symlink(fifo, tmp); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Rename(tmp, link); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		f, err := openNoBlock(link)
+		if err != nil {
+			done <- err
+			return
+		}
+		defer f.Close()
+		fst, err := f.Stat()
+		if err != nil {
+			done <- err
+			return
+		}
+		if fst.Mode().IsRegular() || os.SameFile(st, fst) {
+			t.Errorf("retargeted link passed the open-time check: %v", fst.Mode())
+		}
+		done <- nil
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("open of a symlink retargeted to a FIFO blocked")
+	}
+	if _, e := Load(link); e == nil || e.Code != result.UsageError {
+		t.Fatalf("symlink now pointing to a FIFO: got %+v, want USAGE_ERROR", e)
+	}
+}
