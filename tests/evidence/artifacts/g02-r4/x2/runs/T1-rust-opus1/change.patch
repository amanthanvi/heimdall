+/// True if `pid` is in the stopped state ('T'): /proc on Linux, `ps` elsewhere.
+fn pid_stopped(pid: i32) -> bool {
+    if let Ok(stat) = std::fs::read_to_string(format!("/proc/{pid}/stat")) {
+        return stat
+            .rsplit_once(')')
+            .map(|(_, rest)| rest.trim_start().starts_with('T'))
+            .unwrap_or(false);
+    }
+    Command::new("/bin/ps")
+        .args(["-o", "stat=", "-p", &pid.to_string()])
+        .output()
+        .map(|o| o.stdout.trim_ascii_start().starts_with(b"T"))
+        .unwrap_or(false)
+}
