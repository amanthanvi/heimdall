+        x2_kill(pids)
+        sh.close()
+
+
+def t_x2_s4(shell):
+    @case(f"x2-s4-nested-shell-suspend-fg-{shell}")
+    def inner(b):
+        ctl, hp = x2_s4_once(b, shell, False), x2_s4_once(b, shell, True)
+        x2_check(f"[{shell}]", ctl, hp, [
+            ("the nested bash prompted and answered", lambda r: r["inner_prompt"] and r["inner_answers"]),
+            ("`suspend`: the outer shell prints a stop notice", lambda r: r["notice"]),
+            ("the outer shell answers after the stop", lambda r: r["outer_answers"]),
+            ("after `fg` the nested bash answers typed commands", lambda r: r["inner_answers_after_fg"]),
+            ("`exit 3` gives the outer shell $? = 3", lambda r: r["status"] == 3),
+            ("no job left", lambda r: r["jobs_after"] == "none"),
+            ("no launcher or nested shell left behind", lambda r: r["left_behind"] == []),
+        ])
+        return f"{shell}: suspend/fg/exit 3 as with plain exec"
+    return inner
+
