+def x2_s5_once(b, shell, trigger, via):
+    """S5: --meta-file; the child is stopped by SIGSTOP (by itself or by a third party)."""
+    d = x2_dir("s5")
+    sh = X2Shell(shell, d, b)
+    child = parent = None
+    meta = os.path.join(d, "meta.json")
+    try:
+        cmd = ('"$Y" "$C" selfstop "$D" SIGSTOP 0' if trigger == "self" else '"$Y" "$C" wait "$D" - 0')
+        if via:
+            cmd = '"$P" run --meta-file "$D/meta.json" -- ' + cmd
+        m = len(sh.out)
+        sh.line(cmd)
+        assert x2_wait_file(os.path.join(d, "pid"), 10, sh.pump), "child did not start"
+        child, parent = x2_pids(d)
+        if trigger == "third":
+            sh.pump(0.3)
+            os.kill(child, signal.SIGSTOP)
+            open(os.path.join(d, "go"), "w").close()
+        notice = sh.wait_since(m, sh.stopw, 4.0)
+        sh.pump(0.05)
+        r = {"notice": notice, "status": sh.value("ST") if notice else None}
+        sh.pump(1.0)
+        r["child_state"] = proc_state(child)
+        r["launcher_alive"] = (not via) or not x2_gone(parent)
+        r["stayed_stopped"] = r["child_state"].startswith("T") and not os.path.exists(os.path.join(d, "resumed"))
+        sh.line("fg")
+        sh.pump(0.5)
+        sh.line("X2-S5-TOKEN")
+        r["read_after_fg"] = (x2_wait_file(os.path.join(d, "got"), 3, sh.pump)
+                              and open(os.path.join(d, "got")).read() == "X2-S5-TOKEN")
+        sh.pump(0.3)
+        r["fg_status"] = sh.value("RC")
+        r["jobs_after"] = sh.jobs()
+        if via:
+            try:
+                r["meta"] = json.load(open(meta))
+            except (OSError, ValueError) as e:
+                r["meta"] = repr(e)
+        r["left_behind"] = [x for x in (child, parent if via else None) if x and not x2_gone(x)]
+        return r
+    finally:
+        x2_kill([child, parent if via else None])
+        sh.close()
+
+
+def t_x2_s5(shell):
+    @case(f"x2-s5-sigstop-meta-file-{shell}")
+    def inner(b):
+        got = []
+        for trigger in ("self", "third"):
+            ctl, hp = x2_s5_once(b, shell, trigger, False), x2_s5_once(b, shell, trigger, True)
+            x2_check(f"[{shell} {trigger}]", ctl, hp, [
+                ("stop notice", lambda r: r["notice"]),
+                ("$? is 128+SIGSTOP", lambda r: r["status"] == 128 + signal.SIGSTOP),
+                ("the child stays stopped and the launcher alive until `fg`",
+                 lambda r: r["stayed_stopped"] and r["launcher_alive"]),
+                ("after `fg` the child reads the typed line", lambda r: r["read_after_fg"]),
+                ("$? is 0", lambda r: r["fg_status"] == 0),
+                ("no job left", lambda r: r["jobs_after"] == "none"),
+                ("no launcher or child left behind", lambda r: r["left_behind"] == []),
+            ])
+            m = hp.get("meta")
+            assert isinstance(m, dict) and m.get("code") == "CHILD_EXITED" and m.get("data") == {
+                "launched": True, "exit_code": 0, "signal": None}, f"[{shell} {trigger}] meta file: {m}"
+            got.append(f"{trigger}: $?={hp['status']} then 0, meta CHILD_EXITED")
+        return f"{shell}: " + "; ".join(got)
+    return inner
+
