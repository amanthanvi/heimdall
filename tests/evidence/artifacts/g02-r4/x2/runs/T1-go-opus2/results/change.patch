@@ -0,0 +1,37 @@
+//go:build !windows
+
+package run
+
+import "syscall"
+
+// wstatus decodes a raw wait(2) status word the way the C macros of both
+// Linux and macOS do.
+//
+// syscall.WaitStatus (and x/sys/unix.WaitStatus) cannot be used for stops on
+// BSD-derived systems: there, Stopped() reports false and Continued() true for
+// a child stopped by SIGSTOP, because Go compares the stop signal with SIGSTOP
+// where <sys/wait.h> compares it with 0x13 (SIGCONT). heimdall-proto then took
+// a SIGSTOP stop for an exit, returned exit status 255 and left the child
+// stopped (contract §9.5, Go darwin finding).
+//
+// Layout (Linux and macOS alike): exited is 0x00 in the low 7 bits with the
+// exit code in bits 8-15; killed is the signal number in the low 7 bits
+// (0x80 = core dumped); stopped is 0x7f in the low 8 bits with the stop signal
+// in bits 8-15. A WCONTINUED report is 0xffff on Linux and 0x137f (SIGCONT
+// as the "stop" signal) on macOS; heimdall-proto never asks for it, but it is
+// never taken for a stop.
+type wstatus uint32
+
+func (w wstatus) exited() bool { return w&0x7f == 0 }
+
+func (w wstatus) exitCode() int { return int(w>>8) & 0xff }
+
+func (w wstatus) signaled() bool { return w&0x7f != 0 && w&0x7f != 0x7f }
+
+func (w wstatus) termSignal() syscall.Signal { return syscall.Signal(w & 0x7f) }
+
+func (w wstatus) stopped() bool {
+	return w&0xff == 0x7f && w.stopSignal() != syscall.SIGCONT
+}
+
+func (w wstatus) stopSignal() syscall.Signal { return syscall.Signal(w>>8) & 0xff }
