+++ /tmp/x2ws-c8f87a99/eval/frozen/go/cmd/heimdall-proto/procstate_linux_test.go	2026-10-09 00:03:02
@@ -0,0 +1,28 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"strconv"
+)
+
+// procState is the scheduler state of pid from /proc/<pid>/stat ("T"
+// stopped, "Z" zombie, ...), or "" if there is no such process.
+func procState(pid int) string {
+	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		return ""
+	}
+	i := bytes.LastIndexByte(b, ')')
+	if i < 0 {
+		return ""
+	}
+	f := bytes.Fields(b[i+1:])
+	if len(f) == 0 {
+		return ""
+	}
+	if f[0][0] == 't' {
+		return "T" // stopped by a tracer counts as stopped too
+	}
+	return string(f[0][:1])
+}
