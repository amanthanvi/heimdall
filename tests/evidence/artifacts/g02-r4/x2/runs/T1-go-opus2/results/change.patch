+//go:build darwin || linux
+
+package main
+
+// Exec-equivalent job control for `heimdall-proto run` (X2 task T1, S1-S5).
+// Every scenario runs twice in the same environment: once as plain exec of
+// the child (the control) and once through heimdall-proto. The control must
+// behave as described (otherwise the environment is unsuitable and the test
+// fails as such); heimdall-proto must then give the same observable result.
+// The child is this test binary (hp-jc-child); the shells are the system's
+// bash and zsh, run interactively on a fresh pty.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func init() {
+	helperChildren["hp-jc-child"] = jcChild
+	helperChildren["hp-jc-s1"] = jcS1Runner
+}
+
+// jcChild is the scenario child. HP_JC_MODE selects what it does; it exits
+// with HP_JC_RC. Progress is reported through files in dir.
+//
+//	run            heartbeat for 1.5 s, then exit
+//	selfstop-SIG   wait for dir/go, stop itself with kill(getpid(), SIG)
+//	               (OpenSSH's ~^Z), then read one line from stdin and exit
+//	read           read one line from stdin and exit
+func jcChild(dir string) {
+	put := func(name, text string) {
+		p := filepath.Join(dir, name)
+		_ = os.WriteFile(p+".part", []byte(text), 0o600)
+		_ = os.Rename(p+".part", p)
+	}
+	has := func(name string) bool { _, err := os.Stat(filepath.Join(dir, name)); return err == nil }
+	id, _ := json.Marshal(map[string]int{"pid": os.Getpid(), "ppid": os.Getppid(), "pgrp": unix.Getpgrp()})
+	put("child.json", string(id))
+	rc, _ := strconv.Atoi(os.Getenv("HP_JC_RC"))
+	mode := os.Getenv("HP_JC_MODE")
+	switch {
+	case mode == "run":
+		end := time.Now().Add(1500 * time.Millisecond)
+		for time.Now().Before(end) {
+			time.Sleep(20 * time.Millisecond)
+		}
+		put("done", "1")
+		os.Exit(rc)
+	case strings.HasPrefix(mode, "selfstop-") || mode == "read":
+		if mode != "read" {
+			for !has("go") {
+				time.Sleep(10 * time.Millisecond)
+			}
+			// kill(2) returns before a multithreaded process has stopped;
+			// our own SIGCONT marks the end of the stop.
+			cont := make(chan os.Signal, 1)
+			signal.Notify(cont, syscall.SIGCONT)
+			put("stopping", "1")
+			_ = unix.Kill(os.Getpid(), unix.SignalNum(strings.TrimPrefix(mode, "selfstop-")))
+			<-cont
+			signal.Stop(cont)
+			put("resumed", "1")
+		}
+		put("reading", "1")
+		line, _ := bufio.NewReader(os.Stdin).ReadString('\n')
+		put("got", line)
+		put("done", "1")
+		os.Exit(rc)
+	}
+	os.Exit(99)
+}
+
+type jcS1Result struct {
+	HasCtty     bool  `json:"has_ctty"`
+	Started     bool  `json:"started"`
+	RC          int   `json:"rc"`
+	TimedOut    bool  `json:"timed_out"`
+	AfterContMs int64 `json:"after_cont_ms"`
+	ChildDone   bool  `json:"child_done"`
+	ChildGone   bool  `json:"child_gone"`
+}
+
+// jcS1Runner is S1's non-interactive parent (not a shell). It starts the
+// command in a process group of its own, which is not orphaned (the runner
+// is in the same session), with stdin /dev/null and stdout/stderr files
+// (HP_JC_STDIO=files) or pipes (pipe). As the third party it then stops the
+// child with HP_JC_SIG, waits 0.5 s and continues the child's PID only.
+func jcS1Runner(dir string) {
+	res := jcS1Result{RC: -1}
+	if fd, err := unix.Open("/dev/tty", unix.O_RDONLY|unix.O_NOCTTY, 0); err == nil {
+		res.HasCtty = true
+		unix.Close(fd)
+	}
+	write := func() {
+		b, _ := json.Marshal(res)
+		_ = os.WriteFile(filepath.Join(dir, "s1.json"), b, 0o600)
+		os.Exit(0)
+	}
+	self, _ := os.Executable()
+	job := filepath.Join(dir, "job")
+	_ = os.Mkdir(job, 0o700)
+	argv := []string{self, "hp-jc-child", job}
+	if os.Getenv("HP_JC_VIA") == "proto" {
+		argv = append([]string{self, "run", "--"}, argv...)
+	}
+	cmd := exec.Command(argv[0], argv[1:]...)
+	cmd.Env = append(os.Environ(), "HP_AS_MAIN=1", "HP_JC_MODE=run", "HP_JC_RC=5")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	var keep []*os.File
+	if os.Getenv("HP_JC_STDIO") == "pipe" {
+		for i := 0; i < 3; i++ {
+			r, w, err := os.Pipe()
+			if err != nil {
+				write()
+			}
+			if i == 0 {
+				cmd.Stdin = r
+				keep = append(keep, w)
+			} else {
+				keep = append(keep, r)
+				if i == 1 {
+					cmd.Stdout = w
+				} else {
+					cmd.Stderr = w
+				}
+			}
+		}
+	} else {
+		out, err := os.Create(filepath.Join(dir, "out"))
+		if err != nil {
+			write()
+		}
+		cmd.Stdout, cmd.Stderr = out, out
+	}
+	if err := cmd.Start(); err != nil {
+		write()
+	}
+	res.Started = true
+	waited := make(chan struct{})
+	go func() { _ = cmd.Wait(); close(waited) }()
+	child := 0
+	if waitFile(filepath.Join(job, "child.json"), 10*time.Second) {
+		var id struct{ Pid int }
+		_ = json.Unmarshal(must(os.ReadFile(filepath.Join(job, "child.json"))), &id)
+		child = id.Pid
+	}
+	if child <= 0 {
+		_ = cmd.Process.Kill()
+		<-waited
+		write()
+	}
+	time.Sleep(200 * time.Millisecond)
+	_ = unix.Kill(child, unix.SignalNum(os.Getenv("HP_JC_SIG")))
+	time.Sleep(500 * time.Millisecond)
+	_ = unix.Kill(child, unix.SIGCONT)
+	t0 := time.Now()
+	select {
+	case <-waited:
+		res.AfterContMs = time.Since(t0).Milliseconds()
+		res.RC = cmd.ProcessState.ExitCode()
+	case <-time.After(8 * time.Second):
+		res.TimedOut = true
+		// Release exactly what this runner started: the child and the
+		// launcher (continued first, so a stopped one can die).
+		for _, p := range []int{child, cmd.Process.Pid} {
+			_ = unix.Kill(p, unix.SIGCONT)
+			_ = unix.Kill(p, unix.SIGKILL)
+		}
+		<-waited
+	}
+	_, err := os.Stat(filepath.Join(job, "done"))
+	res.ChildDone = err == nil
+	res.ChildGone = unix.Kill(child, 0) == unix.ESRCH
+	for _, f := range keep {
+		f.Close()
+	}
+	write()
+}
+
+// S1: a non-interactive parent; a third party stops the child and then
+// continues the child's PID only. Like plain exec, the command completes, the
+// launcher exits with its status within 6 s of the SIGCONT and the child is
+// reaped. Run without a controlling terminal and with one (the runner is the
+// session leader of a pty, so heimdall-proto sees a terminal whose
+// foreground it does not hold); the second form hung before the change.
+func TestJobControlS1ThirdPartyStopNonInteractive(t *testing.T) {
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, ctty := range []bool{false, true} {
+		for _, stdio := range []string{"files", "pipe"} {
+			for _, sig := range []string{"SIGSTOP", "SIGTSTP"} {
+				for _, via := range []string{"plain", "proto"} {
+					name := fmt.Sprintf("ctty=%v/%s/%s/%s", ctty, stdio, sig, via)
+					t.Run(name, func(t *testing.T) {
+						d := t.TempDir()
+						cmd := exec.Command(self, "hp-jc-s1", d)
+						cmd.Env = []string{"PATH=/usr/bin:/bin", "HP_JC_SIG=" + sig, "HP_JC_VIA=" + via, "HP_JC_STDIO=" + stdio}
+						var r *ptyRun
+						if ctty {
+							r = startPTY(t)
+							defer r.master.Close()
+							defer r.slave.Close()
+							cmd.Stdin, cmd.Stdout, cmd.Stderr = r.slave, r.slave, r.slave
+							cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+						} else {
+							cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+						}
+						if err := cmd.Start(); err != nil {
+							t.Fatal(err)
+						}
+						done := make(chan struct{})
+						go func() { _ = cmd.Wait(); close(done) }()
+						select {
+						case <-done:
+						case <-time.After(30 * time.Second):
+							_ = cmd.Process.Kill() // the runner this test started
+							<-done
+						}
+						var res jcS1Result
+						if err := json.Unmarshal(must(os.ReadFile(filepath.Join(d, "s1.json"))), &res); err != nil {
+							t.Fatalf("no runner result: %v", err)
+						}
+						t.Logf("%+v", res)
+						if res.HasCtty != ctty {
+							t.Fatalf("precondition: runner has_ctty=%v, want %v", res.HasCtty, ctty)
+						}
+						if res.TimedOut || res.RC != 5 || !res.ChildDone || res.AfterContMs > 6000 {
+							t.Errorf("want exit 5 with the child completed within 6 s of SIGCONT, got %+v", res)
+						}
+						if via == "proto" && !res.ChildGone {
+							t.Errorf("child not reaped after heimdall-proto exited")
+						}
+					})
+				}
+			}
+		}
+	}
+}
+
+// --- interactive shell driver -------------------------------------------
+
+const jcPrompt = "HMJC$ "
+
+var (
+	jcCSI   = regexp.MustCompile(`\x1b(\[[0-9;?<=>]*[ -/]*[@-~]|[()][0-9A-Za-z]|[=>78])`)
+	jcRCre  = regexp.MustCompile(`RC=(\d+)`)
+	jcJobRe = regexp.MustCompile(`NJOBS=\s*(\d+)`)
+)
+
+type jcShell struct {
+	t        *testing.T
+	name     string
+	r        *ptyRun
+	cmd      *exec.Cmd
+	exited   chan struct{}
+	stopWord string
+	jobsExpr string
+	pids     []int // processes of the job, released on cleanup
+}
+
+var jcShells = map[string]struct {
+	argv           []string
+	stopWord, jobs string
+}{
+	"bash": {[]string{"/bin/bash", "--norc", "--noprofile", "-i"}, "Stopped", "$(jobs -p | wc -l)"},
+	"zsh":  {[]string{"/bin/zsh", "-f", "-i"}, "suspended", "${#jobstates}"},
+}
+
+func startShell(t *testing.T, name, dir string) *jcShell {
+	t.Helper()
+	sh := jcShells[name]
+	if _, err := os.Stat(sh.argv[0]); err != nil {
+		t.Skipf("%s not available: %v", sh.argv[0], err)
+	}
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &jcShell{t: t, name: name, r: startPTY(t), exited: make(chan struct{}), stopWord: sh.stopWord, jobsExpr: sh.jobs}
+	s.cmd = exec.Command(sh.argv[0], sh.argv[1:]...)
+	s.cmd.Dir = dir
+	s.cmd.Env = []string{"PATH=/usr/bin:/bin", "HOME=" + dir, "TERM=xterm-256color", "LANG=en_US.UTF-8",
+		"PS1=" + jcPrompt, "HISTFILE=" + filepath.Join(dir, ".hist"), "BASH_SILENCE_DEPRECATION_WARNING=1",
+		"HP_AS_MAIN=1", "P=" + self, "D=" + dir}
+	s.cmd.Stdin, s.cmd.Stdout, s.cmd.Stderr = s.r.slave, s.r.slave, s.r.slave
+	s.cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+	if err := s.cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	go func() { _ = s.cmd.Wait(); close(s.exited) }()
+	t.Cleanup(s.close)
+	if !s.waitFor(0, 10*time.Second, func(out string) bool { return strings.Contains(out, jcPrompt) }) {
+		t.Fatalf("%s printed no prompt: %q", name, s.tail(0))
+	}
+	time.Sleep(time.Second) // zsh drops typeahead sent right after its first prompt
+	return s
+}
+
+func (s *jcShell) close() {
+	for _, p := range s.pids { // exact PIDs of this session's job, identity-checked
+		if p > 1 && p != s.cmd.Process.Pid {
+			if sid, err := unix.Getsid(p); err == nil && sid == s.cmd.Process.Pid {
+				_ = unix.Kill(p, unix.SIGCONT)
+				_ = unix.Kill(p, unix.SIGKILL)
+			}
+		}
+	}
+	select {
+	case <-s.exited:
+	default:
+		_ = s.cmd.Process.Kill() // the shell this test started
+		<-s.exited
+	}
+	s.r.master.Close()
+	s.r.slave.Close()
+}
+
+func (s *jcShell) mark() int { return len(s.r.output()) }
+
+func (s *jcShell) since(m int) string {
+	out := s.r.output()
+	if m > len(out) {
+		m = len(out)
+	}
+	return jcCSI.ReplaceAllString(string(out[m:]), "")
+}
+
+func (s *jcShell) tail(m int) string {
+	out := s.since(m)
+	if len(out) > 400 {
+		out = out[len(out)-400:]
+	}
+	return out
+}
+
+func (s *jcShell) waitFor(m int, d time.Duration, pred func(string) bool) bool {
+	end := time.Now().Add(d)
+	for {
+		if pred(s.since(m)) {
+			return true
+		}
+		if time.Now().After(end) {
+			return false
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+func (s *jcShell) send(text string) { _, _ = s.r.master.Write([]byte(text + "\r")) }
+
+func promptAtEnd(out string) bool {
+	return strings.HasSuffix(strings.TrimRight(out, " \r\n"), strings.TrimRight(jcPrompt, " "))
+}
+
+// run types a command line and waits for the next prompt.
+func (s *jcShell) run(line string) string {
+	m := s.mark()
+	s.send(line)
+	s.waitFor(m+len(line), 5*time.Second, promptAtEnd)
+	time.Sleep(250 * time.Millisecond)
+	return s.since(m + len(line))
+}
+
+// rc returns $? at the shell's prompt.
+func (s *jcShell) rc() int {
+	mm := jcRCre.FindStringSubmatch(s.run(`echo "RC=$?"`))
+	if mm == nil {
+		return -1
+	}
+	n, _ := strconv.Atoi(mm[1])
+	return n
+}
+
+// jobs returns the number of jobs the shell lists and its `jobs` output.
+func (s *jcShell) jobs() (int, string) {
+	out := s.run(`jobs; echo "NJOBS=` + s.jobsExpr + `"`)
+	mm := jcJobRe.FindStringSubmatch(out)
+	if mm == nil {
+		return -1, out
+	}
+	n, _ := strconv.Atoi(mm[1])
+	return n, out
+}
+
+// waitNotice waits for the shell's stop notice followed by its prompt and
+// returns the notice word with its optional "(signal)" suffix.
+func (s *jcShell) waitNotice(m int, d time.Duration) (string, bool) {
+	ok := s.waitFor(m, d, func(out string) bool {
+		i := strings.Index(out, s.stopWord)
+		return i >= 0 && strings.Contains(out[i:], jcPrompt)
+	})
+	if !ok {
+		return "", false
+	}
+	time.Sleep(250 * time.Millisecond)
+	out := s.since(m)
+	i := strings.Index(out, s.stopWord)
+	word := s.stopWord
+	if rest := strings.TrimLeft(out[i+len(word):], " "); strings.HasPrefix(rest, "(") {
+		if j := strings.Index(rest, ")"); j > 0 && j < 24 {
+			word += " " + rest[:j+1]
+		}
+	}
+	return word, true
+}
+
+// jcJob starts one job of the scenario child in the shell and returns its
+// directory, the child's PID and the launcher's PID (the child itself for
+// plain exec).
+func (s *jcShell) jcJob(dir, via, tag, mode string, rc int, meta string) (string, int, int) {
+	s.t.Helper()
+	job := filepath.Join(dir, tag)
+	if err := os.Mkdir(job, 0o700); err != nil {
+		s.t.Fatal(err)
+	}
+	line := fmt.Sprintf(`HP_JC_MODE=%s HP_JC_RC=%d `, mode, rc)
+	if via == "proto" {
+		line += `"$P" run `
+		if meta != "" {
+			line += `--meta-file "` + meta + `" `
+		}
+		line += "-- "
+	}
+	line += `"$P" hp-jc-child "$D/` + tag + `"`
+	s.send(line)
+	if !waitFile(filepath.Join(job, "child.json"), 10*time.Second) {
+		s.t.Fatalf("[%s %s] child did not start: %q", s.name, via, s.tail(0))
+	}
+	var id struct{ Pid, Ppid int }
+	_ = json.Unmarshal(must(os.ReadFile(filepath.Join(job, "child.json"))), &id)
+	launcher := id.Pid
+	if via == "proto" {
+		launcher = id.Ppid
+	}
+	s.pids = append(s.pids, id.Pid, launcher)
+	return job, id.Pid, launcher
+}
+
+func jcSignum(name string) int { return int(unix.SignalNum(name)) }
+
+func forShellsAndVias(t *testing.T, f func(t *testing.T, shell, via string)) {
+	if testing.Short() {
+		t.Skip("interactive-shell scenarios skipped in -short mode")
+	}
+	for _, shell := range []string{"bash", "zsh"} {
+		for _, via := range []string{"plain", "proto"} {
+			t.Run(shell+"/"+via, func(t *testing.T) { f(t, shell, via) })
+		}
+	}
+}
+
+// expect fails the test; for the plain-exec control, a failure means the
+// environment does not behave as the scenario assumes.
+func expect(t *testing.T, via string, ok bool, format string, args ...any) {
+	t.Helper()
+	if ok {
+		return
+	}
+	msg := fmt.Sprintf(format, args...)
+	if via == "plain" {
+		t.Fatalf("precondition (plain exec control): %s", msg)
+	}
+	t.Errorf("%s", msg)
+}
+
+// S2: the foreground child is stopped by a third party (SIGSTOP or SIGTSTP),
+// then continued by the third party after 0.5 s. The shell reports the stop
+// with 128+N of the child's stop signal; the child completes. Then either the
+// job is gone, or (permitted deviation) it is listed as stopped until `fg`,
+// which ends it with the child's status. Nothing is left behind.
+func TestJobControlS2ThirdPartyStopInteractive(t *testing.T) {
+	forShellsAndVias(t, func(t *testing.T, shell, via string) {
+		for _, sig := range []string{"SIGSTOP", "SIGTSTP"} {
+			d := t.TempDir()
+			s := startShell(t, shell, d)
+			job, child, launcher := s.jcJob(d, via, "t", "run", 7, "")
+			time.Sleep(300 * time.Millisecond)
+			m := s.mark()
+			_ = unix.Kill(child, unix.SignalNum(sig))
+			t0 := time.Now()
+			word, ok := s.waitNotice(m, 500*time.Millisecond)
+			time.Sleep(time.Until(t0.Add(500 * time.Millisecond)))
+			_ = unix.Kill(child, unix.SIGCONT)
+			if !ok {
+				word, ok = s.waitNotice(m, 3*time.Second)
+			}
+			expect(t, via, ok, "[%s] no stop notice: %q", sig, s.tail(m))
+			rc := s.rc()
+			expect(t, via, rc == 128+jcSignum(sig), "[%s] $? of the stopped job = %d, want %d", sig, rc, 128+jcSignum(sig))
+			expect(t, via, waitFile(filepath.Join(job, "done"), 6*time.Second), "[%s] child did not run to completion", sig)
+			time.Sleep(500 * time.Millisecond)
+			n, out := s.jobs()
+			if n != 0 {
+				expect(t, via, via == "proto" && strings.Contains(out, s.stopWord),
+					"[%s] job left after the child completed and not listed as stopped: %q", sig, out)
+				s.run("fg")
+				frc := s.rc()
+				expect(t, via, frc == 7, "[%s] `fg` ended the job with %d, want the child's 7", sig, frc)
+				n, out = s.jobs()
+				expect(t, via, n == 0, "[%s] jobs left after `fg`: %q", sig, out)
+			}
+			time.Sleep(200 * time.Millisecond)
+			expect(t, via, procState(child) == "" && procState(launcher) == "",
+				"[%s] process left: child %q launcher %q", sig, procState(child), procState(launcher))
+			t.Logf("[%s %s %s] notice %q", shell, via, sig, word)
+			s.close()
+		}
+	})
+}
+
+// S3: the child stops itself with SIGTSTP; then a third party continues the
+// launcher's PID only (the child's, for plain exec). The child resumes, reads
+// the terminal from the background and is stopped by SIGTTIN; the shell
+// lists the job as stopped, never as running while the child is stopped.
+// `fg` gives the child the terminal; it reads the typed line and its status
+// becomes $?.
+func TestJobControlS3SelfStopThenLauncherContinued(t *testing.T) {
+	forShellsAndVias(t, func(t *testing.T, shell, via string) {
+		d := t.TempDir()
+		s := startShell(t, shell, d)
+		job, child, launcher := s.jcJob(d, via, "t", "selfstop-SIGTSTP", 6, "")
+		time.Sleep(200 * time.Millisecond)
+		m := s.mark()
+		_ = os.WriteFile(filepath.Join(job, "go"), nil, 0o600)
+		_, ok := s.waitNotice(m, 4*time.Second)
+		expect(t, via, ok, "no stop notice after the child's self-stop: %q", s.tail(m))
+		_ = unix.Kill(launcher, unix.SIGCONT)
+		expect(t, via, waitFile(filepath.Join(job, "resumed"), 3*time.Second), "the child did not resume")
+		var last string
+		for i := 0; i < 5; i++ {
+			time.Sleep(150 * time.Millisecond)
+			st := procState(child)
+			_, out := s.jobs()
+			last = out
+			expect(t, via, !(st == "T" && strings.Contains(strings.ToLower(out), "running")),
+				"the shell lists the job as running while the child is stopped: %q", out)
+		}
+		expect(t, via, procState(child) == "T" && strings.Contains(last, s.stopWord),
+			"after reading from the background the child should be stopped (%q) and the job listed as stopped: %q",
+			procState(child), last)
+		m = s.mark()
+		s.send("fg")
+		time.Sleep(400 * time.Millisecond)
+		s.send("S3LINE")
+		expect(t, via, waitFile(filepath.Join(job, "got"), 3*time.Second), "the child did not read after `fg`: %q", s.tail(m))
+		expect(t, via, string(must(os.ReadFile(filepath.Join(job, "got")))) == "S3LINE\n", "the child read the wrong line")
+		s.waitFor(m, 5*time.Second, promptAtEnd)
+		time.Sleep(250 * time.Millisecond)
+		rc := s.rc()
+		expect(t, via, rc == 6, "$? after the job ended = %d, want 6", rc)
+		n, out := s.jobs()
+		expect(t, via, n == 0, "jobs left: %q", out)
+	})
+}
+
+// S4: an interactive bash run through heimdall-proto suspends itself
+// (`suspend`, SIGSTOP to its own group). The outer shell reports the stop and
+// keeps running; `fg` gives the nested shell the terminal again; `exit 3`
+// becomes the outer $?.
+func TestJobControlS4NestedShellSuspend(t *testing.T) {
+	if _, err := os.Stat("/bin/bash"); err != nil {
+		t.Skip("/bin/bash not available")
+	}
+	forShellsAndVias(t, func(t *testing.T, shell, via string) {
+		d := t.TempDir()
+		s := startShell(t, shell, d)
+		line := `PS1='NEST$ ' `
+		if via == "proto" {
+			line += `"$P" run -- `
+		}
+		line += "/bin/bash --norc --noprofile -i"
+		m := s.mark()
+		s.send(line)
+		expect(t, via, s.waitFor(m+len(line), 8*time.Second, func(o string) bool { return strings.Contains(o, "NEST$ ") }),
+			"nested shell printed no prompt: %q", s.tail(m))
+		time.Sleep(300 * time.Millisecond)
+		m = s.mark()
+		s.send("suspend")
+		word, ok := s.waitNotice(m, 5*time.Second)
+		expect(t, via, ok, "no stop notice from the outer shell after `suspend`: %q", s.tail(m))
+		rc := s.rc()
+		expect(t, via, rc == 128+jcSignum("SIGSTOP"), "outer $? after `suspend` = %d, want %d", rc, 128+jcSignum("SIGSTOP"))
+		m = s.mark()
+		s.send("fg")
+		time.Sleep(500 * time.Millisecond)
+		s.send("echo NEST_$((40+2))")
+		expect(t, via, s.waitFor(m, 4*time.Second, func(o string) bool { return strings.Contains(o, "NEST_42") }),
+			"the nested shell does not answer after `fg`: %q", s.tail(m))
+		time.Sleep(200 * time.Millisecond)
+		m = s.mark()
+		s.send("exit 3")
+		s.waitFor(m+6, 5*time.Second, promptAtEnd)
+		time.Sleep(250 * time.Millisecond)
+		rc = s.rc()
+		expect(t, via, rc == 3, "outer $? after `exit 3` = %d", rc)
+		n, out := s.jobs()
+		expect(t, via, n == 0, "jobs left: %q", out)
+		select {
+		case <-s.exited:
+			expect(t, via, false, "the outer shell exited")
+		default:
+		}
+		t.Logf("[%s %s] notice %q", shell, via, word)
+	})
+}
