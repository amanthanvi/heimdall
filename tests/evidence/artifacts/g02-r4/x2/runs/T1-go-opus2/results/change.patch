+//go:build !windows
+
+package run
+
+import (
+	"os"
+	"os/exec"
+	"strconv"
+	"syscall"
+	"testing"
+)
+
+// Synthetic status words, laid out as in <sys/wait.h> on Linux and macOS.
+func TestWStatusDecode(t *testing.T) {
+	for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP, syscall.SIGTTIN, syscall.SIGTTOU} {
+		w := wstatus(uint32(sig)<<8 | 0x7f)
+		if !w.stopped() || w.stopSignal() != sig || w.exited() || w.signaled() {
+			t.Errorf("stop by %v (%#x): stopped=%v sig=%v exited=%v signaled=%v", sig, uint32(w), w.stopped(), w.stopSignal(), w.exited(), w.signaled())
+		}
+	}
+	for _, code := range []int{0, 1, 42, 255} {
+		w := wstatus(uint32(code) << 8)
+		if !w.exited() || w.exitCode() != code || w.stopped() || w.signaled() {
+			t.Errorf("exit %d (%#x) misdecoded", code, uint32(w))
+		}
+	}
+	for _, sig := range []syscall.Signal{syscall.SIGKILL, syscall.SIGTERM, syscall.SIGSEGV} {
+		for _, core := range []uint32{0, 0x80} {
+			w := wstatus(uint32(sig) | core)
+			if !w.signaled() || w.termSignal() != sig || w.stopped() || w.exited() {
+				t.Errorf("death by %v core=%#x misdecoded", sig, core)
+			}
+		}
+	}
+	// WCONTINUED reports (never requested) are not stops: 0xffff on Linux,
+	// SIGCONT in the stop-signal byte on macOS.
+	for _, w := range []wstatus{0xffff, wstatus(uint32(syscall.SIGCONT)<<8 | 0x7f)} {
+		if w.stopped() || w.exited() || w.signaled() {
+			t.Errorf("continue report %#x taken for stop/exit/death", uint32(w))
+		}
+	}
+}
+
+// A real child stopped by each stop signal is decoded as stopped with that
+// signal; syscall.WaitStatus on macOS decodes the SIGSTOP stop as a continue,
+// which made heimdall-proto exit 255 and leave the child stopped.
+func TestWStatusNativeStops(t *testing.T) {
+	for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+		cmd := exec.Command(self(t))
+		cmd.Env = append(os.Environ(), "HP_HELPER=selfstop", "HP_SIG="+strconv.Itoa(int(sig)))
+		// Own process group, not orphaned: SIGTSTP is not discarded.
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		pid := cmd.Process.Pid
+		var ws syscall.WaitStatus
+		if _, err := syscall.Wait4(pid, &ws, syscall.WUNTRACED, nil); err != nil {
+			t.Fatal(err)
+		}
+		w := wstatus(ws)
+		if !w.stopped() || w.stopSignal() != sig {
+			t.Errorf("%v: raw %#x decoded stopped=%v sig=%v", sig, uint32(ws), w.stopped(), w.stopSignal())
+		}
+		_ = syscall.Kill(pid, syscall.SIGCONT)
+		if _, err := syscall.Wait4(pid, &ws, 0, nil); err != nil {
+			t.Fatal(err)
+		}
+		if w := wstatus(ws); !w.exited() || w.exitCode() != 4 {
+			t.Errorf("%v: after SIGCONT raw %#x, want exit 4", sig, uint32(ws))
+		}
+	}
+}
+
+func TestShouldMirror(t *testing.T) {
+	const own, child, other = 100, 200, 300
+	cases := []struct {
+		fg   int
+		sig  syscall.Signal
+		want bool
+	}{
+		// The job holds the terminal: every stop is the shell's to see.
+		{child, syscall.SIGTSTP, true},
+		{child, syscall.SIGSTOP, true},
+		{own, syscall.SIGSTOP, true},
+		// Background terminal access: the shell lists the job as stopped.
+		{other, syscall.SIGTTIN, true},
+		{other, syscall.SIGTTOU, true},
+		// A third party's stop outside the foreground (S1): left alone.
+		{other, syscall.SIGSTOP, false},
+		{other, syscall.SIGTSTP, false},
+		{-1, syscall.SIGTSTP, false},
+	}
+	for _, c := range cases {
+		if got := shouldMirror(c.fg, own, child, c.sig); got != c.want {
+			t.Errorf("fg=%d sig=%v: %v, want %v", c.fg, c.sig, got, c.want)
+		}
+	}
+}
