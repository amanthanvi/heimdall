+// S5: with --meta-file, the child is stopped by SIGSTOP, from itself or
+// from a third party. The shell reports it with 128+SIGSTOP; the child stays
+// stopped and heimdall-proto alive until `fg`; then the child reads the
+// terminal, exits 0, $? is 0 and the meta file says CHILD_EXITED, exit 0.
+func TestJobControlS5SigstopWithMetaFile(t *testing.T) {
+	forShellsAndVias(t, func(t *testing.T, shell, via string) {
+		for _, trig := range []string{"self", "third-party"} {
+			d := t.TempDir()
+			s := startShell(t, shell, d)
+			meta := filepath.Join(d, "meta.json")
+			mode := "read"
+			if trig == "self" {
+				mode = "selfstop-SIGSTOP"
+			}
+			job, child, launcher := s.jcJob(d, via, "t", mode, 0, meta)
+			time.Sleep(300 * time.Millisecond)
+			m := s.mark()
+			if trig == "self" {
+				_ = os.WriteFile(filepath.Join(job, "go"), nil, 0o600)
+			} else {
+				waitFile(filepath.Join(job, "reading"), 3*time.Second)
+				time.Sleep(100 * time.Millisecond)
+				_ = unix.Kill(child, unix.SIGSTOP)
+			}
+			_, ok := s.waitNotice(m, 4*time.Second)
+			expect(t, via, ok, "[%s] no stop notice: %q", trig, s.tail(m))
+			rc := s.rc()
+			expect(t, via, rc == 128+jcSignum("SIGSTOP"), "[%s] $? of the stopped job = %d, want %d", trig, rc, 128+jcSignum("SIGSTOP"))
+			time.Sleep(time.Second)
+			cs, ls := procState(child), procState(launcher)
+			expect(t, via, cs == "T" && ls != "" && ls != "Z", "[%s] while stopped: child %q (want T), launcher %q (want alive)", trig, cs, ls)
+			_, err := os.Stat(filepath.Join(job, "resumed"))
+			expect(t, via, err != nil, "[%s] the child resumed before `fg`", trig)
+			m = s.mark()
+			s.send("fg")
+			time.Sleep(400 * time.Millisecond)
+			s.send("S5LINE")
+			expect(t, via, waitFile(filepath.Join(job, "got"), 3*time.Second), "[%s] the child did not read after `fg`: %q", trig, s.tail(m))
+			s.waitFor(m, 5*time.Second, promptAtEnd)
+			time.Sleep(250 * time.Millisecond)
+			rc = s.rc()
+			expect(t, via, rc == 0, "[%s] $? after the job ended = %d, want 0", trig, rc)
+			if via == "proto" {
+				var doc struct {
+					Code string          `json:"code"`
+					Data json.RawMessage `json:"data"`
+				}
+				_ = json.Unmarshal(must(os.ReadFile(meta)), &doc)
+				var data map[string]any
+				_ = json.Unmarshal(doc.Data, &data)
+				want := map[string]any{"launched": true, "exit_code": float64(0), "signal": nil}
+				if doc.Code != "CHILD_EXITED" || fmt.Sprint(data) != fmt.Sprint(want) {
+					t.Errorf("[%s] meta file: code %q data %v, want CHILD_EXITED %v", trig, doc.Code, data, want)
+				}
+			}
+			s.close()
+		}
+	})
+}
