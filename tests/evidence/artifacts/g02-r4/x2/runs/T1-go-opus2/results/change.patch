@@ -0,0 +1,19 @@
+package main
+
+import "golang.org/x/sys/unix"
+
+// procState is the scheduler state of pid: "T" stopped, "Z" zombie, "S"
+// otherwise, "" if there is no such process (sysctl kern.proc.pid).
+func procState(pid int) string {
+	kp, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
+	if err != nil || int(kp.Proc.P_pid) != pid {
+		return ""
+	}
+	switch kp.Proc.P_stat {
+	case 4: // SSTOP
+		return "T"
+	case 5: // SZOMB
+		return "Z"
+	}
+	return "S"
+}
