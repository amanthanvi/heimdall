+// ---------- profile lint (TASK T2) ----------
+
+/// A schema-valid profile whose values are all distinctive markers, so a leak of any
+/// of them on stdout or stderr is detectable. Destination order puts later-rule
+/// triggers first in the file. Returns (TOML text, values that must never be printed).
+fn lint_profile() -> (String, Vec<&'static str>) {
+    let text = r#"schema_version = 1
+name = "LVNAME-prøfile"
+revision = 7
+
+[meta]
+note = "LVMETA-note"
+nested = { k = "LVMETA-nested" }
+
+[[destinations]]
+id = "dst_zero"
+alias = "LVALIAS-zero"
+host = "LVHOST-one.example"
+account = "LVACCT-zero"
+labels = ["LVLAB-dup", "LVLAB-dup", "LVLAB-DUP", "LVLAB-solo"]
+
+[[destinations]]
+id = "dst_one_ü"
+alias = "LVALIAS-東京"
+host = "lvhost-ONE.example"
+port = 22
+account = "root"
+labels = ["LVLAB-solo"]
+
+[[destinations]]
+id = "dst_two"
+alias = "LVALIAS-two"
+host = "LVHOST-two.example"
+port = 80
+account = "Root"
+labels = ["LVLAB-Mixed"]
+
+[[destinations]]
+id = "dst_three"
+alias = "LVALIAS-three"
+host = "LVHOST-two.example"
+port = 8080
+account = "LVACCT-three"
+labels = ["lvlab-mixed", "LVLAB-mixed"]
+"#;
+    let values = vec![
+        "LVNAME", "LVMETA", "LVALIAS", "LVHOST", "lvhost", "LVACCT", "LVLAB", "lvlab", "Root",
+    ];
+    (text.to_string(), values)
+}
+
+fn lint_expected() -> Value {
+    let f = |rule: &str, paths: &[&str], ids: &[&str], msg: &str| serde_json::json!({"rule": rule, "key_paths": paths, "destination_ids": ids, "message": msg});
+    serde_json::json!({"findings": [
+        f("duplicate-endpoint", &["destinations[0].host", "destinations[1].host"],
+          &["dst_zero", "dst_one_ü"], "destinations share the same host and port"),
+        f("privileged-port", &["destinations[2].port"], &["dst_two"], "port below 1024 other than 22"),
+        f("root-account", &["destinations[1].account"], &["dst_one_ü"], "account is root"),
+        f("duplicate-label", &["destinations[0].labels[0]", "destinations[0].labels[1]"],
+          &["dst_zero"], "label repeated within a destination"),
+        f("label-case-variant",
+          &["destinations[0].labels[0]", "destinations[0].labels[1]", "destinations[0].labels[2]"],
+          &["dst_zero"], "labels differ only in letter case"),
+        f("label-case-variant",
+          &["destinations[2].labels[0]", "destinations[3].labels[0]", "destinations[3].labels[1]"],
+          &["dst_two", "dst_three"], "labels differ only in letter case"),
+    ]})
+}
+
+fn lint_cmd(path: &Path, json_first: Option<bool>, cwd: &Path) -> Output {
+    let mut c = cmd();
+    c.current_dir(cwd).args(["profile", "lint"]);
+    match json_first {
+        Some(true) => c.arg("--json").arg("--file").arg(path),
+        Some(false) => c.arg("--file").arg(path).arg("--json"),
+        None => c.arg("--file").arg(path),
+    };
+    c.stdin(Stdio::null()).output().unwrap()
+}
+
+fn assert_no_values(o: &Output, values: &[&str], what: &str) {
+    for (name, stream) in [("stdout", &o.stdout), ("stderr", &o.stderr)] {
+        let s = String::from_utf8_lossy(stream);
+        for v in values {
+            assert!(!s.contains(v), "{what}: profile value {v:?} on {name}");
+        }
+    }
+}
+
+/// Every file under `dir`, recursively (used to prove lint writes nothing).
+fn tree(dir: &Path) -> Vec<(PathBuf, u64)> {
+    let mut out = Vec::new();
+    for e in std::fs::read_dir(dir).unwrap() {
+        let e = e.unwrap();
+        let m = std::fs::symlink_metadata(e.path()).unwrap();
+        if m.is_dir() {
+            out.extend(tree(&e.path()));
+        }
+        out.push((e.path(), m.len()));
+    }
+    out.sort();
+    out
+}
+
+#[test]
+fn lint_findings_exact_json_both_orders_spaced_path_no_values_no_writes() {
+    let d = TempDir::new("lint");
+    let sub = d.path().join("spaced dir ü 東京");
+    std::fs::create_dir(&sub).unwrap();
+    let p = sub.join("prøfile lint.toml");
+    let (text, values) = lint_profile();
+    std::fs::write(&p, &text).unwrap();
+    let before = tree(d.path());
+    for json_first in [Some(true), Some(false)] {
+        let o = lint_cmd(&p, json_first, &sub);
+        assert_eq!(o.status.code(), Some(3), "{json_first:?}");
+        let v = one_json(&o);
+        assert_eq!(v["state"], "succeeded");
+        assert_eq!(v["code"], "LINT_FINDINGS");
+        assert_eq!(v["warnings"], serde_json::json!([]));
+        assert_eq!(v["next"], Value::Null);
+        assert_eq!(v["data"], lint_expected());
+        assert!(o.stderr.is_empty(), "no stderr on success");
+        assert_no_values(&o, &values, "lint --json");
+    }
+    let o = lint_cmd(&p, None, &sub);
+    assert_eq!(o.status.code(), Some(3), "same exit without --json");
+    assert_no_values(&o, &values, "lint plain");
+    assert_eq!(tree(d.path()), before, "lint wrote nothing");
+    assert_eq!(std::fs::read_to_string(&p).unwrap(), text);
+}
