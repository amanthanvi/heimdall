+            ),
+            ("id-two", "secrethost", Some(21), "SECRETACCT", &[]),
+        ]);
+        let e = envelope(&p, &lint(&p));
+        let v = e.to_value();
+        assert_eq!(v["state"], "succeeded");
+        assert_eq!(v["code"], "LINT_FINDINGS");
+        assert_eq!(v["warnings"], json!([]));
+        assert_eq!(v["next"], Json::Null);
+        assert_eq!(
+            v["data"].as_object().unwrap().len(),
+            1,
+            "data has only findings"
+        );
+        for item in v["data"]["findings"].as_array().unwrap() {
+            let keys: Vec<_> = item.as_object().unwrap().keys().cloned().collect();
+            let mut keys = keys;
+            keys.sort();
+            assert_eq!(keys, ["destination_ids", "key_paths", "message", "rule"]);
+        }
+        let line = e.to_line();
+        assert!(line.ends_with("}\n") && line.matches('\n').count() == 1);
+        let lower = line.to_ascii_lowercase();
+        for value in ["secrethost", "secretlabel", "secretacct", "alias-", "\"n\""] {
+            assert!(!lower.contains(value), "value {value} echoed: {line}");
+        }
