+//! `profile lint` (TASK T2): findings about a schema-valid profile.
+//!
+//! Lint runs on the [`Profile`] that [`crate::profile::load_file`] returned, so every
+//! input-handling rule of `profile show` (size bound, K2, K14, K15, K18) applies
+//! unchanged. Only destinations are linted; `name`, `revision` and `[meta]` never are.
+//!
+//! Value non-echo: a [`Finding`] names places by key path only. The single kind of
+//! profile value it carries is a destination `id` (in `destination_ids`). Messages are
+//! fixed strings.
+
+use std::collections::HashMap;
+
+use serde_json::{Value as Json, json};
+
+use crate::envelope::{Code, Envelope};
+use crate::profile::{Destination, Profile};
+
+/// Lint rules in finding order (rule number 1 to 5).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Rule {
+    DuplicateEndpoint,
+    PrivilegedPort,
+    RootAccount,
+    DuplicateLabel,
+    LabelCaseVariant,
+}
+
+impl Rule {
+    pub fn id(self) -> &'static str {
+        match self {
+            Rule::DuplicateEndpoint => "duplicate-endpoint",
+            Rule::PrivilegedPort => "privileged-port",
+            Rule::RootAccount => "root-account",
+            Rule::DuplicateLabel => "duplicate-label",
+            Rule::LabelCaseVariant => "label-case-variant",
+        }
+    }
+
+    pub fn message(self) -> &'static str {
+        match self {
+            Rule::DuplicateEndpoint => "destinations share the same host and port",
+            Rule::PrivilegedPort => "port below 1024 other than 22",
+            Rule::RootAccount => "account is root",
+            Rule::DuplicateLabel => "label repeated within a destination",
+            Rule::LabelCaseVariant => "labels differ only in letter case",
+        }
+    }
+}
+
+/// A place in the profile a finding points at.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Place {
+    Host(usize),
+    Port(usize),
+    Account(usize),
+    /// `destinations[i].labels[j]`
+    Label(usize, usize),
+}
+
+impl Place {
+    pub fn destination(self) -> usize {
+        match self {
+            Place::Host(i) | Place::Port(i) | Place::Account(i) | Place::Label(i, _) => i,
+        }
+    }
+
+    /// Key path in exactly the form `destinations[2].labels[0]`.
+    pub fn key_path(self) -> String {
+        match self {
+            Place::Host(i) => format!("destinations[{i}].host"),
+            Place::Port(i) => format!("destinations[{i}].port"),
+            Place::Account(i) => format!("destinations[{i}].account"),
+            Place::Label(i, j) => format!("destinations[{i}].labels[{j}]"),
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Finding {
+    pub rule: Rule,
+    /// In the order the rule defines; never empty.
+    pub places: Vec<Place>,
+}
+
+impl Finding {
+    /// Destination indexes named by `places`, first-appearance order, no repeats.
+    pub fn destination_indexes(&self) -> Vec<usize> {
+        let mut out: Vec<usize> = Vec::new();
+        for p in &self.places {
+            let i = p.destination();
+            if !out.contains(&i) {
+                out.push(i);
+            }
+        }
+        out
+    }
+
+    pub fn key_paths(&self) -> Vec<String> {
+        self.places.iter().map(|p| p.key_path()).collect()
+    }
+
+    pub fn to_json(&self, profile: &Profile) -> Json {
+        let ids: Vec<&str> = self
+            .destination_indexes()
+            .into_iter()
+            .map(|i| profile.destinations[i].id.as_str())
+            .collect();
+        json!({
+            "rule": self.rule.id(),
+            "key_paths": self.key_paths(),
+            "destination_ids": ids,
+            "message": self.rule.message(),
+        })
+    }
+}
+
+/// The effective port: `port`, or 22 when omitted. The loader already applies the
+/// default, so this is the stored value.
+fn effective_port(d: &Destination) -> u16 {
+    d.port
+}
+
+/// Insertion-ordered grouping: groups appear in the order of their first member.
+struct Groups<K> {
+    index: HashMap<K, usize>,
+    groups: Vec<Vec<Place>>,
+}
+
+impl<K: std::hash::Hash + Eq> Groups<K> {
+    fn new() -> Self {
+        Groups {
+            index: HashMap::new(),
+            groups: Vec::new(),
+        }
+    }
+
+    fn add(&mut self, key: K, place: Place) -> usize {
+        let n = self.groups.len();
+        let g = *self.index.entry(key).or_insert(n);
+        if g == n {
+            self.groups.push(Vec::new());
+        }
+        self.groups[g].push(place);
+        g
+    }
+}
+
+/// All findings, ordered by rule number and then by the rule's own order.
+pub fn lint(profile: &Profile) -> Vec<Finding> {
+    let dests = &profile.destinations;
+    let mut out = Vec::new();
+
+    // Rule 1: same ASCII-lowercased host and same effective port. Groups are created in
+    // file order, so they are ordered by their first member and members are in file order.
+    let mut endpoints: Groups<(String, u16)> = Groups::new();
+    for (i, d) in dests.iter().enumerate() {
+        endpoints.add(
+            (d.host.to_ascii_lowercase(), effective_port(d)),
+            Place::Host(i),
+        );
+    }
+    out.extend(
+        endpoints
+            .groups
+            .into_iter()
+            .filter(|g| g.len() >= 2)
+            .map(|places| Finding {
+                rule: Rule::DuplicateEndpoint,
+                places,
+            }),
+    );
+
+    // Rule 2: effective port below 1024 and not 22. An omitted port is 22, so the
+    // `port` key path always names a key that is present in the file.
+    for (i, d) in dests.iter().enumerate() {
+        let p = effective_port(d);
+        if p < 1024 && p != 22 {
+            out.push(Finding {
+                rule: Rule::PrivilegedPort,
+                places: vec![Place::Port(i)],
+            });
+        }
+    }
+
+    // Rule 3: account exactly "root" (case-sensitive).
+    for (i, d) in dests.iter().enumerate() {
+        if d.account == "root" {
+            out.push(Finding {
+                rule: Rule::RootAccount,
+                places: vec![Place::Account(i)],
+            });
+        }
+    }
+
+    // Rule 4: within one destination, the same label string (exact) more than once.
+    // Per destination, groups are ordered by the label's first occurrence.
+    for (i, d) in dests.iter().enumerate() {
+        let mut labels: Groups<&str> = Groups::new();
+        for (j, l) in d.labels.iter().enumerate() {
+            labels.add(l.as_str(), Place::Label(i, j));
+        }
+        out.extend(
+            labels
+                .groups
+                .into_iter()
+                .filter(|g| g.len() >= 2)
+                .map(|places| Finding {
+                    rule: Rule::DuplicateLabel,
+                    places,
+                }),
+        );
+    }
+
+    // Rule 5: across the profile, two or more *different* label strings that are equal
+    // after ASCII-lowercasing. Occurrences are visited in (i, j) order, so each set's
+    // members are in (i, j) order and sets are ordered by their first occurrence.
+    let mut folded: Groups<String> = Groups::new();
+    let mut first_spelling: Vec<&str> = Vec::new();
+    let mut variant: Vec<bool> = Vec::new();
+    for (i, d) in dests.iter().enumerate() {
+        for (j, l) in d.labels.iter().enumerate() {
+            let g = folded.add(l.to_ascii_lowercase(), Place::Label(i, j));
+            if g == first_spelling.len() {
+                first_spelling.push(l.as_str());
+                variant.push(false);
+            } else if first_spelling[g] != l.as_str() {
+                variant[g] = true;
+            }
+        }
+    }
+    out.extend(
+        folded
+            .groups
+            .into_iter()
+            .zip(variant)
+            .filter(|(_, v)| *v)
+            .map(|(places, _)| Finding {
+                rule: Rule::LabelCaseVariant,
+                places,
+            }),
+    );
+
+    // Each rule appended its findings in its own order, rules in number order.
+    debug_assert!(out.windows(2).all(|w| w[0].rule <= w[1].rule));
+    out
+}
+
+/// Result envelope: `LINT_CLEAN` (exit 0) or `LINT_FINDINGS` (exit 3), both
+/// `state: succeeded`, `data: {"findings": [...]}`.
+pub fn envelope(profile: &Profile, findings: &[Finding]) -> Envelope {
+    let code = if findings.is_empty() {
+        Code::LintClean
+    } else {
+        Code::LintFindings
+    };
+    let items: Vec<Json> = findings.iter().map(|f| f.to_json(profile)).collect();
+    Envelope::success(code, json!({ "findings": items }))
+}
+
+#[cfg(test)]
