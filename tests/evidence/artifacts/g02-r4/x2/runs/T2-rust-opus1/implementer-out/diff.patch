+#[test]
+fn lint_clean_fixtures_exit_0() {
+    let cwd = TempDir::new("lintc");
+    for name in ["homelab.toml", "spaced dir ü/prøfile homelab.toml"] {
+        let p = fixtures().join(name);
+        let o = lint_cmd(&p, Some(false), cwd.path());
+        assert_eq!(o.status.code(), Some(0), "{name}");
+        let v = one_json(&o);
+        assert_eq!(v["state"], "succeeded");
+        assert_eq!(v["code"], "LINT_CLEAN");
+        assert_eq!(v["data"], serde_json::json!({"findings": []}));
+        let o = lint_cmd(&p, None, cwd.path());
+        assert_eq!(o.status.code(), Some(0), "{name} plain");
+        assert_no_values(
+            &o,
+            &["homelab", "example.internal", "aman", "lab-server"],
+            name,
+        );
+    }
+    // large-100: 33 destinations use account "root" (counted independently with grep);
+    // nothing else fires (unique hosts, ports 22 or >= 2200, one label each).
+    let o = lint_cmd(&fixtures().join("large-100.toml"), Some(true), cwd.path());
+    assert_eq!(o.status.code(), Some(3));
+    let v = one_json(&o);
+    assert_eq!(v["code"], "LINT_FINDINGS");
+    let f = v["data"]["findings"].as_array().unwrap();
+    assert_eq!(f.len(), 33);
+    assert!(f.iter().all(|x| x["rule"] == "root-account"));
+    let idx: Vec<usize> = f
+        .iter()
+        .map(|x| {
+            let kp = x["key_paths"][0].as_str().unwrap();
+            kp["destinations[".len()..kp.find(']').unwrap()]
+                .parse()
+                .unwrap()
+        })
+        .collect();
+    assert!(idx.windows(2).all(|w| w[0] < w[1]), "destination order");
+    assert!(tree(cwd.path()).is_empty(), "lint wrote nothing");
+}
