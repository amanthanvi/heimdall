+/// Lint fails exactly like `profile show` on input it cannot accept: same exit
+/// status, state, code and data.error.key_path; plain runs exit the same way.
+#[test]
+fn lint_input_errors_match_profile_show() {
+    let d = TempDir::new("lintx");
+    let big = d.path().join("over size ü.toml");
+    let mut body = b"schema_version = 1\nname = \"x\"\nrevision = 1\n".to_vec();
+    body.resize(1_048_577, b'#');
+    std::fs::write(&big, body).unwrap();
+    let ctl = d.path().join("control value.toml");
+    std::fs::write(
+        &ctl,
+        "schema_version=1\nname=\"n\"\nrevision=1\n[[destinations]]\nid=\"i\"\nalias=\"a\"\nhost=\"LVHOST\\u001b\"\naccount=\"u\"\n",
+    )
+    .unwrap();
+    let dup = d.path().join("dup id.toml");
+    std::fs::write(
+        &dup,
+        "schema_version=1\nname=\"n\"\nrevision=1\n[[destinations]]\nid=\"x\"\nalias=\"a\"\nhost=\"h\"\naccount=\"u\"\n[[destinations]]\nid=\"x\"\nalias=\"b\"\nhost=\"h\"\naccount=\"u\"\n",
+    )
+    .unwrap();
+    let fifo = d.path().join("profile fifo");
+    mkfifo(&fifo);
+    let sock = d.path().join("p.sock");
+    let _l = UnixListener::bind(&sock).unwrap();
+    let dir = d.path().join("a dir");
+    std::fs::create_dir(&dir).unwrap();
+    let fx = fixtures();
+    let mut paths: Vec<PathBuf> = [
+        "invalid-forbidden-key.toml",
+        "invalid-unknown-dest-key.toml",
+        "invalid-malformed.toml",
+        "invalid-schema-version.toml",
+        "invalid-duplicate-alias.toml",
+        "invalid-port.toml",
+        "does-not-exist.toml",
+    ]
+    .iter()
+    .map(|n| fx.join(n))
+    .collect();
+    paths.extend([big, ctl, dup, fifo, sock, dir, PathBuf::from("/dev/null")]);
+    let run_bounded = |sub: &str, p: &Path, json: bool| -> Output {
+        let mut c = cmd();
+        c.args(["profile", sub, "--file"]).arg(p);
+        if json {
+            c.arg("--json");
+        }
+        let mut c = c
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let t = Instant::now();
+        while c.try_wait().unwrap().is_none() && t.elapsed() < Duration::from_secs(2) {
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        if c.try_wait().unwrap().is_none() {
+            let _ = c.kill();
+            let _ = c.wait();
+            panic!("{sub} {}: still running after 2 s", p.display());
+        }
+        c.wait_with_output().unwrap()
+    };
+    for p in &paths {
+        let show = run_bounded("show", p, true);
+        let lint = run_bounded("lint", p, true);
+        let (vs, vl) = (one_json(&show), one_json(&lint));
+        assert_eq!(lint.status.code(), Some(2), "{}", p.display());
+        assert_eq!(lint.status.code(), show.status.code(), "{}", p.display());
+        for k in ["state", "code", "warnings"] {
+            assert_eq!(vl[k], vs[k], "{k} {}", p.display());
+        }
+        assert_eq!(
+            vl["data"]["error"]["key_path"],
+            vs["data"]["error"]["key_path"],
+            "{}",
+            p.display()
+        );
+        assert_eq!(vl["data"], vs["data"], "{}", p.display());
+        no_canary(&lint);
+        assert_no_values(&lint, &["LVHOST"], "lint error");
+        let plain = run_bounded("lint", p, false);
+        assert_eq!(plain.status.code(), Some(2), "plain {}", p.display());
+        assert!(plain.stdout.is_empty(), "plain error: no stdout");
+        no_canary(&plain);
+        assert_no_values(&plain, &["LVHOST"], "lint plain error");
+    }
+}
