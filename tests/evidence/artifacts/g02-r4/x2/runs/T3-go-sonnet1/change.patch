+func TestHighlight(t *testing.T) {
+	ds := []profile.Destination{
+		{Alias: "Web-Prod", Host: "web1.example.invalid", Account: "web", Port: 22},
+		{Alias: "db", Host: "WEB9.example.invalid", Account: "web", Port: 22},
+		{Alias: "vps-東京", Host: "vps1.example.invalid", Account: "deploy", Port: 2222},
+	}
+	m := New(ds, true) // NO_COLOR: underline must still show
+	m.Update(tea.WindowSizeMsg{Width: 80, Height: 10})
+	if got := ulText(m.Render()); strings.Join(got, "") != "" {
+		t.Fatalf("empty filter underlined %q", got)
+	}
+	press(m, txt("/"), txt("w"), txt("E"), txt("b"))
+	out := m.Render()
+	if strings.Contains(out, "\x1b[3") || strings.Contains(out, "\x1b[1;") {
+		t.Fatalf("colour SGR with NO_COLOR: %q", out)
+	}
+	got := ulText(out)
+	if got[0] != "Webweb" || got[1] != "WEB" || got[2] != "" {
+		t.Fatalf("underlined: %q", got)
+	}
+	// Narrow: host not shown, so the host-only match underlines nothing.
+	m.Update(tea.WindowSizeMsg{Width: 40, Height: 10})
+	got = ulText(m.Render())
+	if got[0] != "Web" || got[1] != "" {
+		t.Fatalf("narrow: %q", got)
+	}
+	// Also after Enter leaves filter mode; CJK filter; Esc clears.
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape}, txt("/"), txt("東"), tea.KeyPressMsg{Code: tea.KeyEnter})
+	if got = ulText(m.Render()); got[0] != "東" {
+		t.Fatalf("cjk: %q", got)
+	}
+	press(m, txt("/"), tea.KeyPressMsg{Code: tea.KeyEscape})
+	if got = ulText(m.Render()); strings.Join(got, "") != "" {
+		t.Fatalf("after esc: %q", got)
+	}
+	// Selected row with colour: bold cyan survives the underline end.
+	mc := New(ds, false)
+	press(mc, txt("/"), txt("e"))
+	if out := mc.Render(); !strings.Contains(out, sgrSelected) || strings.Contains(strings.SplitN(out, "\n", 2)[0], "\x1b[0m\x1b[24m") {
+		t.Fatalf("%q", out)
+	}
+}
