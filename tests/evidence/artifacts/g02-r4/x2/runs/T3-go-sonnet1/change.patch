+// refilter recomputes the shown rows after a filter edit. The destination that
+// was selected just before the edit stays selected when it is still shown;
+// otherwise (or when nothing was shown) the first shown row is selected.
 func (m *Model) refilter() {
+	prev := -1
+	if m.sel >= 0 && m.sel < len(m.shown) {
+		prev = m.shown[m.sel]
+	}
 	m.shown = profile.Filter(m.dests, m.filter)
 	m.sel = 0
+	if prev >= 0 {
+		// shown holds ascending destination indexes.
+		if i := sort.SearchInts(m.shown, prev); i < len(m.shown) && m.shown[i] == prev {
+			m.sel = i
+		}
+	}
 }
 
