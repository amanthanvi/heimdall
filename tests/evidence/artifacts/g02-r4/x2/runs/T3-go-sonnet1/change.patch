+func TestHelpOverlay(t *testing.T) {
+	m := New(dests(5), true)
+	m.Update(tea.WindowSizeMsg{Width: 80, Height: 24})
+	press(m, txt("/"), txt("?")) // ordinary filter text in filter mode
+	if m.help || m.filter != "?" {
+		t.Fatal("? in filter mode")
+	}
+	press(m, tea.KeyPressMsg{Code: tea.KeyEscape}, txt("j"), txt("j"), txt("?"))
+	if !m.help {
+		t.Fatal("help not open")
+	}
+	before := m.sel
+	lines := strings.Split(m.Render(), "\n")
+	for i, want := range helpLines {
+		if strings.Join(strings.Fields(lines[i]), " ") != strings.Join(strings.Fields(want), " ") {
+			t.Fatalf("line %d: %q", i, lines[i])
+		}
+	}
+	press(m, txt("q"), txt("/"), txt("j"), tea.KeyPressMsg{Code: tea.KeyDown}, tea.KeyPressMsg{Code: tea.KeyEnter})
+	if !m.help || m.filtering || m.sel != before || m.Outcome != Quit || m.filter != "" {
+		t.Fatal("keys not ignored")
+	}
+	// Esc closes without clearing an active filter.
+	m = New(dests(30), true)
+	press(m, txt("/"), txt("1"), tea.KeyPressMsg{Code: tea.KeyEnter}, tea.KeyPressMsg{Code: tea.KeyDown}, txt("?"), tea.KeyPressMsg{Code: tea.KeyEscape})
+	if m.help || m.filter != "1" || m.sel != 1 {
+		t.Fatalf("esc: help=%v filter=%q sel=%d", m.help, m.filter, m.sel)
+	}
+	if out := m.Render(); strings.Contains(out, "close help") {
+		t.Fatal("help remains")
+	}
+	press(m, txt("?"), txt("?"))
+	if m.help {
+		t.Fatal("? closes")
+	}
+	// Ctrl-C cancels from the overlay.
+	press(m, txt("?"))
+	_, cmd := m.Update(tea.KeyPressMsg{Code: 'c', Mod: tea.ModCtrl})
+	if m.Outcome != Cancelled || cmd == nil {
+		t.Fatal("ctrl-c in help")
+	}
+	// Tiny sizes never crash.
+	m = New(dests(30), false)
+	press(m, txt("?"))
+	for _, sz := range [][2]int{{20, 5}, {1, 1}, {0, 0}, {80, 24}} {
+		m.Update(tea.WindowSizeMsg{Width: sz[0], Height: sz[1]})
+		_ = m.Render()
 	}
