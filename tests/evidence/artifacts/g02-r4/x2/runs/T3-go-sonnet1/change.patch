+// markMatch returns s sanitized, with the first case-insensitive occurrence of
+// q underlined. Matching is per rune (unicode.ToLower), the rule strings.ToLower
+// applies in profile.Filter, so rune offsets are stable. found reports whether
+// an underline was emitted.
+func markMatch(s string, q []rune) (out string, found bool) {
+	rs := []rune(s)
+	for i, r := range rs {
+		if unicode.IsControl(r) {
+			rs[i] = utf8.RuneError
+		}
+	}
+	at := indexFold(rs, q)
+	if at < 0 {
+		return string(rs), false
+	}
+	end := at + len(q)
+	return string(rs[:at]) + sgrULOn + string(rs[at:end]) + sgrULOff + string(rs[end:]), true
+}
+
+// indexFold is the rune index of the first case-insensitive occurrence of q
+// in rs, or -1. An empty q never matches (no highlight for an empty filter).
+func indexFold(rs, q []rune) int {
+	if len(q) == 0 {
+		return -1
+	}
+	for i := 0; i+len(q) <= len(rs); i++ {
+		j := 0
+		for ; j < len(q); j++ {
+			if unicode.ToLower(rs[i+j]) != unicode.ToLower(q[j]) {
+				break
+			}
+		}
+		if j == len(q) {
+			return i
+		}
+	}
+	return -1
+}
