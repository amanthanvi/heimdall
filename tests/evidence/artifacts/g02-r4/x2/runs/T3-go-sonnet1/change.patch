+// ulCells returns, for each line of the rendered output, the text that sits
+// under the underline attribute (SGR 4 on, 24 off, 0 reset).
+func ulText(out string) []string {
+	var res []string
+	for _, line := range strings.Split(out, "\n") {
+		var sb strings.Builder
+		ul := false
+		for i := 0; i < len(line); {
+			if line[i] == 0x1b && i+1 < len(line) && line[i+1] == '[' {
+				j := i + 2
+				for j < len(line) && (line[j] < 0x40 || line[j] > 0x7e) {
+					j++
+				}
+				if j < len(line) && line[j] == 'm' {
+					for _, p := range strings.Split(line[i+2:j], ";") {
+						switch p {
+						case "4":
+							ul = true
+						case "24":
+							ul = false
+						case "0", "":
+							ul = false
+						}
+					}
+				}
+				i = j + 1
+				continue
+			}
+			if ul {
+				sb.WriteByte(line[i])
+			}
+			i++
+		}
+		res = append(res, sb.String())
+	}
+	return res
+}
