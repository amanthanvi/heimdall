+@case("t3c-k17-latency-part-c")
+def t_k17_part_c(b):
+    """K17 with the part C update predicate: after each edit the status shows the new count,
+    the list shows a full window of consecutive matches in profile order, and '> ' is on
+    the destination part C selects. 5 sessions x 6 edits (7, 0, 5, three Backspaces),
+    after first moving the selection to host-070-lab so that the kept selection matters."""
+    dests = large_destinations()
+    matches = lambda f: [a for a, h in dests if f.lower() in a.lower() or f.lower() in h.lower()]
+    s = tui(b, fixture="large-100.toml")
+    assert s.wait_text("100/100") is not None
+    cap = len(s.screen.text().splitlines()) - 1  # rows above the status line
+
+    def window_ok(t, typed, want_sel):
+        lines = t.splitlines()
+        exp = matches(typed)
+        if lines[-1].strip().split()[0:1] != [f"{len(exp)}/100"]:
+            return False
+        rows = [(l[:2], l[2:].split()[0]) for l in lines[:-1] if l[2:].split()]
+        names = [r[1] for r in rows]
+        if len(names) != min(len(exp), cap):
+            return False
+        if names and names != exp[exp.index(names[0]):exp.index(names[0]) + len(names)]:
+            return False
+        marked = [n for p, n in rows if p == "> "]
+        return marked == ([want_sel] if want_sel else [])
+
+    s.write(b"\x1b[B" * 70)
+    assert s.wait_screen(lambda t: marked_alias(t) == "host-070-lab") is not None
+    lats, sel = [], "host-070-lab"
+    for _session in range(5):
+        s.write(b"/")
+        assert s.wait_screen(lambda t: t.splitlines()[-1].strip() == "100/100  /") is not None
+        typed = ""
+        for edit in ["7", "0", "5", None, None, None]:
+            typed = typed + edit if edit else typed[:-1]
+            exp = matches(typed)
+            sel = sel if sel in exp else (exp[0] if exp else None)
+            t0 = time.monotonic()
+            s.write(edit.encode() if edit else b"\x7f")
+            dt = s.wait_screen(lambda t: window_ok(t, typed, sel))
+            assert dt is not None, f"no part-C update after {typed!r} (want '> {sel}'): {s.screen.text()!r}"
+            lats.append(round((time.monotonic() - t0) * 1000, 1))
+        s.write(b"\x1b")
+        assert s.wait_screen(lambda t: t.splitlines()[-1].strip() == "100/100", timeout=2) is not None
+        s.read_for(0.1)
+    s.write(b"q")
+    code, termios_ok = s.finish()
+    assert code == 0 and termios_ok, f"exit {code}"
+    v = sorted(lats)
+    p95 = v[-(-95 * len(v) // 100) - 1]
+    assert len(lats) == 30 and p95 <= 100, f"p95 {p95} ms: {lats}"
+    return f"30 edits, p95 {p95} ms, max {max(lats)} ms (part C predicate; selection ends on {sel})"
+
