+    fn keys(m: &mut ListModel, s: &str) {
+        for c in s.chars() {
+            m.handle(match c {
+                '\r' => Key::Enter,
+                '\x1b' => Key::Esc,
+                '\x7f' => Key::Backspace,
+                c => Key::Char(c),
+            });
+        }
