+/// One list row: the text of [`ListModel::row_text`], with the first filter match in
+/// the alias and (when the host is shown) in the host underlined (task T3 part A).
+/// Underline is an attribute, not a colour, so it is drawn under `NO_COLOR` too.
+fn row_line<'a>(m: &ListModel, d: &'a Destination, width: u16) -> Line<'a> {
+    let hit = m.row_match(d);
+    let mut spans = underline_match(&d.alias, hit.alias);
+    if width >= 50 {
+        spans.push(Span::raw(format!("  {}@", d.account)));
+        spans.extend(underline_match(&d.host, hit.host));
+        spans.push(Span::raw(format!(":{}", d.port)));
+    }
+    Line::from(spans)
