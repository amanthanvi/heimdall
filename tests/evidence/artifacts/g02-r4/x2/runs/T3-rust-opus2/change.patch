+    impl Screen {
+        fn new(w: u16, h: u16) -> Self {
+            Screen {
+                term: Terminal::new(TestBackend::new(w, h)).unwrap(),
+                state: ListState::default(),
+            }
+        }
+        fn draw(&mut self, m: &mut ListModel, color: bool) {
+            let state = &mut self.state;
+            self.term.draw(|f| render(f, m, state, color)).unwrap();
+        }
+        fn buf(&self) -> &ratatui::buffer::Buffer {
+            self.term.backend().buffer()
+        }
+        fn line(&self, y: u16) -> String {
+            let b = self.buf();
+            (0..b.area.width)
+                .map(|x| b[(x, y)].symbol())
+                .collect::<String>()
+        }
+        /// Per screen row: the underlined cells as (x, symbol), skipping the hidden
+        /// right halves of wide characters (empty symbol).
+        fn underlined(&self) -> Vec<(u16, Vec<(u16, String)>)> {
+            let b = self.buf();
+            (0..b.area.height)
+                .filter_map(|y| {
+                    let cells: Vec<(u16, String)> = (0..b.area.width)
+                        .filter(|&x| b[(x, y)].modifier.contains(Modifier::UNDERLINED))
+                        .map(|x| (x, b[(x, y)].symbol().to_string()))
+                        .filter(|(_, s)| !s.is_empty())
+                        .collect();
+                    (!cells.is_empty()).then_some((y, cells))
+                })
+                .collect()
+        }
+        fn underlined_text(&self) -> Vec<(u16, String)> {
+            self.underlined()
+                .into_iter()
+                .map(|(y, c)| (y, c.into_iter().map(|(_, s)| s).collect()))
+                .collect()
+        }
