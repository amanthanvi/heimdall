+/// Byte range in `hay` of the first case-insensitive occurrence of `needle_lower`
+/// (already lowercased with `str::to_lowercase`, the filter's rule). `None` when
+/// the needle is empty or does not occur.
+///
+/// The search runs on `hay.to_lowercase()`, exactly as the filter does, and the hit is
+/// mapped back to whole characters of `hay`: a character is part of the range when its
+/// lowercase form overlaps the hit. `str::to_lowercase` lowercases character by
+/// character (its one context rule, final sigma, swaps two code points of equal UTF-8
+/// length), so per-character lowercase lengths locate every character exactly, even
+/// where lowercasing changes the length.
+pub fn match_range(hay: &str, needle_lower: &str) -> Option<std::ops::Range<usize>> {
+    if needle_lower.is_empty() {
+        return None;
+    }
+    let lower = hay.to_lowercase();
+    let hit_start = lower.find(needle_lower)?;
+    let hit_end = hit_start + needle_lower.len();
+    let mut lo = 0; // byte offset of the current character's lowercase form in `lower`
+    let mut range: Option<std::ops::Range<usize>> = None;
+    for (i, c) in hay.char_indices() {
+        let len: usize = c.to_lowercase().map(char::len_utf8).sum();
+        if lo < hit_end && lo + len > hit_start {
+            let end = i + c.len_utf8();
+            range = Some(range.map_or(i..end, |r| r.start..end));
+        }
+        lo += len;
+        if lo >= hit_end {
+            break;
+        }
+    }
+    range
+}
