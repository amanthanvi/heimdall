+/// Byte range in `text` of the first case-insensitive occurrence of `needle_lower`,
+/// which must already be lowercased with `str::to_lowercase`. This is the filter's
+/// matching rule (`text.to_lowercase().contains(needle_lower)`), mapped back onto the
+/// original characters: a match that starts or ends inside the lowercase expansion
+/// of one character covers that whole character. `str::to_lowercase` output is the
+/// concatenation of the per-character lowercase forms except for the final-sigma
+/// rule, which swaps one 2-byte form for another, so the byte offsets line up.
+pub fn find_ci(text: &str, needle_lower: &str) -> Option<std::ops::Range<usize>> {
+    if needle_lower.is_empty() {
+        return None;
+    }
+    let lower = text.to_lowercase();
+    let lo_start = lower.find(needle_lower)?;
+    let lo_end = lo_start + needle_lower.len();
+    let (mut start, mut end) = (None, text.len());
+    let mut lo = 0;
+    for (i, c) in text.char_indices() {
+        let n: usize = c.to_lowercase().map(char::len_utf8).sum();
+        if start.is_none() && lo + n > lo_start {
+            start = Some(i);
+        }
+        if lo + n >= lo_end {
+            end = i + c.len_utf8();
+            break;
+        }
+        lo += n;
+    }
+    start.map(|s| s..end)
+}
+
+/// One piece of a list row: its text and whether it is underlined as filter match.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Segment {
+    pub text: String,
+    pub underline: bool,
+}
+
+/// Append `text` to `out`, underlining the first match of `needle_lower` in it.
+fn push_matched(out: &mut Vec<Segment>, text: &str, needle_lower: &str) {
+    match find_ci(text, needle_lower) {
+        Some(r) => {
+            push_plain(out, &text[..r.start]);
+            out.push(Segment {
+                text: text[r.clone()].to_string(),
+                underline: true,
+            });
+            push_plain(out, &text[r.end..]);
+        }
+        None => push_plain(out, text),
+    }
+}
+
+fn push_plain(out: &mut Vec<Segment>, text: &str) {
+    if text.is_empty() {
+        return;
+    }
+    match out.last_mut() {
+        Some(last) if !last.underline => last.text.push_str(text),
+        _ => out.push(Segment {
+            text: text.to_string(),
+            underline: false,
+        }),
+    }
+}
