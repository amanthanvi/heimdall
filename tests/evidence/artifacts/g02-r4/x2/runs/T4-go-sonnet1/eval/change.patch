+// K14 still holds for links: a link whose target is not a regular file (or
+// does not exist, or loops) is exit 2 USAGE_ERROR within 2 s and is never
+// opened blockingly.
+func TestLoadRejectsSymlinkToNonRegular(t *testing.T) {
+	dir, err := os.MkdirTemp("/tmp", "hpsym2")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	fifo := filepath.Join(dir, "fifo.toml")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	sock := filepath.Join(dir, "sock.toml")
+	l, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	links := map[string]string{
+		"link to fifo":        fifo,
+		"link to socket":      sock,
+		"link to directory":   dir,
+		"link to char device": "/dev/null",
+		"dangling link":       filepath.Join(dir, "missing.toml"),
+	}
+	for name, target := range links {
+		link := filepath.Join(dir, "l-"+filepath.Base(target)+".lnk")
+		if err := os.Symlink(target, link); err != nil {
+			t.Fatal(err)
+		}
+		if e := loadWithin(t, name, link); e == nil || e.Code != result.UsageError {
+			t.Errorf("%s: got %+v, want USAGE_ERROR", name, e)
+		}
+	}
+	// Link to a link to a FIFO.
+	l1, l2 := filepath.Join(dir, "l1"), filepath.Join(dir, "l2")
+	if err := os.Symlink("l2", l1); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("fifo.toml", l2); err != nil {
+		t.Fatal(err)
+	}
+	if e := loadWithin(t, "chain to fifo", l1); e == nil || e.Code != result.UsageError {
+		t.Errorf("chain to fifo: got %+v, want USAGE_ERROR", e)
+	}
+	// Loop.
+	a, b := filepath.Join(dir, "loop-a"), filepath.Join(dir, "loop-b")
+	if err := os.Symlink("loop-b", a); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("loop-a", b); err != nil {
+		t.Fatal(err)
+	}
+	if e := loadWithin(t, "link loop", a); e == nil || e.Code != result.UsageError {
+		t.Errorf("link loop: got %+v, want USAGE_ERROR", e)
+	}
+	// A link retargeted to a FIFO after the pre-check cannot make the open
+	// block or the read happen: openNoBlock + the descriptor check refuse it.
+	f, err := openNoBlock(filepath.Join(dir, "l-fifo.toml.lnk"))
+	if err != nil {
+		t.Fatalf("nonblocking open of a link to a FIFO: %v", err)
+	}
+	defer f.Close()
+	if st, err := f.Stat(); err != nil || st.Mode().IsRegular() {
+		t.Fatalf("descriptor of FIFO link: %v %v", st, err)
 	}
 }
