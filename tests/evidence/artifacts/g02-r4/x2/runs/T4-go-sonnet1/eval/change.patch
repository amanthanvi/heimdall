+const okProfile = "schema_version = 1\nname = \"x\"\nrevision = 1\n"
+
+func loadWithin(t *testing.T, name, path string) *Error {
+	t.Helper()
+	done := make(chan *Error, 1)
+	go func() { _, e := Load(path); done <- e }()
+	select {
+	case e := <-done:
+		return e
+	case <-time.After(2 * time.Second):
+		t.Fatalf("%s: Load still blocked after 2 s", name)
+		return nil
+	}
+}
