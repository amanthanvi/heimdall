+// runTUIProcess runs this test binary as `heimdall-proto tui --file path`
+// (HP_AS_MAIN=1) on a pty. If keys is non-empty it is written to the master
+// after the picker had time to start. It returns the exit status, the pty
+// output and the elapsed time; the process is killed (by exact PID) after
+// 10 s.
+func runTUIProcess(t *testing.T, path, keys string) (int, []byte, time.Duration) {
+	t.Helper()
+	r := startPTY(t)
+	defer r.master.Close()
+	defer r.slave.Close()
+	cmd := exec.Command(os.Args[0], "tui", "--file", path)
+	cmd.Env = []string{"HP_AS_MAIN=1", "TERM=xterm-256color", "NO_COLOR=1"}
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = r.slave, r.slave, r.slave
+	start := time.Now()
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- cmd.Wait() }()
+	if keys != "" {
+		go func() {
+			time.Sleep(600 * time.Millisecond)
+			_, _ = r.master.Write([]byte(keys))
+		}()
+	}
+	var werr error
+	select {
+	case werr = <-done:
+	case <-time.After(10 * time.Second):
+		_ = cmd.Process.Kill()
+		<-done
+		t.Fatalf("tui --file %s did not exit", path)
+	}
+	elapsed := time.Since(start)
+	time.Sleep(100 * time.Millisecond)
+	code := 0
+	if ee, ok := werr.(*exec.ExitError); ok {
+		code = ee.ExitCode()
+	} else if werr != nil {
+		t.Fatal(werr)
+	}
+	return code, r.output(), elapsed
+}
+
+// `tui --file` follows a symbolic link to a regular profile exactly like the
+// file itself: the picker starts and 'q' ends it with status 0. A link to a
+// FIFO is exit 2 within 2 s with the terminal untouched (K14).
+func TestTUIFollowsSymlink(t *testing.T) {
+	dir, err := os.MkdirTemp("/tmp", "hptuisym")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	src, err := os.ReadFile(filepath.Join(testfix.Dir(t), "homelab.toml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	reg := filepath.Join(dir, "homelab.toml")
+	if err := os.WriteFile(reg, src, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	abs, rel := filepath.Join(dir, "abs.toml"), filepath.Join(dir, "rel.toml")
+	if err := os.Symlink(reg, abs); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("homelab.toml", rel); err != nil {
+		t.Fatal(err)
+	}
+	for name, path := range map[string]string{"regular": reg, "absolute link": abs, "relative link": rel} {
+		code, out, _ := runTUIProcess(t, path, "q")
+		if code != 0 || !bytes.Contains(out, []byte("\x1b[?1049h")) || !bytes.Contains(out, []byte("\x1b[?1049l")) {
+			t.Errorf("%s: exit %d, alternate screen entered/left: %v/%v", name, code,
+				bytes.Contains(out, []byte("\x1b[?1049h")), bytes.Contains(out, []byte("\x1b[?1049l")))
+		}
+	}
+	fifo := filepath.Join(dir, "fifo.toml")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	fl := filepath.Join(dir, "fifo-link.toml")
+	if err := os.Symlink(fifo, fl); err != nil {
+		t.Fatal(err)
+	}
+	code, out, el := runTUIProcess(t, fl, "")
+	if code != 2 || el > 2*time.Second || bytes.Contains(out, []byte("\x1b[?1049h")) {
+		t.Errorf("link to fifo: exit %d after %v, out %q", code, el, out)
+	}
+}
