+            how = "(b) fg ended the job"
+        else:
+            assert x2_rc(sh) in (7, 0), f"{sig.name}: $? of the finished job"
+            how = "(a) finished by itself"
+        left = x2_jobs(sh)
+        assert not re.search(rb"Stopped|suspended|Running|running", left), f"{sig.name}: a job is left: {left!r}"
+        end = time.monotonic() + 3
+        while time.monotonic() < end and (proc_state(child) or proc_state(hp)):
+            time.sleep(0.05)
+        assert not proc_state(child) and not proc_state(hp), f"{sig.name}: process left behind"
+        out.append(f"{sig.name} $?={128 + int(sig)} then {how}")
+    return ", ".join(out)
+
+
+t_x2_s2 = x2_for_each_shell("x2-s2-third-party-stop-then-cont-child-only", _x2_s2)
+
+
+def _x2_s3(b, sh, kind, pids):
+    """S3: the child stops itself with SIGTSTP; SIGCONT goes to the launcher's PID only."""
+    d = tempfile.mkdtemp(prefix="x2s3-", dir=TMP)
+    child_py = os.path.join(d, "c.py")
+    open(child_py, "w").write(X2_CHILD)
+    child, hp = x2_start(sh, b, child_py)
+    pids += [child, hp]
+    sh.send(b"stop-TSTP\n")
+    x2_wait_stopped(sh, kind, child, hp, "self-stop", 1)
+    assert x2_rc(sh) == 128 + int(signal.SIGTSTP), "$? after the stop notice"
+    sh.out = b""
+    os.kill(hp, signal.SIGCONT)  # the launcher's PID only
+    assert sh.wait_count(b"RESUMED", 1, timeout=4), f"child did not resume: {sh.out[-300:]!r}"
+    # With no terminal in the background, the resumed child stops on its next read.
+    end = time.monotonic() + 3
+    while time.monotonic() < end and not (proc_state(child).startswith("T") and proc_state(hp).startswith("T")):
+        sh.read_for(0.02)
+    st = (proc_state(child), proc_state(hp))
+    assert all(x.startswith("T") for x in st), f"background read did not stop the job: {st}"
+    jobs = x2_jobs(sh)
+    assert NOTICE.search(jobs) and not re.search(rb"Running|running", jobs), f"jobs: {jobs!r}"
+    n = sh.out.count(PROMPT)
+    sh.send(b"fg\n")
+    sh.read_for(0.5)
+    sh.send(b"S3-LINE\n")
+    assert sh.wait_count(b"GOT S3-LINE", 1), f"child did not read after fg: {sh.out[-300:]!r}"
+    sh.send(b"quit\n")
+    assert sh.wait_count(PROMPT, n + 1), f"no prompt after quit: {sh.out[-200:]!r}"
+    assert x2_rc(sh) == 5, "$? after fg and quit"
+    return "child resumed by SIGCONT to the launcher alone, stopped on the background read, jobs=Stopped, fg gave it the terminal, $?=5"
+
+
+t_x2_s3 = x2_for_each_shell("x2-s3-self-stop-then-cont-launcher-only", _x2_s3)
+
+
+def _x2_s4(b, sh, kind, pids):
+    """S4: a nested interactive bash is suspended and brought back with fg."""
+    sh.send(f'"{b}" run -- /bin/bash --norc --noprofile -i\n'.encode())
+    time.sleep(1.0)
+    sh.send(b"PS1='NEST$ '\n")
+    assert sh.wait_count(b"NEST$ ", 2), f"nested shell has no prompt: {sh.out[-300:]!r}"
+    sh.send(b"suspend\n")
+    end = time.monotonic() + 5
+    while time.monotonic() < end and not NOTICE.search(sh.out):
+        sh.read_for(0.02)
+    assert NOTICE.search(sh.out), f"no stop notice: {sh.out[-300:]!r}"
+    n = sh.out.count(PROMPT)
+    assert sh.wait_count(PROMPT, n or 1), "outer shell did not prompt"
+    assert x2_rc(sh) in (128 + int(signal.SIGSTOP), 128 + int(signal.SIGTSTP)), "$? after the stop notice"
+    sh.send(b"fg\n")
+    sh.read_for(0.8)
+    sh.send(b"echo NESTED-ALIVE\n")
+    end = time.monotonic() + 5
+    while time.monotonic() < end and not re.search(rb"\nNESTED-ALIVE", sh.out):
+        sh.read_for(0.02)
+    assert re.search(rb"\nNESTED-ALIVE", sh.out), f"nested shell did not answer after fg: {sh.out[-300:]!r}"
+    sh.send(b"exit 3\n")
+    assert sh.wait_count(PROMPT, n + 2), f"outer shell did not get the terminal back: {sh.out[-200:]!r}"
+    assert x2_rc(sh) == 3, "$? after `exit 3` in the nested shell"
+    return "suspend reported, fg brought the nested shell back (it answered), exit 3 -> $?=3"
+
+
+t_x2_s4 = x2_for_each_shell("x2-s4-nested-shell-suspend-fg", _x2_s4)
+
+
+def _x2_s5(b, sh, kind, pids):
+    """S5: SIGSTOP of the child with --meta-file, sent by the child itself or by a third party."""
+    d = tempfile.mkdtemp(prefix="x2s5-", dir=TMP)
+    child_py = os.path.join(d, "c.py")
+    open(child_py, "w").write(X2_CHILD)
+    out = []
+    for trigger in ("self", "third-party"):
+        sh.out = b""
+        meta = os.path.join(d, f"meta-{trigger}.json")
+        child, hp = x2_start(sh, b, child_py, meta=meta)
+        pids += [child, hp]
+        if trigger == "self":
+            sh.send(b"stop-STOP\n")
+        else:
+            time.sleep(0.2)
+            os.kill(child, signal.SIGSTOP)
+        x2_wait_stopped(sh, kind, child, hp, trigger, 1)
+        assert x2_rc(sh) == 128 + int(signal.SIGSTOP), f"{trigger}: $? after the stop notice"
+        time.sleep(0.7)
+        st = (proc_state(child), proc_state(hp))
+        assert all(x.startswith("T") for x in st), f"{trigger}: not staying stopped: {st}"
+        assert not os.path.exists(meta), f"{trigger}: meta file written while stopped"
+        sh.send(b"fg\n")
+        sh.read_for(0.5)
+        sh.send(b"S5-LINE\n")
+        assert sh.wait_count(b"GOT S5-LINE", 1), f"{trigger}: child did not read after fg: {sh.out[-300:]!r}"
+        n = sh.out.count(PROMPT)
+        sh.send(b"quit\n")
+        assert sh.wait_count(PROMPT, n + 1), f"{trigger}: no prompt after quit"
+        assert x2_rc(sh) == 5, f"{trigger}: $? after fg and quit"
+        v = json.load(open(meta))
+        assert v["code"] == "CHILD_EXITED" and v["data"] == {"launched": True, "exit_code": 5, "signal": None}, v
+        out.append(f"{trigger} ok")
+    return ", ".join(out)
+
+
+t_x2_s5 = x2_for_each_shell("x2-s5-sigstop-with-meta-file", _x2_s5)
+
