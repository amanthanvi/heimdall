+# ---------- round 5 (X2 T1): exec-equivalent job control ----------
+# Each case runs the same scenario under bash and, when installed, zsh. The checks are
+# the observable behaviours of plain exec (the stop notice, `$?`, `jobs`, who reads the
+# terminal), not the launcher's internals.
+
+NOTICE = re.compile(rb"Stopped|suspended")
+PROMPT = b"HPS1$ "
+
+X2_CHILD = r"""
+import os, signal, sys, time
+print('ready', os.getpid(), flush=True)
+while True:
+    line = sys.stdin.readline()
+    if not line:
+        sys.exit(9)
+    line = line.strip()
+    if line == 'quit':
+        sys.exit(5)
+    if line.startswith('stop-'):  # stop ITSELF: kill(getpid(), SIGTSTP or SIGSTOP)
+        print('SELF-STOP', flush=True)
+        os.kill(os.getpid(), getattr(signal, 'SIG' + line[5:]))
+        print('RESUMED', flush=True)
+        continue
+    if line == 'work':  # a terminal-free run of about 3 s of CPU-free work
+        for _ in range(30):
+            time.sleep(0.1)
+        print('WORK-DONE', flush=True)
+        sys.exit(7)
+    print('GOT', line, flush=True)
+"""
+
+
+def x2_shells():
+    kinds = ["bash"] if os.access("/bin/bash", os.X_OK) else []
+    if shutil.which("zsh"):
+        kinds.append("zsh")
+    if not kinds:
+        raise AssertionError("no interactive job-control shell (bash, zsh) found")
+    return kinds
+
+
+def x2_shell(kind):
+    sh = Shell(kind)
+    assert sh.wait_count(PROMPT, 1), f"{kind}: no prompt: {sh.out[-200:]!r}"
+    if kind == "zsh":  # no '%' end-of-line marker before prompts: keeps prompt counting exact
+        sh.send(b"unsetopt PROMPT_SP\n")
+        assert sh.wait_count(PROMPT, 2), f"{kind}: no prompt after setup"
+    assert b"no job control" not in sh.out, f"{kind}: no job control: {sh.out[-200:]!r}"
+    sh.out = b""
+    return sh
+
+
+def x2_start(sh, b, child_py, *extra, meta=None):
+    """Run the launcher as a foreground job; returns (child pid, launcher pid)."""
+    n = sh.out.count(b"ready ")
+    m = ["--meta-file", meta] if meta else []
+    sh.send(" ".join(f'"{x}"' for x in [b, "run", *m, "--", sys.executable, child_py, *extra]).encode() + b"\n")
+    assert sh.wait_count(b"ready ", n + 1), f"child not started: {sh.out[-300:]!r}"
+    sh.read_for(0.1)
+    child = int(re.findall(rb"ready (\d+)", sh.out)[-1])
+    hp = ppid_of(child)
+    assert hp > 1, f"child's parent not found: {hp}"
+    return child, hp
+
+
+def x2_rc(sh):
+    """`echo RC=$?` at the next prompt: the status as the shell reports it."""
+    n = len(re.findall(rb"RC=\d+", sh.out))
+    sh.send(b"echo RC=$?\n")
+    end = time.monotonic() + 4
+    while time.monotonic() < end:
+        found = re.findall(rb"\nRC=(\d+)", sh.out)
+        if len(found) > n:
+            return int(found[-1])
+        sh.read_for(0.02)
+    raise AssertionError(f"no RC: {sh.out[-300:]!r}")
+
+
+def x2_jobs(sh):
+    mark = len(sh.out)
+    n = sh.out.count(PROMPT)
+    sh.send(b"jobs\n")
+    assert sh.wait_count(PROMPT, n + 1), f"no prompt after jobs: {sh.out[-200:]!r}"
+    return sh.out[mark:]
+
+
+def x2_wait_stopped(sh, kind, child, hp, tag, n_notices):
+    end = time.monotonic() + 5
+    while time.monotonic() < end and len(NOTICE.findall(sh.out)) < n_notices:
+        sh.read_for(0.02)
+    assert len(NOTICE.findall(sh.out)) >= n_notices, f"{tag}: no stop notice: {sh.out[-300:]!r}"
+    end = time.monotonic() + 2
+    while time.monotonic() < end and not (proc_state(hp).startswith("T") and proc_state(child).startswith("T")):
+        sh.read_for(0.02)
+    st = (proc_state(child), proc_state(hp))
+    assert all(x.startswith("T") for x in st), f"{tag}: shell says stopped, processes are {st}"
+
+
+def x2_cleanup(sh, pids):
+    for pid in pids:
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+    sh.close()
+
+
+def x2_for_each_shell(name, fn):
+    def run(b):
+        details = []
+        for kind in x2_shells():
+            sh = x2_shell(kind)
+            pids = []
+            try:
+                details.append(f"{kind}: {fn(b, sh, kind, pids)}")
+            finally:
+                x2_cleanup(sh, pids)
+        return "; ".join(details)
+    return case(name)(run)
+
+
