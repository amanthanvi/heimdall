+/// Round 5 (X2 T1, S1): a program that is not a shell starts `run`, with no terminal
+/// on stdin/stdout/stderr and the launcher in a process group of its own. A third party
+/// stops the child (SIGSTOP, then SIGTSTP in a second run), waits 0.5 s and continues
+/// only the child's PID. As with plain exec the child runs to completion and the
+/// launcher exits with its status within 6 s, leaving no zombie. A launcher that
+/// mirrored the stop onto itself would stay stopped for ever: nobody continues it.
+#[test]
+fn x2_s1_third_party_stop_then_cont_child_only_without_terminal() {
+    use std::os::unix::process::CommandExt;
+    for sig in ["STOP", "TSTP"] {
+        let d = TempDir::new("x2s1");
+        let meta = d.path().join("m.json");
+        let mut child = cmd()
+            .arg("run")
+            .arg("--meta-file")
+            .arg(&meta)
+            .args([
+                "--",
+                "sh",
+                "-c",
+                "echo $$; i=0; while [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done; exit 7",
+            ])
+            .process_group(0)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap();
+        let mut r = BufReader::new(child.stdout.take().unwrap());
+        let mut line = String::new();
+        r.read_line(&mut line).unwrap();
+        let target: i32 = line.trim().parse().unwrap();
+        std::thread::sleep(Duration::from_millis(300));
+        assert!(shell_kill(&format!("-{sig}"), &target.to_string()));
+        std::thread::sleep(Duration::from_millis(500));
+        assert!(shell_kill("-CONT", &target.to_string()));
+        let cont = Instant::now();
+        let st = loop {
+            if let Some(st) = child.try_wait().unwrap() {
+                break st;
+            }
+            if cont.elapsed() > Duration::from_secs(6) {
+                // Not stopped itself for good: clean up what this test started, by PID.
+                let _ = shell_kill("-CONT", &child.id().to_string());
+                let _ = child.kill();
+                let _ = child.wait();
+                panic!("SIG{sig}: launcher still running 6 s after SIGCONT of the child");
+            }
+            std::thread::sleep(Duration::from_millis(20));
+        };
+        assert_eq!(
+            st.code(),
+            Some(7),
+            "SIG{sig}: launcher exits with the child's status"
+        );
+        assert!(!pid_alive(target), "SIG{sig}: child reaped, no zombie");
+        let v: Value = serde_json::from_slice(&std::fs::read(&meta).unwrap()).unwrap();
+        assert_eq!(v["code"], "CHILD_EXITED");
+        assert_eq!(v["data"]["exit_code"], 7);
+    }
+}
