+
+// Exec-equivalent job control (docs/g02/slice-contract.md §4, K6e, §9.4,
+// §9.5). Each test runs `heimdall-proto run -- <child>` where plain exec
+// would run `<child>`, and compares what the user, the shell and a third
+// party can observe with what plain exec gives: stop notices, `$?`, the job
+// table, whether typed input reaches the child, and which processes are left.
+
+func init() { helperChildren["hp-child-tty"] = ttyChild }
+
+// ttyChild is the helper child (this test binary, argv[1] == "hp-child-tty").
+// D/mode holds "<how> <exit code>": how is "wait" (run until D/stop exists),
+// "read" (read two lines), "selfstop-tstp" or "selfstop-stop" (stop itself
+// with kill(getpid(), SIGTSTP or SIGSTOP), then read one line).
+func ttyChild(dir string) {
+	b, _ := os.ReadFile(filepath.Join(dir, "mode"))
+	f := strings.Fields(string(b))
+	code, _ := strconv.Atoi(f[1])
+	pid := strconv.Itoa(os.Getpid())
+	_ = os.WriteFile(filepath.Join(dir, "ready.part"), []byte(pid), 0o600)
+	_ = os.Rename(filepath.Join(dir, "ready.part"), filepath.Join(dir, "ready"))
+	fmt.Println("READY")
+	in := bufio.NewReader(os.Stdin)
+	line := func(tag string) {
+		s, _ := in.ReadString('\n')
+		fmt.Printf("%s:%s\n", tag, strings.TrimSpace(s))
+	}
+	switch f[0] {
+	case "wait":
+		for i := 0; i < 600; i++ {
+			if _, err := os.Stat(filepath.Join(dir, "stop")); err == nil {
+				fmt.Println("DONE")
+				os.Exit(code)
+			}
+			time.Sleep(25 * time.Millisecond)
+		}
+		os.Exit(99)
+	case "read":
+		line("GOT1")
+		line("GOT2")
+	case "selfstop-tstp":
+		_ = unix.Kill(os.Getpid(), syscall.SIGTSTP)
+		fmt.Println("RESUMED")
+		line("GOT")
+	case "selfstop-stop":
+		_ = unix.Kill(os.Getpid(), syscall.SIGSTOP)
+		fmt.Println("RESUMED")
+		line("GOT")
+	}
+	os.Exit(code)
+}
+
+// shellSession is an interactive shell on a pty: a session leader with the
+// pty as controlling terminal, as in a terminal emulator.
+type shellSession struct {
+	t    *testing.T
+	r    *ptyRun
+	cmd  *exec.Cmd
+	done chan struct{}
+	pos  int
+}
+
+func needShell(t *testing.T, name string) string {
+	t.Helper()
+	p, err := exec.LookPath(name)
+	if err != nil {
+		t.Skipf("%s not installed", name)
+	}
+	return p
+}
+
+func startShell(t *testing.T, name, dir string) *shellSession {
+	t.Helper()
+	path := needShell(t, name)
+	args := []string{"--norc", "--noprofile", "-i"}
+	if name == "zsh" {
+		args = []string{"-f", "-i"}
+	}
+	r := startPTY(t)
+	_ = unix.IoctlSetWinsize(int(r.slave.Fd()), unix.TIOCSWINSZ, &unix.Winsize{Row: 24, Col: 200})
+	cmd := exec.Command(path, args...)
+	cmd.Dir = dir
+	cmd.Env = []string{"PATH=/usr/bin:/bin:/usr/local/bin", "HOME=" + dir, "TERM=dumb", "LANG=C",
+		"PS1=P> ", "PROMPT=P> ", "HISTFILE=/dev/null", "BASH_SILENCE_DEPRECATION_WARNING=1"}
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = r.slave, r.slave, r.slave
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	s := &shellSession{t: t, r: r, cmd: cmd, done: make(chan struct{})}
+	go func() { _ = cmd.Wait(); close(s.done) }()
+	t.Cleanup(func() {
+		_ = cmd.Process.Kill() // the shell this test started
+		<-s.done
+		r.master.Close()
+		r.slave.Close()
+	})
+	time.Sleep(400 * time.Millisecond)
+	if name == "zsh" {
+		s.send("PROMPT='P> '; unsetopt PROMPT_SP PROMPT_CR; setopt NO_BEEP\n")
+		time.Sleep(500 * time.Millisecond)
+	}
+	s.send("echo SYNC$((1+1))\n")
+	s.waitFor(`SYNC2\nP> $`, 10*time.Second)
+	return s
+}
+
+func (s *shellSession) send(text string) {
+	s.t.Helper()
+	if _, err := s.r.master.WriteString(text); err != nil {
+		s.t.Fatal(err)
+	}
+}
+
+var escapes = regexp.MustCompile(`\x1b\[[0-9;?]*[a-zA-Z]`)
+
+// waitFor waits until the output after the last match contains re, and
+// returns the output since then.
+func (s *shellSession) waitFor(re string, d time.Duration) string {
+	s.t.Helper()
+	rx := regexp.MustCompile(re)
+	end := time.Now().Add(d)
+	for {
+		out := string(s.r.output())
+		if s.pos > len(out) {
+			s.pos = len(out)
+		}
+		// Terminal escapes (bracketed paste, ...) and CRs are not content.
+		text := strings.ReplaceAll(escapes.ReplaceAllString(out[s.pos:], ""), "\r", "")
+		if rx.MatchString(text) {
+			s.pos = len(out)
+			return text
+		}
+		if time.Now().After(end) {
+			s.t.Fatalf("timeout waiting for %q; got %q", re, text)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func (s *shellSession) prompt(d time.Duration) string { return s.waitFor(`P> $`, d) }
+
+// rc reads `$?` of the last command.
+func (s *shellSession) rc() int {
+	s.t.Helper()
+	s.send("echo RC=$?\n")
+	out := s.waitFor(`(?m)^RC=\d+\nP> $`, 10*time.Second)
+	m := regexp.MustCompile(`(?m)^RC=(\d+)$`).FindStringSubmatch(out)
+	n, _ := strconv.Atoi(m[1])
+	return n
+}
+
+// jobs returns the job table with the command text removed.
+func (s *shellSession) jobs() string {
+	s.t.Helper()
+	s.send("echo @@B; jobs; echo @@E\n")
+	out := s.waitFor(`(?m)^@@E\nP> $`, 10*time.Second)
+	m := regexp.MustCompile(`(?ms)^@@B\n(.*)^@@E$`).FindStringSubmatch(out)
+	var lines []string
+	for _, l := range strings.Split(m[1], "\n") {
+		l = regexp.MustCompile(`\s+(HP_AS_MAIN=\S+|\S*(heimdall-proto|\.test)\S*|bash --norc).*$`).ReplaceAllString(l, "")
+		if l = strings.Join(strings.Fields(l), " "); l != "" {
+			lines = append(lines, l)
+		}
+	}
+	return strings.Join(lines, "|")
+}
+
+// notice extracts the stop notice from the text printed up to a prompt:
+// bash "[1]+  Stopped", zsh "zsh: suspended (signal)".
+func notice(out string) string {
+	m := regexp.MustCompile(`(?m)^(\[\d+\][+-]? +(?:Stopped|Running|Done|Exit \d+)|zsh: [a-z]+(?: \([a-z ]+\))?)`).FindStringSubmatch(out)
+	if m == nil {
+		return ""
+	}
+	return strings.Join(strings.Fields(m[1]), " ")
+}
+
+func readPid(t *testing.T, dir string) int {
+	t.Helper()
+	p := filepath.Join(dir, "ready")
+	if !waitFile(p, 10*time.Second) {
+		t.Fatal("child did not start")
+	}
+	b, _ := os.ReadFile(p)
+	n, _ := strconv.Atoi(strings.TrimSpace(string(b)))
+	return n
+}
+
+// procInfo returns the parent PID and the state letter of a process, from
+// /proc on Linux and ps(1) elsewhere.
+func procInfo(pid int) (ppid int, state string, ok bool) {
+	if b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat"); err == nil {
+		s := string(b)
+		f := strings.Fields(s[strings.LastIndexByte(s, ')')+1:])
+		if len(f) < 2 {
+			return 0, "", false
+		}
+		n, _ := strconv.Atoi(f[1])
+		return n, f[0], true
+	}
+	out, err := exec.Command("ps", "-o", "ppid=,stat=", "-p", strconv.Itoa(pid)).Output()
+	f := strings.Fields(string(out))
+	if err != nil || len(f) < 2 {
+		return 0, "", false
+	}
+	n, _ := strconv.Atoi(f[0])
+	return n, f[1][:1], true
+}
+
+func ppidOf(pid int) int {
+	p, _, _ := procInfo(pid)
+	return p
+}
+
+// alive reports a process that exists and is not a zombie.
+func alive(pid int) bool {
+	_, st, ok := procInfo(pid)
+	return pid > 0 && ok && st != "Z"
+}
+
+func stopped(pid int) bool {
+	_, st, ok := procInfo(pid)
+	return ok && st == "T"
+}
+
+func writeMode(t *testing.T, dir, mode string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(dir, "mode"), []byte(mode), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// launch builds the command line: the test binary stands in for both
+// heimdall-proto (HP_AS_MAIN=1) and the child.
+func launch(variant, meta string) string {
+	self, _ := os.Executable()
+	if variant == "plain" {
+		return self + " hp-child-tty"
+	}
+	m := ""
+	if meta != "" {
+		m = " --meta-file " + meta
+	}
+	return "HP_AS_MAIN=1 " + self + " run" + m + " -- " + self + " hp-child-tty"
+}
+
+var shellsUnderTest = []string{"bash", "zsh"}
+
+// S2: a third party stops the foreground child with SIGSTOP or SIGTSTP and
+// continues it. The shell must print the stop notice for that signal, `$?`
+// is 128+signal, the child is not killed and finishes, and the job is either
+// gone or listed as stopped until `fg`, which then ends it with the child's
+// status. Nothing is left behind.
+func TestJobControlThirdPartyStopContinue(t *testing.T) {
+	for _, shell := range shellsUnderTest {
+		for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+			for _, variant := range []string{"plain", "run"} {
+				name := fmt.Sprintf("%s/%s/%s", shell, unix.SignalName(sig), variant)
+				t.Run(name, func(t *testing.T) {
+					dir := t.TempDir()
+					writeMode(t, dir, "wait 7")
+					s := startShell(t, shell, dir)
+					s.send(launch(variant, "") + " " + dir + "\n")
+					child := readPid(t, dir)
+					launcher := ppidOf(child)
+					s.waitFor(`READY`, 5*time.Second)
+					_ = unix.Kill(child, sig)
+					time.Sleep(500 * time.Millisecond)
+					_ = unix.Kill(child, syscall.SIGCONT) // the child only
+					out := s.prompt(10 * time.Second)
+					if got := notice(out); got == "" {
+						t.Fatalf("no stop notice in %q", out)
+					}
+					if rc := s.rc(); rc != 128+int(sig) {
+						t.Errorf("$? = %d, want %d", rc, 128+int(sig))
+					}
+					_ = os.WriteFile(filepath.Join(dir, "stop"), []byte("1"), 0o600)
+					time.Sleep(600 * time.Millisecond) // the child finishes on its own
+					j := s.jobs()
+					if strings.Contains(j, "Stopped") || strings.Contains(j, "suspended") {
+						if variant == "plain" {
+							t.Errorf("plain exec lists the job as %q", j)
+						}
+						s.send("fg\n")
+						s.prompt(10 * time.Second)
+						if rc := s.rc(); rc != 7 {
+							t.Errorf("after fg: $? = %d, want 7", rc)
+						}
+						if j := s.jobs(); j != "" {
+							t.Errorf("job still listed after fg: %q", j)
+						}
+					}
+					time.Sleep(200 * time.Millisecond)
+					if variant == "run" && (alive(child) || alive(launcher)) {
+						t.Errorf("left behind: child %v launcher %v", alive(child), alive(launcher))
+					}
+				})
+			}
+		}
+	}
+}
+
+// S3: the child stops itself with SIGTSTP (OpenSSH's ~^Z); only the
+// launcher's PID gets the SIGCONT. The child resumes and, reading the
+// terminal in the background, is stopped by SIGTTIN. The shell lists the job
+// as stopped, never as running while the child is stopped; `fg` lets the
+// child read the next line, and its status becomes `$?`.
+func TestJobControlChildSelfStopLauncherContinued(t *testing.T) {
+	for _, shell := range shellsUnderTest {
+		for _, variant := range []string{"plain", "run"} {
+			t.Run(shell+"/"+variant, func(t *testing.T) {
+				dir := t.TempDir()
+				writeMode(t, dir, "selfstop-tstp 5")
+				s := startShell(t, shell, dir)
+				s.send(launch(variant, "") + " " + dir + "\n")
+				child := readPid(t, dir)
+				launcher := ppidOf(child)
+				if variant == "plain" {
+					launcher = child
+				}
+				out := s.prompt(10 * time.Second)
+				if notice(out) == "" {
+					t.Fatalf("no stop notice in %q", out)
+				}
+				if rc := s.rc(); rc != 128+int(syscall.SIGTSTP) {
+					t.Errorf("$? = %d, want %d", rc, 128+int(syscall.SIGTSTP))
+				}
+				_ = unix.Kill(launcher, syscall.SIGCONT)
+				var last string
+				for i := 0; i < 8; i++ {
+					time.Sleep(150 * time.Millisecond)
+					last = s.jobs()
+					if !strings.Contains(last, "Stopped") && !strings.Contains(last, "suspended") {
+						// Allowed only while the child is not stopped.
+						if stopped(child) {
+							t.Errorf("job listed as %q while the child is stopped", last)
+						}
+					}
+				}
+				if !strings.Contains(last, "Stopped") && !strings.Contains(last, "suspended") {
+					t.Errorf("after the background read the job is %q, want stopped", last)
+				}
+				s.send("fg\n")
+				time.Sleep(500 * time.Millisecond)
+				s.send("typed-after-fg\n")
+				out = s.waitFor(`GOT:typed-after-fg[\s\S]*P> $`, 10*time.Second)
+				if rc := s.rc(); rc != 5 {
+					t.Errorf("$? = %d, want 5", rc)
+				}
+				if j := s.jobs(); j != "" {
+					t.Errorf("job listed after exit: %q", j)
+				}
+				time.Sleep(200 * time.Millisecond)
+				if alive(child) || alive(launcher) {
+					t.Errorf("left behind: child %v launcher %v", alive(child), alive(launcher))
+				}
+			})
+		}
+	}
+}
+
+// S5: SIGSTOP of the child (itself, or a third party) with --meta-file. The
+// shell reports the stop and `$?` is 128+SIGSTOP; the child stays stopped and
+// the launcher alive until `fg`; the child then reads the terminal again,
+// exits 0, `$?` is 0 and the meta file holds CHILD_EXITED.
+func TestJobControlSigstopWithMetaFile(t *testing.T) {
+	for _, shell := range shellsUnderTest {
+		for _, trigger := range []string{"self", "third-party"} {
+			t.Run(shell+"/"+trigger, func(t *testing.T) {
+				dir := t.TempDir()
+				meta := filepath.Join(dir, "meta.json")
+				if trigger == "self" {
+					writeMode(t, dir, "selfstop-stop 0")
+				} else {
+					writeMode(t, dir, "read 0")
+				}
+				s := startShell(t, shell, dir)
+				s.send(launch("run", meta) + " " + dir + "\n")
+				child := readPid(t, dir)
+				launcher := ppidOf(child)
+				if trigger == "third-party" {
+					s.waitFor(`READY`, 5*time.Second)
+					time.Sleep(300 * time.Millisecond)
+					_ = unix.Kill(child, syscall.SIGSTOP)
+				}
+				out := s.prompt(10 * time.Second)
+				if notice(out) == "" {
+					t.Fatalf("no stop notice in %q", out)
+				}
+				if trigger == "third-party" && shell == "zsh" && !strings.Contains(out, "(signal)") {
+					t.Errorf("zsh notice %q does not name a stop by SIGSTOP", out)
+				}
+				if rc := s.rc(); rc != 128+int(syscall.SIGSTOP) {
+					t.Errorf("$? = %d, want %d", rc, 128+int(syscall.SIGSTOP))
+				}
+				time.Sleep(time.Second)
+				if !alive(launcher) || !alive(child) {
+					t.Fatalf("while stopped: launcher alive %v, child alive %v", alive(launcher), alive(child))
+				}
+				s.send("fg\n")
+				time.Sleep(500 * time.Millisecond)
+				s.send("line-one\n")
+				if trigger == "third-party" {
+					time.Sleep(300 * time.Millisecond)
+					s.send("line-two\n")
+				}
+				out = s.prompt(10 * time.Second)
+				if !strings.Contains(out, "GOT") {
+					t.Errorf("typed input did not reach the child: %q", out)
+				}
+				if rc := s.rc(); rc != 0 {
+					t.Errorf("$? = %d, want 0", rc)
+				}
+				var env struct {
+					Code string
+					Data struct {
+						Launched bool
+						ExitCode *int `json:"exit_code"`
+						Signal   *int
+					}
+				}
+				b, err := os.ReadFile(meta)
+				if err != nil || json.Unmarshal(b, &env) != nil || env.Code != "CHILD_EXITED" ||
+					!env.Data.Launched || env.Data.ExitCode == nil || *env.Data.ExitCode != 0 || env.Data.Signal != nil {
+					t.Errorf("meta file %q (%v)", b, err)
+				}
+				time.Sleep(200 * time.Millisecond)
+				if alive(child) || alive(launcher) {
+					t.Errorf("left behind: child %v launcher %v", alive(child), alive(launcher))
+				}
+			})
+		}
+	}
+}
+
+// S4: an interactive bash run through the launcher is suspended with the
+// `suspend` builtin (SIGSTOP to its own process group) and brought back.
+func TestJobControlNestedShellSuspend(t *testing.T) {
+	needShell(t, "bash")
+	self, _ := os.Executable()
+	for _, shell := range shellsUnderTest {
+		for _, variant := range []string{"plain", "run"} {
+			t.Run(shell+"/"+variant, func(t *testing.T) {
+				dir := t.TempDir()
+				s := startShell(t, shell, dir)
+				cmd := "env PS1='I> ' bash --norc --noprofile -i"
+				if variant == "run" {
+					cmd = "HP_AS_MAIN=1 " + self + " run -- " + cmd
+				}
+				s.send(cmd + "\n")
+				s.waitFor(`I> $`, 10*time.Second)
+				s.send("suspend\n")
+				out := s.prompt(10 * time.Second)
+				if notice(out) == "" {
+					t.Fatalf("no stop notice in %q", out)
+				}
+				if rc := s.rc(); rc != 128+int(syscall.SIGSTOP) {
+					t.Errorf("$? = %d, want %d", rc, 128+int(syscall.SIGSTOP))
