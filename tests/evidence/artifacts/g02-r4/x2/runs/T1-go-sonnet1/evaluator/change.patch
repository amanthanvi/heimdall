+//go:build !windows
+
+package run
+
+import (
+	"syscall"
+	"testing"
+)
+
+// stopSignal must decode a stop by every signal, SIGSTOP included, on every
+// Unix platform. syscall.WaitStatus on the BSDs answers Stopped() == false for
+// a SIGSTOP stop, which made heimdall-proto exit 255 and orphan the child on
+// macOS (docs/g02/slice-contract.md §9.5).
+func TestStopSignalDecode(t *testing.T) {
+	enc := func(sig syscall.Signal) syscall.WaitStatus { return syscall.WaitStatus(uint32(sig)<<8 | 0x7f) }
+	for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP, syscall.SIGTTIN, syscall.SIGTTOU} {
+		got, ok := stopSignal(enc(sig))
+		if !ok || got != sig {
+			t.Errorf("stop by %v decoded as %v, %v", sig, got, ok)
+		}
+	}
+	notStops := map[string]syscall.WaitStatus{
+		"exit 0":          0,
+		"exit 7":          7 << 8,
+		"exit 255":        255 << 8,
+		"killed by 9":     9,
+		"killed by 11":    11 | 0x80, // with the core-dump flag
+		"linux continued": 0xffff,
+	}
+	for name, ws := range notStops {
+		if sig, ok := stopSignal(ws); ok {
+			t.Errorf("%s decoded as a stop by %v", name, sig)
+		}
+	}
+}
