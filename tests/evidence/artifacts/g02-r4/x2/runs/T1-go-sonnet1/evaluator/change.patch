+// S1: heimdall-proto started by a program that is not a shell, with no
+// terminal on stdio, in a process group of its own (not orphaned) of a
+// session that has a controlling terminal. A third party stops the child
+// (SIGSTOP or SIGTSTP), waits, and continues the child only. heimdall-proto
+// must not stop itself (nothing would continue it), must exit with the
+// child's status soon after, and leave nothing behind.
+func TestJobControlNonInteractiveParentStopContinue(t *testing.T) {
+	self, _ := os.Executable()
+	for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+		for label, redirect := range map[string]string{"devnull": ">/dev/null 2>&1", "file": ">\"$D/out\" 2>&1"} {
+			t.Run(unix.SignalName(sig)+"/"+label, func(t *testing.T) {
+				dir := t.TempDir()
+				writeMode(t, dir, "wait 7")
+				r := startPTY(t)
+				// `set -m`: the background job gets its own process group; the
+				// shell script (the "program that is not a shell") is the parent.
+				script := `set -m; HP_AS_MAIN=1 "$P" run -- "$P" hp-child-tty "$D" </dev/null ` + redirect +
+					` & wait $!; echo "RC=$?" > "$D/rc"`
+				cmd := exec.Command("/bin/sh", "-c", script)
+				cmd.Env = []string{"PATH=/usr/bin:/bin", "P=" + self, "D=" + dir}
+				cmd.Stdin, cmd.Stdout, cmd.Stderr = r.slave, r.slave, r.slave
+				cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+				if err := cmd.Start(); err != nil {
+					t.Fatal(err)
+				}
+				done := make(chan struct{})
+				go func() { _ = cmd.Wait(); close(done) }()
+				defer func() {
+					select {
+					case <-done:
+					default:
+						_ = cmd.Process.Kill() // the shell this test started
+						<-done
+					}
+					r.master.Close()
+					r.slave.Close()
+				}()
+				child := readPid(t, dir)
+				launcher := ppidOf(child)
+				time.Sleep(200 * time.Millisecond)
+				_ = unix.Kill(child, sig)
+				time.Sleep(500 * time.Millisecond)
+				_ = unix.Kill(child, syscall.SIGCONT)
+				t0 := time.Now()
+				_ = os.WriteFile(filepath.Join(dir, "stop"), []byte("1"), 0o600)
+				rcFile := filepath.Join(dir, "rc")
+				for time.Since(t0) < 6*time.Second { // the shell creates the file before it writes it
+					if b, _ := os.ReadFile(rcFile); strings.HasSuffix(string(b), "\n") {
+						break
+					}
+					time.Sleep(10 * time.Millisecond)
+				}
+				if b, _ := os.ReadFile(rcFile); !strings.HasSuffix(string(b), "\n") {
+					t.Fatalf("heimdall-proto (pid %d) did not exit within 6 s of SIGCONT; child alive %v launcher alive %v",
+						launcher, alive(child), alive(launcher))
+				}
+				if d := time.Since(t0); d > 6*time.Second {
+					t.Errorf("exit took %v", d)
+				}
+				b, _ := os.ReadFile(filepath.Join(dir, "rc"))
+				if strings.TrimSpace(string(b)) != "RC=7" {
+					t.Errorf("status %q, want RC=7", b)
+				}
+				<-done
+				if alive(child) || alive(launcher) {
+					t.Errorf("left behind: child %v launcher %v", alive(child), alive(launcher))
+				}
+			})
+		}
+	}
+}
