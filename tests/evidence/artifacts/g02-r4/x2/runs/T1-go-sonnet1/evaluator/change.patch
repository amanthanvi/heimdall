+func stopSignal(ws syscall.WaitStatus) (syscall.Signal, bool) {
+	raw := uint32(ws)
+	if raw&0xff != 0x7f || raw == 0xffff {
+		return 0, false
+	}
+	return syscall.Signal((raw >> 8) & 0xff), true
