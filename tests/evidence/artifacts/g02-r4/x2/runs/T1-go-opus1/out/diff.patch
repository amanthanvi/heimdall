@@ -0,0 +1,24 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"strconv"
+)
+
+// jcState is the state letter of /proc/<pid>/stat ("" if there is no such
+// process).
+func jcState(pid int) string {
+	if pid <= 0 {
+		return ""
+	}
+	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		return ""
+	}
+	i := bytes.LastIndexByte(b, ')')
+	if i < 0 || i+2 >= len(b) {
+		return "?"
+	}
+	return string(b[i+2])
+}
