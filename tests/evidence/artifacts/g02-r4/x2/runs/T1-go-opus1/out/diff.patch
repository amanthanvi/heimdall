+//go:build darwin || linux
+
+package run
+
+import (
+	"os/exec"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// decodeWait must read stops from the status bits on every platform. Go's
+// BSD syscall.WaitStatus reports a SIGSTOP stop as "continued", which made
+// heimdall-proto exit 255 on darwin when the child was stopped by SIGSTOP
+// (slice-contract §9.5; TASK.md S4/S5).
+func TestDecodeWait(t *testing.T) {
+	stop := func(s syscall.Signal) syscall.WaitStatus { return syscall.WaitStatus(uint32(s)<<8 | 0x7f) }
+	cases := []struct {
+		name string
+		ws   syscall.WaitStatus
+		kind waitKind
+		n    int
+	}{
+		{"exit 0", 0, waitExited, 0},
+		{"exit 7", 7 << 8, waitExited, 7},
+		{"exit 255", 255 << 8, waitExited, 255},
+		{"SIGKILL", syscall.WaitStatus(syscall.SIGKILL), waitSignaled, int(syscall.SIGKILL)},
+		{"SIGSEGV with core", syscall.WaitStatus(0x80 | uint32(syscall.SIGSEGV)), waitSignaled, int(syscall.SIGSEGV)},
+		{"stopped SIGSTOP", stop(syscall.SIGSTOP), waitStopped, int(syscall.SIGSTOP)},
+		{"stopped SIGTSTP", stop(syscall.SIGTSTP), waitStopped, int(syscall.SIGTSTP)},
+		{"stopped SIGTTIN", stop(syscall.SIGTTIN), waitStopped, int(syscall.SIGTTIN)},
+		{"stopped SIGTTOU", stop(syscall.SIGTTOU), waitStopped, int(syscall.SIGTTOU)},
+		{"BSD continued", stop(syscall.SIGCONT), waitOther, 0},
+		{"Linux continued", 0xffff, waitOther, 0},
+	}
+	for _, c := range cases {
+		k, n := decodeWait(c.ws)
+		if k != c.kind || n != c.n {
+			t.Errorf("%s (%#x): got (%d, %d), want (%d, %d)", c.name, uint32(c.ws), k, n, c.kind, c.n)
+		}
+	}
+}
+
+// decodeWait agrees with the kernel for a real SIGSTOP stop and a real exit.
+func TestDecodeWaitRealStop(t *testing.T) {
+	cmd := exec.Command("/bin/sleep", "5")
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	pid := cmd.Process.Pid
+	defer func() { _ = syscall.Kill(pid, syscall.SIGKILL); _, _ = cmd.Process.Wait() }()
+	_ = syscall.Kill(pid, syscall.SIGSTOP)
+	var ws syscall.WaitStatus
+	if _, err := syscall.Wait4(pid, &ws, syscall.WUNTRACED, nil); err != nil {
+		t.Fatal(err)
+	}
+	if k, n := decodeWait(ws); k != waitStopped || n != int(syscall.SIGSTOP) {
+		t.Fatalf("SIGSTOP stop decoded as (%d, %d) from %#x", k, n, uint32(ws))
+	}
+	if st := childState(pid); st != procStopped {
+		t.Fatalf("childState of a stopped child = %d, want procStopped", st)
+	}
+	_ = syscall.Kill(pid, syscall.SIGCONT)
+	waitState(t, pid, procRunning)
+	_ = syscall.Kill(pid, syscall.SIGTERM)
+	waitState(t, pid, procZombie)
+	if _, err := syscall.Wait4(pid, &ws, 0, nil); err != nil {
+		t.Fatal(err)
+	}
+	if k, n := decodeWait(ws); k != waitSignaled || n != int(syscall.SIGTERM) {
+		t.Fatalf("SIGTERM death decoded as (%d, %d) from %#x", k, n, uint32(ws))
+	}
+	if st := childState(pid); st != procGone {
+		t.Fatalf("childState of a reaped child = %d", st)
+	}
+}
+
+func waitState(t *testing.T, pid int, want procState) {
+	t.Helper()
+	end := time.Now().Add(3 * time.Second)
+	for time.Now().Before(end) {
+		if childState(pid) == want {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("pid %d: state %d, want %d", pid, childState(pid), want)
+}
