+// p_stat values of <sys/proc.h>.
+const (
+	darwinSSTOP = 4
+	darwinSZOMB = 5
+)
+
+// childState reads p_stat through sysctl kern.proc.pid.
+func childState(pid int) procState {
+	kp, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
+	if err != nil {
+		// No record (x/sys reports the empty answer for a missing pid as
+		// an error): tell a missing process from a failed query.
+		if unix.Kill(pid, 0) == unix.ESRCH {
+			return procGone
+		}
+		return procUnknown
+	}
+	if int(kp.Proc.P_pid) != pid {
+		return procGone // the sysctl answers an empty record for no such pid
+	}
+	switch kp.Proc.P_stat {
+	case darwinSSTOP:
+		return procStopped
+	case darwinSZOMB:
+		return procZombie
+	default:
+		return procRunning
+	}
+}
