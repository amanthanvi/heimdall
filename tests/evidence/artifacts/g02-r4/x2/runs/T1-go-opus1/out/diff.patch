+package main
+
+import "golang.org/x/sys/unix"
+
+// jcState maps p_stat (sysctl kern.proc.pid) to a ps-style state letter
+// ("" if there is no such process).
+func jcState(pid int) string {
+	if pid <= 0 {
+		return ""
+	}
+	kp, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
+	if err != nil || int(kp.Proc.P_pid) != pid {
+		return ""
+	}
+	switch kp.Proc.P_stat {
+	case 1:
+		return "I"
+	case 2:
+		return "R"
+	case 3:
+		return "S"
+	case 4:
+		return "T"
+	case 5:
+		return "Z"
+	}
+	return "?"
+}
