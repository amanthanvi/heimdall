 }
+
+// childState reads the state letter of /proc/<pid>/stat (field 3).
+func childState(pid int) procState {
+	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		if os.IsNotExist(err) {
+			return procGone
+		}
+		return procUnknown
+	}
+	// "pid (comm) state ...": comm may contain spaces and ')'.
+	i := bytes.LastIndexByte(b, ')')
+	if i < 0 || i+2 >= len(b) {
+		return procUnknown
+	}
+	switch b[i+2] {
+	case 'T', 't': // job-control stop; tracing stop counts as stopped (act on the report)
+		return procStopped
+	case 'Z', 'X':
+		return procZombie
+	default:
+		return procRunning
+	}
+}
