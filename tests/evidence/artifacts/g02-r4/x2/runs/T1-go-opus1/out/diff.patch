index 0000000..9aca43f
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/jobctl_test.go
@@ -0,0 +1,461 @@
+//go:build darwin || linux
+
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Exec-equivalent job control (TASK.md S1-S5). A minimal job-control shell
+// (hp-jc-shell, below) runs `heimdall-proto run -- <helper child>` the way
+// bash and zsh do: as a session leader on a fresh pty, with the job in its
+// own process group that gets the terminal, waiting with WUNTRACED. It
+// records exactly what a shell bases its stop notice and `$?` on (the wait
+// status of its child, heimdall-proto), and runs `fg`/`bg` on request. The
+// tests compare that with what plain exec of the child would give.
+
+func init() {
+	helperChildren["hp-jc-shell"] = jcShell
+	helperChildren["hp-jc-child"] = jcChild
+}
+
+func jcPut(dir, name, text string) {
+	p := filepath.Join(dir, name)
+	_ = os.WriteFile(p+".part", []byte(text), 0o600)
+	_ = os.Rename(p+".part", p)
+}
+
+// jcChild is the job's child (argv[1] == "hp-jc-child"); HP_JC_MODE selects:
+//
+//	run            run ~1.5 s without touching the terminal, exit 7
+//	selfstop:SIG:N stop itself with kill(getpid(), SIG), then read one line
+//	               from stdin, exit N
+//	read:N         read one line from stdin, exit N
+func jcChild(dir string) {
+	id, _ := json.Marshal(map[string]int{"pid": os.Getpid(), "ppid": os.Getppid(), "pgrp": unix.Getpgrp()})
+	jcPut(dir, "child.json", string(id))
+	f := strings.Split(os.Getenv("HP_JC_MODE"), ":")
+	readLine := func(rc string) {
+		buf := make([]byte, 256)
+		n, _ := os.Stdin.Read(buf)
+		jcPut(dir, "got", string(buf[:max(n, 0)]))
+		code, _ := strconv.Atoi(rc)
+		os.Exit(code)
+	}
+	switch f[0] {
+	case "run":
+		start := time.Now()
+		for i := 0; time.Since(start) < 1500*time.Millisecond; i++ {
+			jcPut(dir, "beat", strconv.Itoa(i))
+			time.Sleep(10 * time.Millisecond)
+		}
+		jcPut(dir, "done", "1")
+		os.Exit(7)
+	case "selfstop":
+		_ = unix.Kill(os.Getpid(), unix.SignalNum(f[1]))
+		jcPut(dir, "resumed", "1")
+		readLine(f[2])
+	case "read":
+		jcPut(dir, "reading", "1")
+		readLine(f[1])
+	}
+	os.Exit(99)
+}
+
+// jcShell is the minimal job-control shell (argv[1] == "hp-jc-shell"). It
+// starts dir/argv.json as a job with HP_AS_MAIN=1. With HP_JC_NOJC=1 it is a
+// plain non-shell parent instead (TASK.md S1): the job gets a process group
+// of its own but not the terminal, stdio is /dev/null, and it waits without
+// WUNTRACED. Every wait result is appended to dir/events ("stopped SIGTSTP",
+// "exited 7", "signaled SIGKILL"); after a stop it takes the terminal back
+// and then runs dir/cmd.<n> ("fg" or "bg") as they appear, while it keeps
+// waiting for further state changes.
+func jcShell(dir string) {
+	var argv []string
+	_ = json.Unmarshal(must(os.ReadFile(filepath.Join(dir, "argv.json"))), &argv)
+	nojc := os.Getenv("HP_JC_NOJC") == "1"
+	// Like a shell: SIGTSTP and SIGTTIN do not stop it (handled here, so they
+	// are SIG_DFL in the job); SIGTTOU is ignored only after the start, so the
+	// job does not inherit the ignore.
+	signal.Notify(make(chan os.Signal, 1), syscall.SIGTSTP, syscall.SIGTTIN)
+	own := unix.Getpgrp()
+	cmd := exec.Command(argv[0], argv[1:]...)
+	cmd.Env = append(os.Environ(), "HP_AS_MAIN=1")
+	if nojc {
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	} else {
+		cmd.Stdin, cmd.Stdout, cmd.Stderr = os.Stdin, os.Stdout, os.Stderr
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true, Foreground: true, Ctty: 0}
+	}
+	if err := cmd.Start(); err != nil {
+		jcPut(dir, "events", "start-error\n")
+		os.Exit(1)
+	}
+	signal.Ignore(syscall.SIGTTOU)
+	pid := cmd.Process.Pid
+	var events []string
+	add := func(e string) {
+		events = append(events, e)
+		jcPut(dir, "events", strings.Join(events, "\n")+"\n")
+	}
+	flags := syscall.WUNTRACED
+	if nojc {
+		flags = 0
+	}
+	ch := make(chan uint32)
+	go func() {
+		for {
+			var ws syscall.WaitStatus
+			_, err := syscall.Wait4(pid, &ws, flags, nil)
+			if err == syscall.EINTR {
+				continue
+			}
+			if err != nil {
+				close(ch)
+				return
+			}
+			ch <- uint32(ws)
+			if uint32(ws)&0xff != 0x7f { // exited or killed
+				close(ch)
+				return
+			}
+		}
+	}()
+	next := 1
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case w, ok := <-ch:
+			if !ok {
+				os.Exit(0)
+			}
+			switch {
+			case w&0xff == 0x7f:
+				_ = unix.IoctlSetPointerInt(0, unix.TIOCSPGRP, own) // take the terminal back
+				add("stopped " + unix.SignalName(syscall.Signal(w>>8&0xff)))
+			case w&0x7f == 0:
+				add(fmt.Sprintf("exited %d", w>>8&0xff))
+			default:
+				add("signaled " + unix.SignalName(syscall.Signal(w&0x7f)))
+			}
+		case <-tick.C:
+			b, err := os.ReadFile(filepath.Join(dir, "cmd."+strconv.Itoa(next)))
+			if err != nil {
+				continue
+			}
+			next++
+			switch strings.TrimSpace(string(b)) {
+			case "fg":
+				_ = unix.IoctlSetPointerInt(0, unix.TIOCSPGRP, pid)
+				_ = unix.Kill(-pid, syscall.SIGCONT)
+			case "bg":
+				_ = unix.Kill(-pid, syscall.SIGCONT)
+			}
+		}
+	}
+}
+
+type jcRun struct {
+	t     *testing.T
+	dir   string
+	pty   *ptyRun
+	shell *exec.Cmd
+	done  chan struct{}
+	child int // the job's child (helper)
+	proto int // heimdall-proto
+	ncmd  int
+}
+
+// startJC starts the mini shell on a fresh pty with the job
+// `heimdall-proto run <runArgs...> -- <this binary> hp-jc-child <dir>`.
+func startJC(t *testing.T, mode string, nojc bool, runArgs ...string) *jcRun {
+	t.Helper()
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	argv := append(append([]string{self, "run"}, runArgs...), "--", self, "hp-jc-child", dir)
+	b, _ := json.Marshal(argv)
+	jcPut(dir, "argv.json", string(b))
+	r := startPTY(t)
+	sh := exec.Command(self, "hp-jc-shell", dir)
+	sh.Env = []string{"PATH=/usr/bin:/bin", "HP_JC_MODE=" + mode}
+	if nojc {
+		sh.Env = append(sh.Env, "HP_JC_NOJC=1")
+	}
+	sh.Stdin, sh.Stdout, sh.Stderr = r.slave, r.slave, r.slave
+	sh.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+	if err := sh.Start(); err != nil {
+		t.Fatal(err)
+	}
+	j := &jcRun{t: t, dir: dir, pty: r, shell: sh, done: make(chan struct{})}
+	go func() { _ = sh.Wait(); close(j.done) }()
+	t.Cleanup(j.cleanup)
+	if !waitFile(filepath.Join(dir, "child.json"), 10*time.Second) {
+		t.Fatalf("the child did not start; events %q", j.events())
+	}
+	var id struct{ Pid, Ppid int }
+	_ = json.Unmarshal(must(os.ReadFile(filepath.Join(dir, "child.json"))), &id)
+	j.child, j.proto = id.Pid, id.Ppid
+	return j
+}
+
+// cleanup releases what this test started and left running: the child and
+// heimdall-proto (exact PIDs reported by this run's child), then the shell.
+func (j *jcRun) cleanup() {
+	for _, p := range []int{j.child, j.proto} {
+		if st := jcState(p); p > 1 && st != "" && st != "Z" {
+			_ = unix.Kill(p, syscall.SIGKILL)
+		}
+	}
+	select {
+	case <-j.done:
+	case <-time.After(5 * time.Second):
+		_ = j.shell.Process.Kill()
+		<-j.done
+	}
+	j.pty.master.Close()
+	j.pty.slave.Close()
+}
+
+func (j *jcRun) events() []string {
+	return readLines(filepath.Join(j.dir, "events"))
+}
+
+// event waits for the n-th (1-based) wait result of the shell.
+func (j *jcRun) event(n int, d time.Duration) string {
+	end := time.Now().Add(d)
+	for {
+		if ev := j.events(); len(ev) >= n {
+			return ev[n-1]
+		}
+		if time.Now().After(end) {
+			return fmt.Sprintf("<none after %v; events %q>", d, j.events())
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func (j *jcRun) command(c string) {
+	j.ncmd++
+	jcPut(j.dir, "cmd."+strconv.Itoa(j.ncmd), c)
+}
+
+func (j *jcRun) typeLine(s string) {
+	if _, err := j.pty.master.Write([]byte(s + "\n")); err != nil {
+		j.t.Fatal(err)
+	}
+}
+
+func (j *jcRun) file(name string) string {
+	return string(must(os.ReadFile(filepath.Join(j.dir, name))))
+}
+
+func (j *jcRun) exists(name string) bool {
+	_, err := os.Stat(filepath.Join(j.dir, name))
+	return err == nil
+}
+
+// waitState waits until jcState(pid) == want.
+func waitState(pid int, want string, d time.Duration) bool {
+	end := time.Now().Add(d)
+	for time.Now().Before(end) {
+		if jcState(pid) == want {
+			return true
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	return jcState(pid) == want
+}
+
+// S2: a third party stops the foreground child (SIGSTOP or SIGTSTP) and then
+// continues the child's PID only. The shell sees the job stop with the
+// child's signal (so `$?` is 128 + that signal, as with plain exec); the
+// child is continued and runs to completion; `fg` then ends the job with the
+// child's status (permitted deviation (b)), and nothing is left behind.
+func TestJobControlThirdPartyStopThenContinueChild(t *testing.T) {
+	for _, s := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+		t.Run(unix.SignalName(s), func(t *testing.T) {
+			j := startJC(t, "run", false)
+			time.Sleep(100 * time.Millisecond)
+			_ = unix.Kill(j.child, s)
+			if ev := j.event(1, 3*time.Second); ev != "stopped "+unix.SignalName(s) {
+				t.Fatalf("shell saw %q, want the stop by %s (plain exec: $? = %d)", ev, unix.SignalName(s), 128+int(s))
+			}
+			time.Sleep(500 * time.Millisecond)
+			_ = unix.Kill(j.child, syscall.SIGCONT) // the child's PID only
+			if !waitFile(filepath.Join(j.dir, "done"), 5*time.Second) {
+				t.Fatalf("the child did not run to completion after its SIGCONT (state %q)", jcState(j.child))
+			}
+			time.Sleep(200 * time.Millisecond)
+			if ev := j.events(); len(ev) == 1 { // (b): the job is still listed as stopped
+				j.command("fg")
+			}
+			if ev := j.event(2, 5*time.Second); ev != "exited 7" {
+				t.Fatalf("job ended with %q, want exited 7", ev)
+			}
+			<-j.done
+			if st := jcState(j.child); st != "" {
+				t.Fatalf("child left behind in state %q", st)
+			}
+		})
+	}
+}
+
+// S3: the child stops itself with SIGTSTP (OpenSSH ~^Z), then a third party
+// continues heimdall-proto's PID only. As with plain exec (where that
+// SIGCONT reaches the child), the child resumes, is stopped by SIGTTIN when
+// it reads the terminal in the background, and the shell sees that stop.
+// `fg` then gives the child the terminal and its status ends the job.
+func TestJobControlSelfStopThenContinueLauncher(t *testing.T) {
+	j := startJC(t, "selfstop:SIGTSTP:5", false)
+	if ev := j.event(1, 3*time.Second); ev != "stopped SIGTSTP" {
+		t.Fatalf("shell saw %q, want stopped SIGTSTP", ev)
+	}
+	_ = unix.Kill(j.proto, syscall.SIGCONT) // heimdall-proto's PID only
+	if !waitFile(filepath.Join(j.dir, "resumed"), 3*time.Second) {
+		t.Fatalf("the child was not continued (state %q)", jcState(j.child))
+	}
+	if ev := j.event(2, 3*time.Second); ev != "stopped SIGTTIN" {
+		t.Fatalf("shell saw %q, want stopped SIGTTIN (the child read the terminal in the background)", ev)
+	}
+	if !waitState(j.child, "T", time.Second) {
+		t.Fatalf("the shell lists the job stopped but the child is in state %q", jcState(j.child))
+	}
+	j.command("fg")
+	time.Sleep(200 * time.Millisecond)
+	j.typeLine("after-fg")
+	if ev := j.event(3, 5*time.Second); ev != "exited 5" {
+		t.Fatalf("job ended with %q, want exited 5", ev)
+	}
+	if got := j.file("got"); got != "after-fg\n" {
+		t.Fatalf("child read %q", got)
+	}
+}
+
+// S5 (and S4, whose nested shell's `suspend` is a SIGSTOP of its own group):
+// the child is stopped by SIGSTOP, from itself or from a third party, under
+// --meta-file. The shell sees a SIGSTOP stop (not SIGTSTP, and not an exit:
+// darwin used to exit 255 here); the child stays stopped and heimdall-proto
+// alive until `fg`; then the child reads the terminal and exits 0, and the
+// meta file records it.
+func TestJobControlSIGSTOPWithMetaFile(t *testing.T) {
+	for _, trig := range []string{"self", "third-party"} {
+		t.Run(trig, func(t *testing.T) {
+			mode := "selfstop:SIGSTOP:0"
+			if trig != "self" {
+				mode = "read:0"
+			}
+			meta := filepath.Join(t.TempDir(), "meta ü.json")
+			j := startJC(t, mode, false, "--meta-file", meta)
+			if trig != "self" {
+				if !waitFile(filepath.Join(j.dir, "reading"), 3*time.Second) {
+					t.Fatal("the child did not reach its read")
+				}
+				time.Sleep(100 * time.Millisecond)
+				_ = unix.Kill(j.child, syscall.SIGSTOP)
+			}
+			if ev := j.event(1, 3*time.Second); ev != "stopped SIGSTOP" {
+				t.Fatalf("shell saw %q, want stopped SIGSTOP", ev)
+			}
+			time.Sleep(500 * time.Millisecond)
+			if c, p := jcState(j.child), jcState(j.proto); c != "T" || p != "T" || j.exists("resumed") {
+				t.Fatalf("before fg: child %q, heimdall-proto %q (want both stopped), resumed=%v", c, p, j.exists("resumed"))
+			}
+			j.command("fg")
+			time.Sleep(200 * time.Millisecond)
+			j.typeLine("line")
+			if ev := j.event(2, 5*time.Second); ev != "exited 0" {
+				t.Fatalf("job ended with %q, want exited 0", ev)
+			}
+			if got := j.file("got"); got != "line\n" {
+				t.Fatalf("child read %q", got)
+			}
+			var m struct {
+				Code string
+				Data map[string]any
+			}
+			if err := json.Unmarshal(must(os.ReadFile(meta)), &m); err != nil {
+				t.Fatal(err)
+			}
+			if m.Code != "CHILD_EXITED" || m.Data["launched"] != true || m.Data["exit_code"] != float64(0) || m.Data["signal"] != nil {
+				t.Fatalf("meta %+v", m)
+			}
+		})
+	}
+}
+
+// K6e regression: Ctrl-Z (terminal SIGTSTP to the child's foreground group),
+// `bg` (the child's background read then stops it with SIGTTIN, as with
+// plain exec), then `fg`: the child reads the terminal and the job is not
+// reported stopped again after `fg`.
+func TestJobControlCtrlZBgFg(t *testing.T) {
+	j := startJC(t, "read:4", false)
+	if !waitFile(filepath.Join(j.dir, "reading"), 3*time.Second) {
+		t.Fatal("the child did not reach its read")
+	}
+	time.Sleep(100 * time.Millisecond)
+	if _, err := j.pty.master.Write([]byte{0x1a}); err != nil {
+		t.Fatal(err)
+	}
+	if ev := j.event(1, 3*time.Second); ev != "stopped SIGTSTP" {
+		t.Fatalf("shell saw %q, want stopped SIGTSTP", ev)
+	}
+	j.command("bg")
+	if ev := j.event(2, 3*time.Second); ev != "stopped SIGTTIN" {
+		t.Fatalf("shell saw %q after bg, want stopped SIGTTIN", ev)
+	}
+	j.command("fg")
+	time.Sleep(300 * time.Millisecond)
+	if ev := j.events(); len(ev) != 2 {
+		t.Fatalf("re-stopped after fg: %q", ev)
+	}
+	j.typeLine("zbf")
+	if ev := j.event(3, 5*time.Second); ev != "exited 4" {
+		t.Fatalf("job ended with %q, want exited 4", ev)
+	}
+	if got := j.file("got"); got != "zbf\n" {
+		t.Fatalf("child read %q", got)
+	}
+}
+
+// S1: a non-shell parent (stdio /dev/null, heimdall-proto in a process group
+// of its own that is not orphaned, a controlling terminal present but not
+// given to the job): a third party stops the child and continues the child's
+// PID only. heimdall-proto must neither exit nor stop itself; it returns the
+// child's status within 6 s of the SIGCONT and leaves nothing behind.
+func TestThirdPartyStopContinueNonShellParent(t *testing.T) {
+	for _, s := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+		t.Run(unix.SignalName(s), func(t *testing.T) {
+			j := startJC(t, "run", true)
+			time.Sleep(100 * time.Millisecond)
+			_ = unix.Kill(j.child, s)
+			time.Sleep(500 * time.Millisecond)
+			if st := jcState(j.proto); st == "T" || st == "Z" || st == "" {
+				t.Fatalf("heimdall-proto is in state %q while the child is stopped (want waiting)", st)
+			}
+			_ = unix.Kill(j.child, syscall.SIGCONT)
+			if ev := j.event(1, 6*time.Second); ev != "exited 7" {
+				t.Fatalf("heimdall-proto ended with %q, want exited 7 within 6 s of the SIGCONT", ev)
+			}
+			<-j.done
+			if st := jcState(j.child); st != "" {
+				t.Fatalf("child left behind in state %q", st)
+			}
+		})
+	}
+}
