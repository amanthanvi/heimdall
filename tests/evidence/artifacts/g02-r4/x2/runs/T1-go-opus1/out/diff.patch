+// decodeWait decodes a wait(2) status from its bits, which have the same
+// layout on Linux and the BSDs (macOS): low 7 bits 0 = exited with the next
+// byte as the code; low byte 0x7f = stopped with the next byte as the signal;
+// any other low 7 bits = killed by that signal (bit 7 is the core flag).
+// syscall.WaitStatus is not used for stops: on the BSDs its Stopped() reports
+// false for a SIGSTOP stop (it takes the BSD WIFCONTINUED encoding to be a
+// stop by SIGSTOP), which made a SIGSTOP of the child look like an exit with
+// status -1 (exit 255) on darwin (slice-contract §9.5).
+func decodeWait(ws syscall.WaitStatus) (waitKind, int) {
+	w := uint32(ws)
+	switch {
+	case w&0x7f == 0:
+		return waitExited, int(w >> 8 & 0xff)
+	case w&0xff == 0x7f:
+		if sig := syscall.Signal(w >> 8 & 0xff); sig != syscall.SIGCONT {
+			return waitStopped, int(sig)
+		}
+		return waitOther, 0 // BSD WIFCONTINUED (only reported with WCONTINUED)
+	case w&0x7f != 0x7f:
+		return waitSignaled, int(w & 0x7f)
+	}
+	return waitOther, 0 // Linux WIFCONTINUED 0xffff (only reported with WCONTINUED)
