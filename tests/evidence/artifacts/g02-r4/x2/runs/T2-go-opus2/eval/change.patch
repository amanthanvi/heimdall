+		fmt.Fprintln(stdout, "no findings")
+	}
+	for _, f := range findings {
+		fmt.Fprintf(stdout, "%s: %s: %s\n", f.Rule, f.Message, strings.Join(f.KeyPaths, ", "))
+	}
+	return result.ExitCode(code)
 }
 
