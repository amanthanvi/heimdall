@@ -0,0 +1,186 @@
+package lint
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/heimdall-g02/proto-go/internal/profile"
+)
+
+// dest renders one [[destinations]] table. port < 0 omits the key.
+func dest(id, host string, port int, account string, labels ...string) string {
+	var b strings.Builder
+	b.WriteString("[[destinations]]\n")
+	b.WriteString("id = " + quote(id) + "\nalias = " + quote("alias-"+id) + "\nhost = " + quote(host) + "\n")
+	if port >= 0 {
+		b.WriteString("port = " + itoa(port) + "\n")
+	}
+	b.WriteString("account = " + quote(account) + "\n")
+	if labels != nil {
+		q := make([]string, len(labels))
+		for n, l := range labels {
+			q[n] = quote(l)
+		}
+		b.WriteString("labels = [" + strings.Join(q, ", ") + "]\n")
+	}
+	return b.String()
+}
+
+func quote(s string) string { b, _ := json.Marshal(s); return string(b) }
+
+func itoa(n int) string { b, _ := json.Marshal(n); return string(b) }
+
+func parse(t *testing.T, dests ...string) *profile.Profile {
+	t.Helper()
+	src := "schema_version = 1\nname = \"p\"\nrevision = 1\n" + strings.Join(dests, "")
+	p, err := profile.Parse([]byte(src))
+	if err != nil {
+		t.Fatalf("fixture not schema-valid: %v\n%s", err, src)
+	}
+	return p
+}
+
+// f is a compact expected finding: rule, key paths, ids.
+type f struct {
+	rule  string
+	paths []string
+	ids   []string
+}
+
+var messages = map[string]string{
+	RuleDuplicateEndpoint: MsgDuplicateEndpoint,
+	RulePrivilegedPort:    MsgPrivilegedPort,
+	RuleRootAccount:       MsgRootAccount,
+	RuleDuplicateLabel:    MsgDuplicateLabel,
+	RuleLabelCaseVariant:  MsgLabelCaseVariant,
+}
+
+func check(t *testing.T, got []Finding, want ...f) {
+	t.Helper()
+	exp := []Finding{}
+	for _, w := range want {
+		exp = append(exp, Finding{Rule: w.rule, KeyPaths: w.paths, DestinationIDs: w.ids, Message: messages[w.rule]})
+	}
+	gj, _ := json.Marshal(got)
+	ej, _ := json.Marshal(exp)
+	if string(gj) != string(ej) {
+		t.Fatalf("findings\n got: %s\nwant: %s", gj, ej)
+	}
+}
+
+func hosts(is ...int) []string {
+	out := make([]string, len(is))
+	for n, i := range is {
+		out[n] = "destinations[" + itoa(i) + "].host"
+	}
+	return out
+}
+
+func TestCleanProfiles(t *testing.T) {
+	check(t, Lint(parse(t)))
+	check(t, Lint(parse(t,
+		dest("a", "h1", -1, "u", "x", "y"),
+		dest("b", "h2", 2222, "u", "x", "y"),   // identical labels across destinations: not a finding
+		dest("c", "h1", 2222, "Root"),          // same host, other port; Root is not root
+		dest("d", "h3", 22, "root2", "é", "É"), // non-ASCII case is not folded
+		dest("e", "h4", 1024, "rooT"),          // 1024 is not below 1024
+	)))
+}
+
+func TestDuplicateEndpoint(t *testing.T) {
+	// Omitted port equals explicit 22; host compares ASCII-lowercased.
+	p := parse(t,
+		dest("a", "Lab.Example", -1, "u"),
+		dest("b", "other", 2222, "u"),
+		dest("c", "lab.example", 22, "u"),
+		dest("d", "OTHER", 2222, "u"),
+		dest("e", "LAB.EXAMPLE", 2200, "u"),
+		dest("f", "LAB.example", -1, "u"),
+	)
+	check(t, Lint(p),
+		f{RuleDuplicateEndpoint, hosts(0, 2, 5), []string{"a", "c", "f"}},
+		f{RuleDuplicateEndpoint, hosts(1, 3), []string{"b", "d"}},
+	)
+	// Non-ASCII letters are not folded: no group.
+	check(t, Lint(parse(t, dest("a", "Ü.example", -1, "u"), dest("b", "ü.example", -1, "u"))))
+}
+
+func TestPrivilegedPortAndRoot(t *testing.T) {
+	p := parse(t,
+		dest("a", "h1", 1023, "root"),
+		dest("b", "h2", 22, "root"),
+		dest("c", "h3", 1, "ROOT"),
+		dest("d", "h4", -1, "u"),
+		dest("e", "h5", 1024, " root"),
+	)
+	check(t, Lint(p),
+		f{RulePrivilegedPort, []string{"destinations[0].port"}, []string{"a"}},
+		f{RulePrivilegedPort, []string{"destinations[2].port"}, []string{"c"}},
+		f{RuleRootAccount, []string{"destinations[0].account"}, []string{"a"}},
+		f{RuleRootAccount, []string{"destinations[1].account"}, []string{"b"}},
+	)
+}
+
+func TestDuplicateLabel(t *testing.T) {
+	p := parse(t,
+		dest("a", "h1", -1, "u", "z", "y", "z", "y", "z"),
+		dest("b", "h2", -1, "u", "q", "Q"), // case variant only: rule 5, not rule 4
+		dest("c", "h3", -1, "u", "k", "k"),
+	)
+	check(t, Lint(p),
+		f{RuleDuplicateLabel, []string{"destinations[0].labels[0]", "destinations[0].labels[2]", "destinations[0].labels[4]"}, []string{"a"}},
+		f{RuleDuplicateLabel, []string{"destinations[0].labels[1]", "destinations[0].labels[3]"}, []string{"a"}},
+		f{RuleDuplicateLabel, []string{"destinations[2].labels[0]", "destinations[2].labels[1]"}, []string{"c"}},
+		f{RuleLabelCaseVariant, []string{"destinations[1].labels[0]", "destinations[1].labels[1]"}, []string{"b"}},
+	)
+}
+
+func TestLabelCaseVariant(t *testing.T) {
+	p := parse(t,
+		dest("a", "h1", -1, "u", "prod", "web"),
+		dest("b", "h2", -1, "u", "Web", "PROD", "Web"),
+		dest("c", "h3", -1, "u", "web", "lone"),
+		dest("d", "h4", -1, "u", "Lone2", "lone2"),
+	)
+	check(t, Lint(p),
+		f{RuleDuplicateLabel, []string{"destinations[1].labels[0]", "destinations[1].labels[2]"}, []string{"b"}},
+		// Ordered by the set's first occurrence: "prod" at (0,0), "web" at (0,1), "lone2" at (3,0).
+		f{RuleLabelCaseVariant, []string{"destinations[0].labels[0]", "destinations[1].labels[1]"}, []string{"a", "b"}},
+		f{RuleLabelCaseVariant, []string{"destinations[0].labels[1]", "destinations[1].labels[0]", "destinations[1].labels[2]", "destinations[2].labels[0]"}, []string{"a", "b", "c"}},
+		f{RuleLabelCaseVariant, []string{"destinations[3].labels[0]", "destinations[3].labels[1]"}, []string{"d"}},
+	)
+}
+
+func TestRuleOrderAndJSONShape(t *testing.T) {
+	p := parse(t,
+		dest("x1", "H", 80, "root", "a", "A", "a"),
+		dest("x2", "h", 80, "u"),
+	)
+	got := Lint(p)
+	var rules []string
+	for _, g := range got {
+		rules = append(rules, g.Rule)
+	}
+	want := "duplicate-endpoint,privileged-port,privileged-port,root-account,duplicate-label,label-case-variant"
+	if strings.Join(rules, ",") != want {
+		t.Fatalf("rule order %v", rules)
+	}
+	b, _ := json.Marshal(got[0])
+	var m map[string]any
+	_ = json.Unmarshal(b, &m)
+	if len(m) != 4 {
+		t.Fatalf("finding must have exactly four members: %s", b)
+	}
+	if b, _ := json.Marshal(Lint(parse(t))); string(b) != "[]" {
+		t.Fatalf("clean findings must encode as []: %s", b)
+	}
+}
+
+func TestASCIILower(t *testing.T) {
+	for in, want := range map[string]string{"ABCxyz": "abcxyz", "ÄÖÜ": "ÄÖÜ", "K-Z_09": "k-z_09", "İ": "İ"} {
+		if got := asciiLower(in); got != want {
+			t.Errorf("asciiLower(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
