+// Package lint implements `heimdall-proto profile lint` (X2 task T2): findings
+// about a profile that already passed schema validation. It is a pure
+// function of the validated profile: no I/O. Findings name places only by key
+// path and destination id; they never carry any other profile value.
+package lint
+
+import (
+	"fmt"
+
+	"github.com/heimdall-g02/proto-go/internal/profile"
+)
+
+// Rule ids, in rule-number order (findings are emitted in this order).
+const (
+	RuleDuplicateEndpoint = "duplicate-endpoint"
+	RulePrivilegedPort    = "privileged-port"
+	RuleRootAccount       = "root-account"
+	RuleDuplicateLabel    = "duplicate-label"
+	RuleLabelCaseVariant  = "label-case-variant"
+)
+
+// Exact finding messages (fixed text, never derived from input).
+const (
+	MsgDuplicateEndpoint = "destinations share the same host and port"
+	MsgPrivilegedPort    = "port below 1024 other than 22"
+	MsgRootAccount       = "account is root"
+	MsgDuplicateLabel    = "label repeated within a destination"
+	MsgLabelCaseVariant  = "labels differ only in letter case"
+)
+
+// Finding is one lint result. KeyPaths and DestinationIDs are never nil so
+// they encode as JSON arrays.
+type Finding struct {
+	Rule           string   `json:"rule"`
+	KeyPaths       []string `json:"key_paths"`
+	DestinationIDs []string `json:"destination_ids"`
+	Message        string   `json:"message"`
+}
+
+// labelRef is one label occurrence: destination index i, label index j.
+type labelRef struct{ i, j int }
+
+// Lint returns the findings for p, ordered by rule number and, within a
+// rule, as the task specifies. It returns an empty (non-nil) slice when there
+// are no findings. Only destinations are linted; name, revision and [meta]
+// are not.
+func Lint(p *profile.Profile) []Finding {
+	ds := p.Destinations
+	out := []Finding{}
+	out = append(out, duplicateEndpoints(ds)...)
+	out = append(out, privilegedPorts(ds)...)
+	out = append(out, rootAccounts(ds)...)
+	out = append(out, duplicateLabels(ds)...)
+	out = append(out, labelCaseVariants(ds)...)
+	return out
+}
+
+// Rule 1: same ASCII-lowercased host and same effective port. One finding per
+// group of two or more, ordered by the group's first member.
+func duplicateEndpoints(ds []profile.Destination) []Finding {
+	type endpoint struct {
+		host string
+		port int64
+	}
+	groups := map[endpoint][]int{}
+	var order []endpoint
+	for i, d := range ds {
+		k := endpoint{asciiLower(d.Host), effectivePort(d)}
+		if _, seen := groups[k]; !seen {
+			order = append(order, k)
+		}
+		groups[k] = append(groups[k], i)
+	}
+	var out []Finding
+	for _, k := range order {
+		members := groups[k]
+		if len(members) < 2 {
+			continue
+		}
+		paths := make([]string, len(members))
+		for n, i := range members {
+			paths[n] = fmt.Sprintf("destinations[%d].host", i)
+		}
+		out = append(out, newFinding(ds, RuleDuplicateEndpoint, MsgDuplicateEndpoint, paths, members))
+	}
+	return out
+}
+
+// Rule 2: effective port below 1024 and not 22.
+func privilegedPorts(ds []profile.Destination) []Finding {
+	var out []Finding
+	for i, d := range ds {
+		if p := effectivePort(d); p < 1024 && p != 22 {
+			out = append(out, newFinding(ds, RulePrivilegedPort, MsgPrivilegedPort,
+				[]string{fmt.Sprintf("destinations[%d].port", i)}, []int{i}))
+		}
+	}
+	return out
+}
+
+// Rule 3: account exactly "root" (case-sensitive).
+func rootAccounts(ds []profile.Destination) []Finding {
+	var out []Finding
+	for i, d := range ds {
+		if d.Account == "root" {
+			out = append(out, newFinding(ds, RuleRootAccount, MsgRootAccount,
+				[]string{fmt.Sprintf("destinations[%d].account", i)}, []int{i}))
+		}
+	}
+	return out
+}
+
+// Rule 4: within one destination, the same label string (exact comparison)
+// more than once. One finding per (destination, label string), ordered by
+// destination, then by the string's first occurrence.
+func duplicateLabels(ds []profile.Destination) []Finding {
+	var out []Finding
+	for i, d := range ds {
+		occ := map[string][]int{}
+		var order []string
+		for j, l := range d.Labels {
+			if _, seen := occ[l]; !seen {
+				order = append(order, l)
+			}
+			occ[l] = append(occ[l], j)
+		}
+		for _, l := range order {
+			js := occ[l]
+			if len(js) < 2 {
+				continue
+			}
+			paths := make([]string, len(js))
+			for n, j := range js {
+				paths[n] = labelPath(i, j)
+			}
+			out = append(out, newFinding(ds, RuleDuplicateLabel, MsgDuplicateLabel, paths, []int{i}))
+		}
+	}
+	return out
+}
+
+// Rule 5: across the profile, two or more different label strings equal
+// after ASCII-lowercasing. One finding per such set, listing every occurrence
+// of every spelling in (i, j) order; sets ordered by their first occurrence.
+func labelCaseVariants(ds []profile.Destination) []Finding {
+	type set struct {
+		refs      []labelRef
+		spellings map[string]bool
+	}
+	sets := map[string]*set{}
+	var order []string
+	for i, d := range ds {
+		for j, l := range d.Labels {
+			k := asciiLower(l)
+			s := sets[k]
+			if s == nil {
+				s = &set{spellings: map[string]bool{}}
+				sets[k] = s
+				order = append(order, k)
+			}
+			s.refs = append(s.refs, labelRef{i, j})
+			s.spellings[l] = true
+		}
+	}
+	var out []Finding
+	for _, k := range order {
+		s := sets[k]
+		if len(s.spellings) < 2 {
+			continue
+		}
+		paths := make([]string, len(s.refs))
+		idx := make([]int, len(s.refs))
+		for n, r := range s.refs {
+			paths[n] = labelPath(r.i, r.j)
+			idx[n] = r.i
+		}
+		out = append(out, newFinding(ds, RuleLabelCaseVariant, MsgLabelCaseVariant, paths, idx))
+	}
+	return out
+}
+
+// newFinding builds a finding; destIdx lists the destination index of each
+// key path (or of the single place) in key-path order, and becomes the ids in
+// first-appearance order without repeats.
+func newFinding(ds []profile.Destination, rule, msg string, paths []string, destIdx []int) Finding {
+	ids := []string{}
+	seen := map[int]bool{}
+	for _, i := range destIdx {
+		if !seen[i] {
+			seen[i] = true
+			ids = append(ids, ds[i].ID)
+		}
+	}
+	return Finding{Rule: rule, KeyPaths: paths, DestinationIDs: ids, Message: msg}
+}
+
+func labelPath(i, j int) string { return fmt.Sprintf("destinations[%d].labels[%d]", i, j) }
+
+// effectivePort is port, or 22 when omitted. profile.Parse already stores 22
+// for an omitted port, so a zero value only occurs in a hand-built profile.
+func effectivePort(d profile.Destination) int64 {
+	if d.Port == 0 {
+		return 22
+	}
+	return d.Port
+}
+
+// asciiLower maps A-Z to a-z and leaves every other byte (and so every
+// non-ASCII character) unchanged. strings.ToLower is not used: it also folds
+// non-ASCII letters, which the rules exclude.
+func asciiLower(s string) string {
+	b := []byte(s)
+	for n, c := range b {
+		if 'A' <= c && c <= 'Z' {
+			b[n] = c + ('a' - 'A')
+		}
+	}
+	return string(b)
+}
diff --color -ruN -x dist /tmp/x2ws-fabd9b12/eval/base/prototypes/go/internal/lint/lint_test.go /tmp/x2ws-fabd9b12/eval/frozen/go/internal/lint/lint_test.go
