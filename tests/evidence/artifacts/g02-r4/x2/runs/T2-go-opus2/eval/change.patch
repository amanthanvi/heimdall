+// lintProfile triggers every rule. Every value is distinctive so the
+// non-echo check can look for it; ids are the only values allowed out.
+const lintProfile = `schema_version = 1
+name = "NAMEVALUE_q1"
+revision = 7
+
+[meta]
+secret_note = "METAVALUE_q2"
+
+[[destinations]]
+id = "id_one"
+alias = "ALIASVALUE_a1"
+host = "HostValue.Q3"
+port = 80
+account = "root"
+labels = ["LabelValueQ4", "labelvalueq4", "dupvalue_q5", "dupvalue_q5"]
+
+[[destinations]]
+id = "id_two"
+alias = "ALIASVALUE_a2"
+host = "hostvalue.q3"
+port = 80
+account = "ACCOUNTVALUE_q6"
+labels = ["LABELVALUEQ4"]
+
+[[destinations]]
+id = "id_ü_three"
+alias = "ALIASVALUE_a3"
+host = "hostvalue.q3"
+account = "ACCOUNTVALUE_q7"
+`
+
+const lintProfileJSON = `{"schema_version":"1","state":"succeeded","code":"LINT_FINDINGS","data":{"findings":[` +
+	`{"rule":"duplicate-endpoint","key_paths":["destinations[0].host","destinations[1].host"],"destination_ids":["id_one","id_two"],"message":"destinations share the same host and port"},` +
+	`{"rule":"privileged-port","key_paths":["destinations[0].port"],"destination_ids":["id_one"],"message":"port below 1024 other than 22"},` +
+	`{"rule":"privileged-port","key_paths":["destinations[1].port"],"destination_ids":["id_two"],"message":"port below 1024 other than 22"},` +
+	`{"rule":"root-account","key_paths":["destinations[0].account"],"destination_ids":["id_one"],"message":"account is root"},` +
+	`{"rule":"duplicate-label","key_paths":["destinations[0].labels[2]","destinations[0].labels[3]"],"destination_ids":["id_one"],"message":"label repeated within a destination"},` +
+	`{"rule":"label-case-variant","key_paths":["destinations[0].labels[0]","destinations[0].labels[1]","destinations[1].labels[0]"],"destination_ids":["id_one","id_two"],"message":"labels differ only in letter case"}` +
+	`]},"warnings":[],"next":null}` + "\n"
+
+var lintValues = []string{"NAMEVALUE_q1", "METAVALUE_q2", "ALIASVALUE_a", "HostValue.Q3", "hostvalue.q3",
+	"LabelValueQ4", "labelvalueq4", "LABELVALUEQ4", "dupvalue_q5", "ACCOUNTVALUE_q6", "ACCOUNTVALUE_q7"}
+
+func writeProfile(t *testing.T, name, body string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(p, []byte(body), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestProfileLintFindingsExactJSONBothOrders(t *testing.T) {
+	f := writeProfile(t, "lint profile ü ✓.toml", lintProfile)
+	for _, args := range [][]string{
+		{"profile", "lint", "--file", f, "--json"},
+		{"profile", "lint", "--json", "--file", f},
+		{"profile", "lint", "--file=" + f, "--json"},
+	} {
+		code, out, errS := call(args...)
+		if code != 3 || out != lintProfileJSON || errS != "" {
+			t.Fatalf("%v: exit %d\nstdout %s\nstderr %q", args[2:], code, out, errS)
+		}
+	}
+	// Without --json: same exit status (K12), output unspecified.
+	if code, _, _ := call("profile", "lint", "--file", f); code != 3 {
+		t.Fatalf("plain exit %d, want 3", code)
+	}
+}
