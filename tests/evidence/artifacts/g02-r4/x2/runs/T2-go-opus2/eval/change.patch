+// cmdProfileLint reports findings about a schema-valid profile (X2 T2).
+// Input handling is that of profile show. Exit 0 LINT_CLEAN with no
+// findings, 3 LINT_FINDINGS otherwise, with or without --json (K12). No
+// profile value is printed in either mode: findings name places by key path,
+// and only the JSON result carries destination ids. lint writes no file.
+func cmdProfileLint(args []string, stdout, stderr io.Writer) int {
+	p, jsonOut, exit := loadProfileArgs("profile lint", args, stdout, stderr)
+	if p == nil {
+		return exit
+	}
+	findings := lint.Lint(p)
+	code := result.LintClean
+	if len(findings) > 0 {
+		code = result.LintFindings
+	}
