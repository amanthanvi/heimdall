+// Value non-echo: no profile value other than destination ids on stdout or
+// stderr, with or without --json; ids appear only with --json.
+func TestProfileLintNoValueEcho(t *testing.T) {
+	f := writeProfile(t, "values.toml", lintProfile)
+	for _, js := range []bool{false, true} {
+		args := []string{"profile", "lint", "--file", f}
+		if js {
+			args = append(args, "--json")
+		}
+		_, out, errS := call(args...)
+		for _, v := range lintValues {
+			if strings.Contains(out, v) || strings.Contains(errS, v) {
+				t.Fatalf("json=%v: value %q echoed\nstdout %s\nstderr %s", js, v, out, errS)
+			}
+		}
+		if !js && strings.Contains(out, "id_") {
+			t.Fatalf("plain output names an id: %s", out)
+		}
+	}
+}
