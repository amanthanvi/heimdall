+func TestProfileLintUsageErrors(t *testing.T) {
+	f := writeProfile(t, "ok.toml", lintProfile)
+	cases := [][]string{
+		{"profile", "lint"},
+		{"profile", "lint", "--file"},
+		{"profile", "lint", "--bogus", "--file", f},
+		{"profile", "lint", "--file", f, "extra"},
+		{"profile", "lint", "--file", ""},
+	}
+	for _, a := range cases {
+		code, out, errS := call(a...)
+		if code != 2 || out != "" || errS == "" {
+			t.Fatalf("%v: exit %d stdout %q", a, code, out)
+		}
+		js := append([]string{"profile", "lint", "--json"}, a[2:]...)
+		code, out, _ = call(js...)
+		if code != 2 || envelope(t, out)["code"] != "USAGE_ERROR" {
+			t.Fatalf("%v: exit %d stdout %q", js, code, out)
+		}
+	}
+	// Unknown profile verb.
+	if code, out, _ := call("profile", "frob", "--json"); code != 2 || envelope(t, out)["code"] != "USAGE_ERROR" {
+		t.Fatal(code, out)
+	}
+}
+
+// lint writes nothing: run as a real process in an empty working directory
+// with HOME and TMPDIR pointed at empty directories, and check all stay empty.
+func TestProfileLintWritesNothing(t *testing.T) {
+	f := writeProfile(t, "w.toml", lintProfile)
+	before, _ := os.ReadFile(f)
+	work, home, tmp := t.TempDir(), t.TempDir(), t.TempDir()
+	for _, js := range []bool{false, true} {
+		args := []string{"profile", "lint", "--file", f}
+		if js {
+			args = append(args, "--json")
+		}
+		cmd := exec.Command(os.Args[0], args...)
+		cmd.Dir = work
+		cmd.Env = append(os.Environ(), "HP_AS_MAIN=1", "HOME="+home, "TMPDIR="+tmp)
+		cmd.WaitDelay = 10 * time.Second
+		err := cmd.Run()
+		if ee, ok := err.(*exec.ExitError); !ok || ee.ExitCode() != 3 {
+			t.Fatalf("json=%v: %v", js, err)
+		}
+	}
+	for _, d := range []string{work, home, tmp} {
+		if ents, _ := os.ReadDir(d); len(ents) != 0 {
+			t.Fatalf("lint wrote into %s: %v", d, ents)
+		}
+	}
+	if after, _ := os.ReadFile(f); !bytes.Equal(before, after) {
+		t.Fatal("lint modified its input")
+	}
+}
