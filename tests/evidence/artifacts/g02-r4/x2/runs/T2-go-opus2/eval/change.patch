+// Input handling is that of profile show: identical stdout, stderr and exit
+// status for invalid, oversize, missing and non-regular inputs.
+func TestProfileLintMatchesShowOnBadInput(t *testing.T) {
+	fix := testfix.Dir(t)
+	dir := t.TempDir()
+	big := filepath.Join(dir, "big ü.toml")
+	if err := os.WriteFile(big, bytes.Repeat([]byte("#"), 1<<20+1), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	ctrl := writeProfile(t, "ctrl.toml", "schema_version = 1\nname = \"n\"\nrevision = 1\n[[destinations]]\nid = \"i\"\nalias = \"a\"\nhost = \"h\\u001b\"\naccount = \"u\"\n")
+	inputs := []string{big, ctrl, filepath.Join(dir, "missing.toml"), dir}
+	for _, n := range []string{"invalid-malformed.toml", "invalid-port.toml", "invalid-unknown-dest-key.toml",
+		"invalid-forbidden-key.toml", "invalid-schema-version.toml", "invalid-duplicate-alias.toml"} {
+		inputs = append(inputs, filepath.Join(fix, n))
+	}
+	for _, in := range inputs {
+		for _, js := range []bool{true, false} {
+			tail := []string{"--file", in}
+			if js {
+				tail = append(tail, "--json")
+			}
+			sc, so, se := call(append([]string{"profile", "show"}, tail...)...)
+			lc, lo, le := call(append([]string{"profile", "lint"}, tail...)...)
+			if sc != 2 || lc != sc || lo != so || le != se {
+				t.Fatalf("%s json=%v: show (%d %q %q) lint (%d %q %q)", filepath.Base(in), js, sc, so, se, lc, lo, le)
+			}
+			if strings.Contains(lo+le, "HEIMDALL_CANARY_") || strings.Contains(lo+le, "\x1b") {
+				t.Fatalf("%s: value echoed", filepath.Base(in))
+			}
+		}
+	}
+}
