+//go:build !windows
+
+package main
+
+import (
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// K14: a FIFO without a writer given to profile lint is USAGE_ERROR within
+// 2 s, exactly as for profile show, and never blocks.
+func TestProfileLintFIFONeverBlocks(t *testing.T) {
+	fifo := filepath.Join(t.TempDir(), "fifo ü")
+	if err := syscall.Mkfifo(fifo, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	type res struct {
+		code     int
+		out, err string
+	}
+	ch := make(chan res, 1)
+	go func() {
+		c, o, e := call("profile", "lint", "--file", fifo, "--json")
+		ch <- res{c, o, e}
+	}()
+	select {
+	case r := <-ch:
+		sc, so, se := call("profile", "show", "--file", fifo, "--json")
+		if r.code != 2 || envelope(t, r.out)["code"] != "USAGE_ERROR" || r.code != sc || r.out != so || r.err != se {
+			t.Fatalf("lint %+v vs show (%d %q %q)", r, sc, so, se)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("profile lint blocked on a FIFO")
+	}
+}
