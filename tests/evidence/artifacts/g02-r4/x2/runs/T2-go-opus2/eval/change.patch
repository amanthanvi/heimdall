+func TestProfileLintCleanFixtures(t *testing.T) {
+	fix := testfix.Dir(t)
+	for _, f := range []string{
+		filepath.Join(fix, "homelab.toml"),
+		filepath.Join(fix, "spaced dir ü", "prøfile homelab.toml"),
+	} {
+		code, out, errS := call("profile", "lint", "--json", "--file", f)
+		want := `{"schema_version":"1","state":"succeeded","code":"LINT_CLEAN","data":{"findings":[]},"warnings":[],"next":null}` + "\n"
+		if code != 0 || out != want || errS != "" {
+			t.Fatalf("%s: exit %d stdout %q stderr %q", filepath.Base(f), code, out, errS)
+		}
+		if code, _, _ := call("profile", "lint", "--file", f); code != 0 {
+			t.Fatalf("%s plain: exit %d", filepath.Base(f), code)
+		}
+	}
+	// The 100-destination fixture uses account "root" on every third
+	// destination and nothing else that lints.
+	code, out, _ := call("profile", "lint", "--file", filepath.Join(fix, "large-100.toml"), "--json")
+	env := envelope(t, out)
+	fs := env["data"].(map[string]any)["findings"].([]any)
+	if code != 3 || env["code"] != "LINT_FINDINGS" || len(fs) != 33 {
+		t.Fatalf("large-100: exit %d, %d findings", code, len(fs))
+	}
+	for n, x := range fs {
+		m := x.(map[string]any)
+		if m["rule"] != "root-account" || m["key_paths"].([]any)[0] != fmt.Sprintf("destinations[%d].account", 2+3*n) {
+			t.Fatalf("large-100 finding %d: %v", n, m)
+		}
+	}
+	// No destinations at all.
+	f := writeProfile(t, "empty.toml", "schema_version = 1\nname = \"n\"\nrevision = 1\n")
+	if code, out, _ := call("profile", "lint", "--file", f, "--json"); code != 0 || envelope(t, out)["code"] != "LINT_CLEAN" {
