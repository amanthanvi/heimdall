new file mode 100644
index 0000000..e853ff8
--- /dev/null
+++ b/prototypes/go/cmd/heimdall-proto/procstate_linux_test.go
@@ -0,0 +1,27 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"strconv"
+)
+
+// procState is "T" (stopped), "Z" (zombie), "R" (any other live state) or ""
+// (no such process), from /proc/<pid>/stat.
+func procState(pid int) string {
+	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		return ""
+	}
+	i := bytes.LastIndexByte(b, ')')
+	if i < 0 || i+2 >= len(b) {
+		return ""
+	}
+	switch b[i+2] {
+	case 'T', 't':
+		return "T"
+	case 'Z':
+		return "Z"
+	}
+	return "R"
+}
diff --git a/prototypes/go/internal/run/proc_darwin.go b/prototypes/go/internal/run/proc_darwin.go
new file mode 100644
index 0000000..6f401f6
--- /dev/null
+++ b/prototypes/go/internal/run/proc_darwin.go
@@ -0,0 +1,33 @@
+package run
+
+import (
+	"os"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+const sstop = 4 // SSTOP, <sys/proc.h>
+
+// processStopped reports whether process pid is in the stopped state
+// (sysctl kern.proc.pid, p_stat). On error it answers true, which keeps the
+// stop report as read.
+func processStopped(pid int) bool {
+	kp, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
+	if err != nil {
+		return true
+	}
+	return kp.Proc.P_stat == sstop
+}
+
+// selfIgnores reports whether heimdall-proto's disposition of sig is SIG_IGN
+// (sysctl kern.proc.pid, p_sigignore). os/signal cannot answer this for the
+// job-control signals: the Go runtime does not record their inherited
+// disposition.
+func selfIgnores(sig syscall.Signal) bool {
+	kp, err := unix.SysctlKinfoProc("kern.proc.pid", os.Getpid())
+	if err != nil || sig < 1 || sig > 32 {
+		return false
+	}
+	return kp.Proc.P_sigignore&(1<<(uint(sig)-1)) != 0
+}
