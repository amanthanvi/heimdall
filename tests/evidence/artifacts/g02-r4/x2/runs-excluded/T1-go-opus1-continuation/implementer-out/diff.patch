@@ -0,0 +1,973 @@
+//go:build darwin || linux
+
+package main
+
+// Exec-equivalent job control for `heimdall-proto run` (TASK S1-S5). Each
+// scenario runs twice in the same environment: first the child alone (plain
+// exec, the control), then under heimdall-proto. The control's observations
+// (stop notices, `$?`, `jobs`, process states, reaping, typed input reaching
+// the child) are a precondition and are what heimdall-proto is compared with;
+// the meta file is checked for heimdall-proto only. Shells are a real
+// interactive `bash --norc --noprofile -i` or `zsh -f -i` on a fresh pty; S1
+// uses a non-shell parent. The test binary is both heimdall-proto
+// (HP_AS_MAIN=1) and the child (hp-jc-* helpers). Every process signalled is
+// one this test started, by exact PID.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func init() {
+	helperChildren["hp-jc-work"] = func(d string) { jcChild(d, "work") }
+	helperChildren["hp-jc-read"] = func(d string) { jcChild(d, "read") }
+	helperChildren["hp-jc-sleepread"] = func(d string) { jcChild(d, "sleepread") }
+	helperChildren["hp-jc-selftstp"] = func(d string) { jcChild(d, "selftstp") }
+	helperChildren["hp-jc-selfstop"] = func(d string) { jcChild(d, "selfstop") }
+	helperChildren["hp-jc-s1driver"] = func(d string) { jcS1Driver(d, true) }
+	helperChildren["hp-jc-s1driver-plain"] = func(d string) { jcS1Driver(d, false) }
+}
+
+// variant is how a scenario's command line starts the child.
+type variant struct {
+	name     string
+	launcher bool
+}
+
+var (
+	plainExec = variant{"plain", false}
+	underRun  = variant{"heimdall-proto", true}
+)
+
+// line is the shell command line for helper mode with optional run flags.
+func (v variant) line(mode, runFlags string) string {
+	if !v.launcher {
+		return `"$P" ` + mode + ` "$D"` + "\n"
+	}
+	return `"$P" run ` + runFlags + `-- "$P" ` + mode + ` "$D"` + "\n"
+}
+
+func jcPut(d, name, v string) {
+	p := filepath.Join(d, name)
+	_ = os.WriteFile(p+".part", []byte(v), 0o600)
+	_ = os.Rename(p+".part", p)
+}
+
+// jcChild writes "<pid> <ppid>" to <d>/pid, then:
+//   - work: runs 1.5 s, writes <d>/done, exits 7;
+//   - read: reads a line from stdin into <d>/got and exits with it as status;
+//   - sleepread: sleeps 1.5 s, then like read;
+//   - selftstp / selfstop: kill(getpid(), SIGTSTP / SIGSTOP), writes
+//     <d>/resumed once continued, then like read.
+func jcChild(d, mode string) {
+	jcPut(d, "pid", fmt.Sprintf("%d %d", os.Getpid(), os.Getppid()))
+	switch mode {
+	case "work":
+		time.Sleep(1500 * time.Millisecond)
+		jcPut(d, "done", "1")
+		os.Exit(7)
+	case "sleepread":
+		time.Sleep(1500 * time.Millisecond)
+	case "selftstp":
+		_ = syscall.Kill(os.Getpid(), syscall.SIGTSTP)
+	case "selfstop":
+		_ = syscall.Kill(os.Getpid(), syscall.SIGSTOP)
+	}
+	jcPut(d, "resumed", "1")
+	line, _ := bufio.NewReader(os.Stdin).ReadString('\n')
+	jcPut(d, "got", line)
+	n, err := strconv.Atoi(strings.TrimSpace(line))
+	if err != nil {
+		os.Exit(99)
+	}
+	os.Exit(n)
+}
+
+// jcS1Driver is S1's non-shell parent, run as the leader of a session whose
+// controlling terminal is a pty: it starts the child (launcher: under
+// heimdall-proto) in a process group of its own (not orphaned: the driver is
+// in the same session), with no terminal on stdio and not in the terminal's
+// foreground, waits for it, and writes its status to <d>/rc ("hang" after
+// 20 s, then kills it by PID).
+func jcS1Driver(d string, launcher bool) {
+	self, _ := os.Executable()
+	nul, _ := os.Open(os.DevNull)
+	out, _ := os.Create(filepath.Join(d, "launcher-out"))
+	argv := []string{"hp-jc-work", d}
+	if launcher {
+		argv = append([]string{"run", "--", self}, argv...)
+	}
+	cmd := exec.Command(self, argv...)
+	cmd.Env = append(os.Environ(), "HP_AS_MAIN=1")
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = nul, out, out
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	if err := cmd.Start(); err != nil {
+		jcPut(d, "rc", "start-failed")
+		os.Exit(1)
+	}
+	done := make(chan struct{})
+	go func() { _ = cmd.Wait(); close(done) }()
+	select {
+	case <-done:
+		jcPut(d, "rc", strconv.Itoa(cmd.ProcessState.ExitCode()))
+	case <-time.After(20 * time.Second):
+		jcPut(d, "rc", "hang")
+		_ = cmd.Process.Kill()
+		<-done
+	}
+	os.Exit(0)
+}
+
+// jcPids returns the child's PID and, under heimdall-proto, the launcher's
+// (the child's parent); for plain exec the second value is 0.
+func jcPids(t *testing.T, d string, v variant) (child, launcher int) {
+	t.Helper()
+	if !waitFile(filepath.Join(d, "pid"), 10*time.Second) {
+		t.Fatal("child never wrote its pid")
+	}
+	var parent int
+	_, err := fmt.Sscanf(string(must(os.ReadFile(filepath.Join(d, "pid")))), "%d %d", &child, &parent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.launcher {
+		launcher = parent
+	}
+	return child, launcher
+}
+
+// reapLeftover kills a child that a failed scenario left behind (by exact
+// PID; it is a process this test started).
+func reapLeftover(pid int) {
+	if st := procState(pid); st != "" && st != "Z" {
+		_ = syscall.Kill(pid, syscall.SIGKILL)
+	}
+}
+
+func fileExists(p string) bool { _, err := os.Stat(p); return err == nil }
+
+func sigName(s syscall.Signal) string {
+	switch s {
+	case syscall.SIGSTOP:
+		return "SIGSTOP"
+	case syscall.SIGTSTP:
+		return "SIGTSTP"
+	}
+	return strconv.Itoa(int(s))
+}
+
+// s1Result is what a non-shell parent observes in S1.
+type s1Result struct {
+	stoppedState string // the child's state 150 ms after the stop
+	rc           string // the child's (or heimdall-proto's) status, or "hang"
+	completed    bool   // the child ran to completion
+	left         string // processes left behind
+}
+
+// runS1 starts the child (or heimdall-proto) from a non-shell parent, stops
+// the child with sig, waits 0.5 s, continues the child's PID only, and
+// collects the outcome. "direct": the parent is this test process; "ctty":
+// a driver whose session has a controlling terminal that heimdall-proto can
+// open but whose foreground it does not hold.
+func runS1(t *testing.T, v variant, layout string, sig syscall.Signal) s1Result {
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := t.TempDir()
+	var wait func() string
+	var driver *exec.Cmd
+	if layout == "direct" {
+		out, _ := os.Create(filepath.Join(d, "launcher-out"))
+		defer out.Close()
+		argv := []string{"hp-jc-work", d}
+		if v.launcher {
+			argv = append([]string{"run", "--", self}, argv...)
+		}
+		cmd := exec.Command(self, argv...)
+		cmd.Env = append(os.Environ(), "HP_AS_MAIN=1")
+		cmd.Stdout, cmd.Stderr = out, out
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		done := make(chan struct{})
+		go func() { _ = cmd.Wait(); close(done) }()
+		defer func() { _ = cmd.Process.Kill(); <-done }()
+		wait = func() string {
+			select {
+			case <-done:
+				return strconv.Itoa(cmd.ProcessState.ExitCode())
+			case <-time.After(6 * time.Second):
+				return "hang"
+			}
+		}
+	} else {
+		r := startPTY(t)
+		defer r.master.Close()
+		defer r.slave.Close()
+		name := "hp-jc-s1driver-plain"
+		if v.launcher {
+			name = "hp-jc-s1driver"
+		}
+		driver = exec.Command(self, name, d)
+		driver.Stdin, driver.Stdout, driver.Stderr = r.slave, r.slave, r.slave
+		driver.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+		if err := driver.Start(); err != nil {
+			t.Fatal(err)
+		}
+		defer func() {
+			if driver != nil {
+				_ = driver.Wait()
+			}
+		}()
+		wait = func() string {
+			if !waitFile(filepath.Join(d, "rc"), 6*time.Second) {
+				return "hang"
+			}
+			return string(must(os.ReadFile(filepath.Join(d, "rc"))))
+		}
+	}
+	child, launcher := jcPids(t, d, v)
+	defer reapLeftover(child)
+	var res s1Result
+	_ = syscall.Kill(child, sig)
+	time.Sleep(150 * time.Millisecond)
+	res.stoppedState = procState(child)
+	time.Sleep(350 * time.Millisecond)
+	_ = syscall.Kill(child, syscall.SIGCONT) // the child's PID only
+	res.rc = wait()
+	res.completed = fileExists(filepath.Join(d, "done"))
+	if driver != nil {
+		if err := driver.Wait(); err != nil {
+			t.Errorf("driver: %v", err)
+		}
+		driver = nil
+	}
+	pids := []int{child}
+	if launcher != 0 && layout == "ctty" {
+		pids = append(pids, launcher) // "direct": this test reaps it (deferred)
+	}
+	res.left = gone(pids...)
+	return res
+}
+
+// S1: a non-shell parent; a third party stops the child (SIGSTOP or SIGTSTP),
+// waits 0.5 s and continues the child only. As with plain exec, the child
+// must run to completion, heimdall-proto must exit with its status within 6 s
+// of the SIGCONT, and nothing may be left behind. Baseline: in the ctty
+// layout SIGSTOP exited 255 on darwin, and SIGTSTP left heimdall-proto stopped
+// forever.
+func TestJobControlS1ThirdPartyStopNoShell(t *testing.T) {
+	for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+		for _, layout := range []string{"direct", "ctty"} {
+			t.Run(layout+"/"+sigName(sig), func(t *testing.T) {
+				ctl := runS1(t, plainExec, layout, sig)
+				if ctl.stoppedState != "T" || ctl.rc != "7" || !ctl.completed || ctl.left != "" {
+					t.Fatalf("plain-exec control precondition: %+v", ctl)
+				}
+				got := runS1(t, underRun, layout, sig)
+				if got.stoppedState != "T" {
+					t.Errorf("child state %q after %s, want T as with plain exec", got.stoppedState, sigName(sig))
+				}
+				if got.rc != ctl.rc {
+					t.Errorf("heimdall-proto status %q within 6 s of SIGCONT, plain exec %q", got.rc, ctl.rc)
+				}
+				if !got.completed {
+					t.Error("child did not run to completion")
+				}
+				if got.left != "" {
+					t.Errorf("left behind: %s", got.left)
+				}
+			})
+		}
+	}
+}
+
+// An orphaned launcher without a terminal (started with setsid by a daemon,
+// say): the kernel discards a SIGTSTP for the orphaned group under plain exec,
+// but the child's own group is not orphaned, so heimdall-proto undoes the
+// stop; a SIGSTOP stays until a SIGCONT, as with plain exec. Baseline: the
+// SIGTSTP stop was never undone, and the run hung.
+func TestJobControlOrphanedNoTTYStop(t *testing.T) {
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	type obs struct {
+		state string // the child's state 300 ms after the stop
+		rc    string
+		left  string
+	}
+	run := func(t *testing.T, v variant, sig syscall.Signal) obs {
+		d := t.TempDir()
+		argv := []string{"hp-jc-work", d}
+		if v.launcher {
+			argv = append([]string{"run", "--", self}, argv...)
+		}
+		out, _ := os.Create(filepath.Join(d, "out"))
+		defer out.Close()
+		cmd := exec.Command(self, argv...)
+		cmd.Env = append(os.Environ(), "HP_AS_MAIN=1")
+		cmd.Stdout, cmd.Stderr = out, out
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true} // no controlling terminal
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		done := make(chan struct{})
+		go func() { _ = cmd.Wait(); close(done) }()
+		defer func() { _ = cmd.Process.Kill(); <-done }()
+		child, _ := jcPids(t, d, v)
+		defer reapLeftover(child)
+		_ = syscall.Kill(child, sig)
+		time.Sleep(300 * time.Millisecond)
+		o := obs{state: procState(child)}
+		if sig == syscall.SIGSTOP {
+			time.Sleep(700 * time.Millisecond)
+			if st := procState(child); st != "T" {
+				o.state += "->" + st
+			}
+			_ = syscall.Kill(child, syscall.SIGCONT)
+		}
+		select {
+		case <-done:
+			o.rc = strconv.Itoa(cmd.ProcessState.ExitCode())
+		case <-time.After(6 * time.Second):
+			o.rc = "hang"
+		}
+		o.left = gone(child)
+		return o
+	}
+	for _, sig := range []syscall.Signal{syscall.SIGTSTP, syscall.SIGSTOP} {
+		t.Run(sigName(sig), func(t *testing.T) {
+			ctl := run(t, plainExec, sig)
+			wantState := "R" // discarded
+			if sig == syscall.SIGSTOP {
+				wantState = "T"
+			}
+			if ctl.state != wantState || ctl.rc != "7" || ctl.left != "" {
+				t.Fatalf("plain-exec control precondition: %+v (want state %s)", ctl, wantState)
+			}
+			if got := run(t, underRun, sig); got != ctl {
+				t.Errorf("heimdall-proto %+v, plain exec %+v", got, ctl)
+			}
+		})
+	}
+}
+
+// shell is an interactive job-control bash or zsh on a fresh pty.
+type shell struct {
+	t    *testing.T
+	r    *ptyRun
+	cmd  *exec.Cmd
+	done chan struct{}
+	pids []int // processes this test started through the shell
+}
+
+var (
+	reStop   = regexp.MustCompile(`Stopped|suspended`)
+	rePrompt = regexp.MustCompile(`P> `)
+	reRC     = regexp.MustCompile(`RC=(\d+)`)
+)
+
+func shells(t *testing.T) []string {
+	var out []string
+	for _, s := range []string{"bash", "zsh"} {
+		if _, err := exec.LookPath(s); err == nil {
+			out = append(out, s)
+		} else {
+			t.Logf("%s not installed: its forms are not run", s)
+		}
+	}
+	return out
+}
+
+func startShell(t *testing.T, name, dir string) *shell {
+	t.Helper()
+	self, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	argv := []string{"bash", "--norc", "--noprofile", "-i"}
+	if name == "zsh" {
+		argv = []string{"zsh", "-f", "-i"}
+	}
+	path, err := exec.LookPath(argv[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := startPTY(t)
+	cmd := exec.Command(path, argv[1:]...)
+	cmd.Env = []string{"PATH=/usr/bin:/bin", "HOME=" + dir, "TERM=dumb", "LANG=C",
+		"HP_AS_MAIN=1", "P=" + self, "D=" + dir}
+	cmd.Stdin, cmd.Stdout, cmd.Stderr = r.slave, r.slave, r.slave
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true, Setctty: true, Ctty: 0}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	s := &shell{t: t, r: r, cmd: cmd, done: make(chan struct{})}
+	go func() { _ = cmd.Wait(); close(s.done) }()
+	t.Cleanup(s.close)
+	s.send("PS1='P> '; PS2=''\n")
+	if name == "zsh" {
+		s.send("unsetopt prompt_sp prompt_cr; PROMPT='P> '\n")
+	}
+	if s.wait(rePrompt, 0, 5*time.Second) == nil {
+		t.Fatalf("%s: no prompt; output %q", name, r.output())
+	}
+	time.Sleep(200 * time.Millisecond)
+	return s
+}
+
+func (s *shell) send(text string) { _, _ = s.r.master.Write([]byte(text)) }
+func (s *shell) mark() int        { return len(s.r.output()) }
+func (s *shell) since(m int) string {
+	return string(s.r.output()[m:])
+}
+
+func (s *shell) wait(re *regexp.Regexp, from int, d time.Duration) []string {
+	end := time.Now().Add(d)
+	for {
+		if m := re.FindStringSubmatch(s.since(from)); m != nil {
+			return m
+		}
+		if time.Now().After(end) {
+			return nil
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+}
+
+// rc returns the shell's $? (-1 if it did not answer).
+func (s *shell) rc() int {
+	m := s.mark()
+	s.send("echo R\"\"C=$?\n") // the echoed input does not match RC=
+	got := s.wait(reRC, m, 5*time.Second)
+	s.wait(rePrompt, m, 2*time.Second)
+	if got == nil {
+		return -1
+	}
+	n, _ := strconv.Atoi(got[1])
+	return n
+}
+
+// jobs lists the shell's jobs that have not finished (Done/Exit lines are
+// reports of finished jobs).
+func (s *shell) jobs() []string {
+	m := s.mark()
+	s.send("jobs; echo J\"\"END\n")
+	s.wait(regexp.MustCompile(`JEND`), m, 5*time.Second)
+	out := strings.SplitN(s.since(m), "JEND", 2)[0]
+	var live []string
+	for _, l := range strings.Split(out, "\n")[1:] {
+		l = strings.TrimSpace(l)
+		if l == "" || strings.Contains(l, `J""END`) || regexp.MustCompile(`Done|Exit`).MatchString(l) {
+			continue
+		}
+		live = append(live, l)
+	}
+	return live
+}
+
+func (s *shell) alive() bool {
+	select {
+	case <-s.done:
+		return false
+	default:
+		return true
+	}
+}
+
+func (s *shell) close() {
+	for i := 0; i < 2; i++ {
+		s.send("\nexit\n")
+		select {
+		case <-s.done:
+		case <-time.After(300 * time.Millisecond):
+		}
+	}
+	for _, pid := range s.pids {
+		if st := procState(pid); st != "" && st != "Z" {
+			_ = syscall.Kill(pid, syscall.SIGKILL)
+		}
+	}
+	select {
+	case <-s.done:
+	case <-time.After(2 * time.Second):
+		_ = s.cmd.Process.Kill()
+		<-s.done
+	}
+	s.r.master.Close()
+	s.r.slave.Close()
+}
+
+func anyStopped(lines []string) bool {
+	for _, l := range lines {
+		if reStop.MatchString(l) {
+			return true
+		}
+	}
+	return false
+}
+
+// gone reports (after up to 2 s) which of pids still exist.
+func gone(pids ...int) string {
+	end := time.Now().Add(2 * time.Second)
+	for {
+		var left []string
+		for _, p := range pids {
+			if p == 0 {
+				continue
+			}
+			if st := procState(p); st != "" {
+				left = append(left, fmt.Sprintf("%d:%s", p, st))
+			}
+		}
+		if len(left) == 0 || time.Now().After(end) {
+			return strings.Join(left, " ")
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+}
+
+// track registers the processes a scenario started through the shell for
+// cleanup.
+func (s *shell) track(pids ...int) {
+	for _, p := range pids {
+		if p != 0 {
+			s.pids = append(s.pids, p)
+		}
+	}
+}
+
+// s2Result is what S2 shows in the shell.
+type s2Result struct {
+	notice    bool
+	stopRC    int
+	completed bool
+	jobsAfter []string // live jobs once the child has completed
+	fgRC      int      // $? after `fg` when a job was still listed (else -1)
+	jobsEnd   []string
+	left      string
+	shellOK   bool
+}
+
+func runS2(t *testing.T, sh string, v variant, sig syscall.Signal) s2Result {
+	d := t.TempDir()
+	s := startShell(t, sh, d)
+	res := s2Result{fgRC: -1}
+	m := s.mark()
+	s.send(v.line("hp-jc-work", ""))
+	child, launcher := jcPids(t, d, v)
+	s.track(launcher, child)
+	_ = syscall.Kill(child, sig)
+	stopped := time.Now()
+	res.notice = s.wait(reStop, m, 4*time.Second) != nil
+	s.wait(rePrompt, m, 3*time.Second)
+	res.stopRC = s.rc()
+	time.Sleep(time.Until(stopped.Add(500 * time.Millisecond)))
+	_ = syscall.Kill(child, syscall.SIGCONT) // the child's PID only
+	res.completed = waitFile(filepath.Join(d, "done"), 6*time.Second)
+	time.Sleep(300 * time.Millisecond)
+	res.jobsAfter = s.jobs()
+	if len(res.jobsAfter) > 0 && anyStopped(res.jobsAfter) {
+		m := s.mark()
+		s.send("fg\n")
+		s.wait(rePrompt, m, 5*time.Second)
+		res.fgRC = s.rc()
+	}
+	res.jobsEnd = s.jobs()
+	res.left = gone(launcher, child)
+	res.shellOK = s.alive()
+	return res
+}
+
+// S2: the foreground child is stopped by a third party (SIGSTOP/SIGTSTP),
+// then only the child is continued. The shell reports the stop with the same
+// $? as plain exec (128 + that signal); the child runs to completion; either
+// the job ends by itself, as with plain exec, or (permitted deviation) it is
+// listed stopped until `fg`, which ends it with the child's status. Baseline:
+// SIGSTOP gave no stop notice and exit 255 on darwin, and was reported as
+// SIGTSTP on Linux.
+func TestJobControlS2ThirdPartyStopForeground(t *testing.T) {
+	for _, sh := range shells(t) {
+		for _, sig := range []syscall.Signal{syscall.SIGSTOP, syscall.SIGTSTP} {
+			t.Run(sh+"/"+sigName(sig), func(t *testing.T) {
+				ctl := runS2(t, sh, plainExec, sig)
+				if !ctl.notice || ctl.stopRC != 128+int(sig) || !ctl.completed ||
+					len(ctl.jobsAfter) != 0 || ctl.left != "" || !ctl.shellOK {
+					t.Fatalf("plain-exec control precondition: %+v", ctl)
+				}
+				got := runS2(t, sh, underRun, sig)
+				if !got.notice {
+					t.Error("no stop notice")
+				}
+				if got.stopRC != ctl.stopRC {
+					t.Errorf("$? after the stop = %d, plain exec %d", got.stopRC, ctl.stopRC)
+				}
+				if !got.completed {
+					t.Error("child did not run to completion")
+				}
+				switch {
+				case len(got.jobsAfter) == 0: // (a) as with plain exec
+				case anyStopped(got.jobsAfter): // (b) permitted deviation
+					if got.fgRC != 7 {
+						t.Errorf("$? after fg = %d, want the child's 7", got.fgRC)
+					}
+				default:
+					t.Errorf("jobs lists %q: neither finished nor stopped", got.jobsAfter)
+				}
+				if len(got.jobsEnd) > 0 {
+					t.Errorf("jobs left at the end: %q", got.jobsEnd)
+				}
+				if got.left != "" {
+					t.Errorf("left behind: %s", got.left)
+				}
+				if !got.shellOK {
+					t.Error("the interactive shell exited")
+				}
+			})
+		}
+	}
+}
+
+// s3Result is what S3 shows.
+type s3Result struct {
+	notice    bool
+	stopRC    int
+	resumed   bool
+	ttinState string // the child's state after its background read
+	listedRun bool   // jobs listed no stopped job while the child was stopped
+	fgRC      int
+	got       string
+	left      string
+}
+
+func runS3(t *testing.T, sh string, v variant) s3Result {
+	d := t.TempDir()
+	s := startShell(t, sh, d)
+	var res s3Result
+	m := s.mark()
+	s.send(v.line("hp-jc-selftstp", ""))
+	child, launcher := jcPids(t, d, v)
+	s.track(launcher, child)
+	res.notice = s.wait(reStop, m, 4*time.Second) != nil
+	s.wait(rePrompt, m, 3*time.Second)
+	res.stopRC = s.rc()
+	target := child // plain exec: the job's only process
+	if v.launcher {
+		target = launcher // the launcher's PID only
+	}
+	_ = syscall.Kill(target, syscall.SIGCONT)
+	res.resumed = waitFile(filepath.Join(d, "resumed"), 3*time.Second)
+	end := time.Now().Add(2 * time.Second)
+	for procState(child) != "T" && time.Now().Before(end) {
+		time.Sleep(20 * time.Millisecond)
+	}
+	res.ttinState = procState(child)
+	for i := 0; i < 2; i++ {
+		j := s.jobs()
+		if procState(child) == "T" && !anyStopped(j) {
+			res.listedRun = true
+		}
+		time.Sleep(400 * time.Millisecond)
+	}
+	m = s.mark()
+	s.send("fg\n")
+	time.Sleep(600 * time.Millisecond)
+	s.send("4\n")
+	s.wait(rePrompt, m, 5*time.Second)
+	res.fgRC = s.rc()
+	res.got = string(must(os.ReadFile(filepath.Join(d, "got"))))
+	res.left = gone(launcher, child)
+	return res
+}
+
+// S3: the child stops itself with SIGTSTP (OpenSSH ~^Z); a third party then
+// continues the job's process: heimdall-proto's PID only (plain exec: the
+// child's). As with plain exec, the child resumes, is stopped by SIGTTIN when
+// it reads the terminal in the background, the shell never lists the job as
+// running meanwhile, and `fg` gives the child the terminal: it reads the
+// typed line and its status becomes $?.
+func TestJobControlS3SelfStopLauncherContinued(t *testing.T) {
+	for _, sh := range shells(t) {
+		t.Run(sh, func(t *testing.T) {
+			ctl := runS3(t, sh, plainExec)
+			if !ctl.notice || ctl.stopRC != 128+int(syscall.SIGTSTP) || !ctl.resumed || ctl.ttinState != "T" ||
+				ctl.listedRun || ctl.fgRC != 4 || ctl.got != "4\n" || ctl.left != "" {
+				t.Fatalf("plain-exec control precondition: %+v", ctl)
+			}
+			got := runS3(t, sh, underRun)
+			if !got.notice || got.stopRC != ctl.stopRC {
+				t.Errorf("stop notice %v, $? %d; plain exec %d", got.notice, got.stopRC, ctl.stopRC)
+			}
+			if !got.resumed {
+				t.Error("child was not resumed")
+			}
+			if got.ttinState != "T" {
+				t.Errorf("child state %q after its background read, want T (SIGTTIN)", got.ttinState)
+			}
+			if got.listedRun {
+				t.Error("jobs listed no stopped job while the child was stopped")
+			}
+			if got.fgRC != ctl.fgRC || got.got != ctl.got {
+				t.Errorf("after fg: $? %d, child read %q; plain exec %d, %q", got.fgRC, got.got, ctl.fgRC, ctl.got)
+			}
+			if got.left != "" {
+				t.Errorf("left behind: %s", got.left)
+			}
+		})
+	}
+}
+
+// s4Result is what S4 shows in the outer shell.
+type s4Result struct {
+	nestedPrompt bool
+	notice       bool
+	outerPrompt  bool
+	stopRC       int
+	answers      bool // the nested shell answers after fg
+	exitRC       int
+	jobsEnd      []string
+}
+
+func runS4(t *testing.T, sh string, v variant) s4Result {
+	d := t.TempDir()
+	s := startShell(t, sh, d)
+	res := s4Result{stopRC: -1, exitRC: -1}
+	m := s.mark()
+	if v.launcher {
+		s.send(`"$P" run -- bash --norc --noprofile -i` + "\n")
+	} else {
+		s.send("bash --norc --noprofile -i\n")
+	}
+	time.Sleep(800 * time.Millisecond)
+	s.send("PS1='N> '\n")
+	if res.nestedPrompt = s.wait(regexp.MustCompile(`N> `), m, 4*time.Second) != nil; !res.nestedPrompt {
+		return res
+	}
+	m = s.mark()
+	s.send("suspend\n")
+	res.notice = s.wait(reStop, m, 4*time.Second) != nil
+	res.outerPrompt = s.wait(rePrompt, m, 3*time.Second) != nil
+	res.stopRC = s.rc()
+	m = s.mark()
+	s.send("fg\n")
+	time.Sleep(600 * time.Millisecond)
+	s.send("echo NE\"\"STED=ok\n")
+	res.answers = s.wait(regexp.MustCompile(`NESTED=ok`), m, 4*time.Second) != nil
+	m = s.mark()
+	s.send("exit 3\n")
+	s.wait(rePrompt, m, 4*time.Second)
+	res.exitRC = s.rc()
+	res.jobsEnd = s.jobs()
+	return res
+}
+
+// S4: a nested interactive bash is suspended (`suspend` sends SIGSTOP to its
+// group). As with plain exec, the outer shell reports the stop and prompts,
+// `fg` gives the nested shell the terminal back, and `exit 3` becomes the
+// outer $?. Baseline on darwin: heimdall-proto exited 255 and the outer shell
+// lost its terminal.
+func TestJobControlS4NestedShellSuspend(t *testing.T) {
+	if _, err := exec.LookPath("bash"); err != nil {
+		t.Skip("bash not installed")
+	}
+	for _, sh := range shells(t) {
+		t.Run(sh, func(t *testing.T) {
+			ctl := runS4(t, sh, plainExec)
+			if !ctl.nestedPrompt || !ctl.notice || !ctl.outerPrompt || ctl.stopRC != 128+int(syscall.SIGSTOP) ||
+				!ctl.answers || ctl.exitRC != 3 || len(ctl.jobsEnd) != 0 {
+				t.Fatalf("plain-exec control precondition: %+v", ctl)
+			}
+			got := runS4(t, sh, underRun)
+			if !got.nestedPrompt {
+				t.Fatal("nested shell has no prompt")
+			}
+			if !got.notice || !got.outerPrompt {
+				t.Errorf("stop notice %v, outer prompt %v", got.notice, got.outerPrompt)
+			}
+			if got.stopRC != ctl.stopRC {
+				t.Errorf("$? after suspend = %d, plain exec %d", got.stopRC, ctl.stopRC)
+			}
+			if !got.answers {
+				t.Error("nested shell does not answer after fg")
+			}
+			if got.exitRC != ctl.exitRC {
+				t.Errorf("outer $? = %d, plain exec %d", got.exitRC, ctl.exitRC)
+			}
+			if len(got.jobsEnd) > 0 {
+				t.Errorf("jobs left: %q", got.jobsEnd)
+			}
+		})
+	}
+}
+
+// s5Result is what S5 shows.
+type s5Result struct {
+	notice bool
+	stopRC int
+	held   string // "" if the child stayed stopped (and heimdall-proto alive) until fg
+	fgRC   int
+	got    string
+	meta   []byte
+	left   string
+}
+
+func runS5(t *testing.T, sh string, v variant, trigger string) s5Result {
+	d := t.TempDir()
+	s := startShell(t, sh, d)
+	var res s5Result
+	mode := "hp-jc-selfstop"
+	if trigger != "self" {
+		mode = "hp-jc-read"
+	}
+	m := s.mark()
+	s.send(v.line(mode, `--meta-file "$D/meta" `))
+	child, launcher := jcPids(t, d, v)
+	s.track(launcher, child)
+	if trigger != "self" {
+		time.Sleep(300 * time.Millisecond)
+		_ = syscall.Kill(child, syscall.SIGSTOP)
+	}
+	res.notice = s.wait(reStop, m, 4*time.Second) != nil
+	s.wait(rePrompt, m, 3*time.Second)
+	res.stopRC = s.rc()
+	for i := 0; i < 5 && res.held == ""; i++ {
+		if c := procState(child); c != "T" {
+			res.held = "child " + c
+		}
+		if l := procState(launcher); v.launcher && (l == "" || l == "Z") {
+			res.held = "heimdall-proto " + l
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	m = s.mark()
+	s.send("fg\n")
+	time.Sleep(600 * time.Millisecond)
+	s.send("0\n")
+	s.wait(rePrompt, m, 5*time.Second)
+	res.fgRC = s.rc()
+	res.got = string(must(os.ReadFile(filepath.Join(d, "got"))))
+	res.meta = must(os.ReadFile(filepath.Join(d, "meta")))
+	res.left = gone(launcher, child)
+	return res
+}
+
+// S5: with --meta-file, the child is stopped by SIGSTOP (by itself or by a
+// third party). As with plain exec, the shell reports it with $? = 128 +
+// SIGSTOP, the child stays stopped (and heimdall-proto alive) until `fg`, the
+// child then reads the terminal, and its exit 0 gives $? 0; the meta file
+// says CHILD_EXITED {launched:true, exit_code:0, signal:null}.
+func TestJobControlS5SigstopMetaFile(t *testing.T) {
+	for _, sh := range shells(t) {
+		for _, trigger := range []string{"self", "third-party"} {
+			t.Run(sh+"/"+trigger, func(t *testing.T) {
+				ctl := runS5(t, sh, plainExec, trigger)
+				if !ctl.notice || ctl.stopRC != 128+int(syscall.SIGSTOP) || ctl.held != "" ||
+					ctl.fgRC != 0 || ctl.got != "0\n" || ctl.left != "" {
+					t.Fatalf("plain-exec control precondition: %+v", ctl)
+				}
+				got := runS5(t, sh, underRun, trigger)
+				if !got.notice || got.stopRC != ctl.stopRC {
+					t.Errorf("stop notice %v, $? %d; plain exec %d", got.notice, got.stopRC, ctl.stopRC)
+				}
+				if got.held != "" {
+					t.Errorf("before fg: %s (want the child stopped and heimdall-proto alive)", got.held)
+				}
+				if got.fgRC != ctl.fgRC || got.got != ctl.got {
+					t.Errorf("after fg: $? %d, child read %q; plain exec %d, %q", got.fgRC, got.got, ctl.fgRC, ctl.got)
+				}
+				var meta struct {
+					Code string
+					Data map[string]any
+				}
+				if err := json.Unmarshal(got.meta, &meta); err != nil {
+					t.Fatalf("meta file: %v", err)
+				}
+				if meta.Code != "CHILD_EXITED" || meta.Data["launched"] != true ||
+					meta.Data["exit_code"] != float64(0) || meta.Data["signal"] != nil {
+					t.Errorf("meta %+v, want CHILD_EXITED {launched:true, exit_code:0, signal:null}", meta)
+				}
+				if got.left != "" {
+					t.Errorf("left behind: %s", got.left)
+				}
+			})
+		}
+	}
+}
+
+// bgResult is what a background job shows when a third party stops its
+// child and the user then brings it to the foreground.
+type bgResult struct {
+	stopped bool // the child was stopped by the third party
+	fgRC    int
+	got     string
+	jobsEnd []string
+	left    string
+}
+
+func runBackgroundStopFg(t *testing.T, sh string, v variant) bgResult {
+	d := t.TempDir()
+	s := startShell(t, sh, d)
+	res := bgResult{fgRC: -1}
+	m := s.mark()
+	s.send(strings.TrimSuffix(v.line("hp-jc-sleepread", ""), "\n") + " &\n")
+	child, launcher := jcPids(t, d, v)
+	s.track(launcher, child)
+	s.wait(rePrompt, m, 3*time.Second)
+	_ = syscall.Kill(child, syscall.SIGSTOP) // while it sleeps, before it reads
+	time.Sleep(300 * time.Millisecond)
+	res.stopped = procState(child) == "T"
+	time.Sleep(200 * time.Millisecond)
+	m = s.mark()
+	s.send("fg\n")
+	time.Sleep(2500 * time.Millisecond) // the child's remaining sleep, then its read
+	s.send("5\n")
+	s.wait(rePrompt, m, 5*time.Second)
+	res.fgRC = s.rc()
+	res.got = string(must(os.ReadFile(filepath.Join(d, "got"))))
+	res.jobsEnd = s.jobs()
+	res.left = gone(launcher, child)
+	return res
+}
+
+// A background job whose child a third party stops is brought to the
+// foreground with `fg`. The shell's SIGCONT reaches only heimdall-proto,
+// which forwards it to the child (plain exec: the SIGCONT reaches the child
+// directly), so the child goes on, reads the typed line, and its status
+// becomes $?. Without the forwarding, the child stayed stopped while the
+// shell waited for a foreground job that could never finish.
+func TestJobControlBackgroundThirdPartyStopThenFg(t *testing.T) {
+	for _, sh := range shells(t) {
+		t.Run(sh, func(t *testing.T) {
+			ctl := runBackgroundStopFg(t, sh, plainExec)
+			if !ctl.stopped || ctl.fgRC != 5 || ctl.got != "5\n" || len(ctl.jobsEnd) != 0 || ctl.left != "" {
+				t.Fatalf("plain-exec control precondition: %+v", ctl)
+			}
+			got := runBackgroundStopFg(t, sh, underRun)
+			if !got.stopped {
+				t.Error("child was not stopped by the third party")
+			}
+			if got.fgRC != ctl.fgRC || got.got != ctl.got {
+				t.Errorf("after fg: $? %d, child read %q; plain exec %d, %q", got.fgRC, got.got, ctl.fgRC, ctl.got)
+			}
+			if len(got.jobsEnd) > 0 {
+				t.Errorf("jobs left: %q", got.jobsEnd)
+			}
+			if got.left != "" {
+				t.Errorf("left behind: %s", got.left)
+			}
+		})
+	}
+}
