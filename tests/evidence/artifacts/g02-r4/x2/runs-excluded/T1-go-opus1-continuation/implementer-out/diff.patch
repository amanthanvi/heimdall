+func TestSelfIgnoresAndMirrorSignal(t *testing.T) {
+	if selfIgnores(syscall.SIGUSR2) {
+		t.Fatal("SIGUSR2 reported ignored before signal.Ignore")
+	}
+	signal.Ignore(syscall.SIGUSR2)
+	ignored := selfIgnores(syscall.SIGUSR2)
+	signal.Reset(syscall.SIGUSR2)
+	if !ignored {
+		t.Fatal("SIGUSR2 not reported ignored after signal.Ignore")
+	}
+	if selfIgnores(syscall.SIGTSTP) {
+		t.Skip("SIGTSTP inherited as ignored by the test process; mirrorSignal identity not checkable")
+	}
+	for in, want := range map[syscall.Signal]syscall.Signal{
+		syscall.SIGSTOP: syscall.SIGSTOP, // reported as itself (TASK S2/S4/S5), not as SIGTSTP
+		syscall.SIGTSTP: syscall.SIGTSTP,
+		syscall.SIGTTIN: syscall.SIGTTIN,
+		syscall.SIGTTOU: syscall.SIGTSTP, // heimdall-proto ignores SIGTTOU
+	} {
+		if got := mirrorSignal(in); got != want {
+			t.Errorf("mirrorSignal(%v) = %v, want %v", in, got, want)
+		}
+	}
+}
