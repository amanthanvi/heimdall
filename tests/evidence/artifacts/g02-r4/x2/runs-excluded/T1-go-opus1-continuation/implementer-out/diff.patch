+func TestDecodeWait(t *testing.T) {
+	stopRaw := func(s syscall.Signal) uint32 { return uint32(s)<<8 | 0x7f }
+	cases := []struct {
+		name string
+		raw  uint32
+		kind waitKind
+		num  int
+	}{
+		{"exit 0", 0x0000, waitExited, 0},
+		{"exit 7", 0x0700, waitExited, 7},
+		{"exit 255", 0xff00, waitExited, 255},
+		{"killed SIGKILL", 0x0009, waitSignaled, 9},
+		{"killed SIGABRT with core", 0x0086, waitSignaled, 6},
+		// The regression: Go's BSD WaitStatus calls this "continued" on darwin.
+		{"stopped SIGSTOP", stopRaw(syscall.SIGSTOP), waitStopped, int(syscall.SIGSTOP)},
+		{"stopped SIGTSTP", stopRaw(syscall.SIGTSTP), waitStopped, int(syscall.SIGTSTP)},
+		{"stopped SIGTTIN", stopRaw(syscall.SIGTTIN), waitStopped, int(syscall.SIGTTIN)},
+		{"stopped SIGTTOU", stopRaw(syscall.SIGTTOU), waitStopped, int(syscall.SIGTTOU)},
+		{"continued (darwin marker 0x13)", stopRaw(syscall.SIGCONT), waitOther, 0},
+		{"continued (Linux 0xffff)", 0xffff, waitOther, 0},
+	}
+	for _, c := range cases {
+		k, n := decodeWait(c.raw)
+		if k != c.kind || n != c.num {
+			t.Errorf("%s: decodeWait(%#x) = (%d, %d), want (%d, %d)", c.name, c.raw, k, n, c.kind, c.num)
+		}
+	}
+}
+
+// A real SIGSTOP stop of a child decodes as a stop by SIGSTOP on this
+// platform, processStopped follows the stop and the continue, and the final
+// SIGKILL decodes as death by signal 9.
+func TestRealStopDecodeAndState(t *testing.T) {
+	cmd := exec.Command("/bin/sleep", "20")
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	pid := cmd.Process.Pid
+	defer func() { _ = syscall.Kill(pid, syscall.SIGKILL); _ = cmd.Wait() }()
+	_ = syscall.Kill(pid, syscall.SIGSTOP)
+	var ws syscall.WaitStatus
+	if _, err := syscall.Wait4(pid, &ws, syscall.WUNTRACED, nil); err != nil {
+		t.Fatal(err)
+	}
+	if k, n := decodeWait(uint32(ws)); k != waitStopped || n != int(syscall.SIGSTOP) {
+		t.Fatalf("SIGSTOP stop decoded as (%d, %d), raw %#x", k, n, uint32(ws))
+	}
+	if !processStopped(pid) {
+		t.Fatal("processStopped = false for a stopped child")
+	}
+	_ = syscall.Kill(pid, syscall.SIGCONT)
+	end := time.Now().Add(2 * time.Second)
+	for processStopped(pid) && time.Now().Before(end) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if processStopped(pid) {
+		t.Fatal("processStopped = true after SIGCONT")
+	}
+	_ = syscall.Kill(pid, syscall.SIGKILL)
+	if _, err := syscall.Wait4(pid, &ws, 0, nil); err != nil {
+		t.Fatal(err)
+	}
+	if k, n := decodeWait(uint32(ws)); k != waitSignaled || n != 9 {
+		t.Fatalf("SIGKILL death decoded as (%d, %d)", k, n)
+	}
+	cmd.Process.Release()
+}
