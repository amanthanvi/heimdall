@@ -0,0 +1,43 @@
+package run
+
+import (
+	"bytes"
+	"os"
+	"strconv"
+	"syscall"
+)
+
+// processStopped reports whether process pid is in the stopped state
+// (/proc/<pid>/stat state T, or t for a tracing stop). On error it answers
+// true, which keeps the stop report as read.
+func processStopped(pid int) bool {
+	b, err := os.ReadFile("/proc/" + strconv.Itoa(pid) + "/stat")
+	if err != nil {
+		return true
+	}
+	// "pid (comm) state ...": comm may contain spaces and ')'.
+	i := bytes.LastIndexByte(b, ')')
+	if i < 0 || i+2 >= len(b) {
+		return true
+	}
+	st := b[i+2]
+	return st == 'T' || st == 't'
+}
+
+// selfIgnores reports whether heimdall-proto's disposition of sig is SIG_IGN
+// (/proc/self/status SigIgn). os/signal cannot answer this for the
+// job-control signals: the Go runtime does not record their inherited
+// disposition.
+func selfIgnores(sig syscall.Signal) bool {
+	b, err := os.ReadFile("/proc/self/status")
+	if err != nil || sig < 1 || sig > 64 {
+		return false
+	}
+	for _, line := range bytes.Split(b, []byte("\n")) {
+		if v, ok := bytes.CutPrefix(line, []byte("SigIgn:")); ok {
+			mask, err := strconv.ParseUint(string(bytes.TrimSpace(v)), 16, 64)
+			return err == nil && mask&(1<<(uint(sig)-1)) != 0
+		}
+	}
+	return false
+}
