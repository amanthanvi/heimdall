+++ b/prototypes/go/cmd/heimdall-proto/procstate_darwin_test.go
@@ -0,0 +1,19 @@
+package main
+
+import "golang.org/x/sys/unix"
+
+// procState is "T" (stopped), "Z" (zombie), "R" (any other live state) or ""
+// (no such process), from sysctl kern.proc.pid p_stat.
+func procState(pid int) string {
+	kp, err := unix.SysctlKinfoProc("kern.proc.pid", pid)
+	if err != nil || kp.Proc.P_pid != int32(pid) {
+		return ""
+	}
+	switch kp.Proc.P_stat {
+	case 4: // SSTOP
+		return "T"
+	case 5: // SZOMB
+		return "Z"
+	}
+	return "R"
+}
