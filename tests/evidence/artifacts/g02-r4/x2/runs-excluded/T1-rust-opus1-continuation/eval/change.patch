+// ---------- X2 T1: exec-equivalent job control (S1) ----------
+
+/// S1 child: records its PID, runs ~1.2 s of wall time in short sleeps (so a stop
+/// lengthens it), marks completion and exits 7. `sh -c` without exec, so the PID that is
+/// stopped is the one that must run to completion.
+const S1_CHILD: &str = "echo $$ > \"$1/pid.part\" && mv \"$1/pid.part\" \"$1/pid\"; \
+     i=0; while [ $i -lt 24 ]; do sleep 0.05; i=$((i+1)); done; : > \"$1/done\"; exit 7";
