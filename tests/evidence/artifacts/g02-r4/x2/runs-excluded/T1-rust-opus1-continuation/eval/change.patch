+/// X2 T1 S1: a non-interactive parent; a third party stops the child (SIGSTOP and
+/// SIGTSTP), waits 0.5 s and continues the child PID only. As with plain exec, the
+/// child runs to completion, heimdall-proto exits with its status (7) within 6 s of the
+/// SIGCONT, and the child is reaped. Red on the round-3c design: heimdall-proto mirrored
+/// the stop onto itself and, never continued, never exited.
+#[test]
+fn s1_third_party_stop_then_child_only_continue_non_interactive() {
+    use rustix::process::Signal;
+    let d = TempDir::new("s1");
+    for stop in [Signal::STOP, Signal::TSTP] {
+        let (cst, csecs, _) = s1_once(false, stop, d.path());
+        assert_eq!(
+            (cst.code(), d.path().join("done").exists()),
+            (Some(7), true),
+            "control (plain exec, {stop:?}) must complete with 7 (harness precondition)"
+        );
+        let (st, secs, child) = s1_once(true, stop, d.path());
+        assert!(
+            d.path().join("done").exists(),
+            "{stop:?}: the child did not run to completion"
+        );
+        assert_eq!(st.code(), Some(7), "{stop:?}: exit status");
+        assert!(
+            secs < 6.0,
+            "{stop:?}: exit {secs:.2} s after SIGCONT (control {csecs:.2} s)"
+        );
+        assert!(
+            !pid_alive(child),
+            "{stop:?}: child {child} left behind (zombie or orphan)"
+        );
+    }
+}
