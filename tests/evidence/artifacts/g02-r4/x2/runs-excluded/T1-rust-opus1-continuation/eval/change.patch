+def x2_s4(b, kind):
+    """S4: the shell runs (heimdall-proto run --) bash -i; the nested shell runs
+    `suspend`; the outer shell prints a stop notice and its prompt; after `fg` the nested
+    shell answers typed commands; `exit 3` makes the outer $? 3."""
+    seen = {}
+    for via in (False, True):
+        sh = Shell(kind)
+        label = f"{kind}/{'heimdall-proto' if via else 'plain exec'}"
+        pids = []
+        try:
+            assert sh.wait_count(b"HPS1$ ", 1), f"{label}: no prompt"
+            inner = "/bin/bash --norc --noprofile -i"
+            cmd = f"PS1='IN$ ' " + (f'"{b}" run -- {inner}' if via else inner)
+            mark = len(sh.out)
+            sh.send(cmd.encode() + b"\n")
+            assert sh.wait_text_after(mark, b"IN$ ", 6.0), f"{label}: nested shell did not prompt: {sh.out[mark:]!r}"
+            mark = len(sh.out)
+            sh.send(b"echo NESTED-$((40+2)) $$ $PPID\n")
+            assert sh.wait_after(mark, lambda o: re.search(rb"NESTED-42 \d+ \d+", o) is not None, 4.0), \
+                f"{label}: nested shell did not answer: {sh.out[mark:]!r}"
+            m = re.search(rb"NESTED-42 (\d+) (\d+)", sh.out[mark:])
+            pids = [int(m.group(1))] + ([int(m.group(2))] if via else [])
+            mark = len(sh.out)
+            sh.send(b"suspend\n")
+            sw = sh.stopword
+            assert sh.wait_after(mark, lambda o: sw in o and b"HPS1$ " in o[o.find(sw):], 4.0), \
+                f"{label}: outer shell printed no stop notice + prompt: {sh.out[mark:]!r}"
+            st = [proc_state(p) for p in pids]
+            jobs, raw = sh.jobs()
+            assert jobs == "stopped", f"{label}: job not listed stopped: {raw!r}"
+            mark = len(sh.out)
+            sh.send(b"fg\n")
+            assert sh.wait_text_after(mark, b"IN$ ", 4.0), f"{label}: nested prompt not back after fg: {sh.out[mark:]!r}"
+            mark = len(sh.out)
+            sh.send(b"echo BACK-$((1+1))\n")
+            assert sh.wait_text_after(mark, b"BACK-2", 4.0), f"{label}: nested shell did not answer after fg: {sh.out[mark:]!r}"
+            mark = len(sh.out)
+            sh.send(b"exit 3\n")
+            assert sh.wait_text_after(mark, b"HPS1$ ", 4.0), f"{label}: outer prompt not back after exit: {sh.out[mark:]!r}"
+            rc = sh.last_status()
+            assert rc == 3, f"{label}: outer $? {rc}, expected 3"
+            jobs, raw = sh.jobs()
+            assert jobs == "none", f"{label}: job left: {raw!r}"
+            end = time.monotonic() + 5
+            while time.monotonic() < end and any(_pid_exists(p) for p in pids):
+                sh.read_for(0.05)
+            assert not any(_pid_exists(p) for p in pids), f"{label}: process left behind"
+            seen[label] = f"ok (states while suspended {st})"
+        finally:
+            for p in pids:
+                if _pid_exists(p):
+                    try:
+                        os.kill(p, signal.SIGKILL)
+                    except (ProcessLookupError, PermissionError):
+                        pass
+            sh.close()
+    return seen
+
+
+def x2_s5(b, kind, trigger):
+    """S5: `run --meta-file M --` child stopped by SIGSTOP (the child itself, or a third
+    party): notice, $? = 128+SIGSTOP, the child stays stopped and heimdall-proto alive
+    until `fg`, then the child reads the terminal; exit 0 gives $? 0 and the meta file."""
+    seen = {}
+    for via in (False, True):
+        meta = os.path.join(tempfile.mkdtemp(prefix="x2m-", dir=TMP), "meta file.json")
+        j = Job(b, kind, via, JC_CHILD, 0, meta=meta)
+        try:
+            mark = len(j.sh.out)
+            if trigger == "self":
+                j.sh.send(b"stop:SIGSTOP\n")
+            else:
+                os.kill(j.child, signal.SIGSTOP)
+            assert j.wait_notice(mark), f"{j.label}: no stop notice: {j.sh.out[mark:][-300:]!r}"
+            rc = j.sh.last_status()
+            assert rc == 128 + signal.SIGSTOP, f"{j.label}: $? {rc}, expected {128 + signal.SIGSTOP}"
+            j.sh.read_for(1.0)
+            st = j.state()
+            assert stopped(st["child"]), f"{j.label}: child not kept stopped until fg: {st}"
+            if via:
+                assert st["hp"] and st["hp"] != "Z", f"{j.label}: heimdall-proto not alive: {st}"
+            mark = len(j.sh.out)
+            j.sh.send(b"fg\n")
+            j.sh.read_for(0.4)
+            j.sh.send(b"S5-LINE\n")
+            assert j.sh.wait_text_after(mark, b"GOT S5-LINE", 3.0), \
+                f"{j.label}: child did not read the terminal after fg: {j.sh.out[mark:][-300:]!r}"
+            mark = len(j.sh.out)
+            j.sh.send(b"quit\n")
+            assert j.sh.wait_text_after(mark, b"HPS1$ ", 4.0), f"{j.label}: no prompt after quit"
+            rc = j.sh.last_status()
+            assert rc == 0, f"{j.label}: $? {rc}, expected 0"
+            if via:
+                m = json.load(open(meta))
+                assert (m["code"], m["data"]) == ("CHILD_EXITED", {"launched": True, "exit_code": 0, "signal": None}), \
+                    f"{j.label}: meta {m}"
+            assert j.wait_gone(), f"{j.label}: process left behind: {j.state()}"
+            seen[j.label] = "ok"
+        finally:
+            j.close()
+    return seen
+
+
+def _shells():
+    return [k for k in ("bash", "zsh") if os.access(SHELLS[k][0][0], os.X_OK)]
+
+
+def _need_shells():
+    ks = _shells()
+    assert "bash" in ks, "/bin/bash missing"
+    return ks
+
+
+@case("x2-s2-third-party-stop-then-child-only-continue")
+def t_x2_s2(b):
+    out = {}
+    for kind in _need_shells():
+        for sig in (signal.SIGSTOP, signal.SIGTSTP):
+            out[f"{kind} {sig.name}"] = x2_s2(b, kind, sig)
+    return out
+
+
+@case("x2-s3-self-stop-then-launcher-only-continue")
+def t_x2_s3(b):
+    return {kind: x2_s3(b, kind) for kind in _need_shells()}
+
+
+@case("x2-s4-nested-interactive-shell-suspend")
+def t_x2_s4(b):
+    return {kind: x2_s4(b, kind) for kind in _need_shells()}
+
+
+@case("x2-s5-sigstop-with-meta-file")
+def t_x2_s5(b):
+    out = {}
+    for kind in _need_shells():
+        for trig in ("self", "third-party"):
+            out[f"{kind} {trig}"] = x2_s5(b, kind, trig)
+    return out
+
