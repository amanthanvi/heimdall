+/// One S1 run: `argv` (either `sh -c S1_CHILD` itself or `heimdall-proto run -- ...`)
+/// in a process group of its own (not orphaned: this test process is its parent, in
+/// another group of the same session), with no terminal on stdin/stdout/stderr. A third
+/// party (this test) stops the child PID with `stop`, waits 0.5 s and continues the
+/// child PID only. Returns (exit status, seconds from SIGCONT to exit, child PID).
+fn s1_once(
+    via_proto: bool,
+    stop: rustix::process::Signal,
+    dir: &Path,
+) -> (std::process::ExitStatus, f64, i32) {
+    use rustix::process::{Pid, Signal, kill_process};
+    use std::os::unix::process::CommandExt;
+    let _ = std::fs::remove_file(dir.join("pid"));
+    let _ = std::fs::remove_file(dir.join("done"));
+    let mut c = if via_proto {
+        let mut c = cmd();
+        c.args(["run", "--"]);
+        c.arg("sh");
+        c
+    } else {
+        Command::new("sh")
+    };
+    let mut p = c
+        .args(["-c", S1_CHILD, "s1"])
+        .arg(dir)
+        .process_group(0)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    let t = Instant::now();
+    while !dir.join("pid").exists() && t.elapsed() < Duration::from_secs(5) {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let child: i32 = std::fs::read_to_string(dir.join("pid"))
+        .expect("child pid file")
+        .trim()
+        .parse()
+        .unwrap();
+    if via_proto {
+        assert_ne!(
+            child,
+            p.id() as i32,
+            "the child is not heimdall-proto itself"
+        );
+    }
+    std::thread::sleep(Duration::from_millis(100));
+    let cpid = Pid::from_raw(child).unwrap();
+    kill_process(cpid, stop).unwrap();
+    std::thread::sleep(Duration::from_millis(500));
+    kill_process(cpid, Signal::CONT).unwrap();
+    let cont = Instant::now();
+    let st = loop {
+        if let Some(st) = p.try_wait().unwrap() {
+            break Some(st);
+        }
+        if cont.elapsed() > Duration::from_secs(8) {
+            break None;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+    };
