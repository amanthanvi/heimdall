+    pid: rustix::process::Pid,
+    state: &Shared,
+    cont_seen: &std::sync::atomic::AtomicBool,
+) {
+    use rustix::process::{Signal, WaitIdOptions, kill_process};
+    let st = lock(state);
+    if st.exited {
+        return;
+    }
+    let stopped = st.stopped || has_report(pid, WaitIdOptions::STOPPED);
+    if !stopped || has_report(pid, WaitIdOptions::CONTINUED | WaitIdOptions::EXITED) {
+        return;
