+///   There a stopped heimdall-proto could not see the child being continued by PID and
+///   would never exit, so the stop is not mirrored and heimdall-proto keeps waiting.
+#[cfg(unix)]
+fn parent_sees_stops(child: rustix::process::Pid) -> bool {
+    use rustix::process::{getpgid, getpgrp, getppid, getsid};
+    use rustix::termios::{isatty, tcgetpgrp, tcgetsid};
+    use std::os::fd::AsFd;
+    let own = getpgrp();
+    let Some(ppid) = getppid() else {
+        return false;
+    };
+    match getpgid(Some(ppid)) {
+        Ok(p) if p != own => {}
+        _ => return false,
+    }
+    let Ok(sid) = getsid(None) else {
+        return false;
+    };
+    let (i, o, e) = (std::io::stdin(), std::io::stdout(), std::io::stderr());
+    let stdio = [i.as_fd(), o.as_fd(), e.as_fd()];
+    if stdio
+        .iter()
+        .any(|fd| isatty(fd) && tcgetsid(fd).ok() == Some(sid))
+    {
+        return true;
+    }
+    use std::os::unix::fs::OpenOptionsExt;
+    // Query only: O_NOCTTY never acquires a terminal, nothing is read or written.
+    let Ok(tty) = std::fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOCTTY | libc::O_NONBLOCK)
+        .open("/dev/tty")
+    else {
+        return false;
+    };
+    match tcgetpgrp(&tty) {
+        Ok(fg) => fg == own || getpgid(Some(child)).ok() == Some(fg),
+        Err(_) => false,
+    }
