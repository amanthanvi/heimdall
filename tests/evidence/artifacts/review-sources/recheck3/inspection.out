+    blob_bad = [x["id"] for x in results if ok(x) and x.get("git_blob_matches_pin") is False]
+    if blob_bad:
+        return EXIT_BLOB_MISMATCH, bad, blob_bad
+    return (EXIT_FETCH_FAILED if bad else 0), bad, blob_bad
