===== alpine:3.22 (musl), linux-arm64 artifact (glibc-linked)
DOCKER_EXIT=255
exec /d/heimdall-proto: no such file or directory

## scripts
--- ctest.sh
set -u
B=/d/heimdall-proto
echo "--- command -v bun node: $(command -v bun node || echo none)"
$B version --json; echo "exit=$?"
$B profile show --file "/f/spaced dir ü/prøfile homelab.toml" --json | head -c 160; echo " exit=$?"
$B profile show --file /f/invalid-forbidden-key.toml --json; echo "exit=$?"
$B run --meta-file /tmp/m.json -- sh -c 'printf "%s|" "$@"; exit 7' x 'a b' '$HOME' ';*' 'ü'; echo " exit=$?"; cat /tmp/m.json
$B run -- sh -c 'kill -TERM $$'; echo "exit=$?"
$B run --meta-file /tmp/m2.json -- does-not-exist-xyz; echo "exit=$?"; cat /tmp/m2.json
printf '\000\377binary' | $B run -- cat | od -An -c | head -2
timeout -s TERM 2 $B tui --file /f/homelab.toml > /tmp/tui.out; echo "tui exit=$?"; echo "tui bytes=$(wc -c < /tmp/tui.out)"; ls -la /tmp | grep '\.bun-' || echo "no .bun- extraction found"
--- ctui.sh
command -v script >/dev/null || { echo "no script(1)"; exit 3; }
TMPDIR=/tmp script -qec "stty cols 80 rows 10; timeout --foreground -k 3 -s TERM 2 /d/heimdall-proto tui --file /f/homelab.toml; echo SCRIPT_DONE tui_exit=\$?" /tmp/ts.out </dev/null >/dev/null 2>&1; echo "script exit=$? (124=timeout sent TERM; inner status recorded below)"; grep -ao "SCRIPT_DONE.*" /tmp/ts.out
grep -c 'lab-server' /tmp/ts.out | sed 's/^/rows containing lab-server: /'
grep -q "$(printf '\033\[?1049h')" /tmp/ts.out && echo "alt-screen enter: yes"; grep -q "$(printf '\033\[?1049l')" /tmp/ts.out && echo "alt-screen leave: yes"
ls -la /tmp | grep '\.bun-' || echo "no .bun- extraction found"
