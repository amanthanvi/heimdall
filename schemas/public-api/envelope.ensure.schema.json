{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "Every ordinary structured result. `T` is the per-primitive `data` payload; errors\nuse [`ErrorData`]. Field order is the spec example's order.",
  "type": "object",
  "properties": {
    "code": {
      "description": "Stable semantic code.",
      "$ref": "#/$defs/Code"
    },
    "data": {
      "description": "Per-primitive payload; never contains private keys or reusable secrets.",
      "$ref": "#/$defs/EnsureData"
    },
    "next": {
      "description": "Machine next action, or `null` when nothing is expected of the caller.\nAlways emitted, `null` when absent (required-nullable in the schema:\n`NextAction | null`).",
      "anyOf": [
        {
          "$ref": "#/$defs/NextAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "description": "Present for effectful or long-running work; absent for pure reads.",
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "description": "Major schema version of this document.",
      "$ref": "#/$defs/SchemaVersion"
    },
    "state": {
      "description": "Operation state; synchronous reads report `succeeded` or `failed`.",
      "$ref": "#/$defs/OperationState"
    },
    "warnings": {
      "description": "Non-fatal findings. Always emitted (listed in the schema's `required`); a\nlenient reader still accepts omission as empty.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "required": [
    "schema_version",
    "state",
    "code",
    "data",
    "warnings",
    "next"
  ],
  "$defs": {
    "AccountName": {
      "description": "Remote account name on a destination.",
      "type": "string"
    },
    "BindingId": {
      "description": "Work binding ID (spec §4.1 \"Work binding\").",
      "type": "string"
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "ConfigProvenance": {
      "description": "Where a configuration directive was read: a display path and a 1-based line.",
      "type": "object",
      "properties": {
        "line": {
          "description": "1-based line number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path_display": {
          "description": "Display path (`~` for the home directory; `--redact` aware).",
          "type": "string"
        }
      },
      "required": [
        "path_display",
        "line"
      ]
    },
    "ConsumerExecutable": {
      "description": "A client executable an integration relies on.",
      "type": "object",
      "properties": {
        "basis": {
          "description": "How it was established.",
          "$ref": "#/$defs/EvidenceBasis"
        },
        "consumer": {
          "description": "Which consumer.",
          "$ref": "#/$defs/ConsumerKind"
        },
        "path": {
          "description": "Absolute path.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256, lowercase hex.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Reported version, when a local query ran.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "consumer",
        "path",
        "basis"
      ]
    },
    "ConsumerIntegration": {
      "description": "How a consumer reaches the binding (no secrets).",
      "type": "object",
      "properties": {
        "environment": {
          "description": "Environment variables a launcher should set (names and values; never secrets).",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "executables": {
          "description": "Client executables the integration relies on (R-SS-03).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsumerExecutable"
          }
        },
        "overrides": {
          "description": "Consumer settings another source keeps in force.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsumerOverride"
          }
        },
        "pairs": {
          "description": "One entry per destination/account pair of the grant (ADR-0007 §7).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PairIntegration"
          }
        },
        "signing_endpoint": {
          "description": "Signing endpoint path or pipe name, if one is materialized.",
          "type": [
            "string",
            "null"
          ]
        },
        "ssh_config_include": {
          "description": "Generated OpenSSH include path, if one is materialized.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ConsumerKind": {
      "description": "A consumer program.",
      "oneOf": [
        {
          "description": "`ssh`.",
          "type": "string",
          "const": "ssh"
        },
        {
          "description": "`scp`.",
          "type": "string",
          "const": "scp"
        },
        {
          "description": "`sftp`.",
          "type": "string",
          "const": "sftp"
        },
        {
          "description": "`git`.",
          "type": "string",
          "const": "git"
        },
        {
          "description": "`ssh-keygen`.",
          "type": "string",
          "const": "ssh_keygen"
        }
      ]
    },
    "ConsumerOverride": {
      "description": "A consumer setting another source keeps in force (ADR-0007 §8 \"Git under\n`run`\"). Names the setting, never its value.",
      "type": "object",
      "properties": {
        "consumer": {
          "description": "Which consumer.",
          "$ref": "#/$defs/ConsumerKind"
        },
        "setting": {
          "description": "The setting (`core.sshCommand`, `GIT_SSH_COMMAND`, `GIT_SSH`,\n`IdentityAgent`, `SSH_AUTH_SOCK`).",
          "type": "string"
        },
        "source": {
          "description": "Where it comes from.",
          "$ref": "#/$defs/OverrideSource"
        }
      },
      "required": [
        "consumer",
        "setting",
        "source"
      ]
    },
    "CredentialAvailability": {
      "description": "Credential availability (spec §4.3): how long new authentications keep working\nwithout further action.",
      "oneOf": [
        {
          "description": "Usable now; no claim about later.",
          "type": "string",
          "const": "current_only"
        },
        {
          "description": "Usable through the deadline.",
          "type": "string",
          "const": "through_deadline"
        },
        {
          "description": "Depends on a refresh before the deadline.",
          "type": "string",
          "const": "refresh_dependent"
        },
        {
          "description": "A human step may be needed for new authentications.",
          "type": "string",
          "const": "interaction_required"
        },
        {
          "description": "Not established (the default for older documents).",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Cursor": {
      "description": "Opaque, reader-scoped resumption token. Never parse it outside the runtime.",
      "type": "string"
    },
    "DeclarationRef": {
      "description": "The declaration a fresh eligibility relied on (ADR-0007 §7 \"Launch eligibility is\nchecked fresh\"). The CLI's pre-launch check requires the same revision and\nendpoint and an unexpired `expires_at`.",
      "type": "object",
      "properties": {
        "endpoint": {
          "description": "The endpoint it covers.",
          "$ref": "#/$defs/EndpointRef"
        },
        "expires_at": {
          "description": "When it lapses.",
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "description": "The declaration row's revision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "revision",
        "endpoint",
        "expires_at"
      ]
    },
    "DestinationId": {
      "description": "Destination ID (spec §4.1 \"Destination\"); route-independent.",
      "type": "string"
    },
    "DestinationScopeEnforcement": {
      "description": "Destination-scope enforcement levels (spec §4.3), ordered weakest to strongest.",
      "oneOf": [
        {
          "description": "Not known.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "Intent only; nothing enforces it.",
          "type": "string",
          "const": "unenforced_intent"
        },
        {
          "description": "Client configuration routes to the destination.",
          "type": "string",
          "const": "client_routing"
        },
        {
          "description": "Agent restriction authenticated to the destination (spec S03).",
          "type": "string",
          "const": "authenticated_agent_restriction"
        },
        {
          "description": "Server-side principal mapping verified by test.",
          "type": "string",
          "const": "verified_server_principals"
        },
        {
          "description": "A separately tested isolated execution boundary.",
          "type": "string",
          "const": "isolated_execution_boundary"
        }
      ]
    },
    "EndpointKind": {
      "description": "The transport of an agent endpoint.",
      "oneOf": [
        {
          "description": "A Unix-domain socket path.",
          "type": "string",
          "const": "unix_socket"
        },
        {
          "description": "A Windows named pipe name.",
          "type": "string",
          "const": "named_pipe"
        }
      ]
    },
    "EndpointRef": {
      "description": "A reference to an agent endpoint. The locator is a path or pipe name, never a\nsecret; it is compared exactly (a changed locator lapses a declaration,\nADR-0007 §7).",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Transport.",
          "$ref": "#/$defs/EndpointKind"
        },
        "locator": {
          "description": "Socket path or pipe name.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "locator"
      ]
    },
    "Enforcement": {
      "description": "Structured guarantee report (spec §4.3, §11.3 `enforcement`). Every claim\nreferences evidence held by the runtime; `Unknown` is a valid value.",
      "type": "object",
      "properties": {
        "destination_scope": {
          "description": "Destination/account restriction mechanism.",
          "$ref": "#/$defs/DestinationScopeEnforcement"
        },
        "existing_connections": {
          "description": "Existing-connection policy.",
          "$ref": "#/$defs/ExistingConnectionsPolicy"
        },
        "new_authentication_expiry": {
          "description": "What stops new authentication at expiry.",
          "$ref": "#/$defs/NewAuthenticationExpiry"
        },
        "revocation": {
          "description": "Revocation propagation.",
          "$ref": "#/$defs/RevocationStatus"
        },
        "workload_isolation": {
          "description": "Isolation label.",
          "$ref": "#/$defs/WorkloadIsolation"
        }
      },
      "required": [
        "destination_scope",
        "new_authentication_expiry",
        "workload_isolation",
        "existing_connections",
        "revocation"
      ]
    },
    "EnsureData": {
      "description": "`ensure`/`bind` success payload (spec §11.3 example, primitives-draft §4.2).",
      "type": "object",
      "properties": {
        "binding_id": {
          "description": "Binding produced or reused.",
          "$ref": "#/$defs/BindingId"
        },
        "consumer": {
          "description": "Consumer integration descriptor; contains endpoints and config references,\nnever secrets.",
          "$ref": "#/$defs/ConsumerIntegration"
        },
        "credential_availability": {
          "description": "Credential availability (spec §4.3), computed fresh for every result. Always\nwritten; a document that omits it reads as `unknown`.",
          "$ref": "#/$defs/CredentialAvailability",
          "default": "unknown"
        },
        "credential_mechanism": {
          "description": "Mechanism name (`managed_certificate`, `native_agent`, `external_signer`, ...).",
          "type": "string"
        },
        "enforcement": {
          "description": "Structured guarantees.",
          "$ref": "#/$defs/Enforcement"
        },
        "environment_id": {
          "description": "Environment the binding is pinned to.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "expires_at": {
          "description": "Immutable grant deadline.",
          "type": "string",
          "format": "date-time"
        },
        "grant_id": {
          "description": "Grant realizing the binding.",
          "$ref": "#/$defs/GrantId"
        },
        "offline_until": {
          "description": "Usable with no controller/issuer contact until.",
          "type": "string",
          "format": "date-time"
        },
        "profile_revision": {
          "description": "Profile revision pinned at activation.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "provider": {
          "description": "The provider's observed state, for existing-access mechanisms.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_dependency": {
          "description": "What ongoing readiness depends on.",
          "$ref": "#/$defs/RefreshDependency"
        },
        "usable_until": {
          "description": "Credentials usable without refresh until.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "binding_id",
        "environment_id",
        "profile_revision",
        "grant_id",
        "expires_at",
        "usable_until",
        "offline_until",
        "refresh_dependency",
        "credential_mechanism",
        "enforcement",
        "consumer"
      ]
    },
    "EnvironmentId": {
      "description": "Stable environment ID (spec §4.1 \"Environment\").",
      "type": "string"
    },
    "EvidenceBasis": {
      "description": "How a reported fact was established (ADR-0007 §7). `declared` is an owner\nstatement, never an observation.",
      "oneOf": [
        {
          "description": "Observed by a probe.",
          "type": "string",
          "const": "observed"
        },
        {
          "description": "Taken from pinned vendor documentation.",
          "type": "string",
          "const": "documented"
        },
        {
          "description": "Inferred; labelled `[I]` in reports.",
          "type": "string",
          "const": "inferred"
        },
        {
          "description": "Declared by the owner through an attended decision.",
          "type": "string",
          "const": "declared"
        }
      ]
    },
    "ExistingConnectionsPolicy": {
      "description": "Effect on existing connections at expiry (spec §6.6).",
      "oneOf": [
        {
          "description": "Not known.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "Dedicated connections may stay; owned masters are closed.",
          "type": "string",
          "const": "graceful_dedicated_connections"
        },
        {
          "description": "Owned connections are closed at expiry.",
          "type": "string",
          "const": "strict_disconnect"
        }
      ]
    },
    "GitScope": {
      "description": "A Git configuration scope (`git config --show-scope`).",
      "oneOf": [
        {
          "description": "System file.",
          "type": "string",
          "const": "system"
        },
        {
          "description": "Global file (`~/.gitconfig` or the XDG file).",
          "type": "string",
          "const": "global"
        },
        {
          "description": "Repository file.",
          "type": "string",
          "const": "local"
        },
        {
          "description": "Worktree file.",
          "type": "string",
          "const": "worktree"
        },
        {
          "description": "Command scope (`-c`, `GIT_CONFIG_COUNT`).",
          "type": "string",
          "const": "command"
        }
      ]
    },
    "GrantId": {
      "description": "Grant ID (spec §4.1 \"Grant\").",
      "type": "string"
    },
    "IdentityId": {
      "description": "Adopted existing-access identity in the catalog (ADR-0007 §7; m02-plan §5\nitem 1). Runtime-generated at adoption; never derived from key material.",
      "type": "string"
    },
    "IdentitySelection": {
      "description": "Whether ssh can only use the adopted identity for an alias (ADR-0007 §3 item 3).",
      "oneOf": [
        {
          "description": "Only the adopted identity can be offered.",
          "type": "string",
          "const": "exclusive"
        },
        {
          "description": "Other identities the configuration adds can be offered.",
          "type": "string",
          "const": "not_exclusive"
        },
        {
          "description": "Static evaluation cannot decide (for example behind `Match exec`).",
          "type": "string",
          "const": "undetermined"
        }
      ]
    },
    "InteractionKind": {
      "description": "The human step an authentication may need (ADR-0007 §7 interaction profile).",
      "oneOf": [
        {
          "description": "No interaction (only ever `declared` for a native agent key).",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The provider asks for approval (1Password).",
          "type": "string",
          "const": "provider_approval"
        },
        {
          "description": "The provider must be unlocked.",
          "type": "string",
          "const": "provider_unlock"
        },
        {
          "description": "A hardware presence touch (FIDO `sk-*` keys).",
          "type": "string",
          "const": "hardware_presence"
        },
        {
          "description": "A passphrase prompt.",
          "type": "string",
          "const": "passphrase"
        },
        {
          "description": "Not known; never satisfies a non-interactive requirement.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "NewAuthenticationExpiry": {
      "description": "What ends new authentication at expiry (spec §4.3 \"Expiry\").",
      "oneOf": [
        {
          "description": "Not known.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "Only the local signer stops.",
          "type": "string",
          "const": "signer_only"
        },
        {
          "description": "Certificate validity and the signer both stop.",
          "type": "string",
          "const": "credential_and_signer"
        },
        {
          "description": "Nothing stops new authentication (existing fixed credentials).",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "NextAction": {
      "description": "Machine next action (spec §11.2 `next`, §11.6 \"machine-readable next action\").\n`action` names are stable; parameters are present only when relevant.",
      "type": "object",
      "properties": {
        "action": {
          "description": "Stable action name; defaults come from [`Code::default_next_action`].",
          "type": "string"
        },
        "binding_id": {
          "description": "Binding to use.",
          "anyOf": [
            {
              "$ref": "#/$defs/BindingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "description": "Cursor to resume from after a resync.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_ref": {
          "description": "Nonsecret reference to a pending owner decision.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Operation to observe.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_interaction": {
          "description": "The provider-owned interaction, with action `interact`, for\n`PROVIDER_LOCKED` and provider-owned `INTERACTION_REQUIRED` (ADR-0007 §7).\nNever combined with `decision_ref`: provider dialogs are not Heimdall\ndecisions (spec §5.5).",
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderInteractionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "description": "Suggested minimum delay before a retry.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "action"
      ]
    },
    "NoninteractiveEligibility": {
      "description": "Whether a pair may be used on the no-interaction path, computed fresh per result.",
      "type": "object",
      "properties": {
        "eligible": {
          "description": "Eligible for non-interactive use.",
          "type": "boolean"
        },
        "reason": {
          "description": "Why not, when not: one of [`noninteractive_reason`]'s values.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "eligible"
      ]
    },
    "OperationId": {
      "description": "Durable operation ID (spec §4.1 \"Operation\").",
      "type": "string"
    },
    "OperationState": {
      "description": "Operation states (spec §11.4). A caller timeout is not a state change.",
      "oneOf": [
        {
          "description": "Accepted and journaled; not yet running.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "In progress.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Waiting for an owner or provider decision on an owner channel.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Settled: completed with a result.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Settled: failed with a classified error.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Settled: explicitly cancelled; the result says whether an irreversible or\nuncertain step may have occurred.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Unresolved: an external effect may or may not have applied. Quiescent until\nreconciliation settles it to `succeeded` or `failed`; never purged while\nunresolved; never retried blindly.",
          "type": "string",
          "const": "outcome_unknown"
        }
      ]
    },
    "OverrideSource": {
      "description": "Where an overriding consumer setting comes from (tagged by `kind`).",
      "oneOf": [
        {
          "description": "An OpenSSH configuration directive (for example an effective\n`IdentityAgent`).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ssh_config"
            }
          },
          "$ref": "#/$defs/ConfigProvenance",
          "required": [
            "kind"
          ]
        },
        {
          "description": "A Git configuration scope.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "git_scope"
            },
            "scope": {
              "description": "The scope.",
              "$ref": "#/$defs/GitScope"
            }
          },
          "required": [
            "kind",
            "scope"
          ]
        },
        {
          "description": "The process environment.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "environment"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PairIntegration": {
      "description": "One destination/account pair's integration (ADR-0007 §7). `endpoint`, `alias`,\n`mechanism`, `identity_selection` and `selection_observed_at` are history\n(prepared facts); the interaction and eligibility fields are computed fresh in\nthe transaction that builds each result (M2-R04).",
      "type": "object",
      "properties": {
        "account": {
          "description": "Account.",
          "$ref": "#/$defs/AccountName"
        },
        "alias": {
          "description": "The managed alias.",
          "type": [
            "string",
            "null"
          ]
        },
        "declaration": {
          "description": "The live declaration the eligibility relied on.",
          "anyOf": [
            {
              "$ref": "#/$defs/DeclarationRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_at": {
          "description": "When the owner declared it (`basis: declared` only).",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "destination": {
          "description": "Destination.",
          "$ref": "#/$defs/DestinationId"
        },
        "eligibility_checked_at": {
          "description": "When the eligibility was computed.",
          "type": "string",
          "format": "date-time"
        },
        "endpoint": {
          "description": "The agent endpoint.",
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "description": "The adopted identity.",
          "$ref": "#/$defs/IdentityId"
        },
        "identity_selection": {
          "description": "The recorded identity selection.",
          "$ref": "#/$defs/IdentitySelection"
        },
        "interaction": {
          "description": "Fresh interaction.",
          "$ref": "#/$defs/InteractionKind"
        },
        "interaction_basis": {
          "description": "How the interaction was established.",
          "$ref": "#/$defs/EvidenceBasis"
        },
        "mechanism": {
          "description": "Mechanism (`native_agent`, `onepassword`).",
          "type": "string"
        },
        "noninteractive": {
          "description": "Fresh non-interactive eligibility.",
          "$ref": "#/$defs/NoninteractiveEligibility"
        },
        "selection_observed_at": {
          "description": "When the selection was observed.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "destination",
        "account",
        "identity",
        "mechanism",
        "interaction",
        "interaction_basis",
        "identity_selection",
        "selection_observed_at",
        "noninteractive",
        "eligibility_checked_at"
      ]
    },
    "ProbeLevel": {
      "description": "The probe ladder levels (ADR-0007 §6; spec §10.2), weakest first.",
      "oneOf": [
        {
          "description": "Parse and evaluate without executing anything (the default).",
          "type": "string",
          "const": "static"
        },
        {
          "description": "`ssh -G` against the real tree (needs `--allow-config-commands`).",
          "type": "string",
          "const": "evaluate"
        },
        {
          "description": "One `SSH_AGENTC_REQUEST_IDENTITIES` to a named endpoint.",
          "type": "string",
          "const": "agent"
        },
        {
          "description": "TCP connect and read the identification line.",
          "type": "string",
          "const": "network"
        },
        {
          "description": "Host-key verification with nothing to sign (needs `--allow-config-commands`).",
          "type": "string",
          "const": "host_verification"
        },
        {
          "description": "A real authentication (needs `--allow-config-commands`).",
          "type": "string",
          "const": "authentication"
        }
      ]
    },
    "ProviderAvailability": {
      "description": "Whether the provider can sign now (ADR-0007 §7 \"Provider states\").",
      "oneOf": [
        {
          "description": "Observed available.",
          "type": "string",
          "const": "available"
        },
        {
          "description": "Observed locked (needs the explicit `agent` level).",
          "type": "string",
          "const": "locked"
        },
        {
          "description": "No endpoint (passively established).",
          "type": "string",
          "const": "unavailable"
        },
        {
          "description": "Not established.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ProviderInteractionRef": {
      "description": "The provider-owned interaction a next action points at (spec §5.5). Used with\naction `interact` for `PROVIDER_LOCKED` and provider-owned\n`INTERACTION_REQUIRED`; never combined with `decision_ref`.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "What it asks for.",
          "$ref": "#/$defs/InteractionKind"
        },
        "provider": {
          "description": "The provider whose dialog it is.",
          "$ref": "#/$defs/ProviderKind"
        }
      },
      "required": [
        "provider",
        "kind"
      ]
    },
    "ProviderKind": {
      "description": "Which provider serves an agent endpoint (ADR-0007 §7 \"Detection is passive\").",
      "oneOf": [
        {
          "description": "An OpenSSH-compatible agent (`ssh-agent`, the Windows OpenSSH agent service).",
          "type": "string",
          "const": "native_agent"
        },
        {
          "description": "The 1Password SSH agent.",
          "type": "string",
          "const": "onepassword"
        },
        {
          "description": "Not determinable passively (for example the Windows `openssh-ssh-agent` pipe,\nF18).",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ProviderStatus": {
      "description": "A provider's observed state (ADR-0007 §7 \"Provider states\").",
      "type": "object",
      "properties": {
        "availability": {
          "description": "Whether it can sign now.",
          "$ref": "#/$defs/ProviderAvailability"
        },
        "basis": {
          "description": "How it was established.",
          "$ref": "#/$defs/EvidenceBasis"
        },
        "interaction": {
          "description": "The interaction its identities need.",
          "$ref": "#/$defs/InteractionKind"
        },
        "observed_at": {
          "description": "When it was observed (RFC 3339, explicit offset).",
          "type": "string",
          "format": "date-time"
        },
        "observed_level": {
          "description": "The probe level that observed it.",
          "$ref": "#/$defs/ProbeLevel"
        },
        "provider": {
          "description": "Which provider.",
          "$ref": "#/$defs/ProviderKind"
        }
      },
      "required": [
        "provider",
        "availability",
        "interaction",
        "observed_level",
        "observed_at",
        "basis"
      ]
    },
    "RefreshDependency": {
      "description": "Dependency of continued readiness (spec §6.5).",
      "oneOf": [
        {
          "description": "No refresh needed before `expires_at`.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Needs the local issuer.",
          "type": "string",
          "const": "local_issuer"
        },
        {
          "description": "Needs the controller device.",
          "type": "string",
          "const": "controller"
        },
        {
          "description": "Needs provider interaction.",
          "type": "string",
          "const": "provider_interaction"
        }
      ]
    },
    "RevocationStatus": {
      "description": "Revocation propagation status (spec §4.3 \"Revocation\", §6.7).",
      "oneOf": [
        {
          "description": "Not known.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "Applied locally.",
          "type": "string",
          "const": "local_applied"
        },
        {
          "description": "Acknowledged remotely.",
          "type": "string",
          "const": "remote_acknowledged"
        },
        {
          "description": "Remote effect pending.",
          "type": "string",
          "const": "remote_pending"
        },
        {
          "description": "Bounded only by an already-issued credential's expiry.",
          "type": "string",
          "const": "bounded_by_credential_expiry"
        }
      ]
    },
    "SchemaVersion": {
      "description": "A `schema_version` value as received from a peer.",
      "type": "string"
    },
    "Warning": {
      "description": "A non-fatal finding attached to a result.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable warning code (SCREAMING_SNAKE_CASE, not localized).",
          "type": "string"
        },
        "message": {
          "description": "Human text; may change without breaking callers.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "WorkloadIsolation": {
      "description": "Workload isolation label (spec §4.3 \"Isolation\"; R-SE-03).",
      "oneOf": [
        {
          "description": "Not known.",
          "type": "string",
          "const": "unknown"
        },
        {
          "description": "Shared OS-user environment; same-user convenience only.",
          "type": "string",
          "const": "shared_os_user"
        },
        {
          "description": "Separately authenticated service boundary.",
          "type": "string",
          "const": "separate_service_boundary"
        },
        {
          "description": "A specifically tested isolated workload.",
          "type": "string",
          "const": "tested_isolated_workload"
        }
      ]
    }
  }
}
