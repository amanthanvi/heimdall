{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerMessage",
  "description": "Server to client frames.",
  "oneOf": [
    {
      "description": "Hello accepted.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "$ref": "#/$defs/ServerHello",
      "required": [
        "type"
      ]
    },
    {
      "description": "Hello rejected; the server closes the connection after this frame. The\nenvelope carries `SCHEMA_UNSUPPORTED` or `USAGE_ERROR`.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "reject"
        }
      },
      "$ref": "#/$defs/Envelope",
      "required": [
        "type"
      ]
    },
    {
      "description": "Response to a request.",
      "type": "object",
      "properties": {
        "envelope": {
          "description": "Result envelope with the primitive's payload or an error.",
          "$ref": "#/$defs/Envelope2"
        },
        "in_reply_to": {
          "description": "Echoed sequence number.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "response"
        }
      },
      "required": [
        "type",
        "in_reply_to",
        "envelope"
      ]
    },
    {
      "description": "Subscription established (ADR-0006 §8). Delivery order afterwards: retained\nbacklog after the client's cursor (or nothing when a snapshot was taken),\nthen live events strictly after `cursor`; overlap is deduplicated by the\nserver, so a consumer may still deduplicate by `event_id` but need not.",
      "type": "object",
      "properties": {
        "cursor": {
          "description": "Head boundary read in the subscription transaction: live events follow\nstrictly after it. With `snapshot`, it is the snapshot's consistent\nboundary; without, it is the boundary **after** the backlog that\nfollows (not the client's cursor), so a consumer resumes from the\ncursor of the last event it processed, not from this value, until the\nbacklog has been consumed.",
          "$ref": "#/$defs/Cursor"
        },
        "in_reply_to": {
          "description": "Echoed sequence number.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "snapshot": {
          "description": "Present when the client sent no cursor, or sent an expired/foreign one\nand the server chose to resync it: a transactionally consistent view\ntaken at `cursor`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "subscription": {
          "description": "Subscription handle.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "subscribed"
        }
      },
      "required": [
        "type",
        "in_reply_to",
        "subscription",
        "cursor"
      ]
    },
    {
      "description": "An event for a subscription.",
      "type": "object",
      "properties": {
        "event": {
          "description": "The event.",
          "$ref": "#/$defs/Event"
        },
        "subscription": {
          "description": "Subscription handle.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "required": [
        "type",
        "subscription",
        "event"
      ]
    },
    {
      "description": "The server is closing the connection (shutdown, limit, or protocol error).",
      "type": "object",
      "properties": {
        "code": {
          "description": "Reason code.",
          "$ref": "#/$defs/Code"
        },
        "message": {
          "description": "Human text.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "goodbye"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ]
    }
  ],
  "$defs": {
    "BindingId": {
      "description": "Work binding ID (spec §4.1 \"Work binding\").",
      "type": "string"
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        }
      ]
    },
    "Cursor": {
      "description": "Opaque, reader-scoped resumption token. Never parse it outside the runtime.",
      "type": "string"
    },
    "EffectStatus": {
      "description": "Whether an operation's external effect happened (spec §11.6).",
      "oneOf": [
        {
          "description": "Nothing external was changed.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The effect was applied and verified.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Some steps applied; the result says which.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "The effect may or may not have applied; reconcile before retrying.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Envelope": {
      "description": "Every ordinary structured result. `T` is the per-primitive `data` payload; errors\nuse [`ErrorData`]. Field order is the spec example's order.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable semantic code.",
          "$ref": "#/$defs/Code"
        },
        "data": {
          "description": "Per-primitive payload; never contains private keys or reusable secrets.",
          "$ref": "#/$defs/ErrorData"
        },
        "next": {
          "description": "Machine next action, or `null` when nothing is expected of the caller.\nAlways emitted, `null` when absent (required-nullable in the schema:\n`NextAction | null`).",
          "anyOf": [
            {
              "$ref": "#/$defs/NextAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation_id": {
          "description": "Present for effectful or long-running work; absent for pure reads.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "description": "Major schema version of this document.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "state": {
          "description": "Operation state; synchronous reads report `succeeded` or `failed`.",
          "$ref": "#/$defs/OperationState"
        },
        "warnings": {
          "description": "Non-fatal findings. Always emitted (listed in the schema's `required`); a\nlenient reader still accepts omission as empty.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Warning"
          }
        }
      },
      "required": [
        "schema_version",
        "state",
        "code",
        "data",
        "warnings",
        "next"
      ]
    },
    "Envelope2": {
      "description": "Every ordinary structured result. `T` is the per-primitive `data` payload; errors\nuse [`ErrorData`]. Field order is the spec example's order.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable semantic code.",
          "$ref": "#/$defs/Code"
        },
        "data": {
          "description": "Per-primitive payload; never contains private keys or reusable secrets."
        },
        "next": {
          "description": "Machine next action, or `null` when nothing is expected of the caller.\nAlways emitted, `null` when absent (required-nullable in the schema:\n`NextAction | null`).",
          "anyOf": [
            {
              "$ref": "#/$defs/NextAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation_id": {
          "description": "Present for effectful or long-running work; absent for pure reads.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "description": "Major schema version of this document.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "state": {
          "description": "Operation state; synchronous reads report `succeeded` or `failed`.",
          "$ref": "#/$defs/OperationState"
        },
        "warnings": {
          "description": "Non-fatal findings. Always emitted (listed in the schema's `required`); a\nlenient reader still accepts omission as empty.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Warning"
          }
        }
      },
      "required": [
        "schema_version",
        "state",
        "code",
        "data",
        "warnings",
        "next"
      ]
    },
    "EnvironmentId": {
      "description": "Stable environment ID (spec §4.1 \"Environment\").",
      "type": "string"
    },
    "ErrorData": {
      "description": "The `data` payload of an error envelope.",
      "type": "object",
      "properties": {
        "error": {
          "description": "The error.",
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "error"
      ]
    },
    "ErrorDetail": {
      "description": "Error detail (`data.error`, primitives-draft §1).",
      "type": "object",
      "properties": {
        "code": {
          "description": "Same code as the envelope.",
          "$ref": "#/$defs/Code"
        },
        "effect_status": {
          "description": "Whether any external effect happened.",
          "$ref": "#/$defs/EffectStatus"
        },
        "message": {
          "description": "Human text; may change without breaking callers; never contains secrets.",
          "type": "string"
        },
        "next": {
          "description": "Machine next action.",
          "$ref": "#/$defs/NextAction"
        },
        "resource": {
          "description": "Resource the error concerns.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "description": "Whether an unchanged retry may succeed later.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "effect_status",
        "retryable",
        "next",
        "message"
      ]
    },
    "Event": {
      "description": "One event (spec §11.5 field list).",
      "type": "object",
      "properties": {
        "cursor": {
          "description": "Cursor positioned *after* this event.",
          "$ref": "#/$defs/Cursor"
        },
        "environment_id": {
          "description": "Environment the event belongs to; ordering is only claimed within one.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "event_id": {
          "description": "Unique event ID for deduplication.",
          "$ref": "#/$defs/EventId"
        },
        "operation_id": {
          "description": "Related operation, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "description": "Redacted payload; never contains private material."
        },
        "resource": {
          "description": "Related resource, if any.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "description": "Major schema version.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "timestamp": {
          "description": "Runtime time of the event (RFC 3339, explicit offset).",
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "description": "Event type.",
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "type",
        "environment_id",
        "timestamp",
        "cursor",
        "payload"
      ]
    },
    "EventId": {
      "description": "Event ID; consumers deduplicate by it (spec §11.5).",
      "type": "string"
    },
    "EventType": {
      "description": "Event types emitted by the runtime (spec §13.6 audit coverage).",
      "oneOf": [
        {
          "description": "An operation changed state.",
          "type": "string",
          "const": "operation_state_changed"
        },
        {
          "description": "A grant changed state.",
          "type": "string",
          "const": "grant_state_changed"
        },
        {
          "description": "A standing policy changed (revision, pause, cutoff).",
          "type": "string",
          "const": "policy_changed"
        },
        {
          "description": "A managed resource changed desired/observed state or generation.",
          "type": "string",
          "const": "resource_changed"
        },
        {
          "description": "A credential lifecycle event (issued, renewed, expired, revoked).",
          "type": "string",
          "const": "credential_lifecycle"
        },
        {
          "description": "An owner decision was requested or recorded.",
          "type": "string",
          "const": "decision"
        },
        {
          "description": "The subscriber fell behind a bounded buffer; take a snapshot and resume\n(spec §11.5 backpressure).",
          "type": "string",
          "const": "resync_required"
        },
        {
          "description": "The runtime started or stopped (restart recovery boundary).",
          "type": "string",
          "const": "runtime_lifecycle"
        }
      ]
    },
    "NextAction": {
      "description": "Machine next action (spec §11.2 `next`, §11.6 \"machine-readable next action\").\n`action` names are stable; parameters are present only when relevant.",
      "type": "object",
      "properties": {
        "action": {
          "description": "Stable action name; defaults come from [`Code::default_next_action`].",
          "type": "string"
        },
        "binding_id": {
          "description": "Binding to use.",
          "anyOf": [
            {
              "$ref": "#/$defs/BindingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "description": "Cursor to resume from after a resync.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_ref": {
          "description": "Nonsecret reference to a pending owner decision.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Operation to observe.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "description": "Suggested minimum delay before a retry.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "action"
      ]
    },
    "OperationId": {
      "description": "Durable operation ID (spec §4.1 \"Operation\").",
      "type": "string"
    },
    "OperationState": {
      "description": "Operation states (spec §11.4). A caller timeout is not a state change.",
      "oneOf": [
        {
          "description": "Accepted and journaled; not yet running.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "In progress.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Waiting for an owner or provider decision on an owner channel.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Settled: completed with a result.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Settled: failed with a classified error.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Settled: explicitly cancelled; the result says whether an irreversible or\nuncertain step may have occurred.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Unresolved: an external effect may or may not have applied. Quiescent until\nreconciliation settles it to `succeeded` or `failed`; never purged while\nunresolved; never retried blindly.",
          "type": "string",
          "const": "outcome_unknown"
        }
      ]
    },
    "PeerInfo": {
      "description": "Identifies the peer software; informational only, never authority (spec §4.2).",
      "type": "object",
      "properties": {
        "name": {
          "description": "Program name (`heimdall-cli`, `heimdall-tui`, a third-party wrapper).",
          "type": "string"
        },
        "version": {
          "description": "Program version.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "PrincipalInfo": {
      "description": "How the server authenticated the client (reported back for transparency).",
      "oneOf": [
        {
          "description": "Unix peer credentials matched the runtime's user.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "os_user_unix"
            },
            "uid": {
              "description": "Numeric user ID.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "uid"
          ]
        },
        {
          "description": "Windows client SID matched the runtime's user.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "os_user_windows"
            },
            "sid": {
              "description": "SID string; an identifier, not a secret.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sid"
          ]
        }
      ]
    },
    "ResourceRef": {
      "description": "A reference to the resource an error concerns. Opaque IDs only; never a secret.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Opaque identifier, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Resource kind (`operation`, `binding`, `grant`, `policy`, `destination`,\n`environment`, `endpoint`, `config`, `store`, `clock`, `decision`).",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "SchemaVersion": {
      "description": "A `schema_version` value as received from a peer.",
      "type": "string"
    },
    "ServerHello": {
      "description": "First server frame on success.",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capabilities in effect (intersection).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "environment_id": {
          "description": "Environment ID of this runtime.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "principal": {
          "description": "How the client was authenticated.",
          "$ref": "#/$defs/PrincipalInfo"
        },
        "protocol": {
          "description": "Protocol version in effect.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "schema_version": {
          "description": "Schema major the server emits.",
          "$ref": "#/$defs/SchemaVersion"
        },
        "server": {
          "description": "Server software.",
          "$ref": "#/$defs/PeerInfo"
        }
      },
      "required": [
        "protocol",
        "schema_version",
        "server",
        "capabilities",
        "principal",
        "environment_id"
      ]
    },
    "Snapshot": {
      "description": "A snapshot with the cursor boundary it is consistent with (spec §11.5).",
      "type": "object",
      "properties": {
        "cursor": {
          "description": "Events after this cursor are not reflected in `data`.",
          "$ref": "#/$defs/Cursor"
        },
        "data": {
          "description": "Snapshot contents."
        },
        "taken_at": {
          "description": "Runtime time of the snapshot.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "data",
        "cursor",
        "taken_at"
      ]
    },
    "Warning": {
      "description": "A non-fatal finding attached to a result.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable warning code (SCREAMING_SNAKE_CASE, not localized).",
          "type": "string"
        },
        "message": {
          "description": "Human text; may change without breaking callers.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
