{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperationView",
  "description": "One durable operation as `observe` (`operation show`, `operation wait`) and `inspect\noperations` show it. Its envelope carries the same `operation_id` and `state`, and\n`next: {action: \"observe\"}` while the state is not quiescent.",
  "type": "object",
  "properties": {
    "cancellation": {
      "description": "Its cancellation. Omitted when none was requested (today: `null`).",
      "anyOf": [
        {
          "$ref": "#/$defs/CancellationView"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "description": "Its result code once terminal. Omitted before (today: `null`).",
      "anyOf": [
        {
          "$ref": "#/$defs/Code"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "description": "When it was created.",
      "type": "string",
      "format": "date-time"
    },
    "effect_status": {
      "description": "Its effect status.",
      "$ref": "#/$defs/EffectStatus"
    },
    "kind": {
      "description": "Its kind.",
      "$ref": "#/$defs/OperationKindView"
    },
    "operation_id": {
      "description": "The operation.",
      "$ref": "#/$defs/OperationId"
    },
    "result": {
      "description": "Its result payload (redacted JSON) once terminal: an `ensure`, `bind` or `delegate`\nresult as a current response shows it. Omitted before it is terminal, and where\n`observe` withholds it: a succeeded binding result that does not read as one, of a\nbinding outside the runtime's own environment (today: `null` in both cases). `state`\nsays whether the operation is terminal, so a terminal operation with no `result`\nreads as withheld (ruled 2026-11-24, PC3)."
    },
    "state": {
      "description": "Its state.",
      "$ref": "#/$defs/OperationState"
    },
    "updated_at": {
      "description": "When it last changed.",
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "operation_id",
    "kind",
    "state",
    "effect_status",
    "created_at",
    "updated_at"
  ],
  "$defs": {
    "CancellationView": {
      "description": "A requested cancellation (spec §11.4).",
      "type": "object",
      "properties": {
        "may_have_external_effect": {
          "description": "Whether an irreversible or uncertain external step may have happened.",
          "type": "boolean"
        },
        "requested_at": {
          "description": "When it was requested.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requested_at",
        "may_have_external_effect"
      ]
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "REQUEST_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "EffectStatus": {
      "description": "Whether an operation's external effect happened (spec §11.6).",
      "oneOf": [
        {
          "description": "Nothing external was changed.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The effect was applied and verified.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Some steps applied; the result says which.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "The effect may or may not have applied; reconcile before retrying.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "OperationId": {
      "description": "Durable operation ID (spec §4.1 \"Operation\").",
      "type": "string"
    },
    "OperationKindView": {
      "description": "An operation's kind, with the dotted names of the setup and enrollment kinds.",
      "oneOf": [
        {
          "description": "`ensure`.",
          "type": "string",
          "const": "ensure"
        },
        {
          "description": "`bind`.",
          "type": "string",
          "const": "bind"
        },
        {
          "description": "`delegate`.",
          "type": "string",
          "const": "delegate"
        },
        {
          "description": "`cancel`.",
          "type": "string",
          "const": "cancel"
        },
        {
          "description": "`release`.",
          "type": "string",
          "const": "release"
        },
        {
          "description": "`revoke`.",
          "type": "string",
          "const": "revoke"
        },
        {
          "description": "An owner policy action.",
          "type": "string",
          "const": "policy"
        },
        {
          "description": "An explicit active probe.",
          "type": "string",
          "const": "probe"
        },
        {
          "description": "⟨M02⟩ `setup.apply`.",
          "type": "string",
          "const": "setup.apply"
        },
        {
          "description": "⟨M02⟩ `setup.rollback`.",
          "type": "string",
          "const": "setup.rollback"
        },
        {
          "description": "⟨M02⟩ `setup.repair`.",
          "type": "string",
          "const": "setup.repair"
        },
        {
          "description": "⟨M02⟩ `catalog`.",
          "type": "string",
          "const": "catalog"
        },
        {
          "description": "⟨M03⟩ `enrollment.apply`.",
          "type": "string",
          "const": "enrollment.apply"
        },
        {
          "description": "⟨M03⟩ `enrollment.verify`.",
          "type": "string",
          "const": "enrollment.verify"
        },
        {
          "description": "⟨M03⟩ `enrollment.remove`.",
          "type": "string",
          "const": "enrollment.remove"
        }
      ]
    },
    "OperationState": {
      "description": "Operation states (spec §11.4). A caller timeout is not a state change.",
      "oneOf": [
        {
          "description": "Accepted and journaled; not yet running.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "In progress.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Waiting for an owner or provider decision on an owner channel.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Settled: completed with a result.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Settled: failed with a classified error.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Settled: explicitly cancelled; the result says whether an irreversible or\nuncertain step may have occurred.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Unresolved: an external effect may or may not have applied. Quiescent until\nreconciliation settles it to `succeeded` or `failed`; never purged while\nunresolved; never retried blindly.",
          "type": "string",
          "const": "outcome_unknown"
        }
      ]
    }
  }
}
