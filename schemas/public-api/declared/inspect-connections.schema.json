{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WithPreview",
  "description": "⟨rev7⟩ A subject's view typed elsewhere, with `inspect --preview`'s `preview` key beside\nits own keys (the ruling of 2026-11-24 on D1 question 5): the view's keys are flattened, so\nthe document is one flat object, and `preview` is omitted without a preview.",
  "type": "object",
  "properties": {
    "connections": {
      "description": "One entry per owned connection.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConnectionEntry"
      }
    },
    "preview": {
      "description": "`inspect --preview`'s result. Omitted without a preview.",
      "anyOf": [
        {
          "$ref": "#/$defs/PreviewView"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "connections"
  ],
  "$defs": {
    "AccessPairRef": {
      "description": "A destination/account pair.",
      "type": "object",
      "properties": {
        "account": {
          "description": "Remote account.",
          "$ref": "#/$defs/AccountName"
        },
        "destination": {
          "description": "Logical destination.",
          "$ref": "#/$defs/DestinationId"
        }
      },
      "required": [
        "destination",
        "account"
      ]
    },
    "AccountName": {
      "description": "Remote account name on a destination.",
      "type": "string"
    },
    "BindingId": {
      "description": "Work binding ID (spec §4.1 \"Work binding\").",
      "type": "string"
    },
    "Capability": {
      "description": "Credential capabilities a caller may request (spec §7.2).",
      "oneOf": [
        {
          "description": "SSH user authentication.",
          "type": "string",
          "const": "ssh-authentication"
        },
        {
          "description": "Git commit/tag signing (never implied by authentication; spec §7.2).",
          "type": "string",
          "const": "git-signing"
        },
        {
          "description": "Agent forwarding (explicit, disabled by default; spec §8.5).",
          "type": "string",
          "const": "agent-forwarding"
        }
      ]
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "ConnectionEntry": {
      "description": "One `owned_connections` row in `inspect connections` (§5 item 4). PIDs are not\nexposed.",
      "type": "object",
      "properties": {
        "binding_id": {
          "description": "Binding.",
          "$ref": "#/$defs/BindingId"
        },
        "closes_at": {
          "description": "When it will be closed, or `null`.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "destination_id": {
          "description": "Destination.",
          "$ref": "#/$defs/DestinationId"
        },
        "grant_id": {
          "description": "Grant.",
          "$ref": "#/$defs/GrantId"
        },
        "id": {
          "description": "Connection ID.",
          "$ref": "#/$defs/ConnectionId"
        },
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/ConnectionKind"
        },
        "policy": {
          "description": "Effective policy.",
          "$ref": "#/$defs/ConnectionPolicy"
        },
        "started_at": {
          "description": "Started.",
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "description": "State.",
          "$ref": "#/$defs/ConnectionState"
        }
      },
      "required": [
        "id",
        "kind",
        "binding_id",
        "grant_id",
        "destination_id",
        "started_at",
        "policy",
        "state"
      ]
    },
    "ConnectionId": {
      "description": "⟨M03⟩ Owned connection ID (an `owned_connections` row; ADR-0008 D8; m03-plan\n§5 items 4, 4a). Runtime-generated; never a PID.",
      "type": "string"
    },
    "ConnectionKind": {
      "description": "An owned connection's kind (ADR-0008 D8).",
      "oneOf": [
        {
          "description": "An owned multiplex master.",
          "type": "string",
          "const": "master"
        },
        {
          "description": "An owned dedicated connection (`connect`, `run ssh`).",
          "type": "string",
          "const": "dedicated"
        }
      ]
    },
    "ConnectionPolicy": {
      "description": "A connection policy (ADR-0008 D8 item 1). The default is `graceful`, `disabled`.",
      "type": "object",
      "properties": {
        "existing": {
          "description": "Existing dedicated connections at the deadline.",
          "$ref": "#/$defs/ExistingConnectionsMode",
          "default": "graceful"
        },
        "multiplexing": {
          "description": "Owned multiplexing.",
          "$ref": "#/$defs/MultiplexingMode",
          "default": "disabled"
        }
      }
    },
    "ConnectionState": {
      "description": "An owned connection's live state in `inspect connections`.",
      "oneOf": [
        {
          "description": "Running.",
          "type": "string",
          "const": "up"
        },
        {
          "description": "Being closed.",
          "type": "string",
          "const": "closing"
        }
      ]
    },
    "DestinationId": {
      "description": "Destination ID (spec §4.1 \"Destination\"); route-independent.",
      "type": "string"
    },
    "ExistingConnectionsMode": {
      "description": "What happens to owned dedicated connections at the admission deadline (ADR-0008\nD8 item 1). `strict` is narrowing; `graceful` (the default) is widening.",
      "oneOf": [
        {
          "description": "Existing dedicated sessions may stay connected (spec §6.6 default).",
          "type": "string",
          "const": "graceful"
        },
        {
          "description": "Owned connections are closed at the deadline.",
          "type": "string",
          "const": "strict"
        }
      ]
    },
    "GrantId": {
      "description": "Grant ID (spec §4.1 \"Grant\").",
      "type": "string"
    },
    "MultiplexingMode": {
      "description": "Owned multiplex masters (ADR-0008 D8 item 3). `disabled` is the default and\nnarrowing; `owned_masters` is widening.",
      "oneOf": [
        {
          "description": "No master; P renders `ControlPath none`.",
          "type": "string",
          "const": "disabled"
        },
        {
          "description": "The supervisor runs one owned master per pair slot.",
          "type": "string",
          "const": "owned_masters"
        }
      ]
    },
    "PreviewSnapshot": {
      "description": "What a preview would resolve.",
      "type": "object",
      "properties": {
        "deadline": {
          "description": "The deadline that would be enforced.",
          "type": "string",
          "format": "date-time"
        },
        "mechanism": {
          "description": "The mechanism that would serve it. Omitted when no adapter is resolved (today:\n`null`).",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "description": "The profile.",
          "$ref": "#/$defs/ProfileId"
        },
        "profile_revision": {
          "description": "Its current revision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requested": {
          "description": "The requested scope.",
          "$ref": "#/$defs/ScopeView"
        }
      },
      "required": [
        "profile",
        "profile_revision",
        "requested",
        "deadline"
      ]
    },
    "PreviewView": {
      "description": "`inspect --preview`'s `preview` key: resolution without effects, added to the data of\nany subject but `export` when the request carries `preview`. Tagged by `outcome`.",
      "oneOf": [
        {
          "description": "Existing authority covers the request.",
          "type": "object",
          "properties": {
            "effective": {
              "description": "The effective authority (the domain `EffectiveAuthority`, verbatim)."
            },
            "outcome": {
              "type": "string",
              "const": "allowed"
            },
            "snapshot": {
              "description": "What would be resolved.",
              "$ref": "#/$defs/PreviewSnapshot"
            }
          },
          "required": [
            "outcome",
            "snapshot",
            "effective"
          ]
        },
        {
          "description": "Only the delta needs an owner decision.",
          "type": "object",
          "properties": {
            "covered": {
              "description": "What existing authority already covers (the domain `EffectiveAuthority`,\nverbatim). Omitted when nothing is covered (today: `null`)."
            },
            "delta": {
              "description": "What needs a decision (the domain `AuthorityDelta`, verbatim)."
            },
            "outcome": {
              "type": "string",
              "const": "approval_required"
            },
            "snapshot": {
              "description": "What would be resolved.",
              "$ref": "#/$defs/PreviewSnapshot"
            }
          },
          "required": [
            "outcome",
            "snapshot",
            "delta"
          ]
        },
        {
          "description": "Refused.",
          "type": "object",
          "properties": {
            "code": {
              "description": "The refusal's code.",
              "$ref": "#/$defs/Code"
            },
            "message": {
              "description": "The refusal's message.",
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "denied"
            }
          },
          "required": [
            "outcome",
            "code",
            "message"
          ]
        }
      ]
    },
    "ProfileId": {
      "description": "Profile name (spec §4.1 \"Profile\").",
      "type": "string"
    },
    "ScopeView": {
      "description": "A set of destination/account pairs and the capabilities permitted on them, as views\nshow a scope (the domain `Scope`'s wire form: two arrays, each sorted and unique).",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capabilities permitted on every pair.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "pairs": {
          "description": "Destination/account pairs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPairRef"
          }
        }
      },
      "required": [
        "pairs",
        "capabilities"
      ]
    }
  }
}
