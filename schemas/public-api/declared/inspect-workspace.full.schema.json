{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WithPreview",
  "description": "⟨rev7⟩ A subject's view typed elsewhere, with `inspect --preview`'s `preview` key beside\nits own keys (the ruling of 2026-11-24 on D1 question 5): the view's keys are flattened, so\nthe document is one flat object, and `preview` is omitted without a preview.",
  "type": "object",
  "properties": {
    "access_digest": {
      "description": "The manifest's access digest (lowercase hex), when a manifest was read.",
      "type": [
        "string",
        "null"
      ]
    },
    "cwd": {
      "description": "The working directory asked about.",
      "type": "string"
    },
    "match": {
      "description": "The match.",
      "$ref": "#/$defs/WorkspaceMatchView"
    },
    "policy_id": {
      "description": "The workspace policy, when one exists.",
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyId"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "description": "`inspect --preview`'s result. Omitted without a preview.",
      "anyOf": [
        {
          "$ref": "#/$defs/PreviewView"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "description": "⟨M05⟩ Revision 5.2 (§17.10 item 21): the proposal the server builds for this working\ndirectory: the manifest's request ∩ the profile's latest snapshot, exactly what a\n`trust_workspace` request is compared with (ADR-0011 §2.2, I5), so a client echoes\nit and never reads the manifest. Owner-only, like the digest; omitted when there is\nnone (no root, no manifest, an unknown profile, or a request that does not resolve),\nso every earlier document is unchanged.",
      "anyOf": [
        {
          "$ref": "#/$defs/TrustProposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "description": "Provenance.",
      "$ref": "#/$defs/ContextProvenance"
    },
    "root": {
      "description": "The discovered workspace root.",
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "description": "The workspace record, for `trusted`, `member` and `ambiguous`.",
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "cwd",
    "match",
    "provenance"
  ],
  "$defs": {
    "AccessPairRef": {
      "description": "A destination/account pair.",
      "type": "object",
      "properties": {
        "account": {
          "description": "Remote account.",
          "$ref": "#/$defs/AccountName"
        },
        "destination": {
          "description": "Logical destination.",
          "$ref": "#/$defs/DestinationId"
        }
      },
      "required": [
        "destination",
        "account"
      ]
    },
    "AccountName": {
      "description": "Remote account name on a destination.",
      "type": "string"
    },
    "Capability": {
      "description": "Credential capabilities a caller may request (spec §7.2).",
      "oneOf": [
        {
          "description": "SSH user authentication.",
          "type": "string",
          "const": "ssh-authentication"
        },
        {
          "description": "Git commit/tag signing (never implied by authentication; spec §7.2).",
          "type": "string",
          "const": "git-signing"
        },
        {
          "description": "Agent forwarding (explicit, disabled by default; spec §8.5).",
          "type": "string",
          "const": "agent-forwarding"
        }
      ]
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "ContextProvenance": {
      "description": "How much a context claim is worth (ADR-0011 R2): the working directory is a same-user\nclaim.",
      "oneOf": [
        {
          "description": "Any same-user process can name any workspace.",
          "type": "string",
          "const": "same_user_context"
        }
      ]
    },
    "DestinationId": {
      "description": "Destination ID (spec §4.1 \"Destination\"); route-independent.",
      "type": "string"
    },
    "EnvironmentId": {
      "description": "Stable environment ID (spec §4.1 \"Environment\").",
      "type": "string"
    },
    "PolicyId": {
      "description": "Standing policy ID (spec §4.1 \"Standing policy\").",
      "type": "string"
    },
    "PreviewSnapshot": {
      "description": "What a preview would resolve.",
      "type": "object",
      "properties": {
        "deadline": {
          "description": "The deadline that would be enforced.",
          "type": "string",
          "format": "date-time"
        },
        "mechanism": {
          "description": "The mechanism that would serve it. Omitted when no adapter is resolved (today:\n`null`).",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "description": "The profile.",
          "$ref": "#/$defs/ProfileId"
        },
        "profile_revision": {
          "description": "Its current revision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requested": {
          "description": "The requested scope.",
          "$ref": "#/$defs/ScopeView"
        }
      },
      "required": [
        "profile",
        "profile_revision",
        "requested",
        "deadline"
      ]
    },
    "PreviewView": {
      "description": "`inspect --preview`'s `preview` key: resolution without effects, added to the data of\nany subject but `export` when the request carries `preview`. Tagged by `outcome`.",
      "oneOf": [
        {
          "description": "Existing authority covers the request.",
          "type": "object",
          "properties": {
            "effective": {
              "description": "The effective authority (the domain `EffectiveAuthority`, verbatim)."
            },
            "outcome": {
              "type": "string",
              "const": "allowed"
            },
            "snapshot": {
              "description": "What would be resolved.",
              "$ref": "#/$defs/PreviewSnapshot"
            }
          },
          "required": [
            "outcome",
            "snapshot",
            "effective"
          ]
        },
        {
          "description": "Only the delta needs an owner decision.",
          "type": "object",
          "properties": {
            "covered": {
              "description": "What existing authority already covers (the domain `EffectiveAuthority`,\nverbatim). Omitted when nothing is covered (today: `null`)."
            },
            "delta": {
              "description": "What needs a decision (the domain `AuthorityDelta`, verbatim)."
            },
            "outcome": {
              "type": "string",
              "const": "approval_required"
            },
            "snapshot": {
              "description": "What would be resolved.",
              "$ref": "#/$defs/PreviewSnapshot"
            }
          },
          "required": [
            "outcome",
            "snapshot",
            "delta"
          ]
        },
        {
          "description": "Refused.",
          "type": "object",
          "properties": {
            "code": {
              "description": "The refusal's code.",
              "$ref": "#/$defs/Code"
            },
            "message": {
              "description": "The refusal's message.",
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "denied"
            }
          },
          "required": [
            "outcome",
            "code",
            "message"
          ]
        }
      ]
    },
    "ProfileId": {
      "description": "Profile name (spec §4.1 \"Profile\").",
      "type": "string"
    },
    "ScopeView": {
      "description": "A set of destination/account pairs and the capabilities permitted on them, as views\nshow a scope (the domain `Scope`'s wire form: two arrays, each sorted and unique).",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capabilities permitted on every pair.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "pairs": {
          "description": "Destination/account pairs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPairRef"
          }
        }
      },
      "required": [
        "pairs",
        "capabilities"
      ]
    },
    "TrustProposal": {
      "description": "What the owner approves in a `TrustWorkspace` decision (ADR-0011 §2.1): the request\nthe workspace makes (its manifest ∩ the latest profile snapshot, or the trust record's\nown scope when there is no manifest), fixed at decision creation (I5).",
      "type": "object",
      "properties": {
        "background_work": {
          "description": "Lock behaviour requested by `preferences.background_work`, shown at review.",
          "type": "boolean"
        },
        "capabilities": {
          "description": "Capabilities.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "uniqueItems": true
        },
        "environments": {
          "description": "Environments.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvironmentId"
          },
          "uniqueItems": true
        },
        "pairs": {
          "description": "Pairs (a subset of the profile; empty means the whole profile).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPairRef"
          },
          "uniqueItems": true
        },
        "profile": {
          "description": "Profile.",
          "$ref": "#/$defs/ProfileId"
        }
      },
      "required": [
        "profile"
      ]
    },
    "WorkspaceId": {
      "description": "Workspace (adopted checkout) ID (spec §4.1 \"Workspace\").",
      "type": "string"
    },
    "WorkspaceMatchView": {
      "description": "How an observation matched the workspace records, as `inspect workspace` shows it.",
      "oneOf": [
        {
          "description": "Equal path and identity.",
          "type": "string",
          "const": "trusted"
        },
        {
          "description": "A verified linked worktree.",
          "type": "string",
          "const": "member"
        },
        {
          "description": "No record matches.",
          "type": "string",
          "const": "untrusted"
        },
        {
          "description": "One `ReconcileWorkspace` decision away.",
          "type": "string",
          "const": "ambiguous"
        },
        {
          "description": "No workspace root above the working directory: personal context.",
          "type": "string",
          "const": "none"
        }
      ]
    }
  }
}
