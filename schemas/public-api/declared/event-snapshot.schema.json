{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventSnapshot",
  "description": "⟨rev7⟩ The typed `data` of a whole snapshot (ADR-0013 §5.5, D4; PC1): read in one store\ntransaction at the head boundary, whole or refused. Each section holds exactly what the\nsubscription's log and visibility deliver, and a section the filter cannot maintain is\nomitted: `operations` only if the filter admits `operation_state_changed`,\n`pending_decisions` only if it admits `decision` (owner role only), and only `operation`\nwith `filter.operation_id`. Its items are [`SnapshotOperation`] and [`SnapshotDecision`]\n([`EventSnapshotData`]). There is no `boundary_seq` (§5.5) and no partial marker: a\nsnapshot over a cap is refused `USAGE_ERROR` / `response_too_large`, naming the section and\nthe filter to use.",
  "type": "object",
  "properties": {
    "authority_generation": {
      "description": "The authority generation at the head boundary.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "environment_id": {
      "description": "The environment the snapshot is of.",
      "$ref": "#/$defs/EnvironmentId"
    },
    "operation": {
      "description": "The one operation `filter.operation_id` names.",
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotOperation"
        },
        {
          "type": "null"
        }
      ]
    },
    "operations": {
      "description": "The open and unresolved operations the reader may see, at most\n[`SNAPSHOT_OPERATIONS_MAX`].",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/SnapshotOperation"
      }
    },
    "pending_decisions": {
      "description": "The pending decisions (owner role only), at most [`SNAPSHOT_DECISIONS_MAX`].",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/SnapshotDecision"
      }
    }
  },
  "required": [
    "environment_id",
    "authority_generation"
  ],
  "$defs": {
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "REQUEST_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "DecisionId": {
      "description": "Server-issued decision record ID (ADR-0006 §3.1 attended confirmation).",
      "type": "string"
    },
    "DecisionKindName": {
      "description": "A decision's kind, as views and events name it.",
      "oneOf": [
        {
          "description": "Approve the authority delta of an operation.",
          "type": "string",
          "const": "approve_authority"
        },
        {
          "description": "Widen a standing policy.",
          "type": "string",
          "const": "widen_policy"
        },
        {
          "description": "Confirm the wall time.",
          "type": "string",
          "const": "confirm_time"
        },
        {
          "description": "⟨M02⟩ Apply a projection plan.",
          "type": "string",
          "const": "apply_projection"
        },
        {
          "description": "⟨M02⟩ Declare an identity's interaction.",
          "type": "string",
          "const": "declare_interaction"
        },
        {
          "description": "⟨M03⟩ Register an issuer.",
          "type": "string",
          "const": "register_issuer"
        },
        {
          "description": "⟨M04⟩ Add a managed environment.",
          "type": "string",
          "const": "add_environment"
        },
        {
          "description": "⟨M03⟩ Retire an issuer.",
          "type": "string",
          "const": "retire_issuer"
        },
        {
          "description": "⟨M03⟩ Enroll an account.",
          "type": "string",
          "const": "enroll_account"
        },
        {
          "description": "⟨M03⟩ Enroll through the system form.",
          "type": "string",
          "const": "enroll_system_form"
        },
        {
          "description": "⟨M05⟩ Trust a workspace.",
          "type": "string",
          "const": "trust_workspace"
        },
        {
          "description": "⟨M05⟩ Reconcile a workspace.",
          "type": "string",
          "const": "reconcile_workspace"
        },
        {
          "description": "⟨M03⟩ Remove an enrollment.",
          "type": "string",
          "const": "remove_enrollment"
        },
        {
          "description": "⟨M03⟩ Approve an enrollment target change.",
          "type": "string",
          "const": "approve_target_change"
        },
        {
          "description": "⟨M06⟩ A paired client's widening request, decided runner-locally.",
          "type": "string",
          "const": "remote_widening"
        }
      ]
    },
    "EffectStatus": {
      "description": "Whether an operation's external effect happened (spec §11.6).",
      "oneOf": [
        {
          "description": "Nothing external was changed.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The effect was applied and verified.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Some steps applied; the result says which.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "The effect may or may not have applied; reconcile before retrying.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "EnvironmentId": {
      "description": "Stable environment ID (spec §4.1 \"Environment\").",
      "type": "string"
    },
    "OperationId": {
      "description": "Durable operation ID (spec §4.1 \"Operation\").",
      "type": "string"
    },
    "OperationKindView": {
      "description": "An operation's kind, with the dotted names of the setup and enrollment kinds.",
      "oneOf": [
        {
          "description": "`ensure`.",
          "type": "string",
          "const": "ensure"
        },
        {
          "description": "`bind`.",
          "type": "string",
          "const": "bind"
        },
        {
          "description": "`delegate`.",
          "type": "string",
          "const": "delegate"
        },
        {
          "description": "`cancel`.",
          "type": "string",
          "const": "cancel"
        },
        {
          "description": "`release`.",
          "type": "string",
          "const": "release"
        },
        {
          "description": "`revoke`.",
          "type": "string",
          "const": "revoke"
        },
        {
          "description": "An owner policy action.",
          "type": "string",
          "const": "policy"
        },
        {
          "description": "An explicit active probe.",
          "type": "string",
          "const": "probe"
        },
        {
          "description": "⟨M02⟩ `setup.apply`.",
          "type": "string",
          "const": "setup.apply"
        },
        {
          "description": "⟨M02⟩ `setup.rollback`.",
          "type": "string",
          "const": "setup.rollback"
        },
        {
          "description": "⟨M02⟩ `setup.repair`.",
          "type": "string",
          "const": "setup.repair"
        },
        {
          "description": "⟨M02⟩ `catalog`.",
          "type": "string",
          "const": "catalog"
        },
        {
          "description": "⟨M03⟩ `enrollment.apply`.",
          "type": "string",
          "const": "enrollment.apply"
        },
        {
          "description": "⟨M03⟩ `enrollment.verify`.",
          "type": "string",
          "const": "enrollment.verify"
        },
        {
          "description": "⟨M03⟩ `enrollment.remove`.",
          "type": "string",
          "const": "enrollment.remove"
        }
      ]
    },
    "OperationState": {
      "description": "Operation states (spec §11.4). A caller timeout is not a state change.",
      "oneOf": [
        {
          "description": "Accepted and journaled; not yet running.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "In progress.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Waiting for an owner or provider decision on an owner channel.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Settled: completed with a result.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Settled: failed with a classified error.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Settled: explicitly cancelled; the result says whether an irreversible or\nuncertain step may have occurred.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Unresolved: an external effect may or may not have applied. Quiescent until\nreconciliation settles it to `succeeded` or `failed`; never purged while\nunresolved; never retried blindly.",
          "type": "string",
          "const": "outcome_unknown"
        }
      ]
    },
    "SnapshotDecision": {
      "description": "⟨rev7; PC1⟩ One pending decision in an [`EventSnapshot`] (owner role only).",
      "type": "object",
      "properties": {
        "decision_id": {
          "description": "The decision. Always present for the local owner; absent from what a paired reader\nreceives (its delivery removes every `decision_id`, as from `decision` events).",
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "description": "After this instant it cannot be completed.",
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "description": "What is decided.",
          "$ref": "#/$defs/DecisionKindName"
        }
      },
      "required": [
        "kind",
        "expires_at"
      ]
    },
    "SnapshotOperation": {
      "description": "⟨rev7; PC1⟩ One operation in an [`EventSnapshot`]: its identity, state and outcome, the\nfields its `operation_state_changed` events carry, without the operation view's result.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Its result code once terminal. Omitted before.",
          "anyOf": [
            {
              "$ref": "#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_status": {
          "description": "Its effect status.",
          "$ref": "#/$defs/EffectStatus"
        },
        "kind": {
          "description": "Its kind.",
          "$ref": "#/$defs/OperationKindView"
        },
        "operation_id": {
          "description": "The operation.",
          "$ref": "#/$defs/OperationId"
        },
        "state": {
          "description": "Its state.",
          "$ref": "#/$defs/OperationState"
        },
        "updated_at": {
          "description": "When it last changed.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "operation_id",
        "kind",
        "state",
        "effect_status",
        "updated_at"
      ]
    }
  }
}
