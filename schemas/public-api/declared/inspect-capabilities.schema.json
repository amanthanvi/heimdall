{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilitiesView",
  "description": "`inspect capabilities` data: capability and schema discovery (R-AP-08).",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "The capability names this runtime's `inspect` lists.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "codes": {
      "description": "The stable code table.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CodeRowView"
      }
    },
    "lock": {
      "description": "⟨M03⟩ The current lock behaviour and its disclosure. Omitted when the disclosure\ncannot be read (the reader shows \"unknown\").",
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilitiesLockView"
        },
        {
          "type": "null"
        }
      ]
    },
    "login_start": {
      "description": "⟨M04⟩ The host's login entry. Omitted only when it cannot be observed.",
      "anyOf": [
        {
          "$ref": "#/$defs/LoginStartView"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "description": "`inspect --preview`'s result. Omitted without a preview.",
      "anyOf": [
        {
          "$ref": "#/$defs/PreviewView"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "description": "The schema major the runtime emits.",
      "$ref": "#/$defs/SchemaVersion"
    },
    "schemas": {
      "description": "The names of the public schemas.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "capabilities",
    "schemas",
    "codes",
    "schema_version"
  ],
  "$defs": {
    "AccessPairRef": {
      "description": "A destination/account pair.",
      "type": "object",
      "properties": {
        "account": {
          "description": "Remote account.",
          "$ref": "#/$defs/AccountName"
        },
        "destination": {
          "description": "Logical destination.",
          "$ref": "#/$defs/DestinationId"
        }
      },
      "required": [
        "destination",
        "account"
      ]
    },
    "AccountName": {
      "description": "Remote account name on a destination.",
      "type": "string"
    },
    "CapabilitiesLockView": {
      "description": "⟨M03⟩ The current lock behaviour (ADR-0008 D9 item 1).",
      "type": "object",
      "properties": {
        "acknowledged_at": {
          "description": "When the owner acknowledged the disclosure. Omitted when never.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "behavior": {
          "description": "The strictest behaviour over the floor and the applicable policies.",
          "$ref": "#/$defs/LockBehavior"
        },
        "disclosure": {
          "description": "The disclosure's text.",
          "type": "string"
        }
      },
      "required": [
        "behavior",
        "disclosure"
      ]
    },
    "Capability": {
      "description": "Credential capabilities a caller may request (spec §7.2).",
      "oneOf": [
        {
          "description": "SSH user authentication.",
          "type": "string",
          "const": "ssh-authentication"
        },
        {
          "description": "Git commit/tag signing (never implied by authentication; spec §7.2).",
          "type": "string",
          "const": "git-signing"
        },
        {
          "description": "Agent forwarding (explicit, disabled by default; spec §8.5).",
          "type": "string",
          "const": "agent-forwarding"
        }
      ]
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "REQUEST_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "CodeRowView": {
      "description": "One row of the stable code table (`crate::schema::code_table`).",
      "type": "object",
      "properties": {
        "code": {
          "description": "The code.",
          "$ref": "#/$defs/Code"
        },
        "default_effect_status": {
          "description": "Its default effect status.",
          "$ref": "#/$defs/EffectStatus"
        },
        "default_next_action": {
          "description": "Its default next action's name.",
          "type": "string"
        },
        "exit_code": {
          "description": "Its CLI exit code.",
          "type": "integer",
          "format": "int32"
        },
        "retryable": {
          "description": "Whether it is retryable.",
          "type": "boolean"
        },
        "success": {
          "description": "Whether it is a success code.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "exit_code",
        "retryable",
        "default_effect_status",
        "default_next_action",
        "success"
      ]
    },
    "DestinationId": {
      "description": "Destination ID (spec §4.1 \"Destination\"); route-independent.",
      "type": "string"
    },
    "EffectStatus": {
      "description": "Whether an operation's external effect happened (spec §11.6).",
      "oneOf": [
        {
          "description": "Nothing external was changed.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The effect was applied and verified.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Some steps applied; the result says which.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "The effect may or may not have applied; reconcile before retrying.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "LockBehavior": {
      "description": "What a desktop/session lock does to a grant (ADR-0008 D9; spec §6.4). The default\nis `continue`; `revoke_on_lock` is narrowing, `continue` is widening (§5 item 6).",
      "oneOf": [
        {
          "description": "A lock does not end managed grants (the default, spec §6.4).",
          "type": "string",
          "const": "continue"
        },
        {
          "description": "A lock revokes the grant (cause `session_locked`).",
          "type": "string",
          "const": "revoke_on_lock"
        }
      ]
    },
    "LoginStartKind": {
      "description": "The login entry kind of `inspect capabilities` `login_start` (ADR-0010 §1, §6).",
      "oneOf": [
        {
          "description": "`HKCU\\...\\Run` value (Windows).",
          "type": "string",
          "const": "run_value"
        },
        {
          "description": "A LaunchAgent (macOS).",
          "type": "string",
          "const": "launch_agent"
        },
        {
          "description": "A systemd user unit (Linux with a user manager).",
          "type": "string",
          "const": "systemd_user"
        },
        {
          "description": "No login entry is possible (`on_demand`).",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "LoginStartView": {
      "description": "`inspect capabilities` → `login_start` (m04-plan §5 item 7).",
      "type": "object",
      "properties": {
        "installed": {
          "description": "Whether Heimdall's entry is installed.",
          "type": "boolean"
        },
        "kind": {
          "description": "The host's entry kind.",
          "$ref": "#/$defs/LoginStartKind"
        }
      },
      "required": [
        "kind",
        "installed"
      ]
    },
    "PreviewSnapshot": {
      "description": "What a preview would resolve.",
      "type": "object",
      "properties": {
        "deadline": {
          "description": "The deadline that would be enforced.",
          "type": "string",
          "format": "date-time"
        },
        "mechanism": {
          "description": "The mechanism that would serve it. Omitted when no adapter is resolved (today:\n`null`).",
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "description": "The profile.",
          "$ref": "#/$defs/ProfileId"
        },
        "profile_revision": {
          "description": "Its current revision.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "requested": {
          "description": "The requested scope.",
          "$ref": "#/$defs/ScopeView"
        }
      },
      "required": [
        "profile",
        "profile_revision",
        "requested",
        "deadline"
      ]
    },
    "PreviewView": {
      "description": "`inspect --preview`'s `preview` key: resolution without effects, added to the data of\nany subject but `export` when the request carries `preview`. Tagged by `outcome`.",
      "oneOf": [
        {
          "description": "Existing authority covers the request.",
          "type": "object",
          "properties": {
            "effective": {
              "description": "The effective authority (the domain `EffectiveAuthority`, verbatim)."
            },
            "outcome": {
              "type": "string",
              "const": "allowed"
            },
            "snapshot": {
              "description": "What would be resolved.",
              "$ref": "#/$defs/PreviewSnapshot"
            }
          },
          "required": [
            "outcome",
            "snapshot",
            "effective"
          ]
        },
        {
          "description": "Only the delta needs an owner decision.",
          "type": "object",
          "properties": {
            "covered": {
              "description": "What existing authority already covers (the domain `EffectiveAuthority`,\nverbatim). Omitted when nothing is covered (today: `null`)."
            },
            "delta": {
              "description": "What needs a decision (the domain `AuthorityDelta`, verbatim)."
            },
            "outcome": {
              "type": "string",
              "const": "approval_required"
            },
            "snapshot": {
              "description": "What would be resolved.",
              "$ref": "#/$defs/PreviewSnapshot"
            }
          },
          "required": [
            "outcome",
            "snapshot",
            "delta"
          ]
        },
        {
          "description": "Refused.",
          "type": "object",
          "properties": {
            "code": {
              "description": "The refusal's code.",
              "$ref": "#/$defs/Code"
            },
            "message": {
              "description": "The refusal's message.",
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "const": "denied"
            }
          },
          "required": [
            "outcome",
            "code",
            "message"
          ]
        }
      ]
    },
    "ProfileId": {
      "description": "Profile name (spec §4.1 \"Profile\").",
      "type": "string"
    },
    "SchemaVersion": {
      "description": "A `schema_version` value as received from a peer.",
      "type": "string"
    },
    "ScopeView": {
      "description": "A set of destination/account pairs and the capabilities permitted on them, as views\nshow a scope (the domain `Scope`'s wire form: two arrays, each sorted and unique).",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "Capabilities permitted on every pair.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Capability"
          }
        },
        "pairs": {
          "description": "Destination/account pairs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccessPairRef"
          }
        }
      },
      "required": [
        "pairs",
        "capabilities"
      ]
    }
  }
}
