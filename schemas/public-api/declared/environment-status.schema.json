{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvironmentStatusView",
  "description": "`heimdall environment status --json` data: the controller's own view of its runners.\nReading it opens no session, except for one limited-role record named on the command\nline (`runner_view`).",
  "type": "object",
  "properties": {
    "environments": {
      "description": "One entry per recorded runner, ordered by environment ID.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/EnvironmentStatusEntry"
      }
    },
    "management": {
      "description": "Whether management connections are possible now: `available`, or the refusal\nreason (`mgmt_key_store_locked`, …).",
      "type": "string"
    }
  },
  "required": [
    "management",
    "environments"
  ],
  "$defs": {
    "AccessPairRef": {
      "description": "A destination/account pair.",
      "type": "object",
      "properties": {
        "account": {
          "description": "Remote account.",
          "$ref": "#/$defs/AccountName"
        },
        "destination": {
          "description": "Logical destination.",
          "$ref": "#/$defs/DestinationId"
        }
      },
      "required": [
        "destination",
        "account"
      ]
    },
    "AccountName": {
      "description": "Remote account name on a destination.",
      "type": "string"
    },
    "AuthenticationResidual": {
      "description": "⟨M06⟩ Revision 6 (ADR-0012 §7.3, §9 item 10): the new-authentication residual of a\nrevocation. Its bound comes from the counted issuance history (reserved and published\ncertificates count until their `valid_before`) plus the destination clock's error;\nwhere that error is unmeasured the residual reads \"until `valid_before` plus an\nunmeasured destination-clock error\", never a bare deadline.",
      "type": "object",
      "properties": {
        "destination_clock_error": {
          "description": "The destination clock's error: `{\"measured\": {…}}` (its bound is\n`behind_upper_ms`) or `\"unmeasured\"`.",
          "$ref": "#/$defs/DestinationClock"
        },
        "latest_possible_credential_expiry": {
          "description": "The latest instant a counted certificate stays valid; absent: `unknown` (no counted\nhistory for the grant).",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "destination_clock_error"
      ]
    },
    "Capability": {
      "description": "Credential capabilities a caller may request (spec §7.2).",
      "oneOf": [
        {
          "description": "SSH user authentication.",
          "type": "string",
          "const": "ssh-authentication"
        },
        {
          "description": "Git commit/tag signing (never implied by authentication; spec §7.2).",
          "type": "string",
          "const": "git-signing"
        },
        {
          "description": "Agent forwarding (explicit, disabled by default; spec §8.5).",
          "type": "string",
          "const": "agent-forwarding"
        }
      ]
    },
    "ClientId": {
      "description": "⟨M06⟩ Revision 6 (ADR-0012 §3.6, §3.7): a paired management client, minted by the\nrunner at invitation (`cl_<32 hex>`). It names the enrollment line\n(`heimdall-mgmt:<cid>`) and the bridge's argv; it is never a credential and never a\nrequest field that sets a caller (ADR-0006 §18).",
      "type": "string"
    },
    "ClockMeasurement": {
      "description": "A destination clock measurement (ADR-0008 D5 §6.5 item 4): the destination's\nclock lags local time by at most `behind_upper_ms`.",
      "type": "object",
      "properties": {
        "behind_upper_ms": {
          "description": "Upper bound of the destination clock's lag, in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "measured_at": {
          "description": "When measured (local wall time).",
          "type": "string",
          "format": "date-time"
        },
        "rtt_ms": {
          "description": "Round trip of the measurement, in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "behind_upper_ms",
        "rtt_ms",
        "measured_at"
      ]
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "REQUEST_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "Connectivity": {
      "description": "A remote environment's connectivity as the controller sees it (ADR-0012 §7.1).",
      "oneOf": [
        {
          "description": "A management session is open.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "connected"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "No session; last seen then.",
          "type": "object",
          "properties": {
            "last_seen_at": {
              "description": "When the runner was last reached.",
              "type": "string",
              "format": "date-time"
            },
            "state": {
              "type": "string",
              "const": "disconnected"
            }
          },
          "required": [
            "state",
            "last_seen_at"
          ]
        },
        {
          "description": "The runner cannot be reached for a known reason.",
          "type": "object",
          "properties": {
            "reason": {
              "description": "The reason (a stable reason string).",
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "unreachable"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        }
      ]
    },
    "DestinationClock": {
      "description": "A pair's destination clock (ADR-0008 D7 item 3). Wire forms:\n`{\"measured\":{…}}` or `\"unmeasured\"`. Per pair the weakest is shown.",
      "oneOf": [
        {
          "description": "A fresh measurement exists.",
          "type": "object",
          "properties": {
            "measured": {
              "$ref": "#/$defs/ClockMeasurement"
            }
          },
          "required": [
            "measured"
          ]
        },
        {
          "description": "No (fresh) measurement.",
          "type": "string",
          "const": "unmeasured"
        }
      ]
    },
    "DestinationId": {
      "description": "Destination ID (spec §4.1 \"Destination\"); route-independent.",
      "type": "string"
    },
    "DeviceId": {
      "description": "Device ID (spec §4.1 \"Device\").",
      "type": "string"
    },
    "DistributionGuid": {
      "description": "A WSL distribution's registration GUID under `HKCU\\...\\Lxss` (ADR-0010 §3 item 1): the\nidentity of a distribution, kept across renames; a re-registered distribution is a new\nGUID. Wire form: 36 lowercase hex-and-hyphen characters, `8-4-4-4-12`, no braces\n(validated on decode; the CLI normalizes case and strips braces before sending).",
      "type": "string"
    },
    "EarlyCutoffView": {
      "description": "A delivered cutoff that fired before the owner's instant because the runner's time was\nuncertain.",
      "type": "object",
      "properties": {
        "at": {
          "description": "The owner's instant.",
          "type": "string",
          "format": "date-time"
        },
        "fired_at": {
          "description": "The instant it took effect at on the runner.",
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "description": "The controller that produced it.",
          "$ref": "#/$defs/ClientId"
        },
        "reason": {
          "description": "Why it fired early: always `time_uncertain`.",
          "type": "string"
        },
        "scope": {
          "description": "The scope's canonical key (`all`, `policy:<id>`, …).",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "producer",
        "at",
        "fired_at",
        "reason"
      ]
    },
    "EffectId": {
      "description": "⟨M06⟩ Revision 6 (ADR-0012 §7.2): a narrowing effect, minted by its producing\ncontroller. Keyed with the authenticated producer, the typed target and its\ngeneration.",
      "type": "string"
    },
    "EffectTarget": {
      "description": "A typed narrowing effect's target (ADR-0012 §7.2). With the authenticated producing\ncontroller (the session's client, never a field) and the effect ID, it keys the\neffect; each target carries its own generation.",
      "oneOf": [
        {
          "description": "Applied as a durable grant tombstone (ADR-0005 §6.1 \"Revocation\"), acknowledged\nwith its enforcement state.",
          "type": "object",
          "properties": {
            "grant": {
              "description": "The grant.",
              "$ref": "#/$defs/GrantId"
            },
            "grant_generation": {
              "description": "The grant's generation.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "grant_revoke"
            }
          },
          "required": [
            "kind",
            "grant",
            "grant_generation"
          ]
        },
        {
          "description": "Applied as a durable policy revision: running grants continue, new activations\nare refused (§6.1 \"Pause\"). Not a tombstone.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "policy_pause"
            },
            "policy": {
              "description": "The policy.",
              "$ref": "#/$defs/PolicyId"
            },
            "revision": {
              "description": "The revision this pause produces.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "policy",
            "revision"
          ]
        },
        {
          "description": "Applied as a durable policy revision that also ends every affected grant like\nexpiry and refuses new grants until cleared (ADR-0005 §6.1 \"Cutoff\").\n⟨rev6.1; M06-W0-R02, orchestrator ruling⟩ It carries the owner's instant `at` (as the\nlocal `policy cutoff` request does). The runner's effective cutoff is\n`min(existing, at)`: a delivered or replayed cutoff only shortens it, never delays it\n(moving a cutoff later is a widening, runner-local). An `at` at or before trusted now\napplies at the durable apply, with no signature after that commit; a future `at` is\npersisted and enforced at `at` by the supervisor wake; under uncertain time it fires\nas soon as `at` may have passed (the upper bound of now). Enforcement is m06-plan U4's.",
          "type": "object",
          "properties": {
            "at": {
              "description": "The owner's cutoff instant.",
              "type": "string",
              "format": "date-time"
            },
            "kind": {
              "type": "string",
              "const": "policy_cutoff"
            },
            "revision": {
              "description": "The revision this cutoff produces.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "scope": {
              "description": "The policies it applies to.",
              "$ref": "#/$defs/PolicyTarget"
            }
          },
          "required": [
            "kind",
            "scope",
            "at",
            "revision"
          ]
        }
      ]
    },
    "EnvironmentId": {
      "description": "Stable environment ID (spec §4.1 \"Environment\").",
      "type": "string"
    },
    "EnvironmentKindView": {
      "description": "An environment's kind on the wire (`EnvironmentView.kind`).",
      "oneOf": [
        {
          "description": "The runtime's own native session.",
          "type": "string",
          "const": "native_session"
        },
        {
          "description": "A WSL distribution in Mode B.",
          "type": "string",
          "const": "wsl_distribution"
        },
        {
          "description": "A local container environment.",
          "type": "string",
          "const": "container"
        },
        {
          "description": "⟨M06⟩ Revision 6 (ADR-0012 §4.1, §9 item 5): a Heimdall runtime on a headless Linux\nhost under the runner account, managed over the management channel.",
          "type": "string",
          "const": "remote_runner"
        }
      ]
    },
    "EnvironmentListView": {
      "description": "`inspect environments` data, whole: M01's keys for the runtime's own environment, which\nevery role reads, and, for the owner role, `items` (every environment the runtime\nknows, [`crate::environment::EnvironmentsView`]'s list).\n\nProvisional schema name `inspect-environments.full`: today's public\n`inspect-environments` schema describes `items` only.",
      "type": "object",
      "properties": {
        "enrolled": {
          "description": "Whether the runtime's own environment has an enrollment record.",
          "type": "boolean"
        },
        "environment_id": {
          "description": "The runtime's own environment.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "environments": {
          "description": "The own environment's enrollment record: one entry when enrolled, none otherwise.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnvironmentRecordView"
          }
        },
        "items": {
          "description": "⟨M04⟩ Owner role only: every environment the runtime knows, its own first. Omitted\nfor any other role.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/EnvironmentView"
          }
        },
        "preview": {
          "description": "`inspect --preview`'s result. Omitted without a preview.",
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "environment_id",
        "enrolled",
        "environments"
      ]
    },
    "EnvironmentPermissionsView": {
      "description": "What an enrolled environment may do.",
      "type": "object",
      "properties": {
        "automatic_activation": {
          "description": "May activate automatic work under standing policies.",
          "type": "boolean"
        },
        "issuer_access": {
          "description": "May request certificates from the per-user issuer.",
          "type": "boolean"
        },
        "managed_signing": {
          "description": "May host a signing endpoint for managed credentials.",
          "type": "boolean"
        }
      },
      "required": [
        "automatic_activation",
        "managed_signing",
        "issuer_access"
      ]
    },
    "EnvironmentRecordView": {
      "description": "An enrolled environment's record (M01).",
      "type": "object",
      "properties": {
        "device": {
          "description": "Its device.",
          "$ref": "#/$defs/DeviceId"
        },
        "id": {
          "description": "The environment.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "kind": {
          "description": "Its kind.",
          "$ref": "#/$defs/EnvironmentKindView"
        },
        "label": {
          "description": "Its human label. Omitted when none is set (today: `null`).",
          "type": [
            "string",
            "null"
          ]
        },
        "permissions": {
          "description": "Its enrolled permissions.",
          "$ref": "#/$defs/EnvironmentPermissionsView"
        }
      },
      "required": [
        "id",
        "device",
        "kind",
        "permissions"
      ]
    },
    "EnvironmentState": {
      "description": "An environment's state (m04-plan §5 item 4).",
      "oneOf": [
        {
          "description": "In the managed set and running.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "In the managed set; its distribution is not running (background repair never\nstarts it).",
          "type": "string",
          "const": "not_running"
        },
        {
          "description": "Removed by the owner (`wsl disable`, `container remove`); kept as a removed\nidentity, refused as a target (`environment_removed`).",
          "type": "string",
          "const": "removed"
        },
        {
          "description": "Its distribution was unregistered; refused as a target.",
          "type": "string",
          "const": "gone"
        }
      ]
    },
    "EnvironmentStatusEntry": {
      "description": "One recorded runner: the controller's record, and the remote fields when this\ncontroller's state can be read.",
      "type": "object",
      "properties": {
        "client": {
          "description": "This device's client on that runner.",
          "$ref": "#/$defs/ClientId"
        },
        "connectivity": {
          "description": "Its connectivity.",
          "$ref": "#/$defs/Connectivity"
        },
        "cutoffs_fired_early": {
          "description": "The cutoffs the runner's last report showed fired early under uncertain time.\nOmitted when empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EarlyCutoffView"
          }
        },
        "destination": {
          "description": "The catalog destination that reaches it.",
          "$ref": "#/$defs/DestinationId"
        },
        "environment": {
          "description": "The runner's environment ID, as its hello reported it.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "issuance": {
          "description": "The issuer's barrier for this runner.",
          "$ref": "#/$defs/IssuanceGateView"
        },
        "issuance_failures": {
          "description": "⟨M06 W3⟩ The delivered grants whose last remote issuance failed. Omitted when empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssuanceFailedView"
          }
        },
        "key_fingerprint": {
          "description": "The fingerprint of the K_mgmt enrolled there.",
          "$ref": "#/$defs/KeyFingerprint"
        },
        "label": {
          "description": "The owner's label.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_known_readiness": {
          "description": "The last-known readiness of its grants, computed forward. Omitted when empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/LastKnownReadinessView"
          }
        },
        "last_seen_at": {
          "description": "When a session last completed its hello. Omitted when never.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pinned_at": {
          "description": "When the record was written.",
          "type": "string",
          "format": "date-time"
        },
        "remote_pending": {
          "description": "The narrowing effects this controller produced that the runner has not\nacknowledged. Always written, possibly empty. From revision 7 (ADR-0013 §6.4) it\nholds at most the first 16 entries; `remote_pending_count` counts them all.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RemotePending"
          }
        },
        "remote_pending_count": {
          "description": "**Revision 7, not emitted yet** (ADR-0013 §6.4): how many entries `remote_pending`\nhas in full. Omitted until emitted.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "residuals": {
          "description": "The residuals of the grants this controller asked the runner to revoke. Omitted when\nempty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GrantResidual"
          }
        },
        "role": {
          "description": "This device's role there.",
          "$ref": "#/$defs/Role"
        },
        "route": {
          "description": "The route and pins.",
          "$ref": "#/$defs/ManagementRoute"
        },
        "runner_view": {
          "description": "⟨M06 W5; ADR-0006 §18.9 item 6⟩ The runner's own view, read over one management\nsession, for a limited-role record named on the command line. Omitted otherwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunnerViewEntry"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "environment",
        "destination",
        "route",
        "client",
        "role",
        "key_fingerprint",
        "pinned_at"
      ]
    },
    "EnvironmentView": {
      "description": "One environment in `inspect environments` (m04-plan §5 item 4: every environment, not\nonly the caller's).",
      "type": "object",
      "properties": {
        "connectivity": {
          "description": "⟨M06⟩ Revision 6 (ADR-0012 §7.1, §9 item 5): a remote runner's connectivity. Every\nrevision-6 field is omitted when absent, so every M04 view is unchanged.",
          "anyOf": [
            {
              "$ref": "#/$defs/Connectivity"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_id": {
          "description": "Environment ID.",
          "$ref": "#/$defs/EnvironmentId"
        },
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/EnvironmentKindView"
        },
        "label": {
          "description": "Owner label.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_at": {
          "description": "⟨M06⟩ When the runner was last reached.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "management_policy": {
          "description": "⟨M06⟩ Whether limited roles may enroll (ADR-0012 §3.2).",
          "anyOf": [
            {
              "$ref": "#/$defs/ManagementPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "pinned_host_key": {
          "description": "⟨M06⟩ The runner's pinned host key (ADR-0012 §3.3, §7.5).",
          "anyOf": [
            {
              "$ref": "#/$defs/KeyFingerprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "realization": {
          "description": "Realization.",
          "$ref": "#/$defs/RealizationView"
        },
        "remote_pending": {
          "description": "⟨M06⟩ Narrowing steps reported but not yet applied on the runner (ADR-0012 §7.1).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RemotePending"
          }
        },
        "runner_lifetime": {
          "description": "⟨M06⟩ The runner runtime's lifetime (ADR-0012 §4.3).",
          "anyOf": [
            {
              "$ref": "#/$defs/RunnerLifetime"
            },
            {
