{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Envelope",
  "description": "Every ordinary structured result. `T` is the per-primitive `data` payload; errors\nuse [`ErrorData`]. Field order is the spec example's order.",
  "type": "object",
  "properties": {
    "code": {
      "description": "Stable semantic code.",
      "$ref": "#/$defs/Code"
    },
    "data": {
      "description": "Per-primitive payload; never contains private keys or reusable secrets.",
      "$ref": "#/$defs/ErrorData"
    },
    "next": {
      "description": "Machine next action, or `null` when nothing is expected of the caller.\nAlways emitted, `null` when absent (required-nullable in the schema:\n`NextAction | null`).",
      "anyOf": [
        {
          "$ref": "#/$defs/NextAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "description": "Present for effectful or long-running work; absent for pure reads.",
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "description": "Major schema version of this document.",
      "$ref": "#/$defs/SchemaVersion"
    },
    "state": {
      "description": "Operation state; synchronous reads report `succeeded` or `failed`.",
      "$ref": "#/$defs/OperationState"
    },
    "warnings": {
      "description": "Non-fatal findings. Always emitted (listed in the schema's `required`); a\nlenient reader still accepts omission as empty.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "required": [
    "schema_version",
    "state",
    "code",
    "data",
    "warnings",
    "next"
  ],
  "$defs": {
    "BindingId": {
      "description": "Work binding ID (spec §4.1 \"Work binding\").",
      "type": "string"
    },
    "Code": {
      "description": "Stable semantic code (ADR-0006 §5). Readers treat an unlisted value as an error with exit 1.",
      "oneOf": [
        {
          "type": "string",
          "const": "OK"
        },
        {
          "type": "string",
          "const": "ACCESS_READY"
        },
        {
          "type": "string",
          "const": "ACCEPTED"
        },
        {
          "type": "string",
          "const": "APPROVAL_REQUIRED"
        },
        {
          "type": "string",
          "const": "INTERACTION_REQUIRED"
        },
        {
          "type": "string",
          "const": "PROVIDER_LOCKED"
        },
        {
          "type": "string",
          "const": "CAPABILITY_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "POLICY_PAUSED"
        },
        {
          "type": "string",
          "const": "POLICY_CUTOFF"
        },
        {
          "type": "string",
          "const": "CREDENTIAL_EXPIRED"
        },
        {
          "type": "string",
          "const": "HOST_TRUST_CHANGED"
        },
        {
          "type": "string",
          "const": "DELEGATION_EXCEEDS_PARENT"
        },
        {
          "type": "string",
          "const": "OPERATION_CANCELLED"
        },
        {
          "type": "string",
          "const": "DESTINATION_UNREACHABLE"
        },
        {
          "type": "string",
          "const": "TIME_UNCERTAIN"
        },
        {
          "type": "string",
          "const": "UNSUPPORTED_CLIENT"
        },
        {
          "type": "string",
          "const": "SERVICE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "STATE_UNAVAILABLE"
        },
        {
          "type": "string",
          "const": "BACKPRESSURE"
        },
        {
          "type": "string",
          "const": "REQUEST_CONFLICT"
        },
        {
          "type": "string",
          "const": "CONFIG_CONFLICT"
        },
        {
          "type": "string",
          "const": "REQUEST_EXPIRED"
        },
        {
          "type": "string",
          "const": "RESYNC_REQUIRED"
        },
        {
          "type": "string",
          "const": "DECISION_STALE"
        },
        {
          "type": "string",
          "const": "OUTCOME_UNKNOWN"
        },
        {
          "type": "string",
          "const": "USAGE_ERROR"
        },
        {
          "type": "string",
          "const": "SCHEMA_UNSUPPORTED"
        },
        {
          "type": "string",
          "const": "NOT_FOUND"
        },
        {
          "type": "string",
          "const": "INTERNAL_ERROR"
        },
        {
          "type": "string",
          "const": "LAUNCH_FAILED"
        }
      ]
    },
    "ConfigProvenance": {
      "description": "Where a configuration directive was read: a display path and a 1-based line.",
      "type": "object",
      "properties": {
        "line": {
          "description": "1-based line number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path_display": {
          "description": "Display path (`~` for the home directory; `--redact` aware).",
          "type": "string"
        }
      },
      "required": [
        "path_display",
        "line"
      ]
    },
    "Cursor": {
      "description": "Opaque, reader-scoped resumption token. Never parse it outside the runtime.",
      "type": "string"
    },
    "EffectStatus": {
      "description": "Whether an operation's external effect happened (spec §11.6).",
      "oneOf": [
        {
          "description": "Nothing external was changed.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The effect was applied and verified.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Some steps applied; the result says which.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "The effect may or may not have applied; reconcile before retrying.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ErrorData": {
      "description": "The `data` payload of an error envelope.",
      "type": "object",
      "properties": {
        "error": {
          "description": "The error.",
          "$ref": "#/$defs/ErrorDetail"
        },
        "setup": {
          "description": "A setup operation's partial result: a held operation's envelope\n(`OUTCOME_UNKNOWN`, reason `projection_held`) lists every item and held\nstep here (m02-plan §5 item 2). Boxed so the common error stays small.",
          "anyOf": [
            {
              "$ref": "#/$defs/SetupResult"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "error"
      ]
    },
    "ErrorDetail": {
      "description": "Error detail (`data.error`, primitives-draft §1).",
      "type": "object",
      "properties": {
        "code": {
          "description": "Same code as the envelope.",
          "$ref": "#/$defs/Code"
        },
        "effect_status": {
          "description": "Whether any external effect happened.",
          "$ref": "#/$defs/EffectStatus"
        },
        "entries": {
          "description": "⟨M02⟩ ADR-0007 §12.24 item 4: the configuration entries the refusal concerns,\neach as its file's display path and 1-based line (a pre-launch fallback\nrefusal names the refused `IdentityFile` entries). Display paths and line\nnumbers only, never file content. Additive: omitted when empty, and a reader\nthat predates it reads an empty list.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigProvenance"
          }
        },
        "message": {
          "description": "Human text; may change without breaking callers; never contains secrets.",
          "type": "string"
        },
        "next": {
          "description": "Machine next action.",
          "$ref": "#/$defs/NextAction"
        },
        "reason": {
          "description": "Stable `snake_case` sub-reason refining the code (m02-plan §5 item 14; the\nvalues are in [`reason`]). Readers tolerate unknown values.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource": {
          "description": "Resource the error concerns.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "description": "Whether an unchanged retry may succeed later.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "effect_status",
        "retryable",
        "next",
        "message"
      ]
    },
    "FileOutcome": {
      "description": "One file of an item's outcome.",
      "type": "object",
      "properties": {
        "path_display": {
          "description": "Display path.",
          "type": "string"
        },
        "role": {
          "description": "Role.",
          "$ref": "#/$defs/ProjectionFileRole"
        },
        "state": {
          "description": "State.",
          "$ref": "#/$defs/FileOutcomeState"
        }
      },
      "required": [
        "role",
        "path_display",
        "state"
      ]
    },
    "FileOutcomeState": {
      "description": "A file's outcome.",
      "oneOf": [
        {
          "description": "Written and active.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Not written.",
          "type": "string",
          "const": "not_applied"
        },
        {
          "description": "Restored.",
          "type": "string",
          "const": "restored"
        },
        {
          "description": "Written but not referenced (the item did not commit).",
          "type": "string",
          "const": "written_inactive"
        },
        {
          "description": "Removed.",
          "type": "string",
          "const": "removed"
        },
        {
          "description": "Kept as found (`keep_held`).",
          "type": "string",
          "const": "conflict_preserved"
        },
        {
          "description": "Held for the owner.",
          "type": "string",
          "const": "held"
        }
      ]
    },
    "InteractionKind": {
      "description": "The human step an authentication may need (ADR-0007 §7 interaction profile).",
      "oneOf": [
        {
          "description": "No interaction (only ever `declared` for a native agent key).",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The provider asks for approval (1Password).",
          "type": "string",
          "const": "provider_approval"
        },
        {
          "description": "The provider must be unlocked.",
          "type": "string",
          "const": "provider_unlock"
        },
        {
          "description": "A hardware presence touch (FIDO `sk-*` keys).",
          "type": "string",
          "const": "hardware_presence"
        },
        {
          "description": "A passphrase prompt.",
          "type": "string",
          "const": "passphrase"
        },
        {
          "description": "Not known; never satisfies a non-interactive requirement.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "ItemOutcome": {
      "description": "One item's outcome.",
      "type": "object",
      "properties": {
        "files": {
          "description": "Its files.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FileOutcome"
          }
        },
        "item": {
          "description": "The item.",
          "$ref": "#/$defs/ProjectionItem"
        },
        "outcome": {
          "description": "Its outcome.",
          "$ref": "#/$defs/ItemOutcomeKind"
        }
      },
      "required": [
        "item",
        "outcome"
      ]
    },
    "ItemOutcomeKind": {
      "description": "An item's outcome.",
      "oneOf": [
        {
          "description": "Applied.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Not applied; nothing changed.",
          "type": "string",
          "const": "not_applied"
        },
        {
          "description": "Applied, then restored after a failed check.",
          "type": "string",
          "const": "restored"
        },
        {
          "description": "Closed by the owner with `keep_held`.",
          "type": "string",
          "const": "conflict_preserved"
        },
        {
          "description": "Held for the owner (ADR-0007 §5.7 outcome H).",
          "type": "string",
          "const": "held"
        }
      ]
    },
    "NextAction": {
      "description": "Machine next action (spec §11.2 `next`, §11.6 \"machine-readable next action\").\n`action` names are stable; parameters are present only when relevant.",
      "type": "object",
      "properties": {
        "action": {
          "description": "Stable action name; defaults come from [`Code::default_next_action`].",
          "type": "string"
        },
        "binding_id": {
          "description": "Binding to use.",
          "anyOf": [
            {
              "$ref": "#/$defs/BindingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "description": "Cursor to resume from after a resync.",
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_ref": {
          "description": "Nonsecret reference to a pending owner decision.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Operation to observe.",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_interaction": {
          "description": "The provider-owned interaction, with action `interact`, for\n`PROVIDER_LOCKED` and provider-owned `INTERACTION_REQUIRED` (ADR-0007 §7).\nNever combined with `decision_ref`: provider dialogs are not Heimdall\ndecisions (spec §5.5).",
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderInteractionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_ms": {
          "description": "Suggested minimum delay before a retry.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "action"
      ]
    },
    "OperationId": {
      "description": "Durable operation ID (spec §4.1 \"Operation\").",
      "type": "string"
    },
    "OperationState": {
      "description": "Operation states (spec §11.4). A caller timeout is not a state change.",
      "oneOf": [
        {
          "description": "Accepted and journaled; not yet running.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "In progress.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Waiting for an owner or provider decision on an owner channel.",
          "type": "string",
          "const": "awaiting_approval"
        },
        {
          "description": "Settled: completed with a result.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Settled: failed with a classified error.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Settled: explicitly cancelled; the result says whether an irreversible or\nuncertain step may have occurred.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Unresolved: an external effect may or may not have applied. Quiescent until\nreconciliation settles it to `succeeded` or `failed`; never purged while\nunresolved; never retried blindly.",
          "type": "string",
          "const": "outcome_unknown"
        }
      ]
    },
    "ProjectionFileRole": {
      "description": "The role of a file in a projection plan or result.",
      "oneOf": [
        {
          "description": "The user's OpenSSH configuration (holds B).",
          "type": "string",
          "const": "user_ssh"
        },
        {
          "description": "The managed OpenSSH file P.",
          "type": "string",
          "const": "managed_ssh"
        },
        {
          "description": "A materialized public key file.",
          "type": "string",
          "const": "key_file"
        },
        {
          "description": "The global Git file (holds B_git).",
          "type": "string",
          "const": "git_include"
        },
        {
          "description": "The managed Git file P_git.",
          "type": "string",
          "const": "git_managed"
        }
      ]
    },
    "ProjectionItem": {
      "description": "A projection item: the OpenSSH projection or the Git include (ADR-0007 §5.4).",
      "oneOf": [
        {
          "description": "The OpenSSH include block B and the managed file P (with key files).",
          "type": "string",
          "const": "ssh"
        },
        {
          "description": "The Git include block B_git and the managed file P_git.",
          "type": "string",
          "const": "git"
        }
      ]
    },
    "ProviderInteractionRef": {
      "description": "The provider-owned interaction a next action points at (spec §5.5). Used with\naction `interact` for `PROVIDER_LOCKED` and provider-owned\n`INTERACTION_REQUIRED`; never combined with `decision_ref`.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "What it asks for.",
          "$ref": "#/$defs/InteractionKind"
        },
        "provider": {
          "description": "The provider whose dialog it is.",
          "$ref": "#/$defs/ProviderKind"
        }
      },
      "required": [
        "provider",
        "kind"
      ]
    },
    "ProviderKind": {
      "description": "Which provider serves an agent endpoint (ADR-0007 §7 \"Detection is passive\").",
      "oneOf": [
        {
          "description": "An OpenSSH-compatible agent (`ssh-agent`, the Windows OpenSSH agent service).",
          "type": "string",
          "const": "native_agent"
        },
        {
          "description": "The 1Password SSH agent.",
          "type": "string",
          "const": "onepassword"
        },
        {
          "description": "Not determinable passively (for example the Windows `openssh-ssh-agent` pipe,\nF18).",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "RemainingArtifact": {
      "description": "An artifact left for the owner.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/RemainingArtifactKind"
        },
        "path_display": {
          "description": "Display path.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path_display"
      ]
    },
    "RemainingArtifactKind": {
      "description": "The kind of an artifact left for the owner.",
      "oneOf": [
        {
          "description": "A backup copy.",
          "type": "string",
          "const": "backup"
        },
        {
          "description": "A conflict file.",
          "type": "string",
          "const": "conflict_file"
        },
        {
          "description": "A manual-mode block the owner inserted.",
          "type": "string",
          "const": "manual_block"
        },
        {
          "description": "The Heimdall state store.",
          "type": "string",
          "const": "state_store"
        },
        {
          "description": "A recovery record.",
          "type": "string",
          "const": "recovery_record"
        },
        {
          "description": "The quarantine directory.",
          "type": "string",
          "const": "quarantine"
        }
      ]
    },
    "ResourceRef": {
      "description": "A reference to the resource an error concerns. Opaque IDs only; never a secret.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Opaque identifier, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Resource kind (`operation`, `binding`, `grant`, `policy`, `destination`,\n`environment`, `endpoint`, `config`, `store`, `clock`, `decision`, and\nsince M02 `projection`, `identity`, `provider`, `executable`).",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "SchemaVersion": {
      "description": "A `schema_version` value as received from a peer.",
      "type": "string"
    },
    "SetupResult": {
      "description": "An apply, rollback or repair result (schema `setup-result`). A held operation's\nerror envelope (`OUTCOME_UNKNOWN`, reason `projection_held`) carries it in\n`data.setup`.",
      "type": "object",
      "properties": {
        "generation": {
          "description": "The projection generation.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "items": {
          "description": "One outcome per item.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ItemOutcome"
          }
        },
        "remaining": {
          "description": "Artifacts left for the owner.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RemainingArtifact"
          }
        }
      },
      "required": [
        "generation"
      ]
    },
    "Warning": {
      "description": "A non-fatal finding attached to a result.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable warning code (SCREAMING_SNAKE_CASE, not localized).",
          "type": "string"
        },
        "message": {
          "description": "Human text; may change without breaking callers.",
          "type": "string"
        },
        "reason": {
          "description": "⟨M03; ADR-0008 §17.25 item 15⟩ Stable `snake_case` sub-reason refining the\ncode (the values are in [`m03_warning::REASONS`], with the code each refines).\nReaders tolerate unknown values. Additive: omitted when absent, so every\nearlier warning is byte-identical.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
