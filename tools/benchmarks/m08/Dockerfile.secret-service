# The M08 secret-service probe container (m08-w3-plan W3-6; ruled 2026-11-24). It is the soak
# image's package set plus a D-Bus session bus and GNOME Keyring's Secret Service, so a release
# build's managed recipe can find an unlocked login collection with no test hook. The soak
# image (Dockerfile) is unchanged.
#
# Built once with the network (the package install); every run then has none
# (`--network none`). The base image is pinned by its index digest, and the packages named here
# by version. Their dependencies are whatever Debian 13 resolves at build time; the probe's
# record lists the image ID and every installed package with its version (`dpkg-query -W`).
FROM debian@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      openssh-server=1:10.0p1-7+deb13u4 openssh-client=1:10.0p1-7+deb13u4 git=1:2.47.3-0+deb13u1 \
      python3=3.13.5-1 procps=2:4.0.4-9 util-linux=2.41.5-0+deb13u1 \
      dbus=1.16.2-2 dbus-daemon=1.16.2-2 dbus-bin=1.16.2-2 dbus-session-bus-common=1.16.2-2 \
      gnome-keyring=48.0-1 libsecret-tools=0.21.7-1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -s /bin/bash soaks \
 && mkdir -p /run/sshd
